---
import SeoHead from '../../../components/SeoHead.astro';
import FloatingAssistant from "../../../components/FloatingAssistant.astro";
import { getTourGallery } from '../../../utils/tourGallery';
// src/pages/tours/goreme-comfort-hot-air-balloon-tour.astro
const tour = {
  title: 'Tour Privado Mix de Capadocia',
  kicker: 'CAPPADOCIAGO',
  heroDesc: 'Descubre Capadocia a tu propio ritmo con un itinerario privado diseñado según tus intereses. Combina los lugares destacados de los Tours Rojo y Verde con transporte privado, guía profesional y horarios flexibles.',
  overviewTitle: 'Resumen del Tour Privado de Capadocia',
  overviewParagraphs: ['El Tour Privado Mix de Capadocia está pensado para quienes desean explorar la región con una ruta preparada especialmente para ellos. En lugar de un tour grupal estándar, viajarás con vehículo privado y guía profesional.'],
  priceTitle: 'Precio del Tour Privado de Capadocia',
  priceText: 'Precio a Consultar',
  whatsIncluded: ['Servicio de traslado VIP privado', 'Guía turístico privado profesional', 'Almuerzo', 'Planificación flexible de ruta', 'Vehículo privado para tu grupo', 'Asistencia de reservas 24/7'],
  importantInfo: ['Ruta flexible diseñada para tu grupo', 'Opción de combinar paradas de los Tours Rojo y Verde', 'Ideal para familias, parejas y grupos pequeños', 'Recogida y regreso al hotel', 'La ruta final depende de tus intereses y tiempo disponible', 'El precio depende del tamaño del grupo y programa seleccionado'],
  flightDetailsTitle: 'Ruta del Tour Privado de Capadocia',
  flightDetailsParagraphs: ['Planificación de Ruta Personalizada: Podemos preparar un itinerario especial según los lugares que quieras visitar en Capadocia, ofreciéndote mayor control sobre el programa.', 'Combinación de Lugares de los Tours Rojo y Verde: Según tus preferencias, podemos reunir paradas populares de ambos tours en una sola ruta privada.', 'Comodidad para Familias y Grupos: El programa se adapta al número de participantes, expectativas, preferencias de caminata y tiempo disponible.', 'Más Control y Comodidad: Puedes pasar más tiempo en tus lugares favoritos y avanzar más rápido en otras paradas para disfrutar de una experiencia más personal.'],
  afterFlightTitle: 'Fin del Tour',
  afterFlightText: 'Después del programa, regresarás cómodamente a tu hotel.',
  refundTitle: 'Cancelación y Reserva',
  refundText: 'Las condiciones de reserva y cancelación dependen de la disponibilidad y del programa elegido. Contáctanos para confirmar los detalles.',
  advanceTitle: '¿Por Qué Reservar con Anticipación?',
  advanceText: 'Reservar con antelación ayuda a asegurar la fecha, el guía y el vehículo deseados.',
  safetyTitle: 'Servicio Profesional',
  safetyText: 'El tour está organizado con conductores experimentados, guías profesionales y nuestro equipo local de operaciones.'
};
const pageLang = 'es';
const galleryImages = getTourGallery({ slug: 'private-cappadocia-mix-tour', title: tour.title, preferred: ['/images/tours/Private-Cappadocia-Mix-Tour.webp'], max: 6 });
const galleryPhotoWord = 'fotos';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SeoHead title={`${tour.title} | CappadociaGo`} description={tour.heroDesc || tour.overviewParagraphs?.[0] || tour.title} lang={pageLang} />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/css/intlTelInput.css">
  <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/js/intlTelInput.min.js"></script>
</head>
<body>

  <!-- HEADER / NAVBAR - ANA SAYFA İLE AYNI TASARIM -->
  <header class="site-header">
    <div class="header-container">
      <div class="logo">
        <a href="/es/" class="logo-home" aria-label="CappadociaGo Home" title="CappadociaGo - Inicio">
          <img src="/images/logo/turkey-balloons-cappadocia.webp" alt="CappadociaGo" loading="lazy" width="600" height="200" />
        </a>

        <a
          href="https://www.instagram.com/cappadociago/"
          class="header-instagram"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="CappadociaGo on Instagram"
        >
          <img
            src="/images/icons/instagram-logo.webp"
            alt=""
            class="header-instagram-icon"
            width="23"
            height="23"
            aria-hidden="true" loading="lazy"
          />
          <span>@cappadociago</span>
        </a>
      </div>

      <nav class="main-nav" id="mainNav">
        <ul>
          <li><a href="/es/">Tours en Globo</a></li>
          <li><a href="/es/">Tours por Capadocia</a></li>
          <li><a href="/es/">Actividades</a></li>
          <li><a href="/es/">Tours Privados</a></li>
          <li><a href="/es/transfers/">Traslados</a></li>
          <li><a href="/es/flight-status/">Estado de Vuelos</a></li>
        </ul>
      </nav>

      <div class="header-right">
        <div class="lang-switcher" id="langSwitcher">
          <button
            class="lang-btn"
            id="langButton"
            type="button"
            aria-label="Select language"
            aria-expanded="false"
          >
            <span class="lang-flag">🇪🇸</span>
            <span class="lang-code">ES</span>
            <span class="arrow">▾</span>
          </button>

          <div class="lang-dropdown" id="langDropdown">
            <a href="/en/tours/private-cappadocia-mix-tour" class="lang-item"><span class="flag">🇬🇧</span><span>English</span></a>
            <a href="/tr/tours/private-cappadocia-mix-tour" class="lang-item"><span class="flag">🇹🇷</span><span>Türkçe</span></a>
            <a href="/es/tours/private-cappadocia-mix-tour" class="lang-item active"><span class="flag">🇪🇸</span><span>Español</span></a>
          </div>
        </div>

        <a href="https://wa.me/905401015050" class="whatsapp-btn" target="_blank" rel="noopener noreferrer">
          <img
            src="/images/icons/whatsapp-logo.webp"
            alt=""
            class="whatsapp-btn-icon"
            width="18"
            height="18"
            aria-hidden="true" loading="lazy"
          />
          <span>WhatsApp</span>
        </a>

        <button class="mobile-menu-toggle" id="mobileMenuToggle" type="button" aria-label="Toggle Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </header>

  <section class="tbc-tour-page">
    <div class="tbc-tour-container">

      <!-- BREADCRUMB -->
      <div class="tbc-breadcrumb">
        <a href="/es/">Inicio</a> <span>›</span> <span>{tour.title}</span>
      </div>

      <!-- HERO ALANI -->
      <div class="tbc-tour-hero">
        <div class="tbc-tour-kicker">{tour.kicker}</div>
        <h1 class="tbc-tour-title">{tour.title}</h1>
        <p class="tbc-tour-desc">{tour.heroDesc}</p>

        <!-- ÖZELLİK ROZETLERİ -->
        <div class="tbc-hero-badges-bar">
          <div class="tbc-badge-item">
            <span class="tbc-stars">★★★★★</span>
            <strong class="tbc-badge-val">4.97</strong>
            <span class="tbc-badge-sep">|</span>
            <span class="tbc-badge-link" id="tbc-scrollToReviews">9 Reseñas ❯</span>
          </div>
          <div class="tbc-badge-item">
            <span class="tbc-badge-icon">⏱</span>
            <span>Duración del Tour: 60 Minutos</span>
          </div>
          <div class="tbc-badge-item">
            <span class="tbc-badge-icon">⚡</span>
            <span>¡Confirmación Instantánea!</span>
          </div>
          <a href="https://wa.me/905401015050" class="tbc-badge-item tbc-badge-wa" target="_blank" rel="noopener noreferrer">
            <img src="/images/icons/whatsapp-logo.webp" alt="" class="tbc-badge-wa-icon" width="20" height="20" aria-hidden="true" loading="lazy" />
            <strong>905401015050</strong>
          </a>
        </div>
      </div>

      <!-- PHOTO GALLERY GRID -->
      {galleryImages.length > 0 && (
        <div class="tbc-photo-grid-wrapper" data-gallery-root>
          <button type="button" class="tbc-main-photo tbc-gallery-click" data-gallery-index="0">
            <img src={galleryImages[0]} alt={tour.title} width="1200" height="800" loading="lazy" decoding="async" />
            <div class="tbc-photo-badge">📁 {galleryImages.length} {galleryPhotoWord}</div>
          </button>
          <div class="tbc-side-photos">
            {galleryImages.slice(1,5).map((src, i) => (
              <button type="button" class="tbc-side-photo-item tbc-gallery-click" data-gallery-index={String(i+1)}>
                <img src={src} alt={tour.title} width="1200" height="800" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        </div>
      )}
      <div class="tbc-gallery-modal" id="tbcGalleryModal" aria-hidden="true">
        <button type="button" class="tbc-gallery-close" aria-label="Close">×</button>
        <button type="button" class="tbc-gallery-prev" aria-label="Previous">‹</button>
        <img id="tbcGalleryModalImg" alt={tour.title} width="1200" height="800" loading="lazy" decoding="async" />
        <button type="button" class="tbc-gallery-next" aria-label="Next">›</button>
        <div class="tbc-gallery-count" id="tbcGalleryCount"></div>
      </div>

      <div class="tbc-tour-grid">

        <!-- MAIN CONTENT -->
        <div class="tbc-tour-main">
          <div class="tbc-tour-card tbc-tour-main-card">

            <div class="tbc-tour-section">
              <h2>{tour.overviewTitle}</h2>
              {tour.overviewParagraphs.map(p => (
                <p>{p}</p>
              ))}
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.priceTitle}</h2>
              <p>{tour.priceText}</p>
            </div>

            <div class="tbc-tour-section">
              <h2>Qué Incluye el Precio</h2>
              <div class="tbc-tour-list">
                {tour.whatsIncluded.map(item => (
                  <div class="tbc-tour-list-item"><span class="tbc-tour-check">✓</span><span>{item}</span></div>
                ))}
              </div>
            </div>

            <div class="tbc-tour-section">
              <h2>Información Importante</h2>
              <div class="tbc-tour-list">
                {tour.importantInfo.map(info => (
                  <div class="tbc-tour-list-item"><span class="tbc-tour-check">✓</span><span>{info}</span></div>
                ))}
              </div>
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.flightDetailsTitle}</h2>
              {tour.flightDetailsParagraphs.map(fp => (
                <p>{fp}</p>
              ))}
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.afterFlightTitle}</h2>
              <p>{tour.afterFlightText}</p>
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.refundTitle}</h2>
              <p>{tour.refundText}</p>
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.advanceTitle}</h2>
              <p>{tour.advanceText}</p>
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.safetyTitle}</h2>
              <p>{tour.safetyText}</p>
            </div>

          </div>

          <!-- YORUMLAR -->
          <div class="tbc-tour-card tbc-reviews-card" id="reviews-section">
            <h3 class="tbc-reviews-main-title">Reseñas (9)</h3>
            <div class="tbc-aggregate-rating" style="margin:8px 0 18px;font-weight:800;font-size:18px;"><span style="letter-spacing:2px;">★★★★★</span> <span>5,00 / 5</span></div>

            <div class="tbc-reviews-container" id="tbc-reviews-container">
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">A</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Alexander Wright</h4>
                    <span class="tbc-review-tour-type">Tour Privado Mix de Capadocia</span>
                  </div>
                  <div class="tbc-review-date">10 de agosto de 2026</div>
                </div>
                <p class="tbc-review-text">Reservar un tour Private VIP fue la mejor decisión que tomamos para nuestras vacaciones en Capadocia. Nuestro guía privado adaptó toda la ruta entre las maravillas subterráneas del Tour Verde y las icónicas chimeneas de hadas del Tour Rojo exactamente a nuestro ritmo. La furgoneta Mercedes VIP estaba impecable, era muy cómoda y el aire acondicionado fue muy agradecido durante las horas más calurosas. Tener un experto en historia solo para nosotros hizo que cada visita se sintiera exclusiva y profundamente personal. ¡Un servicio de primera clase de principio a fin!</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">B</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Beatriz Gomez</h4>
                    <span class="tbc-review-tour-type">Tour Privado Mix de Capadocia</span>
                  </div>
                  <div class="tbc-review-date">22 de julio de 2026</div>
                </div>
                <p class="tbc-review-text">¡Una auténtica obra maestra de organización de viajes privados! Queríamos un itinerario personalizado combinando los mejores lugares de los Tours Rojo y Verde sin tener que viajar en autobuses llenos. Nuestro guía personal se expresaba de maravilla, tenía muchísimo conocimiento y estuvo muy atento a nuestras preferencias. El vehículo VIP era amplio, lujoso y tenía bebidas durante todo el día. Si buscas máximo confort, flexibilidad y una guía experta en Capadocia, esta es una gran elección.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">H</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Henri Leroy</h4>
                    <span class="tbc-review-tour-type">Tour Privado Mix de Capadocia</span>
                  </div>
                  <div class="tbc-review-date">5 de julio de 2026</div>
                </div>
                <p class="tbc-review-text">Nuestro tour privado VIP superó todas nuestras expectativas. Desde la recogida perfecta en el hotel con una furgoneta de lujo impecable hasta la atención personalizada de nuestro guía, todo se sintió exclusivo. Exploramos los valles excavados en roca y las antiguas estructuras subterráneas a nuestro propio ritmo, sin sentirnos presionados por un horario de grupo. Los profundos conocimientos históricos y la excelente comunicación de nuestro guía hicieron que los paisajes cobraran vida. ¡Vale cada céntimo para quienes valoran el lujo y la privacidad!</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">K</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Katarina Novak</h4>
                    <span class="tbc-review-tour-type">Tour Privado Mix de Capadocia</span>
                  </div>
                  <div class="tbc-review-date">18 de junio de 2026</div>
                </div>
                <p class="tbc-review-text">Elegancia, comodidad y excelencia profesional definen perfectamente esta excursión VIP privada. Nuestro guía hizo todo lo posible para garantizar nuestro confort, adaptando la intensidad de las caminatas y las paradas para almorzar exactamente a nuestro gusto. El vehículo privado de lujo era excepcionalmente cómodo y facilitó muchísimo los desplazamientos entre los principales puntos del norte y del sur. Fue maravilloso evitar los grupos grandes y disfrutar de los paisajes de Capadocia con tranquilidad y estilo.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">L</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Liam Henderson</h4>
                    <span class="tbc-review-tour-type">Tour Privado Mix de Capadocia</span>
                  </div>
                  <div class="tbc-review-date">30 de mayo de 2026</div>
                </div>
                <p class="tbc-review-text">¡Una experiencia Private VIP fenomenal! Combinamos los mejores lugares de las rutas Roja y Verde en un único día personalizado. Nuestro guía privado no solo sabía muchísimo sobre la historia regional, sino que también era un excelente fotógrafo y nos ayudó a encontrar los mejores ángulos. La furgoneta de lujo era moderna, con asientos de cuero y extremadamente cómoda para nuestra familia. Servicio excepcional, flexibilidad total y guía de primer nivel.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">V</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Victoria Vance</h4>
                    <span class="tbc-review-tour-type">Tour Privado Mix de Capadocia</span>
                  </div>
                  <div class="tbc-review-date">15 de abril de 2026</div>
                </div>
                <p class="tbc-review-text">Si buscas privacidad, comodidad de alto nivel y una experiencia de guía exclusiva, reserva este tour VIP. Nuestro guía fue encantador, muy conocedor y adaptó las explicaciones históricas a nuestros intereses específicos. El vehículo Mercedes de lujo ofrecía un espacio relajante entre las paradas y los trayectos por las carreteras rurales fueron muy cómodos. Cada detalle estuvo cuidado con precisión y disfrutamos de un día completamente libre de estrés.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">S</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Sven Lindqvist</h4>
                    <span class="tbc-review-tour-type">Tour Privado Mix de Capadocia</span>
                  </div>
                  <div class="tbc-review-date">20 de marzo de 2026</div>
                </div>
                <p class="tbc-review-text">Lujo absoluto y profesionalidad de primer nivel desde el momento en que subimos a nuestra furgoneta VIP privada. Nuestro guía consiguió que nos sintiéramos verdaderos invitados VIP, respondiendo cada pregunta con gran conocimiento y entusiasmo. El tour combinó de forma perfecta los mejores lugares culturales de ambas rutas y pudimos conocer lo mejor de Capadocia con máxima comodidad. Muy recomendable para parejas o familias que buscan una experiencia privada.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">C</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Claudia Moretti</h4>
                    <span class="tbc-review-tour-type">Tour Privado Mix de Capadocia</span>
                  </div>
                  <div class="tbc-review-date">12 de noviembre de 2025</div>
                </div>
                <p class="tbc-review-text">Un tour privado impecable que cambió por completo nuestras expectativas de viaje. El vehículo de lujo era extremadamente cómodo y nuestro guía privado fue profesional y muy cercano. Nos encantó poder pasar más tiempo en los miradores y monasterios históricos sin ninguna presión de tiempo. La atención personalizada, los comentarios expertos y el nivel de comodidad hicieron que este fuera el momento más destacado de todo nuestro viaje a Turquía.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">N</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Nathaniel Brooks</h4>
                    <span class="tbc-review-tour-type">Tour Privado Mix de Capadocia</span>
                  </div>
                  <div class="tbc-review-date">8 de octubre de 2025</div>
                </div>
                <p class="tbc-review-text">Reservar la opción Private VIP fue la decisión más inteligente que tomamos. Nuestro guía conocía a fondo la arqueología y la cultura local y convirtió una visita turística normal en una aventura intelectual. El vehículo de lujo estaba impecable, era extremadamente cómodo y tenía todo lo necesario para un día completo en carretera. Privacidad total, comodidad inigualable y un guía brillante que se adaptó a todas nuestras necesidades.</p>
              </div>
              <div class="tbc-load-more-wrap" id="tbc-load-more-wrap">
                <button type="button" class="tbc-load-more-btn" id="tbc-load-more-btn">Ver las 9 Reseñas ▾</button>
              </div>
            </div>
          </div>

        </div>

        <!-- SIDEBAR -->
        <aside class="tbc-tour-side">
          <div class="tbc-tour-card tbc-tour-side-card">
            <div class="tbc-tour-price-top">
              <span class="tbc-tour-price-label">Precio del Tour Privado</span>
              <div class="tbc-tour-price-value">
                <strong id="tbc-main-price">Precio a Consultar</strong>
                <span></span>
              </div>
              <div class="tbc-tour-badge-row"><div class="tbc-tour-badge">Ruta Privada</div><div class="tbc-tour-badge">Traslado VIP</div><div class="tbc-tour-badge">Ideal para Familias</div></div>
            </div>

            <div class="tbc-tour-contact-box">
              <a class="tbc-tour-contact-link" href="tel:+905401015050">📞 +90 540 844 0050</a>
              <a class="tbc-tour-whatsapp" href="https://wa.me/905401015050" target="_blank" rel="noopener">Contactar por WhatsApp</a>
            </div>

            <div class="tbc-tour-side-list">
              <div><span>✓</span><div>Planificación flexible solo para ti</div></div>
              <div><span>✓</span><div>Combina lugares de los Tours Rojo y Verde</div></div>
              <div><span>✓</span><div>Viaje cómodo para familias y grupos pequeños</div></div>
              <div><span>✓</span><div>Comunicación rápida y reserva sencilla</div></div>
            </div>
          </div>

          <div class="tbc-tour-card tbc-booking-card">
            <div class="tbc-booking-head">
              <h3>Formulario de Reserva Rápida</h3>
              <p>Déjanos tus datos y nuestro equipo se pondrá en contacto contigo lo antes posible.</p>
            </div>

            <form class="tbc-booking-form" action="#" method="post">
              <div class="tbc-booking-group">
                <label for="tbc-name">Nombre Completo</label>
                <input type="text" id="tbc-name" name="name" placeholder="Nombre completo" required>
              </div>

              <div class="tbc-booking-group tbc-phone-group">
                <label for="tbc-phone">Número de Teléfono</label>
                <input type="tel" id="tbc-phone" name="phone" placeholder="Número de teléfono" required>
                <input type="hidden" id="tbc-phone-full" name="full_phone">
              </div>

              <div class="tbc-booking-group tbc-date-group">
                <label for="tbc-date">Fecha</label>
                <div class="tbc-date-picker-wrap">
                  <input type="text" id="tbc-date" name="date" placeholder="Seleccionar fecha" autocomplete="off" readonly required>
                  <button type="button" class="tbc-calendar-icon" id="tbc-calendar-open" aria-label="Abrir calendario">📅</button>

                  <div class="tbc-custom-calendar" id="tbc-custom-calendar">
