  .tbc-review-stars { color: #eab308; font-size: 13px; letter-spacing: 1px; margin-bottom: 3px; }
  .tbc-review-name { margin: 0; font-size: 16px; font-weight: 800; color: #f8fafc; }
  .tbc-review-tour-type { font-size: 12px; color: #94a3b8; font-weight: 600; }
  .tbc-review-date { position: absolute; right: 0; top: 0; font-size: 12px; color: #94a3b8; font-weight: 600; }
  .tbc-review-text { margin: 0; font-size: 14px; line-height: 1.8; color: #cbd5e1; }
  .tbc-load-more-wrap { margin-top: 24px; text-align: center; padding-top: 16px; border-top: 1px solid #334155; }
  .tbc-load-more-btn { background: #0f172a; border: 1px solid #eab308; color: #eab308; padding: 12px 28px; border-radius: 999px; font-weight: 800; font-size: 14px; cursor: pointer; transition: all 0.2s ease; }
  .tbc-load-more-btn:hover { background: #eab308; color: #0f172a; }
  .tbc-tour-side-card { padding: 22px; }
  .tbc-tour-price-top { padding-bottom: 18px; margin-bottom: 18px; border-bottom: 1px solid #334155; }
  .tbc-tour-price-label { display: block; margin-bottom: 6px; font-size: 13px; color: #94a3b8; font-weight: 700; }
  .tbc-tour-price-value { display: flex; align-items: flex-end; gap: 8px; color: #eab308; }
  .tbc-tour-price-value strong { font-size: 40px; line-height: 1; font-weight: 900; }
  .tbc-tour-price-value span { font-size: 15px; font-weight: 700; color: #94a3b8; padding-bottom: 4px; }
  .tbc-tour-badge-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .tbc-tour-badge { display: inline-flex; align-items: center; min-height: 30px; padding: 0 12px; border-radius: 999px; background: #0f172a; border: 1px solid #334155; color: #eab308; font-size: 12px; font-weight: 800; }
  .tbc-tour-contact-box { margin-top: 0; padding-top: 0; border-top: 0; display: grid; gap: 10px; }
  .tbc-tour-contact-link, .tbc-tour-whatsapp { display: inline-flex; align-items: center; justify-content: center; width: 100%; min-height: 48px; border-radius: 999px; text-decoration: none; font-size: 14px; font-weight: 800; }
  .tbc-tour-contact-link { background: #0f172a; border: 1px solid #334155; color: #f8fafc; }
  .tbc-tour-whatsapp { background: #22c55e; color: #fff; }
  .tbc-tour-side-list { margin-top: 18px; display: grid; gap: 10px; }
  .tbc-tour-side-list div { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.75; color: #cbd5e1; }
  .tbc-tour-side-list span { color: #eab308; font-weight: 900; }
  .tbc-booking-card { padding: 22px; }
  .tbc-booking-head { margin-bottom: 16px; }
  .tbc-booking-head h3 { margin: 0 0 8px; font-size: 20px; line-height: 1.2; color: #f8fafc; font-weight: 800; }
  .tbc-booking-head p { margin: 0; font-size: 14px; line-height: 1.75; color: #94a3b8; }
  .tbc-booking-form { display: grid; grid-template-columns: 1fr; gap: 14px; }
  .tbc-booking-group { display: flex; flex-direction: column; }
  .tbc-booking-group-full { grid-column: 1 / -1; }
  .tbc-booking-group label { margin-bottom: 7px; font-size: 13px; font-weight: 700; color: #cbd5e1; }
  .tbc-booking-group input, .tbc-booking-group select, .tbc-booking-group textarea { width: 100%; min-height: 48px; padding: 12px 14px; border: 1px solid #334155; border-radius: 16px; background: #0f172a; font-size: 14px; color: #f8fafc; outline: none; transition: .2s ease; }
  .tbc-booking-group textarea { min-height: 110px; resize: vertical; }
  .tbc-booking-group input:focus, .tbc-booking-group select:focus, .tbc-booking-group textarea:focus { border-color: #eab308; box-shadow: 0 0 0 4px rgba(234, 179, 8, 0.15); }
  .tbc-booking-submit { width: 100%; min-height: 50px; border: 0; border-radius: 999px; background: #eab308; color: #0f172a; font-size: 14px; font-weight: 800; cursor: pointer; transition: .2s ease; }
  .tbc-booking-submit:hover { background: #ca8a04; color: #fff; }
  .tbc-phone-group .iti { width: 100%; display: block; }
  .tbc-phone-group .iti__tel-input { width: 100%; min-height: 48px; padding: 12px 14px; border: 1px solid #334155; border-radius: 16px; background: #0f172a; font-size: 14px; color: #f8fafc; outline: none; }
  .tbc-phone-group .iti__country-list { z-index: 99999; border-radius: 16px; background: #1e293b; color: #f8fafc; box-shadow: 0 18px 45px rgba(0, 0, 0, 0.6); border: 1px solid #334155; }
  .tbc-phone-group .iti__country { padding: 8px 10px; }
  .tbc-phone-group .iti__country:hover { background: #334155; }
  .tbc-date-picker-wrap { position: relative; width: 100%; }
  .tbc-date-picker-wrap input { padding-right: 48px; cursor: pointer; }
  .tbc-calendar-icon { position: absolute; right: 10px; top: 50%; width: 34px; height: 34px; transform: translateY(-50%); border: 0; border-radius: 12px; background: #1e293b; color: #eab308; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 15px; }
  .tbc-custom-calendar { position: absolute; top: calc(100% + 10px); left: 0; width: 320px; max-width: calc(100vw - 40px); background: #1e293b; border: 1px solid #334155; border-radius: 20px; box-shadow: 0 18px 45px rgba(0, 0, 0, 0.6); padding: 16px; z-index: 9999; display: none; }
  .tbc-custom-calendar.is-open { display: block; }
  .tbc-calendar-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .tbc-cal-title { font-size: 15px; font-weight: 900; color: #f8fafc; text-align: center; }
  .tbc-cal-nav { width: 36px; height: 36px; border: 0; border-radius: 12px; background: #0f172a; color: #eab308; font-size: 24px; cursor: pointer; }
  .tbc-cal-nav:hover { background: #334155; }
  .tbc-calendar-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 8px; }
  .tbc-calendar-weekdays span { text-align: center; font-size: 11px; font-weight: 800; color: #94a3b8; }
  .tbc-calendar-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; }
  .tbc-cal-day { min-height: 46px; border: 0; border-radius: 13px; background: #0f172a; color: #f8fafc; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4px 2px; }
  .tbc-cal-day:hover { background: #334155; }
  .tbc-cal-day.is-empty, .tbc-cal-day.is-disabled { cursor: default; opacity: .3; background: transparent; }
  .tbc-cal-day.is-selected { background: #eab308; color: #0f172a; }
  .tbc-cal-day-number { display: block; font-size: 13px; font-weight: 900; line-height: 1.1; }
  .tbc-cal-day-price { display: block; margin-top: 3px; font-size: 10px; line-height: 1; font-weight: 800; color: #eab308; }
  .tbc-cal-day.is-selected .tbc-cal-day-price { color: #0f172a; }
  .tbc-calendar-note { margin-top: 12px; padding-top: 12px; border-top: 1px solid #334155; font-size: 11px; line-height: 1.5; color: #94a3b8; }
  .tbc-selected-price-box { grid-column: 1 / -1; display: none; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 15px; border-radius: 16px; background: #0f172a; border: 1px solid #334155; }
  .tbc-selected-price-box.is-visible { display: flex; }
  .tbc-selected-price-box span { font-size: 13px; font-weight: 700; color: #94a3b8; }
  .tbc-selected-price-box strong { font-size: 18px; font-weight: 900; color: #eab308; }
  .tbc-site-footer { width: 100%; background: #0b1120; border-top: 1px solid #1e293b; padding: 50px 20px; color: #f8fafc; }
  .tbc-footer-container { max-width: 1240px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; gap: 40px; flex-wrap: wrap; }
  .tbc-footer-col-left .tbc-footer-logo-big { max-height: 180px; width: auto; display: block; }
  .tbc-footer-col-right { display: flex; flex-direction: column; gap: 24px; max-width: 700px; }
  .tbc-footer-contacts { display: flex; flex-wrap: wrap; gap: 30px; }
  .tbc-f-contact-item { display: flex; align-items: center; gap: 14px; }
  .tbc-f-icon { width: 44px; height: 44px; border-radius: 50%; background: #ff5722; display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff; flex-shrink: 0; }
  .whatsapp-icon { background: #22c55e; }
  .email-icon { background: #ff5722; }
  .phone-icon { background: #ff5722; }
  .tbc-f-label { display: block; font-size: 12px; color: #94a3b8; font-weight: 600; }
  .tbc-footer-contacts a { color: #f8fafc; text-decoration: none; font-size: 15px; font-weight: 700; transition: color 0.2s; }
  .tbc-footer-contacts a:hover { color: #eab308; }
  .tbc-footer-gallery { display: flex; gap: 12px; }
  .tbc-footer-gallery img { width: 110px; height: 75px; object-fit: cover; border-radius: 12px; border: 1px solid #334155; }
  @media (max-width: 1024px) {
    .tbc-tour-grid { grid-template-columns: 1fr; }
    .tbc-tour-list { grid-template-columns: 1fr; }
    .tbc-tour-side { order: -1; }
    .tbc-main-nav { display: none; }
    .tbc-footer-container { flex-direction: column; align-items: flex-start; }
    .tbc-footer-gallery { flex-wrap: wrap; }
    .tbc-photo-grid-wrapper { grid-template-columns: 1fr; }
    .tbc-side-photos { height: auto; grid-template-columns: repeat(4, 1fr); }
    .tbc-hero-badges-bar { flex-direction: column; align-items: stretch; }
    .tbc-review-date { position: static; margin-top: 4px; display: block; }
  }

