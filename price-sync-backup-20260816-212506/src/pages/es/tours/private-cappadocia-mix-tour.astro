<script>
document.addEventListener("DOMContentLoaded", function () {

  // Header dil menüsü
  const langSwitcher = document.getElementById("langSwitcher");
  const langButton = document.getElementById("langButton");
  const langDropdown = document.getElementById("langDropdown");

  if (langSwitcher && langButton && langDropdown) {
    const closeLanguageMenu = () => {
      langSwitcher.classList.remove("is-open");
      langButton.setAttribute("aria-expanded", "false");
    };

    langButton.addEventListener("click", function (event) {
      event.preventDefault();
      event.stopPropagation();
      const willOpen = !langSwitcher.classList.contains("is-open");
      closeLanguageMenu();
      if (willOpen) {
        langSwitcher.classList.add("is-open");
        langButton.setAttribute("aria-expanded", "true");
      }
    });

    document.addEventListener("click", function (event) {
      if (!langSwitcher.contains(event.target)) closeLanguageMenu();
    });
  }

  // Mobil menü
  const mobileMenuToggle = document.getElementById("mobileMenuToggle");
  const mainNav = document.getElementById("mainNav");
  if (mobileMenuToggle && mainNav) {
    mobileMenuToggle.addEventListener("click", function () {
      mainNav.classList.toggle("is-open");
    });
  }

  // =========================================================
  // LIVE SUPABASE PRICE & AVAILABILITY CALENDAR – ES
  // =========================================================
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
  const TBC_PRODUCT_SLUG = 'private-cappadocia-mix-tour';
  const tbcMonthNames = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  const tbcText = {'left': 'plazas', 'closed': 'Cerrado', 'sold': 'Agotado', 'unavailable': 'No disponible', 'loading': 'Cargando disponibilidad...', 'selectPeople': 'Seleccionar personas', 'person': 'Persona', 'people': 'Personas', 'children': 'Los niños también están incluidos en este número de personas.', 'unit': 'Precio por persona', 'total': 'Precio total', 'request': 'Nueva Solicitud de Reserva', 'name': 'Nombre', 'phone': 'Teléfono', 'date': 'Fecha', 'guests': 'Personas', 'message': 'Mensaje', 'alert': 'Completa nombre, teléfono, fecha y número de personas antes de enviar.'};

  const tbcDateInput = document.getElementById("tbc-date");
  const tbcCalendar = document.getElementById("tbc-custom-calendar");
  const tbcCalendarOpen = document.getElementById("tbc-calendar-open");
  const tbcCalendarDays = document.getElementById("tbc-calendar-days");
  const tbcCalendarTitle = document.getElementById("tbc-cal-title");
  const tbcPrevMonthBtn = document.getElementById("tbc-prev-month");
  const tbcNextMonthBtn = document.getElementById("tbc-next-month");
  const tbcSelectedPriceBox = document.getElementById("tbc-selected-price-box");
  const tbcSelectedPriceText = document.getElementById("tbc-selected-price-text");
  const tbcSelectedPriceInput = document.getElementById("tbc-selected-price-input");
  const tbcMainPrice = document.getElementById("tbc-main-price");
  const tbcPersonSelect = document.getElementById("tbc-person");
  let tbcProduct = null, tbcAvailability = {}, tbcSelectedRow = null, tbcSelectedDateKey = "";
  let tbcCurrentMonth = new Date().getMonth(), tbcCurrentYear = new Date().getFullYear();

  const tbcPad = n => String(n).padStart(2,"0");
  const tbcDateKey = (y,m,d) => `${y}-${tbcPad(m+1)}-${tbcPad(d)}`;
  const tbcDisplayDate = (y,m,d) => `${tbcPad(d)}.${tbcPad(m+1)}.${y}`;
  const tbcMoney = v => `${Number(v||0).toLocaleString('es'==='tr'?'tr-TR':'es'==='es'?'es-ES':'en-US',{maximumFractionDigits:2})} €`;
  const tbcRemaining = row => Math.max(Number(row?.capacity||0)-Number(row?.booked||0),0);
  function tbcIsPast(y,m,d){const x=new Date(y,m,d);x.setHours(0,0,0,0);const n=new Date();n.setHours(0,0,0,0);return x<n}
  function tbcEffectiveRow(key){
    if(tbcAvailability[key]) return tbcAvailability[key];
    if(!tbcProduct) return null;
    return {date:key,price:Number(tbcProduct.default_price||0),capacity:Number(tbcProduct.default_capacity||0),booked:0,status:"available",_default:true};
  }
  function tbcAvailable(row){return !!row && row.status==="available" && Number(row.capacity||0)>0 && tbcRemaining(row)>0}
  async function tbcGet(path){const r=await fetch(SUPABASE_URL+"/rest/v1/"+path,{headers:{apikey:SUPABASE_KEY,Authorization:"Bearer "+SUPABASE_KEY}});if(!r.ok)throw new Error(await r.text());return r.json()}

  async function tbcLoadProduct(){
    const rows=await tbcGet("products?slug=eq."+encodeURIComponent(TBC_PRODUCT_SLUG)+"&active=eq.true&select=id,default_price,default_capacity&limit=1");
    tbcProduct=rows[0]||null;if(!tbcProduct)throw new Error("Product not found: "+TBC_PRODUCT_SLUG);
    const today=new Date().toISOString().slice(0,10);
    const future=await tbcGet("availability?product_id=eq."+tbcProduct.id+"&date=gte."+today+"&status=eq.available&select=price,capacity,booked&order=price.asc&limit=250");
    const values=[Number(tbcProduct.default_price||0),...future.filter(r=>tbcRemaining(r)>0).map(r=>Number(r.price||0))].filter(v=>v>0);
    if(values.length && tbcMainPrice) tbcMainPrice.textContent=tbcMoney(Math.min(...values));
  }
  async function tbcLoadMonth(){
    if(!tbcProduct)return;
    tbcCalendarDays.innerHTML='<div class="tbc-calendar-message">'+tbcText['loading']+'</div>';
    const first=`${tbcCurrentYear}-${tbcPad(tbcCurrentMonth+1)}-01`, lastDay=new Date(tbcCurrentYear,tbcCurrentMonth+1,0).getDate(), last=`${tbcCurrentYear}-${tbcPad(tbcCurrentMonth+1)}-${tbcPad(lastDay)}`;
    const rows=await tbcGet("availability?product_id=eq."+tbcProduct.id+"&date=gte."+first+"&date=lte."+last+"&select=date,price,capacity,booked,status&order=date.asc");
    tbcAvailability={};rows.forEach(r=>tbcAvailability[r.date]=r);tbcRenderCalendar();
  }
  function tbcRenderCalendar(){
    if(!tbcCalendarDays||!tbcCalendarTitle)return;tbcCalendarDays.innerHTML="";tbcCalendarTitle.textContent=tbcMonthNames[tbcCurrentMonth]+" "+tbcCurrentYear;
    let offset=new Date(tbcCurrentYear,tbcCurrentMonth,1).getDay();offset=offset===0?6:offset-1;
    for(let i=0;i<offset;i++){const b=document.createElement("button");b.type="button";b.className="tbc-cal-day is-empty";b.disabled=true;tbcCalendarDays.appendChild(b)}
    const last=new Date(tbcCurrentYear,tbcCurrentMonth+1,0).getDate();
    for(let d=1;d<=last;d++){const key=tbcDateKey(tbcCurrentYear,tbcCurrentMonth,d),row=tbcEffectiveRow(key),ok=!tbcIsPast(tbcCurrentYear,tbcCurrentMonth,d)&&tbcAvailable(row),b=document.createElement("button");b.type="button";b.className="tbc-cal-day"+(ok?"":" is-disabled")+(key===tbcSelectedDateKey?" is-selected":"");b.disabled=!ok;const rem=tbcRemaining(row);let status=!row?tbcText['unavailable']:row.status==="closed"?tbcText['closed']:rem<=0?tbcText['sold']:ok?rem+" "+tbcText['left']:tbcText['unavailable'];b.innerHTML='<span class="tbc-cal-day-number">'+d+'</span>'+(row&&Number(row.price)>0?'<span class="tbc-cal-day-price">'+tbcMoney(row.price)+'</span>':'')+'<span class="tbc-cal-day-stock '+(ok?'':'is-closed')+'">'+status+'</span>';if(ok)b.addEventListener("click",()=>tbcChoose(row,d,key));tbcCalendarDays.appendChild(b)}
  }
  function tbcEnsurePriceUI(){
    if(tbcPersonSelect && !document.querySelector('.tbc-people-note')){const n=document.createElement('div');n.className='tbc-people-note';n.textContent=tbcText['children'];tbcPersonSelect.insertAdjacentElement('afterend',n)}
    if(tbcSelectedPriceBox && !tbcSelectedPriceBox.querySelector('.tbc-live-price-line')){tbcSelectedPriceBox.innerHTML='<div class="tbc-live-price-line"><span>'+tbcText['unit']+'</span><span id="tbc-live-unit">—</span></div><div class="tbc-live-price-line"><span>'+tbcText['total']+'</span><strong id="tbc-selected-price-text">—</strong></div>';}
  }
  function tbcChoose(row,d,key){tbcSelectedRow=row;tbcSelectedDateKey=key;tbcDateInput.value=tbcDisplayDate(tbcCurrentYear,tbcCurrentMonth,d);tbcPersonSelect.innerHTML='<option value="">'+tbcText['selectPeople']+'</option>';for(let i=1;i<=Math.min(tbcRemaining(row),20);i++){const o=document.createElement('option');o.value=String(i);o.textContent=i+' '+(i===1?tbcText['person']:tbcText['people']);tbcPersonSelect.appendChild(o)};document.getElementById('tbc-live-unit').textContent=tbcMoney(row.price);if(tbcSelectedPriceInput)tbcSelectedPriceInput.value=String(row.price);tbcSelectedPriceBox?.classList.add('is-visible');tbcUpdateTotal();tbcCalendar?.classList.remove('is-open');tbcRenderCalendar()}
  function tbcUpdateTotal(){if(!tbcSelectedRow)return;const n=Number(tbcPersonSelect?.value||0),el=document.getElementById('tbc-selected-price-text');if(el)el.textContent=n?tbcMoney(Number(tbcSelectedRow.price)*n):'—'}
  async function tbcOpenCalendar(){tbcCalendar?.classList.add('is-open');await tbcLoadMonth()}
  function tbcCloseCalendar(){tbcCalendar?.classList.remove('is-open')}
  tbcEnsurePriceUI();
  tbcDateInput?.addEventListener('click',tbcOpenCalendar);tbcCalendarOpen?.addEventListener('click',tbcOpenCalendar);tbcPersonSelect?.addEventListener('change',tbcUpdateTotal);
  tbcPrevMonthBtn?.addEventListener('click',async()=>{tbcCurrentMonth--;if(tbcCurrentMonth<0){tbcCurrentMonth=11;tbcCurrentYear--}await tbcLoadMonth()});
  tbcNextMonthBtn?.addEventListener('click',async()=>{tbcCurrentMonth++;if(tbcCurrentMonth>11){tbcCurrentMonth=0;tbcCurrentYear++}await tbcLoadMonth()});
  document.addEventListener('click',e=>{if(tbcCalendar&&!tbcCalendar.contains(e.target)&&e.target!==tbcDateInput&&e.target!==tbcCalendarOpen)tbcCloseCalendar()});
  tbcLoadProduct().then(tbcLoadMonth).catch(e=>{console.error(e);if(tbcCalendarDays)tbcCalendarDays.innerHTML='<div class="tbc-calendar-message">'+tbcText['unavailable']+'</div>'});

  const tbcPhoneInput = document.getElementById("tbc-phone");
  const tbcPhoneFullInput = document.getElementById("tbc-phone-full");
  let tbcPhoneIti = null;
  if(tbcPhoneInput && window.intlTelInput){tbcPhoneIti=window.intlTelInput(tbcPhoneInput,{initialCountry:"tr",separateDialCode:true,nationalMode:false,autoPlaceholder:"aggressive",preferredCountries:["tr","us","gb","de","fr","nl","ru","sa"],utilsScript:"https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/js/utils.js"})}
  const tbcBookingFormEl=document.querySelector('.tbc-booking-form');
  if(tbcBookingFormEl){tbcBookingFormEl.addEventListener('submit',function(event){event.preventDefault();if(tbcPhoneIti&&tbcPhoneFullInput)tbcPhoneFullInput.value=tbcPhoneIti.getNumber()||tbcPhoneInput.value;const name=document.getElementById('tbc-name')?.value?.trim()||'',phone=tbcPhoneFullInput?.value||tbcPhoneInput?.value||'',date=tbcDateInput?.value||'',people=tbcPersonSelect?.value||'',message=document.getElementById('tbc-message')?.value?.trim()||'';if(!name||!phone||!date||!people||!tbcSelectedRow){alert(tbcText['alert']);return}const unit=Number(tbcSelectedRow.price),total=unit*Number(people),tour=document.querySelector('.tbc-tour-title')?.textContent?.trim()||TBC_PRODUCT_SLUG;const lines=[tbcText['request'],'Tour: '+tour,tbcText['name']+': '+name,tbcText['phone']+': '+phone,tbcText['date']+': '+date,tbcText['guests']+': '+people,tbcText['unit']+': '+tbcMoney(unit),tbcText['total']+': '+tbcMoney(total),message?tbcText['message']+': '+message:''].filter(Boolean).join('\n');window.open('https://wa.me/905401015050?text='+encodeURIComponent(lines),'_blank','noopener,noreferrer')})}

  const loadMoreBtn = document.getElementById("tbc-load-more-btn");
  const hiddenReviews = document.getElementById("tbc-hidden-reviews");
  const scrollToReviewsBadge = document.getElementById("tbc-scrollToReviews");
  const reviewsSection = document.getElementById("reviews-section");

  if (loadMoreBtn && hiddenReviews) {
    loadMoreBtn.addEventListener("click", function () {
      hiddenReviews.style.display = "block";
      loadMoreBtn.style.display = "none";
    });
  }

  if (scrollToReviewsBadge && reviewsSection) {
    scrollToReviewsBadge.addEventListener("click", function () {
      reviewsSection.scrollIntoView({ behavior: "smooth" });
    });
  }
});
</script>
\n<script>
  // Homepage booking handoff: preselect date + people and let the page's own calendar set live price/state.
  window.addEventListener('load', () => {
    setTimeout(async () => {
      const q = new URLSearchParams(window.location.search);
      const qDate = q.get('date');
      const qPeople = Math.max(1, Math.min(20, Number(q.get('people') || 0)));
      if (!qDate || !/^\d{4}-\d{2}-\d{2}$/.test(qDate)) return;
      const dateInput = document.getElementById('tbc-date');
      const next = document.getElementById('tbc-next-month');
      const prev = document.getElementById('tbc-prev-month');
      if (!dateInput || !next || !prev) return;
      const [yy, mm, dd] = qDate.split('-').map(Number);
      const now = new Date();
      const delta = (yy - now.getFullYear()) * 12 + ((mm - 1) - now.getMonth());
      dateInput.click();
      const wait = (ms) => new Promise(r => setTimeout(r, ms));
      await wait(350);
      const btn = delta >= 0 ? next : prev;
      for (let i = 0; i < Math.abs(delta); i++) { btn.click(); await wait(220); }
      await wait(250);
      const dayButton = [...document.querySelectorAll('#tbc-calendar-days .tbc-cal-day')].find(b => {
        const n = b.querySelector('.tbc-cal-day-number');
        return !b.disabled && n && Number(n.textContent) === dd;
      });
      if (dayButton) {
        dayButton.click();
        await wait(80);
        const people = document.getElementById('tbc-person');
        if (people && qPeople) {
          const option = [...people.options].find(o => Number(o.value) === qPeople || parseInt(o.textContent,10) === qPeople);
          if (option) { people.value = option.value; people.dispatchEvent(new Event('change', {bubbles:true})); }
        }
      }
    }, 180);
  });
</script>

