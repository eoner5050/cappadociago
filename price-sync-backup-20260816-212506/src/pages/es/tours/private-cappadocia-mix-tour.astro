  body {
    background:
      radial-gradient(circle at 10% 0%, rgba(227,168,0,.08), transparent 28%),
      radial-gradient(circle at 90% 8%, rgba(23,52,93,.05), transparent 26%),
      var(--tbc-brand-bg) !important;
