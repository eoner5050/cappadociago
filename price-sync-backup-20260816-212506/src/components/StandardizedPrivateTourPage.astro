ent:space-between;font-size:10px}.price-box strong{font-size:16px;color:#b77f00}.submit{min-height:44px;border:0;border-radius:99px;background:#efb400;color:#071d3b;font-weight:900;cursor:pointer}.calendar{display:none;position:absolute;right:0;top:52px;width:340px;max-width:calc(100vw - 32px);background:#fff;border:1px solid #d6e0ec;border-radius:18px;padding:14px;z-index:200;box-shadow:0 20px 50px #0003}.calendar.open{display:block}.cal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.cal-head button{width:34px;height:34px;border:0;border-radius:10px;background:#fff7dd;color:#9b7000;font-size:22px}.week,.days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}.week span{text-align:center;font-size:9px;color:#64748b;font-weight:800}.day{min-width:0;height:55px;border:1px solid #dbe4ef;border-radius:8px;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;padding:2px;cursor:pointer}.day b{font-size:11px}.day span{font-size:8px;color:#b77f00;white-space:nowrap}.day small{font-size:7px;color:#139b4e;white-space:nowrap}.day.disabled{opacity:.38;background:#f2f4f7;cursor:not-allowed}.day.selected{border:2px solid #eeb400;background:#fff8dd}.day.empty{border-color:transparent;background:transparent}.msg{grid-column:1/-1;padding:15px;text-align:center;font-size:11px}footer{display:flex;justify-content:space-between;gap:20px;max-width:1240px;margin:auto;padding:30px 16px 45px;color:#51647a;font-size:11px}
@media(max-width:1000px){.header-container nav{display:none}.grid{grid-template-columns:1fr}.side{position:static}.gallery{grid-template-columns:1fr}.side-photos{grid-template-columns:repeat(4,1fr)}.side-photos img{min-height:90px}.checks{grid-template-columns:1fr}}
@media(max-width:600px){.header-container{height:76px}.logo>a:first-child img{width:auto!important;height:60px!important;max-width:125px!important;object-fit:contain!important}.insta{display:none}.hero{padding:22px 18px}.hero h1{font-size:26px}.gallery{padding:7px}.main-photo{height:260px}.side-photos{grid-template-columns:1fr 1fr}.side-photos img{min-height:110px}.content{padding:18px}.calendar{left:0;right:auto;width:min(340px,calc(100vw - 36px))}.wa-head{font-size:0}.grid{gap:14px}}

.main-photo.preserve-photo{background:#172235;isolation:isolate}.main-photo.preserve-photo::before{content:"";position:absolute;inset:-22px;background-image:var(--main-photo-bg);background-size:cover;background-position:center;filter:blur(20px) brightness(.55);transform:scale(1.08);z-index:0}.main-photo.preserve-photo img{position:relative;z-index:1;object-fit:contain!important;object-position:center!important}.main-photo.preserve-photo span{z-index:2}
.gallery-modal{position:fixed;inset:0;background:rgba(3,12,25,.92);z-index:5000;display:none;align-items:center;justify-content:center;padding:70px 80px}.gallery-modal.open{display:flex}.gallery-modal>img{max-width:min(1180px,88vw);max-height:82vh;object-fit:contain;border-radius:16px;box-shadow:0 20px 70px #0008}.gallery-close,.gallery-prev,.gallery-next{position:absolute;border:0;background:#fff;color:#071d3b;display:grid;place-items:center;cursor:pointer;box-shadow:0 8px 24px #0004}.gallery-close{right:26px;top:22px;width:44px;height:44px;border-radius:50%;font-size:28px}.gallery-prev,.gallery-next{top:50%;transform:translateY(-50%);width:48px;height:48px;border-radius:50%;font-size:30px}.gallery-prev{left:24px}.gallery-next{right:24px}.gallery-count{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);color:#fff;font-weight:800;font-size:13px;background:#0008;padding:7px 12px;border-radius:99px}@media(max-width:600px){.gallery-modal{padding:65px 14px}.gallery-prev{left:8px}.gallery-next{right:8px}}
</style>

<script define:vars={{ imgs }}>
  const galleryItems = imgs || [];
  const galleryModal = document.getElementById('galleryModal');
  const galleryModalImg = document.getElementById('galleryModalImg');
  const galleryCount = document.getElementById('galleryCount');
  let galleryIndex = 0;
  function showGallery(i){ if(!galleryItems.length||!galleryModal||!galleryModalImg)return; galleryIndex=(i+galleryItems.length)%galleryItems.length; galleryModalImg.src=galleryItems[galleryIndex]; if(galleryCount)galleryCount.textContent=`${galleryIndex+1} / ${galleryItems.length}`; galleryModal.classList.add('open'); document.body.style.overflow='hidden'; }
  function closeGallery(){ if(!galleryModal)return; galleryModal.classList.remove('open'); document.body.style.overflow=''; }
  document.querySelectorAll('.gallery-click').forEach(btn=>btn.addEventListener('click',()=>showGallery(Number(btn.dataset.galleryIndex||0))));
  galleryModal?.querySelector('.gallery-close')?.addEventListener('click',closeGallery);
  galleryModal?.querySelector('.gallery-prev')?.addEventListener('click',()=>showGallery(galleryIndex-1));
  galleryModal?.querySelector('.gallery-next')?.addEventListener('click',()=>showGallery(galleryIndex+1));
  galleryModal?.addEventListener('click',e=>{if(e.target===galleryModal)closeGallery()});
  document.addEventListener('keydown',e=>{if(!galleryModal?.classList.contains('open'))return;if(e.key==='Escape')closeGallery();if(e.key==='ArrowLeft')showGallery(galleryIndex-1);if(e.key==='ArrowRight')showGallery(galleryIndex+1)});
</script>

<style is:global>
.unified-footer{background:#fff;border-top:1px solid #e5e7eb;margin-top:42px;padding:38px 0 42px}.uf-inner{width:min(1240px,calc(100% - 32px));margin:auto;display:flex;align-items:center;justify-content:space-between;gap:48px}.uf-logo img{width:145px;height:auto;display:block}.uf-right{display:grid;gap:18px}.uf-contacts{display:flex;flex-wrap:wrap;gap:26px}.uf-contacts>div{display:flex;align-items:center;gap:9px}.uf-contacts img{width:30px;height:30px;object-fit:contain}.uf-contacts span{display:grid}.uf-contacts small{font-size:9px;color:#64748b}.uf-contacts a{color:#071d3b;text-decoration:none;font-size:12px;font-weight:800}.uf-gallery{display:flex;gap:10px}.uf-gallery img{width:88px;height:62px;object-fit:cover;border-radius:9px;border:1px solid #d9e1eb}.uf-social{display:flex;gap:10px;flex-wrap:wrap}.uf-social a{display:flex;align-items:center;gap:7px;border:1px solid #d9e1eb;border-radius:99px;padding:7px 11px;color:#071d3b;text-decoration:none;font-size:10px;font-weight:800}.uf-social img{width:18px;height:18px;object-fit:contain}@media(max-width:800px){.uf-inner{align-items:flex-start;flex-direction:column}.uf-contacts{flex-direction:column}.uf-gallery{flex-wrap:wrap}}
