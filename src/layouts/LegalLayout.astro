---
import Layout from './Layout.astro';

export interface Props {
  title: string;
  updated: string;
}
const { title, updated } = Astro.props;
---
<Layout title={`${title} | CappadociaGo`}>

<nav>
  <div class="wrap">
    <a href="/" class="logo-mark"><img src="/images/logo.png" alt="CappadociaGo" /></a>
    <ul class="nav-menu">
      <li><a href="/#tours">Balloon Tours</a></li>
      <li><a href="/#tours">Daily Tours</a></li>
      <li><a href="/#tours">Activities</a></li>
      <li><a href="/#tours">Private Tours</a></li>
      <li><a href="/#tours">Transfers</a></li>
    </ul>
    <div class="nav-right">
      <a href="/" class="back-home">← Back to Home</a>
    </div>
  </div>
</nav>

<main class="legal-page">
  <div class="wrap legal-wrap">
    <div class="legal-header">
      <span class="legal-tag">Legal</span>
      <h1>{title}</h1>
      <p class="legal-updated">Last updated: {updated}</p>
    </div>
    <div class="legal-body">
      <slot />
    </div>

    <div class="legal-cta">
      <p>Questions about this policy?</p>
      <a class="btn-wa" href="https://wa.me/905401015050" target="_blank" rel="noopener">💬 Chat on WhatsApp</a>
    </div>
  </div>
</main>

<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <img src="/images/logo.png" alt="CappadociaGo" style="height:46px;width:auto;margin-bottom:14px;filter:brightness(0) invert(1);" />
        <p style="font-size:13.5px;line-height:1.6;max-width:280px;color:#A9B4CC;">Goreme-based local travel agency offering Cappadocia's balloon, daily, package, adventure and transfer tours all under one roof.</p>
      </div>
      <div><h5>Tours</h5><ul><li><a href="/#tours">Balloon Tours</a></li><li><a href="/#tours">Daily Tours</a></li><li><a href="/#tours">Package Tours</a></li><li><a href="/#tours">Activities</a></li></ul></div>
      <div><h5>Company</h5><ul><li><a href="/#tours">About Us</a></li><li><a href="/#tours">Blog</a></li><li><a href="/#tours">Contact</a></li><li><a href="/#tours">FAQ</a></li></ul></div>
      <div><h5>Customer Support</h5><ul><li><a href="/legal/cancellation-refund">Cancellation &amp; Refund Policy</a></li><li><a href="/legal/privacy">Privacy Policy</a></li><li><a href="/legal/terms">Terms &amp; Conditions</a></li><li><a href="/legal/distance-sales">Distance Sales Agreement</a></li><li><a href="/legal/kvkk">KVKK / Personal Data</a></li><li><a href="/legal/cookie-policy">Cookie Policy</a></li></ul></div>
      <div><h5>Contact</h5><ul><li>📍 Cappadocia, Nevşehir, Türkiye</li><li>📞 +90 540 101 50 50</li><li>✉ info@kapheratravel.com</li></ul></div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 CappadociaGo — Cappadocia Kaphera Travel Agency</span>
      <span>TÜRSAB No: 18577</span>
    </div>
  </div>
</footer>

</Layout>

<style>
  nav{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:50;}
  nav .wrap{display:flex;align-items:center;justify-content:space-between;height:78px;gap:20px;}
  .logo-mark{display:flex;align-items:center;white-space:nowrap;}
  .logo-mark img{height:40px;width:auto;display:block;}
  .nav-menu{display:flex;gap:28px;font-size:14px;font-weight:500;color:#2A3532;list-style:none;}
  .nav-menu a:hover{color:var(--gold-bright);}
  .back-home{font-size:13.5px;font-weight:600;color:var(--blue-deep);}
  .back-home:hover{color:var(--gold-bright);}
  @media(max-width:900px){.nav-menu{display:none;}}

  .legal-page{background:var(--cream);padding:70px 0 100px;}
  .legal-wrap{max-width:820px;}
  .legal-header{border-bottom:1px solid var(--line);padding-bottom:32px;margin-bottom:40px;}
  .legal-tag{font-family:'Space Grotesk',monospace;font-size:12px;letter-spacing:.22em;color:var(--gold-bright);text-transform:uppercase;display:block;margin-bottom:14px;}
  .legal-header h1{font-family:'Fraunces',serif;font-weight:600;font-size:clamp(28px,4vw,40px);color:var(--blue-deeper);letter-spacing:-0.01em;}
  .legal-updated{font-size:13px;color:var(--stone);margin-top:10px;}

  .legal-body{font-size:15.5px;line-height:1.75;color:#3A4340;}
  .legal-body h2{font-family:'Fraunces',serif;font-weight:600;font-size:22px;color:var(--blue-deeper);margin:36px 0 14px;}
  .legal-body h2:first-child{margin-top:0;}
  .legal-body h3{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:16px;color:var(--blue-deep);margin:22px 0 8px;}
  .legal-body p{margin-bottom:14px;}
  .legal-body ul, .legal-body ol{margin:0 0 14px 22px;}
  .legal-body li{margin-bottom:8px;}
  .legal-body a{color:var(--blue-deep);text-decoration:underline;text-decoration-color:var(--gold-bright);text-underline-offset:3px;}
  .legal-body strong{color:var(--blue-deeper);font-weight:700;}
  .legal-body .highlight-box{
    background:var(--cream-2);border:1px solid var(--line);border-left:4px solid var(--gold-bright);
    border-radius:10px;padding:18px 20px;margin:20px 0;font-size:14.5px;
  }

  .legal-cta{
    margin-top:56px;padding-top:32px;border-top:1px solid var(--line);
    display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;
  }
  .legal-cta p{font-family:'Fraunces',serif;font-weight:600;font-size:17px;color:var(--blue-deeper);}
  .btn-wa{display:inline-flex;align-items:center;gap:10px;background:#25D366;color:#fff;padding:13px 24px;border-radius:100px;font-weight:600;font-size:14px;}

  footer{background:var(--blue-deeper);color:#C9D3E8;padding:70px 28px 26px;}
  .footer-grid{display:grid;grid-template-columns:1.3fr 0.85fr 0.85fr 1.1fr 1fr;gap:32px;padding-bottom:44px;border-bottom:1px solid rgba(244,239,227,.12);}
  @media(max-width:1000px){.footer-grid{grid-template-columns:1fr 1fr 1fr;}}
  @media(max-width:600px){.footer-grid{grid-template-columns:1fr 1fr;}}
  footer h5{font-family:'Space Grotesk',monospace;font-size:11.5px;letter-spacing:.15em;color:var(--gold-bright);text-transform:uppercase;margin-bottom:14px;}
  footer ul{display:flex;flex-direction:column;gap:9px;font-size:13.5px;list-style:none;}
  footer ul li a{color:#C9D3E8;}
  footer ul li a:hover{color:#F0D48A;}
  .foot-bottom{display:flex;justify-content:space-between;padding-top:22px;font-size:12px;color:#7C88A3;flex-wrap:wrap;gap:8px;}
</style>
