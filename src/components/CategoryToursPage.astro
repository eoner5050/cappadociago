---
import SeoHead from './SeoHead.astro';
import TourFooter from './TourFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { en } from '../i18n/en';
import { tr } from '../i18n/tr';
import { es } from '../i18n/es';
import { getTourGallery } from '../utils/tourGallery';
const { lang='en', category='cappadocia' } = Astro.props;
const categorySupabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const categorySupabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const dictionaries = { en, tr, es };
const t = dictionaries[lang] || en;
const copy={
 en:{duration:'Duration',starting:'Starting Price',head:{balloon:['Cappadocia Balloon Tours','Sunrise balloon experiences in Göreme, Ihlara, Pamukkale and Soğanlı, plus balloon watching experiences.'],cappadocia:['Cappadocia Tours','Explore the same Cappadocia day tours and flexible experiences featured on our homepage.'],private:['Private Tours','Private Cappadocia experiences with flexible service and dedicated arrangements.'],transfers:['Cappadocia Airport Transfers','Airport shuttle and private VIP transfer services featured on our homepage.'],activities:['Cappadocia Activities','Adventure, culture and special Cappadocia experiences featured on our homepage.']}},
 tr:{duration:'Süre',starting:'Başlangıç Fiyatı',head:{balloon:['Kapadokya Balon Turları','Göreme, Ihlara, Pamukkale ve Soğanlı balon deneyimleri ile balon izleme turlarını keşfedin.'],cappadocia:['Kapadokya Turları','Ana sayfamızda yer alan Kapadokya günlük turları ve esnek deneyimlerin tamamını keşfedin.'],private:['Özel Turlar','Size özel düzenlenen esnek Kapadokya tur deneyimleri.'],transfers:['Kapadokya Havalimanı Transferleri','Ana sayfamızdaki havalimanı shuttle ve VIP transfer seçenekleri.'],activities:['Kapadokya Aktiviteleri','Ana sayfamızda yer alan macera, kültür ve özel Kapadokya deneyimleri.']}},
 es:{duration:'Duración',starting:'Precio Desde',head:{balloon:['Tours en Globo por Capadocia','Experiencias en globo en Göreme, Ihlara, Pamukkale y Soğanlı, además de tours de observación.'],cappadocia:['Tours por Capadocia','Descubre los tours diarios y experiencias flexibles que aparecen en nuestra página principal.'],private:['Tours Privados','Experiencias privadas en Capadocia con servicio flexible.'],transfers:['Traslados en Capadocia','Servicios shuttle y traslados VIP que aparecen en nuestra página principal.'],activities:['Actividades en Capadocia','Aventura, cultura y experiencias especiales de nuestra página principal.']}}
};
const c=copy[lang]||copy.en; const [heading,intro]=c.head[category];
const titleSlugMap = {
  'Göreme Standart Hot Air Balloon Tour':'goreme-standart-hot-air-balloon-tour','Göreme Standart Sıcak Hava Balonu Turu':'goreme-standart-hot-air-balloon-tour','Tour Estándar en Globo Aerostático por Göreme':'goreme-standart-hot-air-balloon-tour',
  'Göreme Comfort Hot Air Balloon Tour':'goreme-comfort-hot-air-balloon-tour','Göreme Comfort Sıcak Hava Balonu Turu':'goreme-comfort-hot-air-balloon-tour','Tour Comfort en Globo Aerostático por Göreme':'goreme-comfort-hot-air-balloon-tour',
  'Ihlara Valley Balloons Tour':'ihlara-valley-balloons-tour','Ihlara Vadisi Balon Turu':'ihlara-valley-balloons-tour','Tour en Globo por el Valle de Ihlara':'ihlara-valley-balloons-tour',
  'Pamukkale Balloons Tour':'pamukkale-balloons-tour','Pamukkale Balon Turu':'pamukkale-balloons-tour','Tour en Globo por Pamukkale':'pamukkale-balloons-tour',
  'Soğanlı Valley Balloon Tour':'soganli-valley-balloon-tour','Soğanlı Vadisi Balon Turu':'soganli-valley-balloon-tour','Tour en Globo por el Valle de Soğanlı':'soganli-valley-balloon-tour',
  'Balloons Watching Tour Cappadocia':'balloons-watching-tour-cappadocia','Kapadokya Balon İzleme Turu':'balloons-watching-tour-cappadocia','Tour de Observación de Globos en Capadocia':'balloons-watching-tour-cappadocia',
  'Blue Tour Cappadocia (Discover Hidden Valleys)':'blue-tour-cappadocia','Blue Tour Kapadokya (Gizli Vadileri Keşfedin)':'blue-tour-cappadocia','Blue Tour Capadocia (Descubre Valles Ocultos)':'blue-tour-cappadocia',
  'Red Tour Cappadocia':'red-tour-cappadocia','Kapadokya Kırmızı Tur':'red-tour-cappadocia','Tour Rojo de Capadocia':'red-tour-cappadocia',
  'Green Tour Cappadocia':'green-tour-cappadocia','Kapadokya Yeşil Tur':'green-tour-cappadocia','Tour Verde de Capadocia':'green-tour-cappadocia',
  'Cappadocia Mix Tour':'cappadocia-mix-tour','Özel Mix Kapadokya Turu':'cappadocia-mix-tour',
  'Cappadocia Custom Package Tour':'cappadocia-custom-package-tour','Kapadokya Özel Paket Tur':'cappadocia-custom-package-tour','Paquete Personalizado de Capadocia':'cappadocia-custom-package-tour',
  'Private Red Tour Cappadocia':'private-red-tour-cappadocia','Özel Kapadokya Kırmızı Tur':'private-red-tour-cappadocia','Tour Rojo Privado de Capadocia':'private-red-tour-cappadocia',
  'Private Green Tour Cappadocia':'private-green-tour-cappadocia','Özel Kapadokya Yeşil Tur':'private-green-tour-cappadocia','Tour Verde Privado de Capadocia':'private-green-tour-cappadocia',
};
const slugOf = (card) => {
  const href=(card.href||'').split('?')[0].replace(/\/$/,'');
  const fromHref = href ? href.split('/').pop() : '';
  return titleSlugMap[card.title] || fromHref;
};
const preferredImages = {
  'goreme-standart-hot-air-balloon-tour':'/images/tours/goreme-standart-hot-air-balloon-tour (2).webp',
  'goreme-comfort-hot-air-balloon-tour':'/images/tours/goreme-comfort-hot-air-balloon-tour (2).webp',
  'ihlara-valley-balloons-tour':'/images/tours/ihlara-valley-balloons-tour (1).webp',
  'pamukkale-balloons-tour':'/images/tours/pamukkale-balloons-tour (1).webp',
  'soganli-valley-balloon-tour':'/images/tours/soganli-valley-balloon-tour (1).webp',
  'balloons-watching-tour-cappadocia':'/images/tours/balloons-watching-tour-cappadocia (2).webp',
  'blue-tour-cappadocia':'/images/tours/Blue-Tour-Cappadocia (1).webp',
  'red-tour-cappadocia':'/images/tours/red-tour-cappadocia (2).webp',
  'green-tour-cappadocia':'/images/tours/green-tour-cappadocia (2).webp',
  'cappadocia-mix-tour':'/images/tours/cappadocia-tour.webp',
  'cappadocia-custom-package-tour':'/images/tours/cappadocia-package-tours.webp',
  'private-red-tour-cappadocia':'/images/tours/red-tour-cappadocia (4).webp',
  'private-green-tour-cappadocia':'/images/tours/green-tour-cappadocia (4).webp',
  'kayseri-airport-shuttle-transfer':'/images/tours/Kayseri-Airport-ASR-Shuttle-Transfer.webp',
  'nevsehir-airport-shuttle-transfer':'/images/tours/Nevsehir-Airport-NAV-Shuttle-Transfer.webp',
  'private-airport-transfer':'/images/tours/Private-VIP-Airport-Transfer-Cappadocia.webp',
  'atv-tour-with-goreme-valleys':'/images/tours/ATV-Tour-With-Goreme-Valleys (2).webp',
  'cappadocia-pottery-making-experience':'/images/tours/cappadocia-pottery-making-experience (2).webp',
  'cappadocia-classic-car-tour':'/images/tours/cappadocia-classic-car-tour (2).webp',
  'photo-shoot-flying-dress-experience':'/images/tours/Photo Shoot & Flying Dress Experience.webp',
  'jeep-safari-cappadocia':'/images/tours/jeep-safari-cappadocia (2).webp',
  'turkish-night-with-cave-dinner-cappadocia':'/images/tours/turkish-night-with-cave-dinner-cappadocia (1).webp',
  'sunrise-sunset-horse-riding-cappadocia':'/images/tours/sunrise-sunset-horse-riding-cappadocia.webp',
  'cappadocia-sunset-camel-riding-tour':'/images/tours/cappadocia-sunset-camel-riding-tour (1).webp',
};
const cardImage = (tour) => {
  const slug = slugOf(tour);
  return getTourGallery({ slug, title:String(tour?.title||''), preferred:[tour?.image].filter(Boolean), max:1 })[0] || tour.image;
};
const hrefFor = (tour) => {
  const slug = slugOf(tour);
  if (groups.transfers.has(slug)) return `/${lang}/transfers/${slug}`;
  return `/${lang}/tours/${slug}`;
};
const groups = {
  balloon: new Set(['goreme-comfort-hot-air-balloon-tour','goreme-standart-hot-air-balloon-tour','ihlara-valley-balloons-tour','pamukkale-balloons-tour','soganli-valley-balloon-tour','balloons-watching-tour-cappadocia']),
  cappadocia: new Set(['blue-tour-cappadocia','red-tour-cappadocia','green-tour-cappadocia','cappadocia-mix-tour','cappadocia-custom-package-tour']),
  private: new Set(['private-green-tour-cappadocia','private-red-tour-cappadocia']),
  transfers: new Set(['kayseri-airport-shuttle-transfer','nevsehir-airport-shuttle-transfer','private-airport-transfer']),
};
const used = new Set([...groups.balloon,...groups.cappadocia,...groups.private,...groups.transfers]);
const cards = t.tourCards.filter((card) => {
  const slug=slugOf(card);
  if(category==='activities') return !used.has(slug);
  return groups[category]?.has(slug);
});

const heroImages = {
  balloon: '/images/hero-reference-cappadociago.jpg',
  cappadocia: '/images/tours/red-tour-cappadocia (2).webp',
  activities: '/images/tours/ATV-Tour-With-Goreme-Valleys (2).webp',
  private: '/images/tours/green-tour-cappadocia (4).webp',
  transfers: '/images/tours/Private-VIP-Airport-Transfer-Cappadocia.webp'
};
const heroImage = heroImages[category] || heroImages.balloon;
const heroTrust = lang==='tr'
  ? ['Yerel Kapadokya Ekibi','7/24 WhatsApp Desteği','Güvenli Rezervasyon']
  : lang==='es'
    ? ['Equipo Local en Capadocia','Soporte WhatsApp 24/7','Reserva Segura']
    : ['Local Cappadocia Team','24/7 WhatsApp Support','Secure Reservation'];
---
<!doctype html>
<html lang={lang}>
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><SeoHead title={`${heading} | CappadociaGo`} description={intro} lang={lang} /><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Montserrat:wght@700;800;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"></head>
<body>
<SiteHeader lang={lang} active={category}/>
<section class="cat-hero" style={`--cat-hero-image:url(${JSON.stringify(heroImage)})`}>
  <div class="cat-hero-shade"></div>
  <div class="cat-container cat-hero-content">
    <span class="cat-kicker">CAPPADOCIAGO</span>
    <h1>{heading}</h1>
    <p>{intro}</p>
    <div class="cat-hero-trust" aria-label="CappadociaGo benefits">
      {heroTrust.map((item) => <span><b>✓</b>{item}</span>)}
    </div>
    <a class="cat-explore" href="#categoryToursGrid">{lang==='tr'?'TURLARI KEŞFET':lang==='es'?'EXPLORAR TOURS':'EXPLORE TOURS'} <b>→</b></a>
  </div>
  <div class="cat-finder-wrap">
    <nav class="cat-quick-tabs" aria-label="Tour categories">
      <a href={`/${lang}/balloon-tours/`} class:list={[{active:category==='balloon'}]}>◉ <span>{lang==='tr'?'Balon':lang==='es'?'Globos':'Balloons'}</span></a>
      <a href={`/${lang}/cappadocia-tours/`} class:list={[{active:category==='cappadocia'}]}>◇ <span>{lang==='tr'?'Günlük Turlar':lang==='es'?'Tours':'Daily Tours'}</span></a>
      <a href={`/${lang}/activities/`} class:list={[{active:category==='activities'}]}>✦ <span>{lang==='tr'?'Aktiviteler':lang==='es'?'Actividades':'Activities'}</span></a>
      <a href={`/${lang}/private-tours/`} class:list={[{active:category==='private'}]}>★ <span>{lang==='tr'?'Özel':lang==='es'?'Privados':'Private'}</span></a>
      <a href={`/${lang}/transfers/`} class:list={[{active:category==='transfers'}]}>↗ <span>{lang==='tr'?'Transfer':lang==='es'?'Traslados':'Transfers'}</span></a>
    </nav>
    <div class="cat-search-band">
      <div class="cat-search-field"><small>{lang==='tr'?'DESTİNASYON':lang==='es'?'DESTINO':'DESTINATION'}</small><strong>Cappadocia</strong></div>
      <div class="cat-search-field"><small>{lang==='tr'?'DENEYİM':lang==='es'?'EXPERIENCIA':'EXPERIENCE'}</small><strong>{heading}</strong></div>
      <div class="cat-search-field"><small>{lang==='tr'?'DESTEK':lang==='es'?'SOPORTE':'SUPPORT'}</small><strong>24/7 WhatsApp</strong></div>
      <a class="cat-search-button" href="#categoryToursGrid">{lang==='tr'?'TURLARI GÖR':lang==='es'?'VER TOURS':'VIEW TOURS'} <b>→</b></a>
    </div>
  </div>
</section>
<main class="cat-section"><div class="cat-container"><div class="cat-list-head"><div><small>CAPPADOCIAGO COLLECTION</small><h2>{heading}</h2></div><p>{cards.length} {lang==='tr'?'deneyim':lang==='es'?'experiencias':'experiences'}</p></div><div class="cat-grid" id="categoryToursGrid" data-category={category} data-lang={lang} data-supabase-url={categorySupabaseUrl} data-supabase-key={categorySupabaseKey}>
{cards.map((tour) => (
  <article class="cat-card" data-product-href={tour.href} data-product-slug={slugOf(tour)} data-product-name={tour.title}>
    <a class="cat-cover" href={hrefFor(tour)} aria-label={tour.title}></a>
    <div class="cat-img"><img src={cardImage(tour)} alt={tour.title} loading="lazy" width="800" height="533"/><b>⭐ {tour.rating}</b></div>
    <div class="cat-body"><small>{c.duration}: {tour.duration}</small><h2>{tour.title}</h2><em>✓ {tour.tag}</em>{tour.status && <span class={`cat-status ${tour.statusType||''}`}>{tour.statusIcon} {tour.status}</span>}
      <div class="cat-price"><span>{c.starting}</span><div><del data-cat-old-price>{tour.oldPrice || ""}</del><strong data-cat-current-price>{tour.currentPrice}</strong></div></div>
    </div>
  </article>
))}
</div></div></main>
<style>
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f7f5f0;color:#071a35;font-family:Inter,Arial,sans-serif}.cat-container{width:min(1180px,calc(100% - 32px));margin:auto}
.cat-hero{min-height:620px;position:relative;background-image:linear-gradient(90deg,rgba(6,35,70,.88) 0%,rgba(7,48,88,.76) 45%,rgba(8,37,67,.64) 100%),var(--cat-hero-image);background-position:center;background-size:cover;background-repeat:no-repeat;display:flex;align-items:center;padding:82px 0 154px;color:#fff;overflow:visible}.cat-hero-shade{position:absolute;inset:0;background:radial-gradient(circle at 50% 18%,rgba(36,139,210,.18),transparent 34%),linear-gradient(180deg,rgba(5,28,56,.04),rgba(5,29,57,.24));pointer-events:none}.cat-hero-content{position:relative;z-index:2;text-align:center;display:flex;flex-direction:column;align-items:center}.cat-kicker{display:inline-flex;align-items:center;justify-content:center;border:1px solid rgba(221,174,57,.78);background:rgba(7,51,91,.44);backdrop-filter:blur(8px);padding:8px 17px;border-radius:999px;font-size:10px;font-weight:800;letter-spacing:.1em;color:#fff}.cat-hero h1{font-family:'Fraunces',Georgia,serif;font-size:clamp(45px,5.5vw,76px);line-height:1.01;font-weight:600;margin:19px auto 18px;letter-spacing:-.045em;max-width:1000px;text-shadow:0 2px 18px rgba(0,0,0,.18);text-transform:none}.cat-hero p{max-width:800px;margin:0 auto;color:rgba(255,255,255,.88);line-height:1.72;font-size:15px;font-weight:500}.cat-hero-trust{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:10px 22px;margin-top:22px}.cat-hero-trust span{display:inline-flex;align-items:center;gap:7px;color:#fff;font-size:11px;font-weight:700}.cat-hero-trust b{display:inline-grid;place-items:center;width:20px;height:20px;border-radius:50%;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.25);color:#f1c24e;font-size:10px}.cat-explore{display:inline-flex;align-items:center;gap:10px;margin-top:25px;background:linear-gradient(135deg,#d59a18,#efbd3e);color:#08294f;text-decoration:none;padding:13px 22px;border-radius:999px;font-size:10px;font-weight:900;letter-spacing:.08em;box-shadow:0 10px 28px rgba(0,0,0,.16)}.cat-explore b,.cat-search-button b{font-size:14px;line-height:1}
.cat-finder-wrap{position:absolute;z-index:5;left:50%;bottom:-72px;transform:translateX(-50%);width:min(1100px,calc(100% - 34px))}.cat-quick-tabs{display:grid;grid-template-columns:repeat(5,1fr);width:min(820px,calc(100% - 30px));margin:auto;background:#fff;border:1px solid #dbe7f0;border-bottom:0;border-radius:18px 18px 0 0;overflow:hidden;box-shadow:0 -7px 28px rgba(7,26,53,.12)}.cat-quick-tabs a{min-height:66px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:5px;text-decoration:none;color:#61758b;border-right:1px solid #edf2f6;font-size:15px}.cat-quick-tabs a span{font-size:9px;letter-spacing:.035em;font-weight:800}.cat-quick-tabs a.active{background:linear-gradient(135deg,#0b67b2,#0d3158);color:#fff}.cat-search-band{display:grid;grid-template-columns:1fr 1.25fr .9fr auto;gap:8px;align-items:center;padding:15px 18px;background:#fff;border:1px solid #dbe7f0;border-top:4px solid #d59a18;border-radius:18px;box-shadow:0 20px 50px rgba(8,44,80,.17)}.cat-search-field{background:#f7fbfe;border:1px solid #dde8f0;min-height:54px;padding:9px 13px;border-radius:12px;display:flex;flex-direction:column;justify-content:center;min-width:0}.cat-search-field small{font-size:7px;color:#7890a5;font-weight:800;letter-spacing:.08em}.cat-search-field strong{font-size:11px;color:#0a2342;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cat-search-button{display:flex;align-items:center;justify-content:center;gap:8px;min-height:54px;padding:0 21px;border-radius:999px;background:linear-gradient(135deg,#0b67b2,#238bd2);color:#fff;text-decoration:none;font-size:9px;font-weight:900;letter-spacing:.06em;white-space:nowrap;box-shadow:0 8px 18px rgba(11,103,178,.18)}
.cat-section{padding:128px 0 76px}.cat-list-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}.cat-list-head small{font-size:9px;font-weight:900;letter-spacing:.13em;color:#d18a25}.cat-list-head h2{font:900 28px Montserrat;margin:5px 0 0}.cat-list-head p{margin:0;color:#7c8797;font-size:11px}.cat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.cat-card{position:relative;background:#fff;border:1px solid #e4e0d8;border-radius:18px;overflow:hidden;box-shadow:0 9px 25px rgba(31,41,55,.06);transition:.22s ease}.cat-card:hover{transform:translateY(-3px);box-shadow:0 16px 34px rgba(31,41,55,.11)}.cat-cover{position:absolute;inset:0;z-index:5}.cat-img{height:205px;position:relative;background:#edf1f5}.cat-img img{width:100%;height:100%;object-fit:cover;display:block}.cat-img b{position:absolute;right:10px;top:10px;background:#fff;padding:5px 9px;border-radius:999px;font-size:10px;box-shadow:0 4px 12px #0002}.cat-body{padding:16px 17px 18px}.cat-body small{color:#758397;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.04em}.cat-body h2{font:800 14px/1.4 Montserrat;margin:6px 0 8px;min-height:39px}.cat-body em{font-size:9px;color:#167337;font-style:normal;font-weight:800}.cat-status{font-size:8px;font-weight:800;color:#1e4ca1;margin-left:7px}.cat-status.red{color:#c33}.cat-price{display:flex;justify-content:space-between;align-items:end;margin-top:22px;padding-top:14px;border-top:1px solid #eef0f2}.cat-price>span{font-size:9px;color:#8993a1}.cat-price del{font-size:10px;color:#8d95a1;margin-right:5px}.cat-price strong{font:900 21px Montserrat;color:#071a35}
@media(max-width:940px){.cat-grid{grid-template-columns:repeat(2,1fr)}.cat-search-band{grid-template-columns:1fr 1fr}.cat-search-button{grid-column:1/-1}.cat-hero{min-height:660px}.cat-finder-wrap{bottom:-108px}.cat-section{padding-top:170px}}
@media(max-width:620px){.cat-hero{min-height:715px;padding:54px 0 180px;background-position:center}.cat-hero h1{font-size:39px;line-height:1.05;margin-top:16px}.cat-hero p{font-size:12.5px;line-height:1.68}.cat-hero-trust{gap:8px 12px;margin-top:18px}.cat-hero-trust span{font-size:9px}.cat-explore{margin-top:20px}.cat-finder-wrap{bottom:-175px;width:calc(100% - 18px)}.cat-quick-tabs{grid-template-columns:repeat(5,1fr);width:calc(100% - 14px)}.cat-quick-tabs a{min-height:55px}.cat-quick-tabs a span{font-size:7px}.cat-search-band{grid-template-columns:1fr;padding:11px}.cat-search-field{min-height:46px}.cat-search-button{min-height:46px}.cat-section{padding-top:238px}.cat-list-head{align-items:start;flex-direction:column}.cat-grid{grid-template-columns:1fr}}
</style>

<script>
(() => {
  const grid=document.getElementById('categoryToursGrid');
  if(!grid) return;
  const base=grid.dataset.supabaseUrl||'', key=grid.dataset.supabaseKey||'';
  if(!base||!key) return;
  const cards=[...grid.querySelectorAll('.cat-card[data-product-slug]')];
  const headers={apikey:key,Authorization:`Bearer ${key}`};
  const norm=(v='')=>String(v).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,' ').trim();
  const today=new Date(), todayKey=`${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;
  Promise.all([
    fetch(`${base}/rest/v1/products?active=eq.true&select=id,slug,name,default_price,ask_for_price`,{headers,cache:'no-store'}).then(r=>r.ok?r.json():Promise.reject(r.status)),
    fetch(`${base}/rest/v1/availability?date=gte.${todayKey}&status=eq.available&select=product_id,price,capacity,booked&limit=5000`,{headers,cache:'no-store'}).then(r=>r.ok?r.json():[])
  ]).then(([products,availability])=>{
    const bySlug=new Map(products.map(p=>[String(p.slug||'').trim().toLowerCase(),p]));
    const byName=new Map(products.map(p=>[norm(p.name),p]));
    const minById=new Map();
    for(const r of availability){const price=Number(r.price||0),remaining=Number(r.capacity||0)-Number(r.booked||0);if(price<=0||remaining<=0)continue;const id=String(r.product_id||''),prev=minById.get(id);if(!(prev>0)||price<prev)minById.set(id,price)}
    const pageLang=document.documentElement.lang||'en', ask=pageLang==='tr'?'Fiyat Sorunuz':pageLang==='es'?'Consultar Precio':'Ask For Price';
    for(const card of cards){const product=bySlug.get(String(card.dataset.productSlug||'').trim().toLowerCase())||byName.get(norm(card.dataset.productName||''));if(!product)continue;const cur=card.querySelector('[data-cat-current-price]'),old=card.querySelector('[data-cat-old-price]');if(!cur||!old)continue;if(product.ask_for_price){cur.textContent=ask;old.textContent='';old.style.display='none';continue}const min=Number(minById.get(String(product.id))||0)||Number(product.default_price||0);if(!(min>0))continue;cur.textContent=`${Math.round(min)} €`;old.textContent=`${Math.round(min*1.20)} €`;old.style.display='';}
  }).catch(e=>console.error('Category live prices failed',e));
})();
</script>

<script>
(() => {
  const grid=document.getElementById('categoryToursGrid');
  if(!grid) return;
  const base=grid.dataset.supabaseUrl||'', key=grid.dataset.supabaseKey||'', lang=grid.dataset.lang||'en', pageCategory=grid.dataset.category||'cappadocia';
  if(!base||!key) return;
  const headers={apikey:key,Authorization:`Bearer ${key}`};
  const allowed={balloon:['balloon'],cappadocia:['daily','package'],private:['private'],transfers:['transfer'],activities:['activity','safari','sunset']}[pageCategory]||[];
  const existing=new Set([...grid.querySelectorAll('[data-product-slug]')].map(x=>String(x.dataset.productSlug||'').toLowerCase()));
  Promise.all([
    fetch(`${base}/rest/v1/tours?is_published=eq.true&select=id,slug,category,price,old_price,duration_minutes,rating,hero_image&order=created_at.desc`,{headers,cache:'no-store'}).then(r=>r.ok?r.json():[]),
    fetch(`${base}/rest/v1/tour_translations?lang=eq.${lang}&select=tour_id,title,duration_label,hero_desc`,{headers,cache:'no-store'}).then(r=>r.ok?r.json():[])
  ]).then(([tours,translations])=>{
    const trById=new Map(translations.map(t=>[String(t.tour_id),t]));
    for(const t of tours){
      if(!allowed.includes(String(t.category||''))||existing.has(String(t.slug||'').toLowerCase())) continue;
      const tr=trById.get(String(t.id)); if(!tr?.title) continue;
      const href=t.category==='transfer'?`/${lang}/transfers/${t.slug}`:`/${lang}/tours/${t.slug}`;
      const card=document.createElement('article'); card.className='cat-card'; card.dataset.productSlug=t.slug; card.dataset.productName=tr.title;
      const duration=tr.duration_label||(t.duration_minutes?`${t.duration_minutes} min`:'Flexible');
      card.innerHTML=`<a class="cat-cover" href="${href}" aria-label="${esc(tr.title)}"></a><div class="cat-img"><img src="${esc(t.hero_image||'/images/hero-cappadociaGo.webp')}" alt="${esc(tr.title)}" loading="lazy"/><b>${Number(t.rating||4.9).toFixed(1)} ★</b></div><div class="cat-body"><small>${esc(duration)}</small><h2>${esc(tr.title)}</h2><em>${lang==='tr'?'Yeni tur':lang==='es'?'Nuevo tour':'New tour'}</em><div class="cat-price"><span>${lang==='tr'?'Başlangıç Fiyatı':lang==='es'?'Precio Desde':'Starting Price'}</span><div><del data-cat-old-price>${t.old_price?`${Math.round(Number(t.old_price))} €`:''}</del><strong data-cat-current-price>${Math.round(Number(t.price||0))} €</strong></div></div></div>`;
      grid.appendChild(card); existing.add(String(t.slug).toLowerCase());
    }
  }).catch(()=>{});
  function esc(v=''){return String(v).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]||c))}
})();
</script>

<TourFooter lang={lang} />
</body></html>

