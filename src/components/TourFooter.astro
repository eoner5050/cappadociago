---
import { getFooterGallery } from '../utils/tourGallery';
const { lang = 'en' } = Astro.props;
const imgs = getFooterGallery(4);
const copy = {
  en:{tag:'LOCAL TRAVEL EXPERTS',lead:'Plan Cappadocia with a local team that is available before, during and after your tour.',explore:'Explore tours',contact:'WhatsApp support',nav:'Explore',info:'Information',connect:'Stay connected',home:'Home',balloons:'Balloon Tours',tours:'Cappadocia Tours',activities:'Activities',private:'Private Tours',transfers:'Transfers',terms:'Terms & Conditions',privacy:'Privacy Policy',refund:'Cancellation & Refund',address:'Cappadocia, Nevşehir, Türkiye'},
  tr:{tag:'YEREL SEYAHAT UZMANLARI',lead:'Kapadokya planınızı tur öncesinde, sırasında ve sonrasında ulaşabileceğiniz yerel ekiple yapın.',explore:'Turları keşfet',contact:'WhatsApp destek',nav:'Keşfet',info:'Bilgiler',connect:'Bizi takip edin',home:'Ana Sayfa',balloons:'Balon Turları',tours:'Kapadokya Turları',activities:'Aktiviteler',private:'Özel Turlar',transfers:'Transferler',terms:'Şartlar ve Koşullar',privacy:'Gizlilik Politikası',refund:'İptal & İade',address:'Kapadokya, Nevşehir, Türkiye'},
  es:{tag:'EXPERTOS LOCALES',lead:'Planifica Capadocia con un equipo local disponible antes, durante y después de tu tour.',explore:'Explorar tours',contact:'Soporte WhatsApp',nav:'Explorar',info:'Información',connect:'Síguenos',home:'Inicio',balloons:'Tours en Globo',tours:'Tours por Capadocia',activities:'Actividades',private:'Tours Privados',transfers:'Traslados',terms:'Términos y Condiciones',privacy:'Privacidad',refund:'Cancelación y Reembolso',address:'Capadocia, Nevşehir, Türkiye'}
}[lang] || null;
---
<footer class="cg-global-footer">
  <div class="cg-global-footer__accent"></div>
  <div class="cg-global-footer__shell">
    <div class="cg-global-footer__lead">
      <div class="cg-global-footer__brand">
        <a href={`/${lang}/`} aria-label="CappadociaGo"><img src="/images/logo.png" alt="CappadociaGo" width="600" height="200" loading="lazy" decoding="async" /></a>
        <span>{copy.tag}</span>
        <p>{copy.lead}</p>
        <div class="cg-global-footer__actions">
          <a class="primary" href={`/${lang}/#tours`}>{copy.explore}</a>
          <a class="secondary" href="https://wa.me/905401015050" target="_blank" rel="noopener noreferrer"><img src="/images/icons/whatsapp-logo.webp" alt="" width="18" height="18" />{copy.contact}</a>
        </div>
      </div>
      {imgs.length > 0 && <div class="cg-global-footer__gallery">{imgs.map((src,i)=><img src={src} alt={`CappadociaGo experience ${i+1}`} width="320" height="220" loading="lazy" decoding="async" />)}</div>}
    </div>
    <div class="cg-global-footer__grid">
      <div><h4>{copy.nav}</h4><a href={`/${lang}/`}>{copy.home}</a><a href={`/${lang}/balloon-tours/`}>{copy.balloons}</a><a href={`/${lang}/cappadocia-tours/`}>{copy.tours}</a><a href={`/${lang}/activities/`}>{copy.activities}</a></div>
      <div><h4>&nbsp;</h4><a href={`/${lang}/private-tours/`}>{copy.private}</a><a href={`/${lang}/transfers/`}>{copy.transfers}</a><a href={`/${lang}/cancellation-refund-policy/`}>{copy.refund}</a><a href={`/${lang}/terms-and-conditions/`}>{copy.terms}</a></div>
      <div><h4>{copy.info}</h4><span>{copy.address}</span><a href="tel:+905401015050">+90 540 101 50 50</a><a href="mailto:info@kapheratravel.com">info@kapheratravel.com</a><strong>TÜRSAB No: 18577</strong></div>
      <div><h4>{copy.connect}</h4><a href="https://www.instagram.com/cappadociago/" target="_blank" rel="noopener noreferrer">Instagram · @cappadociago</a><a href="https://www.facebook.com/share/19A14kRwHz/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer">Facebook · CappadociaGo</a><a href="https://wa.me/905401015050" target="_blank" rel="noopener noreferrer"><img class="cg-global-footer__wa-icon" src="/images/icons/whatsapp-logo.webp" alt="" width="16" height="16" />WhatsApp · +90 540 101 50 50</a><a href={`/${lang}/privacy-policy/`}>{copy.privacy}</a></div>
    </div>
    <div class="cg-global-footer__bottom"><span>© 2026 CappadociaGo</span><span>Cappadocia Kaphera Travel Agency · TÜRSAB 18577</span></div>
  </div>
</footer>
<style is:global>
.cg-global-footer{margin-top:44px;background:linear-gradient(145deg,#061a35 0%,#082d59 56%,#075aa6 135%);color:#eaf2fb;font-family:'Plus Jakarta Sans',Arial,sans-serif;overflow:hidden}.cg-global-footer__accent{height:4px;background:linear-gradient(90deg,#d9a51f,#f2c856,#075aa6)}.cg-global-footer__shell{width:min(1240px,calc(100% - 36px));margin:auto;padding:44px 0 24px}.cg-global-footer__lead{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(360px,.9fr);gap:54px;align-items:end;padding-bottom:34px;border-bottom:1px solid rgba(255,255,255,.13)}.cg-global-footer__brand img{width:150px;height:auto;display:block;filter:drop-shadow(0 8px 18px rgba(0,0,0,.15))}.cg-global-footer__brand>span{display:inline-block;margin-top:16px;color:#f3c75a;font-size:10px;letter-spacing:.14em;font-weight:900}.cg-global-footer__brand p{max-width:610px;margin:9px 0 0;color:#c7d5e5;font-size:13px;line-height:1.75}.cg-global-footer__actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:18px}.cg-global-footer__actions a{min-height:42px;padding:0 16px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;gap:7px;text-decoration:none;font-size:11px;font-weight:900}.cg-global-footer__actions .primary{background:#d9a51f;color:#062d63}.cg-global-footer__actions .secondary{border:1px solid rgba(255,255,255,.25);color:#fff;background:rgba(255,255,255,.07)}.cg-global-footer__actions img{width:17px;height:17px}.cg-global-footer__gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.cg-global-footer__gallery img{width:100%;height:106px;object-fit:cover;border-radius:16px;border:1px solid rgba(255,255,255,.18)}.cg-global-footer__grid{display:grid;grid-template-columns:1fr 1fr 1.25fr 1.25fr;gap:34px;padding:34px 0 30px}.cg-global-footer__grid>div{display:grid;align-content:start;gap:9px}.cg-global-footer__grid h4{margin:0 0 4px;color:#fff;font-size:13px;font-weight:900}.cg-global-footer__grid a,.cg-global-footer__grid span{color:#b9cce0;text-decoration:none;font-size:11px;line-height:1.55}.cg-global-footer__grid a:hover{color:#f3c75a}.cg-global-footer__grid strong{color:#f3c75a;font-size:11px}.cg-global-footer__bottom{padding-top:20px;border-top:1px solid rgba(255,255,255,.13);display:flex;justify-content:space-between;gap:16px;color:#91abc5;font-size:10px}
@media(max-width:850px){.cg-global-footer__lead{grid-template-columns:1fr;gap:24px}.cg-global-footer__gallery{max-width:600px}.cg-global-footer__grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.cg-global-footer{margin-top:30px}.cg-global-footer__shell{width:calc(100% - 28px);padding-top:32px}.cg-global-footer__brand img{width:128px}.cg-global-footer__brand p{font-size:12px}.cg-global-footer__gallery{grid-template-columns:repeat(2,1fr)}.cg-global-footer__gallery img{height:90px}.cg-global-footer__grid{grid-template-columns:1fr;gap:22px;padding:28px 0}.cg-global-footer__grid>div h4:empty{display:none}.cg-global-footer__bottom{flex-direction:column;gap:5px}.cg-global-footer__actions a{flex:1 1 145px}}
</style>

<style is:global>
/* 2026-08-30 footer WhatsApp mobile polish */
.cg-global-footer__wa-icon{width:15px;height:15px;object-fit:contain;vertical-align:middle;margin-right:6px}
.cg-global-footer__grid>div:last-child a[href^="https://wa.me"]{display:flex;align-items:center;gap:2px}
@media(max-width:560px){
  .cg-global-footer__actions{display:grid!important;grid-template-columns:1fr 1fr!important;gap:7px!important;}
  .cg-global-footer__actions a{min-height:38px!important;padding:0 10px!important;font-size:10px!important;flex:none!important;}
  .cg-global-footer__actions .secondary{background:rgba(255,255,255,.09)!important;border-color:rgba(243,199,90,.45)!important;}
  .cg-global-footer__grid>div:last-child a[href^="https://wa.me"]{width:100%!important;box-sizing:border-box!important;min-height:38px!important;padding:0 11px!important;border:1px solid rgba(243,199,90,.32)!important;border-radius:12px!important;background:rgba(255,255,255,.07)!important;color:#fff!important;}
  .cg-global-footer__wa-icon{width:14px!important;height:14px!important;margin-right:5px!important;}
}
@media(max-width:360px){.cg-global-footer__actions{grid-template-columns:1fr!important;}}
</style>

<style is:global>
/* 2026-08-30 SURGICAL FOOTER WHATSAPP FIX */
.cg-global-footer__actions .secondary img,
.cg-global-footer__wa-icon{
  width:15px!important;height:15px!important;min-width:15px!important;max-width:15px!important;
  object-fit:contain!important;object-position:center!important;display:block!important;flex:0 0 15px!important;
  margin:0!important;filter:none!important;transform:none!important;
}
@media(max-width:560px){
  .cg-global-footer__actions{grid-template-columns:1fr 1fr!important;align-items:stretch!important;}
  .cg-global-footer__actions a{width:100%!important;min-width:0!important;box-sizing:border-box!important;overflow:hidden!important;}
  .cg-global-footer__actions .secondary{justify-content:center!important;gap:6px!important;white-space:normal!important;text-align:center!important;line-height:1.05!important;}
  .cg-global-footer__grid>div:last-child a[href^="https://wa.me"]{gap:7px!important;overflow:hidden!important;}
}
@media(max-width:350px){.cg-global-footer__actions{grid-template-columns:1fr!important;}}
</style>
