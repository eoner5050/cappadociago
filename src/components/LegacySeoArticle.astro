---
const { article } = Astro.props;
const siteOrigin = "https://cappadociago.com";
const lang = article.lang === "tr" ? "tr" : "en";
const canonical = `${siteOrigin}${article.newPath}`;
const homeUrl = `/${lang}/`;
const balloonUrl = `/${lang}/balloon-tours/`;
const toursUrl = `/${lang}/cappadocia-tours/`;
const helpUrl = `/${lang}/faq/`;
const blogUrl = `/${lang}/blog/`;
const heroImages = {
  "1-gunluk-kapadokya-turlari": "/images/tours/cappadocia-tour.webp",
  "air-balloon-cappadocia-price": "/images/tours/soganli-valley-balloon-tour (2).webp",
  "air-balloon-in-cappadocia-price": "/images/tours/ihlara-valley-balloons-tour (6).webp",
  "air-balloon-ride-turkey": "/images/tours/balloons-watching-tour-cappadocia (1).webp",
  "antalya-to-cappadocia-turkey-distance": "/images/tours/kayseri-airport-shuttle-transfer.webp",
  "balloon-flight-cappadocia-cost": "/images/tours/balloons-watching-tour-cappadocia (3).webp",
  "balloons-of-cappadocia-travel-agency": "/images/tours/cappadocia-sunset-camel-riding-tour (4).webp",
  "balon-dahil-kapadokya-turu": "/images/tours/Red-Tour-Cappadocia.webp",
  "balon-fiyatlari-kapadokya": "/images/tours/pamukkale-balloons-tour (1).webp",
  "best-balloon-flights-in-cappadocia": "/images/tours/goreme-standart-hot-air-balloon-tour (8).webp",
  "best-cappadocia-day-tour-from-turkey": "/images/tours/Blue-Tour-Cappadocia-Discover-Hidden-Valleys.webp",
  "best-cappadocia-green-tour": "/images/tours/Private-Green-Tour-Cappadocia.webp",
  "best-hot-air-balloons-cappadocia": "/images/tours/ihlara-valley-balloons-tour (1).webp",
  "cappadocia-turkey-holidays": "/images/tours/cappadocia-jeep-safari (14).webp",
  "istanbul-cappadocia-tours-turkey": "/images/tours/Nevsehir-Airport-NAV-Shuttle-Transfer.webp",
  "cappadocia-balloon-tour-price": "/images/blog/balloon/cappadocia-balloon-tours.webp"
};
const heroImage = heroImages[article.slug] || "/images/tours/soganli-valley-balloon-tour (2).webp";
const socialImage = `${siteOrigin}${heroImage}`;
const labels = lang === "tr" ? {
  balloon:"Balon Turları", tours:"Kapadokya Turları", help:"SSS", blog:"Blog",
  migrated:"SEO Rehberi", updated:"Güncellenmiş rehber", related:"Kapadokya'yı planlayın",
  cta:"Kapadokya deneyiminizi planlayın", ctaText:"Balon uçuşları, günlük turlar ve sık sorulan soruları tek yerden inceleyin.",
  back:"Tüm rehberler", whatsapp:"WhatsApp ile Sor"
} : {
  balloon:"Balloon Tours", tours:"Cappadocia Tours", blog:"Blog",
  migrated:"SEO Travel Guide", updated:"Updated guide", related:"Plan your Cappadocia trip",
  cta:"Plan your Cappadocia experience", ctaText:"Compare balloon flights, daily tours and local Cappadocia experiences in one place.",
  back:"All travel guides", whatsapp:"Ask on WhatsApp"
};
const schema = {
  "@context":"https://schema.org",
  "@type":"Article",
  "headline":article.title,
  "description":article.description,
  "mainEntityOfPage":canonical,
  "url":canonical,
  "image":socialImage,
  "datePublished":article.published || undefined,
  "dateModified":"2026-08-15",
  "inLanguage":lang,
  "author":{"@type":"Organization","name":"CappadociaGo","url":siteOrigin},
  "publisher":{"@type":"Organization","name":"CappadociaGo","url":siteOrigin,"logo":{"@type":"ImageObject","url":`${siteOrigin}/images/logo.png`}}
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{article.seoTitle}</title>
  <meta name="description" content={article.description} />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  {article.focusKeyword && <meta name="keywords" content={article.focusKeyword} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={article.seoTitle} />
  <meta property="og:description" content={article.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={article.seoTitle} />
  <meta name="twitter:description" content={article.description} />
  <meta name="twitter:image" content={socialImage} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <style>
    :root{--navy:#071f4e;--navy2:#10375f;--gold:#f5b700;--bg:#f6f3eb;--ink:#26364c;--muted:#6b7b90;--line:#e8e1d4}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--ink)}
    a{color:inherit}.site-header{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid #e7ebf0;box-shadow:0 5px 18px #071f4e0a}.header-inner{width:min(1240px,calc(100% - 28px));margin:auto;min-height:86px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand img{height:66px;width:auto;display:block}.nav{display:flex;align-items:center;gap:24px;font-size:13px;font-weight:850}.nav a{text-decoration:none}.nav a:hover{color:#c99300}.wa{display:inline-flex!important;align-items:center;gap:7px;padding:10px 14px;border:1px solid #dce4ed;border-radius:999px}.wa img{width:18px;height:18px}
    .crumb{width:min(1180px,calc(100% - 32px));margin:18px auto 0;font-size:11px;color:#728196}.crumb a{text-decoration:none;color:#4b6180}.hero{width:min(1180px,calc(100% - 32px));margin:14px auto 0;padding:clamp(26px,4vw,48px);border:1px solid var(--line);border-radius:24px;background:radial-gradient(circle at 95% 0,#fff1b5 0,transparent 24rem),#fff;box-shadow:0 18px 45px #071f4e12}.kicker{display:inline-flex;padding:7px 11px;border-radius:999px;background:#f9c900;color:#10264a;font-size:10px;font-weight:950;letter-spacing:.05em}.hero h1{margin:13px 0 12px;color:var(--navy);font-size:clamp(31px,4vw,52px);line-height:1.07;letter-spacing:-.035em;max-width:980px}.hero p{max-width:900px;margin:0;color:#5c6d83;font-size:16px;line-height:1.75}.meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.meta span{padding:7px 10px;border-radius:999px;background:#f5f8fb;border:1px solid #e1e7ee;color:#4f6178;font-size:11px;font-weight:750}
    .hero-image{width:min(1180px,calc(100% - 32px));height:clamp(260px,37vw,480px);margin:16px auto 0;border-radius:24px;overflow:hidden;border:1px solid var(--line);background:#ddd}.hero-image img{width:100%;height:100%;object-fit:cover;display:block}
    .layout{width:min(1180px,calc(100% - 32px));margin:18px auto 50px;display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:20px;align-items:start}.article{background:#fff;border:1px solid var(--line);border-radius:24px;padding:clamp(24px,4vw,42px);box-shadow:0 14px 38px #071f4e0b}.article :global(h2){color:var(--navy);font-size:clamp(23px,2.5vw,32px);line-height:1.2;margin:36px 0 13px;padding-top:22px;border-top:1px solid #eee7da}.article :global(h3){color:#143d69;font-size:20px;margin:28px 0 10px}.article :global(p),.article :global(li){font-size:15px;line-height:1.9;color:#4f6178}.article :global(ul),.article :global(ol){padding-left:23px}.article :global(a){color:#0a5eaa;font-weight:700;text-decoration-thickness:1px;text-underline-offset:3px}.article :global(strong){color:#243851}.article :global(table){width:100%;border-collapse:collapse;display:block;overflow:auto}.article :global(th),.article :global(td){border:1px solid #e0e6ed;padding:9px}.article :global(.article-media){margin:28px 0}.article :global(.article-media img){width:100%;height:auto;max-height:460px;object-fit:cover;display:block;border-radius:18px;border:1px solid var(--line)}.article :global(.article-media figcaption){margin-top:8px;color:#77869a;font-size:11px;line-height:1.55}.article :global(.article-related){margin:18px 0 26px;padding:14px 16px;border:1px solid #e7dfcf;border-radius:14px;background:#fff9e8;color:#52647a;font-size:12px;line-height:1.75}.article :global(.article-related strong){color:var(--navy);margin-right:5px}.article :global(.article-related a){font-size:12px}.article :global(.article-link){margin:10px 0 18px}.article :global(.article-link a){display:inline-flex;padding:10px 13px;border-radius:12px;background:#f7faff;border:1px solid #dfe8f2;color:#0a5eaa;font-size:13px;font-weight:800;text-decoration:none}.article :global(.article-link a:hover){border-color:#f5b700;background:#fff9e4}
    .sidebar{display:grid;gap:14px;position:sticky;top:104px}.side-card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:20px;box-shadow:0 12px 32px #071f4e0a}.side-card h2{margin:0 0 8px;color:var(--navy);font-size:19px}.side-card p{margin:0 0 14px;font-size:12px;line-height:1.65;color:#6c7c90}.side-links{display:grid;gap:8px}.side-links a{padding:11px 12px;border-radius:12px;background:#f7faff;border:1px solid #e0e8f1;text-decoration:none;font-size:12px;font-weight:850;color:#0b3768}.side-links a:hover{border-color:#f5b700;background:#fff9e4}.cta{background:linear-gradient(135deg,#071f4e,#123d6d);color:#fff;border-color:#123d6d}.cta h2{color:#fff}.cta p{color:#d8e2ef}.cta a{display:flex;justify-content:center;padding:12px;border-radius:999px;background:#18b965;color:#fff;text-decoration:none;font-size:12px;font-weight:900}
    .footer{background:#fff;border-top:1px solid #e3e8ee;padding:28px 16px;text-align:center;color:#6c7b8d;font-size:11px}.assistant{position:fixed;right:22px;bottom:22px;z-index:30;display:flex;align-items:center;gap:9px;padding:11px 16px;border-radius:999px;background:#082f5b;color:#fff;text-decoration:none;font-weight:900;font-size:12px;box-shadow:0 16px 40px #071f4e38}.assistant img{width:22px;height:22px}
    @media(max-width:900px){.nav a:not(.wa){display:none}.layout{grid-template-columns:1fr}.sidebar{position:static}.header-inner{min-height:76px}.brand img{height:58px}}@media(max-width:560px){.hero,.article{border-radius:18px}.hero{padding:24px 18px}.article{padding:24px 18px}.hero-image{height:230px;border-radius:18px}.assistant{right:13px;bottom:13px}.wa span{display:none}}
  </style>
</head>
<body>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={homeUrl} aria-label="CappadociaGo"><img src="/images/logo.png" alt="CappadociaGo" width="150" height="70" loading="lazy" decoding="async"/></a>
    <nav class="nav" aria-label="Main navigation">
      <a href={balloonUrl}>{labels.balloon}</a>
      <a href={toursUrl}>{labels.tours}</a>
      <a href={helpUrl}>{labels.help}</a>
      <a href={blogUrl}>{labels.blog}</a>
      <a class="wa" href="https://wa.me/905401015050" target="_blank" rel="noopener"><img src="/images/icons/whatsapp-logo.webp" alt="" width="600" height="600" loading="lazy"/><span>WhatsApp</span></a>
    </nav>
  </div>
</header>
<div class="crumb"><a href={homeUrl}>CappadociaGo</a> › <a href={blogUrl}>{labels.blog}</a> › {article.title}</div>
<section class="hero">
  <span class="kicker">{labels.migrated}</span>
  <h1>{article.title}</h1>
  <p>{article.description}</p>
  <div class="meta">
    {article.focusKeyword && <span>Focus: {article.focusKeyword}</span>}
    <span>{labels.updated}: 2026</span>
  </div>
</section>
<div class="hero-image"><img src={heroImage} alt={`${article.title} - Cappadocia travel guide`} width="1180" height="480" decoding="async" fetchpriority="high"/></div>
<main class="layout">
  <article class="article" set:html={article.contentHtml}></article>
  <aside class="sidebar">
    <section class="side-card">
      <h2>{labels.related}</h2>
      <p>{lang==="tr" ? "Rehberden sonra güncel ürün ve planlama sayfalarına geçebilirsiniz." : "Continue from the guide to current booking and planning pages."}</p>
      <div class="side-links">
        <a href={balloonUrl}>{labels.balloon} →</a>
        <a href={toursUrl}>{labels.tours} →</a>
        <a href={helpUrl}>{labels.help} →</a>
        <a href={blogUrl}>{labels.back} →</a>
      </div>
    </section>
    <section class="side-card cta">
      <h2>{labels.cta}</h2>
      <p>{labels.ctaText}</p>
      <a href="https://wa.me/905401015050" target="_blank" rel="noopener">{labels.whatsapp}</a>
    </section>
  </aside>
</main>
<footer class="footer">© 2026 CappadociaGo · Cappadocia, Türkiye</footer>
<a class="assistant" href="https://wa.me/905401015050" target="_blank" rel="noopener"><img src="/images/icons/whatsapp-logo.webp" alt="" width="600" height="600" loading="lazy"/> Assistant</a>
</body>
</html>
