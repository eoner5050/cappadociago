<style is:global>
/* CAPPADOCIAGO — final authoritative tour visual system.
   Rendered last on every real tour page. */
html,body{background:#eaf1f6!important;}
body{
  background:
    radial-gradient(circle at 10% 4%,rgba(217,165,31,.12),transparent 24%),
    radial-gradient(circle at 90% 16%,rgba(7,90,166,.11),transparent 28%),
    linear-gradient(180deg,#eef5fa 0%,#e7eff5 56%,#f3eee5 100%)!important;
  background-attachment:fixed!important;
}
body .page,body .tbc-tour-page,body .tour-page,body .tour-detail-page,body main{background:transparent!important;}
body .hero,body .tbc-tour-hero{
  background:linear-gradient(120deg,#123b63 0%,#0d3158 58%,#092648 100%)!important;
  color:#fff!important;border:1px solid rgba(255,255,255,.10)!important;
  box-shadow:0 16px 38px rgba(8,44,80,.16)!important;
}
body .hero h1,body .tbc-tour-title{color:#fff!important;text-shadow:none!important;}
body .hero>p,body .tbc-tour-desc{color:rgba(255,255,255,.84)!important;}
</style>

<style is:global>
/* CAPPADOCIAGO — authoritative tour mobile layout guard.
   This component is intentionally rendered LAST on tour detail pages. */
@media (max-width: 900px){
  html,body{width:100%!important;max-width:100%!important;overflow-x:hidden!important}

  body .page,body .tbc-tour-page,body .tour-page,body .tour-detail-page,
  body .container,body .tbc-tour-container,body .wrap{
    box-sizing:border-box!important;min-width:0!important;max-width:100%!important;
  }
  body .container,body .tbc-tour-container,body .wrap{
    width:calc(100% - 20px)!important;margin-left:auto!important;margin-right:auto!important;
  }

  /* Never allow the content/sidebar grid to stay two-column on a phone/tablet. */
  body .grid,body .tbc-tour-grid,body .tour-layout{
    display:flex!important;flex-direction:column!important;grid-template-columns:none!important;
    align-items:stretch!important;width:100%!important;max-width:100%!important;min-width:0!important;
    gap:14px!important;
  }
  body .main-col,body .tbc-tour-main,body .tour-content,
  body .tbc-tour-main-card,body .card.content,body .content{
    order:2!important;display:block!important;position:static!important;float:none!important;
    width:100%!important;max-width:100%!important;min-width:0!important;flex:0 0 auto!important;
    margin-left:0!important;margin-right:0!important;left:auto!important;right:auto!important;
    transform:none!important;overflow:visible!important;column-count:auto!important;columns:auto!important;
  }
  body .side,body .tbc-tour-side,body .tour-sidebar{
    order:1!important;display:flex!important;flex-direction:column!important;position:static!important;float:none!important;
    width:100%!important;max-width:100%!important;min-width:0!important;flex:0 0 auto!important;
    margin:0!important;left:auto!important;right:auto!important;transform:none!important;
  }
  body .side>*,body .tbc-tour-side>*{width:100%!important;max-width:100%!important;min-width:0!important;}
  body .side>.price-card,body .tbc-tour-side>.tbc-tour-side-card,body .tbc-tour-side>.tbc-price-card{order:1!important;}
  body .side>.booking,body .tbc-tour-side>.tbc-booking-card{order:2!important;}
  /* Mobile order is intentionally: price -> quick reservation -> description/content. */

  /* Content sections must remain real full-width blocks. */
  body .content>section,body .content section,body .tbc-tour-section,body .content-block{
    display:block!important;visibility:visible!important;opacity:1!important;
    position:relative!important;float:none!important;clear:both!important;
    width:100%!important;max-width:100%!important;min-width:0!important;
    height:auto!important;min-height:0!important;max-height:none!important;
    overflow:visible!important;transform:none!important;clip:auto!important;clip-path:none!important;
    writing-mode:horizontal-tb!important;text-orientation:mixed!important;
  }
  body .content>section>*,body .content section>*,body .tbc-tour-section>*,body .content-block>*{
    min-width:0!important;max-width:100%!important;writing-mode:horizontal-tb!important;text-orientation:mixed!important;
  }

  body .content h1,body .content h2,body .content h3,
  body .tbc-tour-section h1,body .tbc-tour-section h2,body .tbc-tour-section h3,
  body .content-block h1,body .content-block h2,body .content-block h3{
    display:block!important;width:100%!important;max-width:100%!important;min-width:0!important;
    white-space:normal!important;word-break:normal!important;overflow-wrap:break-word!important;hyphens:none!important;
    writing-mode:horizontal-tb!important;text-orientation:mixed!important;
  }
  body .content p,body .content li,
  body .tbc-tour-section p,body .tbc-tour-section li,
  body .content-block p,body .content-block li,
  body .tbc-tour-list-item,body .tbc-tour-list-item span,body .checks>div,body .check-item{
    width:100%!important;max-width:100%!important;min-width:0!important;
    white-space:normal!important;word-break:normal!important;overflow-wrap:break-word!important;hyphens:none!important;
    writing-mode:horizontal-tb!important;text-orientation:mixed!important;
  }
  body .content h2,body .tbc-tour-section h2,body .content-block h2{font-size:18px!important;line-height:1.28!important;margin:0 0 10px!important}
  body .content p,body .tbc-tour-section p,body .content-block p{font-size:12.5px!important;line-height:1.72!important;margin:0 0 11px!important}
  body .content li,body .tbc-tour-section li,body .content-block li,body .tbc-tour-list-item,body .checks>div{font-size:12px!important;line-height:1.62!important}

  body .checks,body .tbc-tour-list,body .check-grid{
    display:grid!important;grid-template-columns:1fr!important;width:100%!important;max-width:100%!important;min-width:0!important;gap:8px!important;
  }
  body .tbc-tour-list-item,body .checks>div,body .check-item{display:flex!important;align-items:flex-start!important;gap:8px!important}
  body .tbc-tour-check,body .checks i{flex:0 0 18px!important}

  /* Quick Reservation phone: country code and phone number get separate lanes. */
  body .iti{display:block!important;position:relative!important;width:100%!important;max-width:100%!important;min-width:0!important;overflow:visible!important}
  body .iti__country-container{position:absolute!important;left:0!important;top:0!important;bottom:0!important;width:88px!important;min-width:88px!important;max-width:88px!important;z-index:5!important}
  body .iti__selected-country{width:88px!important;min-width:88px!important;max-width:88px!important;padding:0 8px!important;display:flex!important;align-items:center!important;gap:4px!important;background:#f3f8fc!important;border-right:1px solid #cbdbe8!important;border-radius:11px 0 0 11px!important}
  body .iti__selected-country-primary{display:flex!important;align-items:center!important;gap:4px!important;min-width:0!important;padding:0!important}
  body .iti__selected-dial-code{display:inline-block!important;font-size:11px!important;line-height:1!important;font-weight:800!important;white-space:nowrap!important;color:#062d63!important;margin:0!important}
  body .iti input[type=tel],body input.iti__tel-input,body .iti__tel-input{
    display:block!important;width:100%!important;max-width:100%!important;min-width:0!important;box-sizing:border-box!important;
    padding-left:100px!important;padding-right:11px!important;text-indent:0!important;font-size:12.5px!important;
  }
  body .iti__country-list{z-index:2147483646!important;max-width:calc(100vw - 24px)!important}
}

@media (max-width: 390px){
  body .container,body .tbc-tour-container,body .wrap{width:calc(100% - 16px)!important}
  body .content h2,body .tbc-tour-section h2,body .content-block h2{font-size:17px!important}
  body .content p,body .tbc-tour-section p,body .content-block p{font-size:12px!important}
  body .iti__country-container,body .iti__selected-country{width:84px!important;min-width:84px!important;max-width:84px!important}
  body .iti input[type=tel],body input.iti__tel-input,body .iti__tel-input{padding-left:95px!important;font-size:12px!important}
}
</style>

<style is:global>
/* FINAL MOBILE TOUR ORDER — authoritative and loaded last.
   Required order: title/hero -> gallery -> price -> quick reservation -> tour content. */
@media (max-width: 900px){
  body .grid, body .tbc-tour-grid{display:flex!important;flex-direction:column!important;}
  body .side, body .tbc-tour-side{order:1!important;display:flex!important;flex-direction:column!important;}
  body .main-col, body .tbc-tour-main{order:2!important;}
  body .side>.price-card, body .tbc-tour-side>.tbc-tour-side-card, body .tbc-tour-side>.tbc-price-card{order:1!important;}
  body .side>.booking, body .tbc-tour-side>.tbc-booking-card{order:2!important;}
  body .main-col, body .tbc-tour-main, body .content, body .tbc-tour-main-card{width:100%!important;max-width:100%!important;min-width:0!important;}
}
</style>

<script is:inline>
(() => {
  const MOBILE_MAX = 900;
  const pairs = [
    { grid: '.grid', main: '.main-col', side: '.side', price: '.price-card', booking: '.booking' },
    { grid: '.tbc-tour-grid', main: '.tbc-tour-main', side: '.tbc-tour-side', price: '.tbc-tour-side-card, .tbc-price-card', booking: '.tbc-booking-card' },
    { grid: '.tour-layout', main: '.tour-content', side: '.tour-sidebar', price: '.price-card, .tour-price-card', booking: '.booking, .booking-card' }
  ];

  function forceOrder() {
    if (window.innerWidth > MOBILE_MAX) return;

    pairs.forEach((cfg) => {
      document.querySelectorAll(cfg.grid).forEach((grid) => {
        const main = grid.querySelector(`:scope > ${cfg.main}`) || grid.querySelector(cfg.main);
        const side = grid.querySelector(`:scope > ${cfg.side}`) || grid.querySelector(cfg.side);
        if (!main || !side) return;

        // Ensure sidebar is physically before the content column on mobile.
        if (side.parentElement === grid && main.parentElement === grid && grid.firstElementChild !== side) {
          grid.insertBefore(side, main);
        }

        const price = side.querySelector(cfg.price);
        const booking = side.querySelector(cfg.booking);
        if (price && booking && price.nextElementSibling !== booking) {
          side.insertBefore(price, side.firstElementChild);
          if (price.nextElementSibling !== booking) side.insertBefore(booking, price.nextElementSibling);
        }

        // Inline styles are intentional here: older tour templates contain high-specificity
        // mobile rules that can otherwise override the shared CSS ordering.
        grid.style.setProperty('display', 'flex', 'important');
        grid.style.setProperty('flex-direction', 'column', 'important');
        side.style.setProperty('order', '1', 'important');
        side.style.setProperty('display', 'flex', 'important');
        side.style.setProperty('flex-direction', 'column', 'important');
        main.style.setProperty('order', '2', 'important');
        if (price) price.style.setProperty('order', '1', 'important');
        if (booking) booking.style.setProperty('order', '2', 'important');
      });
    });
  }

  const run = () => requestAnimationFrame(() => requestAnimationFrame(forceOrder));
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run, { once: true });
  else run();
  window.addEventListener('load', run, { once: true });
  window.addEventListener('resize', run, { passive: true });

  // Database/admin revisions can hydrate/replace tour markup after the initial paint.
  const observer = new MutationObserver(() => run());
  observer.observe(document.documentElement, { childList: true, subtree: true });
  setTimeout(() => observer.disconnect(), 8000);
})();
</script>
