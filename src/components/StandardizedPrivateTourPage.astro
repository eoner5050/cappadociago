---
import SeoHead from './SeoHead.astro';
import SiteHeader from './SiteHeader.astro';
import { getTourGallery } from '../utils/tourGallery';

const {
  lang = 'en', slug, title, heroDesc, overviewTitle, overviewParagraphs = [], priceTitle, priceText,
  included = [], importantTitle = 'Important Information', important = [], detailsTitle = 'Tour Details', details = [],
  extraSections = [], duration = 'Full Day', rating = '', mainImage, galleryImages = [], priceMode = 'perPerson',
  sidebarBadges = [], sideHighlights = [], reviewCount = 0
} = Astro.props;
const copy = {
  en:{home:'Home',balloon:'Balloon Tours',tours:'Cappadocia Tours',activities:'Activities',private:'Private Tours',transfers:'Transfers',price:'Tour Price, starting from',perPerson:'per person',group:'per group',ask:'Ask for Price',contact:'Contact via WhatsApp',form:'Quick Reservation Form',formDesc:'Leave your details and our team will contact you as soon as possible.',name:'Full Name',phone:'Phone Number',date:'Date',people:'Number of People',selectDate:'Select Date',selectPeople:'Select People',children:'Children are included in this number of people.',message:'Your Message',messagePh:'You can write your additional note.',send:'Send Reservation Request',unit:'Price per person',groupPrice:'Group price',total:'Total price',left:'left',closed:'Closed',sold:'Sold out',loading:'Loading availability...',availability:'Availability',request:'New Reservation Request',alert:'Please complete name, phone, date and number of people before sending.',duration:'Tour Duration',instant:'Instant Confirmation!'},
  tr:{home:'Ana Sayfa',balloon:'Balon Turları',tours:'Kapadokya Turları',activities:'Aktiviteler',private:'Özel Turlar',transfers:'Transferler',price:'Tur Fiyatı, başlayan',perPerson:'kişi başı',group:'grup fiyatı',ask:'Fiyat Sorunuz',contact:'WhatsApp ile İletişim',form:'Hızlı Rezervasyon Formu',formDesc:'Bilgilerinizi bırakın, ekibimiz en kısa sürede sizinle iletişime geçsin.',name:'Ad Soyad',phone:'Telefon Numarası',date:'Tarih',people:'Kişi Sayısı',selectDate:'Tarih Seçin',selectPeople:'Kişi Seçin',children:'Çocuklar da bu kişi sayısına dahildir.',message:'Mesajınız',messagePh:'Ek notunuzu yazabilirsiniz.',send:'Rezervasyon Talebi Gönder',unit:'Kişi başı fiyat',groupPrice:'Grup fiyatı',total:'Toplam fiyat',left:'kaldı',closed:'Kapalı',sold:'Dolu',loading:'Müsaitlik yükleniyor...',availability:'Müsaitlik',request:'Yeni Rezervasyon Talebi',alert:'Lütfen ad, telefon, tarih ve kişi sayısını tamamlayın.',duration:'Tur Süresi',instant:'Anında Onay!'},
  es:{home:'Inicio',balloon:'Tours en Globo',tours:'Tours por Capadocia',activities:'Actividades',private:'Tours Privados',transfers:'Traslados',price:'Precio desde',perPerson:'por persona',group:'por grupo',ask:'Consultar Precio',contact:'Contactar por WhatsApp',form:'Formulario de Reserva Rápida',formDesc:'Déjanos tus datos y nuestro equipo te contactará lo antes posible.',name:'Nombre Completo',phone:'Teléfono',date:'Fecha',people:'Número de Personas',selectDate:'Seleccionar Fecha',selectPeople:'Seleccionar Personas',children:'Los niños están incluidos en este número de personas.',message:'Tu Mensaje',messagePh:'Puedes escribir una nota adicional.',send:'Enviar Solicitud de Reserva',unit:'Precio por persona',groupPrice:'Precio del grupo',total:'Precio total',left:'disponibles',closed:'Cerrado',sold:'Agotado',loading:'Cargando disponibilidad...',availability:'Disponibilidad',request:'Nueva Solicitud de Reserva',alert:'Completa nombre, teléfono, fecha y número de personas.',duration:'Duración',instant:'¡Confirmación Instantánea!'}
}[lang] || null;
const flag = lang==='tr'?'🇹🇷':lang==='es'?'🇪🇸':'🇬🇧';
const code = lang.toUpperCase();
const imgs = getTourGallery({ slug, title, preferred: [mainImage, ...galleryImages], max: 6 });
const preserveMainPhoto = new Set([
  'photo-shoot-flying-dress-experience',
  'jeep-safari-cappadocia',
  'ihlara-valley-balloons-tour'
]).has(String(slug));
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <SeoHead title={`${title} | CappadociaGo`} description={heroDesc || overviewParagraphs[0] || title} lang={lang} />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/css/intlTelInput.css">
  <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/js/intlTelInput.min.js"></script>
</head>
<body>
<SiteHeader lang={lang} detailSlug={slug} section={/transfer/i.test(String(slug)) ? 'transfers' : 'tours'} />
<main class="page"><div class="container">
  <div class="breadcrumb"><a href={`/${lang}/`}>{copy.home}</a><span>›</span><span>{title}</span></div>
  <section class="hero"><span class="kicker">CAPPADOCIAGO</span><h1>{title}</h1><p>{heroDesc}</p><div class="hero-badges">{rating && <span class="hero-rating"><span class="hero-stars">★★★★★</span><b>{rating}</b>{reviewCount>0 && <><i></i><em>{reviewCount} Reviews</em></>}</span>}<span>⏱ {copy.duration}: {duration}</span><span>⚡ {copy.instant}</span><a class="hero-wa" href="https://wa.me/905401015050" target="_blank" rel="noopener noreferrer"><img src="/images/icons/whatsapp-logo.webp" alt="" width="18" height="18" loading="lazy"/>+90 540 101 50 50</a></div></section>
  {imgs.length>0 && <section class="gallery" data-gallery-root>
    <button class:list={["main-photo", "gallery-click", preserveMainPhoto && "preserve-photo"]} style={preserveMainPhoto ? `--main-photo-bg:url(${JSON.stringify(imgs[0])})` : undefined} type="button" data-gallery-index="0"><img src={imgs[0]} alt={title} width="1200" height="800" loading="lazy" decoding="async" /><span>📁 {imgs.length} {lang==='tr'?'fotoğraf':lang==='es'?'fotos':'photos'}</span></button>
    <div class="side-photos">{imgs.slice(1,5).map((src, i)=> <button type="button" class="gallery-click" data-gallery-index={String(i+1)}><img src={src} alt={title} width="1200" height="800" loading="lazy" decoding="async" /></button>)}</div>
  </section>}
  <div class="gallery-modal" id="galleryModal" aria-hidden="true"><button class="gallery-close" type="button" aria-label="Close">×</button><button class="gallery-prev" type="button" aria-label="Previous">‹</button><img id="galleryModalImg" alt={title} width="1200" height="800" loading="lazy" decoding="async"/><button class="gallery-next" type="button" aria-label="Next">›</button><div class="gallery-count" id="galleryCount"></div></div>
  <div class="grid"><div class="main-col"><section class="card content">
    <section><h2>{overviewTitle}</h2>{overviewParagraphs.map((p)=><p>{p}</p>)}</section>
    <section><h2>{priceTitle}</h2><p>{priceText}</p></section>
    <section><h2>{lang==='tr'?'Fiyata Dahil Olanlar':lang==='es'?'Qué Incluye':'What’s Included'}</h2><div class="checks">{included.map((x)=><div><i>✓</i><span>{x}</span></div>)}</div></section>
    <section><h2>{importantTitle}</h2><div class="checks">{important.map((x)=><div><i>✓</i><span>{x}</span></div>)}</div></section>
    <section><h2>{detailsTitle}</h2>{details.map((p)=><p>{p}</p>)}</section>
    {extraSections.map((s)=><section><h2>{s.title}</h2>{s.paragraphs?.map((p)=><p>{p}</p>)}{s.items && <div class="checks">{s.items.map((x)=><div><i>✓</i><span>{x}</span></div>)}</div>}</section>)}
  </section></div>
  <aside class="side"><section class="card price-card"><span class="label">{copy.price}</span><div class="price"><del id="mainOldPrice"></del><strong id="mainPrice">{priceMode==='ask'?copy.ask:'—'}</strong><small id="priceSuffix">{priceMode==='perPerson'?copy.perPerson:priceMode==='group'?copy.group:''}</small></div><a id="askPriceLink" class:list={["ask-price-link",priceMode==='ask'&&"show"]} href={`https://wa.me/905401015050?text=${encodeURIComponent(`Hello CappadociaGo, please send me a price for ${title}.`)}`}>💬 {copy.ask}</a><div class="badges">{sidebarBadges.map((x)=><span>{x}</span>)}</div><hr/><a class="phone" href="tel:+905401015050">📞 +90 540 101 50 50</a><a class="wa" href="https://wa.me/905401015050"><img src="/images/icons/whatsapp-logo.webp" alt="" loading="lazy" width="24" height="24"/>{copy.contact}</a><div class="side-list">{sideHighlights.map((x)=><div>✓ <span>{x}</span></div>)}</div></section>
  <section class="card booking"><h3>{copy.form}</h3><p>{copy.formDesc}</p><form id="bookingForm"><label>{copy.name}<input id="name" required placeholder={copy.name}/></label><label>{copy.phone}<input id="phone" type="tel" required/></label><label>{copy.date}<div class="date-wrap"><input id="date" readonly required placeholder={copy.selectDate}/><button type="button" id="calOpen">📅</button><div id="calendar" class="calendar"><div class="cal-head"><button type="button" id="prev">‹</button><b id="calTitle"></b><button type="button" id="next">›</button></div><div class="week"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div><div id="days" class="days"></div></div></div></label><label>{copy.people}<select id="people" required><option value="">{copy.selectPeople}</option></select><small class="children">{copy.children}</small></label><div id="priceBox" class="price-box"><div><span id="unitLabel">{priceMode==='group'?copy.groupPrice:copy.unit}</span><b id="unit">—</b></div><div><span>{copy.total}</span><strong id="total">—</strong></div></div><label>{copy.message}<textarea id="message" placeholder={copy.messagePh}></textarea></label><button class="submit">{copy.send}</button></form></section></aside></div>
</div></main>
<footer class="unified-footer"><div class="uf-inner"><div class="uf-logo"><img src="/images/logo.png" alt="CappadociaGo" width="600" height="200" loading="lazy" /></div><div class="uf-right"><div class="uf-contacts"><div><img src="/images/icons/telefon-logo.webp" alt="" width="24" height="24" loading="lazy" decoding="async"/><span><small>Telephone</small><a href="tel:+905401015050">+90 540 101 50 50</a></span></div><div><img src="/images/icons/whatsapp-logo.webp" alt="" width="24" height="24" loading="lazy" decoding="async"/><span><small>WhatsApp</small><a href="https://wa.me/905401015050">+90 540 101 50 50</a></span></div><div><img src="/images/icons/mail-logo.webp" alt="" width="24" height="24" loading="lazy" decoding="async"/><span><small>E-Mail</small><a href="mailto:info@kapheratravel.com">info@kapheratravel.com</a></span></div></div><div class="uf-gallery"><img src="/images/tours/goreme-standart-hot-air-balloon-tour (2).webp" alt="Göreme Standard Balloon Tour" loading="lazy" width="800" height="600"/><img src="/images/tours/goreme-comfort-hot-air-balloon-tour (2).webp" alt="Göreme Comfort Balloon Tour" loading="lazy" width="800" height="600"/><img src="/images/tours/ihlara-valley-balloons-tour (1).webp" alt="Ihlara Valley Balloon Tour" loading="lazy" width="800" height="600"/><img src="/images/tours/soganli-valley-balloon-tour (1).webp" alt="Soğanlı Valley Balloon Tour" loading="lazy" width="800" height="600"/></div><div class="uf-social"><a href="https://www.instagram.com/cappadociago/"><img src="/images/icons/instagram-logo.webp" alt="" width="24" height="24" loading="lazy" decoding="async"/>@cappadociago</a><a href="https://www.facebook.com/share/19A14kRwHz/?mibextid=wwXIfr"><img src="/images/icons/facebook-logo.webp" alt="" width="24" height="24" loading="lazy" decoding="async"/>Facebook</a></div></div></div></footer>
<script define:vars={{slug,lang,priceMode,copy,supabaseUrl,supabaseKey}}>
const URL=supabaseUrl, KEY=supabaseKey;
let runtimePriceMode=priceMode;
const $=id=>document.getElementById(id); const months=lang==='tr'?['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık']:lang==='es'?['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre']:['January','February','March','April','May','June','July','August','September','October','November','December'];
let product=null, availability={}, selected=null, selKey='', cm=new Date().getMonth(), cy=new Date().getFullYear();
const pad=n=>String(n).padStart(2,'0'), key=(y,m,d)=>`${y}-${pad(m+1)}-${pad(d)}`, display=k=>{const [y,m,d]=k.split('-');return `${d}.${m}.${y}`}, money=v=>`${Number(v||0).toLocaleString(lang==='tr'?'tr-TR':lang==='es'?'es-ES':'en-US',{maximumFractionDigits:2})} €`, rem=r=>Math.max(Number(r?.capacity||0)-Number(r?.booked||0),0);
async function get(path){const r=await fetch(`${URL}/rest/v1/${path}`,{headers:{apikey:KEY,Authorization:`Bearer ${KEY}`}});if(!r.ok)throw new Error(await r.text());return r.json()}
function effective(k){return availability[k]||{date:k,price:Number(product?.default_price||0),capacity:Number(product?.default_capacity||0),booked:0,status:'available',_default:true}}
function available(r){return r&&r.status==='available'&&Number(r.capacity)>0&&rem(r)>0}
async function loadProduct(){if(!URL||!KEY)return;const rows=await get(`products?slug=eq.${encodeURIComponent(slug)}&active=eq.true&select=id,default_price,default_capacity,ask_for_price&limit=1`);product=rows[0]||null;if(!product)return;if(product.ask_for_price)runtimePriceMode='ask';if(runtimePriceMode==='ask'){$('mainPrice').textContent=copy.ask;const old=$('mainOldPrice');if(old){old.textContent='';old.classList.remove('has-price')}const suf=$('priceSuffix');if(suf)suf.style.display='none';$('askPriceLink')?.classList.add('show');}if(runtimePriceMode!=='ask'){const today=new Date().toISOString().slice(0,10);const rows2=await get(`availability?product_id=eq.${product.id}&date=gte.${today}&status=eq.available&select=price,capacity,booked&limit=365`);const vals=rows2.filter(r=>rem(r)>0).map(r=>Number(r.price||0)).filter(v=>v>0);const min=vals.length?Math.min(...vals):Number(product.default_price||0);$('mainPrice').textContent=min>0?money(min):'—';const old=$('mainOldPrice');if(old){if(min>0){old.textContent=money(Math.round(min*1.20));old.classList.add('has-price')}else{old.textContent='';old.classList.remove('has-price')}}}}
async function loadMonth(){if(!product){$('days').innerHTML=`<div class="msg">${copy.availability}</div>`;return}const first=`${cy}-${pad(cm+1)}-01`,ld=new Date(cy,cm+1,0).getDate(),last=`${cy}-${pad(cm+1)}-${pad(ld)}`;const rows=await get(`availability?product_id=eq.${product.id}&date=gte.${first}&date=lte.${last}&select=date,price,capacity,booked,status`);availability={};rows.forEach(r=>availability[r.date]=r);render()}
function render(){$('days').innerHTML='';$('calTitle').textContent=`${months[cm]} ${cy}`;let off=new Date(cy,cm,1).getDay();off=off===0?6:off-1;for(let i=0;i<off;i++)$('days').insertAdjacentHTML('beforeend','<button class="day empty" disabled></button>');const last=new Date(cy,cm+1,0).getDate();for(let d=1;d<=last;d++){const k=key(cy,cm,d),r=effective(k),past=new Date(cy,cm,d)<new Date(new Date().setHours(0,0,0,0)),ok=!past&&available(r),b=document.createElement('button');b.type='button';b.className=`day ${ok?'':'disabled'} ${k===selKey?'selected':''}`;b.disabled=!ok;const status=r.status==='closed'?copy.closed:rem(r)<=0?copy.sold:`${rem(r)} ${copy.left}`;b.innerHTML=`<b>${d}</b>${runtimePriceMode==='ask'?'':`<span>${money(r.price)}</span>`}<small>${status}</small>`;if(ok)b.onclick=()=>choose(r,k);$('days').appendChild(b)}}
function fillPeople(max,selectedVal=''){const s=$('people');s.innerHTML=`<option value="">${copy.selectPeople}</option>`;for(let i=1;i<=Math.min(max,20);i++){const o=document.createElement('option');o.value=String(i);o.textContent=`${i} ${i===1?(lang==='tr'?'Kişi':lang==='es'?'Persona':'Person'):(lang==='tr'?'Kişi':lang==='es'?'Personas':'People')}`;s.appendChild(o)}if(selectedVal)s.value=String(selectedVal)}
function updatePrice(){if(!selected){return}const n=Number($('people').value||0);if(runtimePriceMode==='ask'){$('unit').textContent=copy.ask;$('total').textContent=copy.ask;return}const unit=Number(selected.price||product?.default_price||0);$('unit').textContent=money(unit);$('total').textContent=runtimePriceMode==='group'?money(unit):(n?money(unit*n):'—')}
function choose(r,k,people=''){selected=r;selKey=k;$('date').value=display(k);fillPeople(rem(r),people);$('priceBox').classList.add('show');updatePrice();$('calendar').classList.remove('open');render()}
$('date').onclick=$('calOpen').onclick=async()=>{$('calendar').classList.add('open');await loadMonth()};$('prev').onclick=async()=>{cm--;if(cm<0){cm=11;cy--}await loadMonth()};$('next').onclick=async()=>{cm++;if(cm>11){cm=0;cy++}await loadMonth()};$('people').onchange=updatePrice;
document.addEventListener('click',e=>{if(!$('calendar').contains(e.target)&&e.target!==$('date')&&e.target!==$('calOpen'))$('calendar').classList.remove('open')});
$('langBtn').onclick=()=>document.querySelector('.lang').classList.toggle('open');
const iti=window.intlTelInput?window.intlTelInput($('phone'),{initialCountry:'tr',separateDialCode:true,nationalMode:false,preferredCountries:['tr','us','gb','de','fr','es']}):null;
$('bookingForm').onsubmit=e=>{e.preventDefault();const name=$('name').value.trim(),phone=iti?.getNumber()||$('phone').value,date=$('date').value,people=$('people').value,msg=$('message').value.trim();if(!name||!phone||!date||!people||!selected){alert(copy.alert);return}const unit=Number(selected.price||0),total=runtimePriceMode==='ask'?copy.ask:runtimePriceMode==='group'?money(unit):money(unit*Number(people));const lines=[copy.request,`Tour: ${document.querySelector('h1').textContent}`,`${copy.name}: ${name}`,`${copy.phone}: ${phone}`,`${copy.date}: ${date}`,`${copy.people}: ${people}`,`${runtimePriceMode==='group'?copy.groupPrice:copy.unit}: ${runtimePriceMode==='ask'?copy.ask:money(unit)}`,`${copy.total}: ${total}`,msg?`${copy.message}: ${msg}`:''].filter(Boolean).join('\n');window.open(`https://wa.me/905401015050?text=${encodeURIComponent(lines)}`,'_blank')};
(async()=>{await loadProduct();await loadMonth();const qp=new URLSearchParams(location.search),qd=qp.get('date'),qpeople=Math.max(1,Math.min(20,Number(qp.get('people')||0)));if(qd&&/^\d{4}-\d{2}-\d{2}$/.test(qd)&&product){const [y,m]=qd.split('-').map(Number);cy=y;cm=m-1;await loadMonth();const r=effective(qd);if(available(r))choose(r,qd,qpeople||'')}})().catch(console.error)
</script>
<style>
*{box-sizing:border-box}body{margin:0;font-family:'Plus Jakarta Sans',Arial,sans-serif;color:#071d3b;background:#f7f4ec}.site-header{position:sticky;top:0;z-index:1000;background:#fff;border-bottom:1px solid #e6edf4}.header-container{max-width:1320px;height:88px;margin:auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between;gap:18px}.logo,.head-right,.insta,.wa-head{display:flex;align-items:center}.logo>a:first-child img{width:auto!important;height:70px!important;max-width:145px!important;object-fit:contain!important;display:block}.insta{gap:6px;margin-left:12px;padding:7px 10px;border:1px solid #e4eaf1;border-radius:99px;text-decoration:none;color:#30445d;font-size:10px;font-weight:700}.insta img,.wa-head img,.wa img{width:20px;height:20px;object-fit:contain}.header-container nav{display:flex;gap:20px}.header-container nav a{font-size:12px;font-weight:800;color:#0a1526;text-decoration:none}.head-right{gap:12px}.wa-head{gap:6px;color:#0a1526;text-decoration:none;font-weight:800;font-size:12px}.lang{position:relative}.lang button{border:1px solid #cbd5e1;background:#f8fafc;border-radius:99px;padding:7px 12px;font-weight:800}.lang>div{display:none;position:absolute;right:0;top:42px;background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:6px;min-width:150px;box-shadow:0 14px 30px #0002}.lang.open>div{display:grid}.lang>div a{padding:8px;text-decoration:none;color:#071d3b;border-radius:8px}.lang>div a:hover{background:#f1f5f9}.page{padding:18px 16px 60px}.container{max-width:1240px;margin:auto}.breadcrumb{display:flex;gap:8px;font-size:12px;color:#64748b;margin-bottom:12px}.breadcrumb a{color:#0b4aa2;text-decoration:none}.hero{background:#fff;color:#071d3b;border:1px solid #e7dfd2;box-shadow:0 14px 34px rgba(11,31,58,.07);border-radius:22px;padding:30px 32px;margin-bottom:18px}.kicker{display:inline-block;background:#f5c400;color:#09203d;padding:6px 12px;border-radius:99px;font-size:10px;font-weight:900}.hero h1{font-size:34px;margin:12px 0 8px}.hero p{max-width:950px;line-height:1.72;font-size:14px;color:#64748b}.hero-badges{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.hero-badges span{background:#fff;border:1px solid #d9e0e8;padding:7px 11px;border-radius:99px;font-size:11px;color:#071d3b;box-shadow:0 4px 10px rgba(11,31,58,.04)}.gallery{display:grid;grid-template-columns:2fr 1fr;gap:10px;background:#fff;border:1px solid #e7dfd2;border-radius:22px;padding:10px;margin-bottom:24px;box-shadow:0 14px 34px rgba(11,31,58,.07)}.main-photo{height:380px;position:relative;overflow:hidden;border-radius:14px;border:0;padding:0;background:#f2eee5;cursor:zoom-in}.main-photo img,.side-photos img{width:100%;height:100%;object-fit:cover;display:block}.main-photo span{position:absolute;bottom:12px;left:12px;background:#fff;color:#071d3b;padding:7px 10px;border-radius:99px;font-size:10px;font-weight:800}.side-photos{display:grid;grid-template-columns:1fr 1fr;gap:8px}.side-photos button{border:0;padding:0;background:#f2eee5;border-radius:12px;overflow:hidden;cursor:zoom-in;min-width:0}.side-photos img{min-height:180px;border-radius:12px}.grid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:20px;align-items:start}.card{background:#fff;border:1px solid #e7dfd2;border-radius:22px;box-shadow:0 14px 34px rgba(11,31,58,.07)}.content{padding:30px 32px}.content section{padding-bottom:20px;margin-bottom:20px;border-bottom:1px solid #e3e9f0}.content section:last-child{border:0;margin:0;padding:0}.content h2{font-size:24px;line-height:1.2;margin:0 0 14px;color:#071d3b;letter-spacing:-.02em}.content p{font-size:14px;line-height:1.9;color:#64748b}.checks{display:grid;grid-template-columns:1fr 1fr;gap:9px 16px}.checks>div{display:flex;gap:9px;font-size:13px;line-height:1.62;color:#334155}.checks i{font-style:normal;color:#9a7200;font-weight:900;background:#fff5cf;border-radius:50%;width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;flex:0 0 18px}.side{display:grid;gap:16px;