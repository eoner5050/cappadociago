---
import SeoHead from './SeoHead.astro';
import SiteHeader from './SiteHeader.astro';
import TourFooter from './TourFooter.astro';
import FloatingAssistant from './FloatingAssistant.astro';
import { getTourGallery } from '../utils/tourGallery';
import { existingTourCatalog } from '../data/existingTourCatalog';

const {
  lang = 'en', slug, title, heroDesc, overviewTitle, overviewParagraphs = [], priceTitle, priceText,
  included = [], importantTitle = 'Important Information', important = [], detailsTitle = 'Tour Details', details = [],
  extraSections = [], duration = 'Full Day', rating = '', mainImage, galleryImages = [], priceMode = 'perPerson',
  sidebarBadges = [], sideHighlights = [], reviewCount = 0, seoTitle = '', seoDescription = '', standardPhoneFix = false
} = Astro.props;
const copy = {
  en:{home:'Home',balloon:'Balloon Tours',tours:'Cappadocia Tours',activities:'Activities',private:'Private Tours',transfers:'Transfers',price:'Tour Price, starting from',perPerson:'per person',group:'per group',ask:'Ask for Price',contact:'Contact via WhatsApp',form:'Quick Reservation Form',formDesc:'Leave your details and our team will contact you as soon as possible.',name:'Full Name',phone:'Phone Number',date:'Date',people:'Number of People',selectDate:'Select Date',selectPeople:'Select People',children:'Children are included in this number of people.',message:'Your Message',messagePh:'You can write your additional note.',send:'Send Reservation Request',unit:'Price per person',groupPrice:'Group price',total:'Total price',left:'left',closed:'Closed',sold:'Sold out',loading:'Loading availability...',availability:'Availability',request:'New Reservation Request',alert:'Please complete name, phone, date and number of people before sending.',duration:'Tour Duration',instant:'Instant Confirmation!'},
  tr:{home:'Ana Sayfa',balloon:'Balon Turları',tours:'Kapadokya Turları',activities:'Aktiviteler',private:'Özel Turlar',transfers:'Transferler',price:'Tur Fiyatı, başlayan',perPerson:'kişi başı',group:'grup fiyatı',ask:'Fiyat Sorunuz',contact:'WhatsApp ile İletişim',form:'Hızlı Rezervasyon Formu',formDesc:'Bilgilerinizi bırakın, ekibimiz en kısa sürede sizinle iletişime geçsin.',name:'Ad Soyad',phone:'Telefon Numarası',date:'Tarih',people:'Kişi Sayısı',selectDate:'Tarih Seçin',selectPeople:'Kişi Seçin',children:'Çocuklar da bu kişi sayısına dahildir.',message:'Mesajınız',messagePh:'Ek notunuzu yazabilirsiniz.',send:'Rezervasyon Talebi Gönder',unit:'Kişi başı fiyat',groupPrice:'Grup fiyatı',total:'Toplam fiyat',left:'kaldı',closed:'Kapalı',sold:'Dolu',loading:'Müsaitlik yükleniyor...',availability:'Müsaitlik',request:'Yeni Rezervasyon Talebi',alert:'Lütfen ad, telefon, tarih ve kişi sayısını tamamlayın.',duration:'Tur Süresi',instant:'Anında Onay!'},
  es:{home:'Inicio',balloon:'Tours en Globo',tours:'Tours por Capadocia',activities:'Actividades',private:'Tours Privados',transfers:'Traslados',price:'Precio desde',perPerson:'por persona',group:'por grupo',ask:'Consultar Precio',contact:'Contactar por WhatsApp',form:'Formulario de Reserva Rápida',formDesc:'Déjanos tus datos y nuestro equipo te contactará lo antes posible.',name:'Nombre Completo',phone:'Teléfono',date:'Fecha',people:'Número de Personas',selectDate:'Seleccionar Fecha',selectPeople:'Seleccionar Personas',children:'Los niños están incluidos en este número de personas.',message:'Tu Mensaje',messagePh:'Puedes escribir una nota adicional.',send:'Enviar Solicitud de Reserva',unit:'Precio por persona',groupPrice:'Precio del grupo',total:'Precio total',left:'disponibles',closed:'Cerrado',sold:'Agotado',loading:'Cargando disponibilidad...',availability:'Disponibilidad',request:'Nueva Solicitud de Reserva',alert:'Completa nombre, teléfono, fecha y número de personas.',duration:'Duración',instant:'¡Confirmación Instantánea!'}
}[lang] || null;
const flag = lang==='tr'?'🇹🇷':lang==='es'?'🇪🇸':'🇬🇧';
const code = lang.toUpperCase();
const imgs = getTourGallery({ slug, title, preferred: [mainImage, ...galleryImages], max: 6 });
const preserveMainPhoto = new Set([
  'photo-shoot-flying-dress-experience',
  'jeep-safari-cappadocia',
  'ihlara-valley-balloons-tour'
]).has(String(slug));
const slugCandidates = String(slug)==='goreme-standard-hot-air-balloon-tour'
  ? ['goreme-standard-hot-air-balloon-tour','goreme-standart-hot-air-balloon-tour']
  : String(slug)==='goreme-standart-hot-air-balloon-tour'
    ? ['goreme-standart-hot-air-balloon-tour','goreme-standard-hot-air-balloon-tour']
    : [String(slug)];
const builtInTour:any = existingTourCatalog.find((t:any)=>slugCandidates.includes(String(t.slug)));
const fallbackDefaultPrice = Math.max(0, Number(builtInTour?.price || 0));
const fallbackDefaultCapacity = Math.max(1, Number(builtInTour?.default_capacity || 20));

---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <SeoHead title={seoTitle || `${title} | CappadociaGo`} description={seoDescription || heroDesc || overviewParagraphs[0] || title} lang={lang} />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
<SiteHeader lang={lang} detailSlug={slug} section={/transfer/i.test(String(slug)) ? 'transfers' : 'tours'} />
<main class="page"><div class="container">
  <div class="breadcrumb"><a href={`/${lang}/`}>{copy.home}</a><span>›</span><span>{title}</span></div>
  <section class="hero"><span class="kicker">CAPPADOCIAGO</span><h1>{title}</h1><p>{heroDesc}</p><div class="hero-badges">{rating && <span class="hero-rating"><span class="hero-stars">★★★★★</span><b>{rating}</b>{reviewCount>0 && <><i></i><em>{reviewCount} Reviews</em></>}</span>}<span>⏱ {copy.duration}: {duration}</span><span>⚡ {copy.instant}</span><a class="hero-wa" href="https://wa.me/905401015050" target="_blank" rel="noopener noreferrer"><img src="/images/icons/whatsapp-logo.webp" alt="" width="18" height="18" loading="lazy"/>+90 540 101 50 50</a></div></section>
  {imgs.length>0 && <section class="gallery" data-gallery-root>
    <button class:list={["main-photo", "gallery-click", preserveMainPhoto && "preserve-photo"]} style={preserveMainPhoto ? `--main-photo-bg:url(${JSON.stringify(imgs[0])})` : undefined} type="button" data-gallery-index="0"><img src={imgs[0]} alt={title} width="1200" height="800" loading="lazy" decoding="async" /><span>📁 {imgs.length} {lang==='tr'?'fotoğraf':lang==='es'?'fotos':'photos'}</span></button>
    <div class="side-photos">{imgs.slice(1,5).map((src, i)=> <button type="button" class="gallery-click" data-gallery-index={String(i+1)}><img src={src} alt={title} width="1200" height="800" loading="lazy" decoding="async" /></button>)}</div>
  </section>}
  <div class="gallery-modal" id="galleryModal" aria-hidden="true"><button class="gallery-close" type="button" aria-label="Close">×</button><button class="gallery-prev" type="button" aria-label="Previous">‹</button><img id="galleryModalImg" alt={title} width="1200" height="800" loading="lazy" decoding="async"/><button class="gallery-next" type="button" aria-label="Next">›</button><div class="gallery-count" id="galleryCount"></div></div>
  <div class="grid"><div class="main-col"><section class="card content">
    <section><h2>{overviewTitle}</h2>{overviewParagraphs.map((p)=><p>{p}</p>)}</section>
    <section><h2>{priceTitle}</h2><p>{priceText}</p></section>
    <section><h2>{lang==='tr'?'Fiyata Dahil Olanlar':lang==='es'?'Qué Incluye':'What’s Included'}</h2><div class="checks">{included.map((x)=><div><i>✓</i><span>{x}</span></div>)}</div></section>
    <section><h2>{importantTitle}</h2><div class="checks">{important.map((x)=><div><i>✓</i><span>{x}</span></div>)}</div></section>
    <section><h2>{detailsTitle}</h2>{details.map((p)=><p>{p}</p>)}</section>
    {extraSections.map((s)=><section><h2>{s.title}</h2>{s.paragraphs?.map((p)=><p>{p}</p>)}{s.items && <div class="checks">{s.items.map((x)=><div><i>✓</i><span>{x}</span></div>)}</div>}</section>)}
  </section></div>
  <aside class="side"><section class="card price-card"><span class="label">{copy.price}</span><div class="price"><del id="mainOldPrice"></del><strong id="mainPrice">{priceMode==='ask'?copy.ask:(fallbackDefaultPrice>0?`${fallbackDefaultPrice} €`:'—')}</strong><small id="priceSuffix">{priceMode==='perPerson'?copy.perPerson:priceMode==='group'?copy.group:''}</small></div><a id="askPriceLink" class:list={["ask-price-link",priceMode==='ask'&&"show"]} href={`https://wa.me/905401015050?text=${encodeURIComponent(`Hello CappadociaGo, please send me a price for ${title}.`)}`}>💬 {copy.ask}</a><div class="badges">{sidebarBadges.map((x)=><span>{x}</span>)}</div><hr/><a class="phone" href="tel:+905401015050">📞 +90 540 101 50 50</a><a class="wa" href="https://wa.me/905401015050"><img src="/images/icons/whatsapp-logo.webp" alt="" loading="lazy" width="24" height="24"/>{copy.contact}</a><div class="side-list">{sideHighlights.map((x)=><div>✓ <span>{x}</span></div>)}</div></section>
  <section class="card booking"><h3>{copy.form}</h3><p>{copy.formDesc}</p><form id="bookingForm"><label>{copy.name}<input id="name" required placeholder={copy.name}/></label><label>{copy.phone}<div class:list={["cg-phone-field", standardPhoneFix && "cg-phone-standard-fix"]}><select id="phoneCode" class="cg-phone-code" aria-label="Country code"><option value="+90" selected>🇹🇷 +90</option>
<option value="+1">🇺🇸 +1</option>
<option value="+44">🇬🇧 +44</option>
<option value="+49">🇩🇪 +49</option>
<option value="+33">🇫🇷 +33</option>
<option value="+34">🇪🇸 +34</option>
<option value="+39">🇮🇹 +39</option>
<option value="+31">🇳🇱 +31</option>
<option value="+7">🇷🇺 +7</option>
<option value="+966">🇸🇦 +966</option>
<option value="+971">🇦🇪 +971</option>
<option value="+91">🇮🇳 +91</option></select><input id="phone" class="cg-phone-number" type="tel" inputmode="tel" autocomplete="tel-national" required/></div></label><label>{copy.date}<div class="date-wrap"><input id="date" readonly required placeholder={copy.selectDate}/><button type="button" id="calOpen">📅</button><div id="calendar" class="calendar"><div class="cal-head"><button type="button" id="prev">‹</button><b id="calTitle"></b><button type="button" id="next">›</button></div><div class="week"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div><div id="days" class="days"></div></div></div></label><label>{copy.people}<select id="people" required><option value="">{copy.selectPeople}</option></select><small class="children">{copy.children}</small></label><div id="priceBox" class="price-box"><div><span id="unitLabel">{priceMode==='group'?copy.groupPrice:copy.unit}</span><b id="unit">—</b></div><div><span>{copy.total}</span><strong id="total">—</strong></div></div><label>{copy.message}<textarea id="message" placeholder={copy.messagePh}></textarea></label><button class="submit">{copy.send}</button></form></section></aside></div>
</div></main>
<FloatingAssistant lang={lang} />
<TourFooter lang={lang} />
<script define:vars={{slug,lang,priceMode,copy,fallbackDefaultPrice,fallbackDefaultCapacity}}>
let runtimePriceMode=priceMode;
const $=id=>document.getElementById(id); const months=lang==='tr'?['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık']:lang==='es'?['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre']:['January','February','March','April','May','June','July','August','September','October','November','December'];
let product=null, availability={}, selected=null, selKey='', cm=new Date().getMonth(), cy=new Date().getFullYear();
const pad=n=>String(n).padStart(2,'0'), key=(y,m,d)=>`${y}-${pad(m+1)}-${pad(d)}`, display=k=>{const [y,m,d]=k.split('-');return `${d}.${m}.${y}`}, money=v=>`${Number(v||0).toLocaleString(lang==='tr'?'tr-TR':lang==='es'?'es-ES':'en-US',{maximumFractionDigits:2})} €`, rem=r=>Math.max(Number(r?.capacity||0)-Number(r?.booked||0),0);
async function pricingApi(month=''){
  const qs=new URLSearchParams({slug});if(month)qs.set('month',month);
  const r=await fetch(`/api/public/tour-pricing?${qs.toString()}`,{cache:'no-store'});
  if(!r.ok){const t=await r.text();throw new Error(t||`Pricing API ${r.status}`)}
  return r.json();
}
function effective(k){const base={date:k,price:Number(product?.default_price||fallbackDefaultPrice||0),capacity:Number(product?.default_capacity||fallbackDefaultCapacity||20),booked:0,status:'available',_default:true};const row=availability[k];if(!row)return base;return {...row,price:Number(row.price||0)>0?Number(row.price):base.price,capacity:Number(row.capacity||0)>0?Number(row.capacity):base.capacity,booked:Math.max(0,Number(row.booked||0)),status:row.status||'available'} }
function available(r){return r&&r.status==='available'&&Number(r.capacity)>0&&rem(r)>0}
async function loadProduct(){
  try{
    const data=await pricingApi();
    product=data.product||null;
    if(!product) throw new Error('No pricing product');
    if(product.ask_for_price)runtimePriceMode='ask';
    if(runtimePriceMode==='ask'){
      $('mainPrice').textContent=copy.ask;
      const old=$('mainOldPrice');if(old){old.textContent='';old.classList.remove('has-price')}
      const suf=$('priceSuffix');if(suf)suf.style.display='none';
      $('askPriceLink')?.classList.add('show');return;
    }
    const visibleDefault=Number(data.defaultPrice||product.default_price||fallbackDefaultPrice||0);
    $('mainPrice').textContent=visibleDefault>0?money(visibleDefault):'—';
    const old=$('mainOldPrice');if(old){if(visibleDefault>0){old.textContent=money(Math.round(visibleDefault*1.20));old.classList.add('has-price')}else{old.textContent='';old.classList.remove('has-price')}}
  }catch(err){
    console.error('Pricing API fallback:',err);
    product={id:null,slug,default_price:Number(fallbackDefaultPrice||0),default_capacity:Number(fallbackDefaultCapacity||20),ask_for_price:priceMode==='ask'};
    runtimePriceMode=priceMode;
    const visibleDefault=Number(fallbackDefaultPrice||0);
    $('mainPrice').textContent=runtimePriceMode==='ask'?copy.ask:(visibleDefault>0?money(visibleDefault):'—');
    const old=$('mainOldPrice');if(old){if(visibleDefault>0&&runtimePriceMode!=='ask'){old.textContent=money(Math.round(visibleDefault*1.20));old.classList.add('has-price')}else{old.textContent='';old.classList.remove('has-price')}}
  }
}
async function loadMonth(){
  if(!product){
    product={id:null,slug,default_price:Number(fallbackDefaultPrice||0),default_capacity:Number(fallbackDefaultCapacity||20),ask_for_price:priceMode==='ask'};
  }
  try{
    const data=await pricingApi(`${cy}-${pad(cm+1)}`);
    if(data?.product) product={...product,...data.product};
    availability={};(data.availability||[]).forEach(r=>availability[r.date]=r);
  }catch(err){
    console.error('Calendar API fallback:',err);
    availability={};
  }
  render();
}
function render(){$('days').innerHTML='';$('calTitle').textContent=`${months[cm]} ${cy}`;let off=new Date(cy,cm,1).getDay();off=off===0?6:off-1;for(let i=0;i<off;i++)$('days').insertAdjacentHTML('beforeend','<button class="day empty" disabled></button>');const last=new Date(cy,cm+1,0).getDate();for(let d=1;d<=last;d++){const k=key(cy,cm,d),r=effective(k),past=new Date(cy,cm,d)<new Date(new Date().setHours(0,0,0,0)),ok=!past&&available(r),b=document.createElement('button');b.type='button';b.className=`day ${ok?'':'disabled'} ${k===selKey?'selected':''}`;b.disabled=!ok;const status=r.status==='closed'?copy.closed:rem(r)<=0?copy.sold:`${rem(r)} ${copy.left}`;b.innerHTML=`<b>${d}</b>${runtimePriceMode==='ask'?'':`<span>${money(r.price)}</span>`}<small>${status}</small>`;if(ok)b.onclick=()=>choose(r,k);$('days').appendChild(b)}}
function fillPeople(max,selectedVal=''){const s=$('people');s.innerHTML=`<option value="">${copy.selectPeople}</option>`;for(let i=1;i<=Math.min(max,20);i++){const o=document.createElement('option');o.value=String(i);o.textContent=`${i} ${i===1?(lang==='tr'?'Kişi':lang==='es'?'Persona':'Person'):(lang==='tr'?'Kişi':lang==='es'?'Personas':'People')}`;s.appendChild(o)}if(selectedVal)s.value=String(selectedVal)}
function updatePrice(){if(!selected){return}const n=Number($('people').value||0);if(runtimePriceMode==='ask'){$('unit').textContent=copy.ask;$('total').textContent=copy.ask;return}const unit=Number(selected.price||product?.default_price||0);$('unit').textContent=money(unit);$('total').textContent=runtimePriceMode==='group'?money(unit):(n?money(unit*n):'—')}
function choose(r,k,people=''){selected=r;selKey=k;$('date').value=display(k);fillPeople(rem(r),people);$('priceBox').classList.add('show');updatePrice();$('calendar').classList.remove('open');render()}
$('date').onclick=$('calOpen').onclick=async()=>{$('calendar').classList.add('open');await loadMonth()};$('prev').onclick=async()=>{cm--;if(cm<0){cm=11;cy--}await loadMonth()};$('next').onclick=async()=>{cm++;if(cm>11){cm=0;cy++}await loadMonth()};$('people').onchange=updatePrice;
document.addEventListener('click',e=>{if(!$('calendar').contains(e.target)&&e.target!==$('date')&&e.target!==$('calOpen'))$('calendar').classList.remove('open')});
$('langBtn').onclick=()=>document.querySelector('.lang').classList.toggle('open');
const iti=null;
$('bookingForm').onsubmit=e=>{e.preventDefault();const name=$('name').value.trim(),phone=((document.getElementById('phoneCode')?.value||'+90')+' '+$('phone').value.trim()).trim(),date=$('date').value,people=$('people').value,msg=$('message').value.trim();if(!name||!phone||!date||!people||!selected){alert(copy.alert);return}const unit=Number(selected.price||0),total=runtimePriceMode==='ask'?copy.ask:runtimePriceMode==='group'?money(unit):money(unit*Number(people));const lines=[copy.request,`Tour: ${document.querySelector('h1').textContent}`,`${copy.name}: ${name}`,`${copy.phone}: ${phone}`,`${copy.date}: ${date}`,`${copy.people}: ${people}`,`${runtimePriceMode==='group'?copy.groupPrice:copy.unit}: ${runtimePriceMode==='ask'?copy.ask:money(unit)}`,`${copy.total}: ${total}`,msg?`${copy.message}: ${msg}`:''].filter(Boolean).join('\n');window.open(`https://wa.me/905401015050?text=${encodeURIComponent(lines)}`,'_blank')};
(async()=>{await loadProduct();await loadMonth();const qp=new URLSearchParams(location.search),qd=qp.get('date'),qpeople=Math.max(1,Math.min(20,Number(qp.get('people')||0)));if(qd&&/^\d{4}-\d{2}-\d{2}$/.test(qd)&&product){const [y,m]=qd.split('-').map(Number);cy=y;cm=m-1;await loadMonth();const r=effective(qd);if(available(r))choose(r,qd,qpeople||'')}})().catch(console.error)
</script>
<style is:inline>
:root{--cg-navy:#0b3158;--cg-navy2:#082746;--cg-blue:#0b6eb8;--cg-gold:#dfa913;--cg-bg:#eef5fa;--cg-card:#fff;--cg-line:#d8e4ed;--cg-text:#51657a;--cg-ink:#0b2340}
*{box-sizing:border-box}
html,body{margin:0;background:linear-gradient(180deg,#eef5fa 0%,#f7fafc 60%,#f2f6f9 100%);color:var(--cg-ink);font-family:'Plus Jakarta Sans',Arial,sans-serif}
.page{padding:22px 14px 64px;background:transparent}
.container{width:min(1180px,100%);margin:0 auto}
.breadcrumb{display:flex;gap:8px;align-items:center;margin:0 0 13px;font-size:11px;color:#718398}
.breadcrumb a{color:#075aa6;text-decoration:none;font-weight:700}
.hero{position:relative;overflow:hidden;margin:0 0 20px;padding:31px 32px 27px;border:1px solid rgba(255,255,255,.12);border-radius:24px;background:linear-gradient(120deg,#143f69 0%,#0b3158 58%,#082746 100%);box-shadow:0 16px 38px rgba(8,44,80,.16);color:#fff}
.hero:after{content:'';position:absolute;right:-75px;top:-105px;width:290px;height:290px;border-radius:50%;background:radial-gradient(circle,rgba(223,169,19,.18),transparent 70%);pointer-events:none}
.kicker{position:relative;z-index:1;display:inline-flex;align-items:center;padding:7px 13px;border:1px solid rgba(238,190,64,.68);border-radius:999px;background:rgba(255,255,255,.08);color:#ffd96d;font-size:9px;font-weight:900;letter-spacing:.1em;line-height:1}
.hero h1{position:relative;z-index:1;margin:14px 0 9px;max-width:980px;color:#fff!important;-webkit-text-fill-color:#fff!important;font-family:'Fraunces','Plus Jakarta Sans',Georgia,serif;font-size:clamp(32px,4vw,50px);font-weight:700;line-height:1.04;letter-spacing:-.045em;text-shadow:none;opacity:1!important;visibility:visible!important}
.hero>p{position:relative;z-index:1;display:block;max-width:940px;margin:0;color:rgba(255,255,255,.84)!important;-webkit-text-fill-color:rgba(255,255,255,.84)!important;font-size:13px;line-height:1.7;opacity:1!important;visibility:visible!important}
.hero-badges{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:8px;margin-top:18px;padding-top:15px;border-top:1px solid rgba(255,255,255,.18)}
.hero-badges>span,.hero-badges>a{display:inline-flex;align-items:center;gap:6px;min-height:34px;padding:7px 12px;border:1px solid rgba(255,255,255,.22);border-radius:999px;background:#fff;color:#0b3158!important;-webkit-text-fill-color:#0b3158!important;font-size:10px;font-weight:700;text-decoration:none}
.hero-stars{color:#e4ad19!important;-webkit-text-fill-color:#e4ad19!important}.hero-rating i{width:1px;height:14px;background:#d7e1ea}.hero-rating em{font-style:normal}
.gallery{display:grid;grid-template-columns:2fr 1fr;gap:8px;margin:0 0 22px;padding:8px;border:1px solid var(--cg-line);border-radius:22px;background:#fff;box-shadow:0 12px 30px rgba(9,47,86,.07);overflow:hidden}
.main-photo{position:relative;height:365px;padding:0;border:0;border-radius:15px;overflow:hidden;background:#edf2f5;cursor:pointer}.main-photo img,.side-photos img{display:block;width:100%;height:100%;object-fit:cover}.main-photo>span{position:absolute;left:12px;bottom:12px;padding:7px 10px;border-radius:999px;background:#fff;color:#0b3158;font-size:10px;font-weight:800}
.side-photos{display:grid;grid-template-columns:1fr 1fr;gap:8px;height:365px}.side-photos button{min-width:0;padding:0;border:0;border-radius:12px;overflow:hidden;background:#edf2f5}.side-photos img{min-width:0;min-height:0}
.grid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:20px;align-items:start}
.main-col,.side{min-width:0}.side{display:grid;gap:16px;position:sticky;top:100px}
.card{border:1px solid var(--cg-line);border-radius:22px;background:#fff;box-shadow:0 12px 30px rgba(9,47,86,.065)}
.content{padding:0;overflow:hidden}.content>section{margin:0;padding:23px 25px;border-bottom:1px solid #e8eef3}.content>section:last-child{border-bottom:0}.content h2{margin:0 0 12px;color:#0b2340;font-family:'Fraunces','Plus Jakarta Sans',Georgia,serif;font-size:21px;line-height:1.18;letter-spacing:-.028em}.content p{margin:0 0 10px;color:var(--cg-text);font-size:12.5px;line-height:1.78}.content p:last-child{margin-bottom:0}
.checks{display:grid;grid-template-columns:1fr 1fr;gap:10px 15px}.checks>div{display:flex;gap:9px;align-items:flex-start;color:#40566d;font-size:11.5px;line-height:1.55}.checks i{display:inline-flex;align-items:center;justify-content:center;flex:0 0 18px;width:18px;height:18px;border-radius:50%;background:#eef7fd;color:#0b6eb8;font-style:normal;font-weight:900}
.price-card,.booking{padding:20px}.price-card{border-top:4px solid var(--cg-gold)}.price-card .label{display:block;margin-bottom:5px;color:#7890a4;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.price{display:flex;align-items:flex-end;gap:8px;margin:5px 0 10px}.price del{display:none;padding-bottom:4px;color:#98a5b2;font-size:14px;font-weight:700}.price del.has-price{display:inline}.price strong{color:#d69f0c;font-size:32px;line-height:1;font-weight:900}.price small{padding-bottom:4px;color:#72859a;font-size:9px;font-weight:700}.ask-price-link{display:none}.ask-price-link.show{display:flex;justify-content:center;padding:10px;border-radius:12px;background:#0b6eb8;color:#fff;text-decoration:none;font-size:11px;font-weight:800}.badges{display:flex;flex-wrap:wrap;gap:6px;margin:9px 0 15px}.badges span{padding:5px 8px;border:1px solid #ecd99c;border-radius:999px;background:#fff9e8;color:#7b5a06;font-size:8px;font-weight:800}.price-card hr{border:0;border-top:1px solid #e5ebf0;margin:14px 0}.price-card .phone,.price-card .wa{display:flex;align-items:center;justify-content:center;width:100%;min-height:41px;border:1px solid #cbdce8;border-radius:13px;background:#fff;color:#0b3158;text-decoration:none;font-size:9px;font-weight:800}.price-card .wa{gap:7px;margin-top:8px;border-color:#b7e3cb;background:#f0fbf5;color:#147144}.price-card .wa img{width:17px;height:17px}.side-list{display:grid;gap:10px;margin-top:15px}.side-list>div{display:flex;gap:8px;color:#52677b;font-size:9.5px;line-height:1.5}.side-list>div:first-letter{color:#d9a211}
.booking{border-top:4px solid #0b6eb8}.booking h3{margin:0 0 5px;color:#0b2340;font-family:'Fraunces','Plus Jakarta Sans',Georgia,serif;font-size:19px;line-height:1.2}.booking>p{margin:0 0 14px;color:#71859a;font-size:10px;line-height:1.55}.booking form{display:grid;gap:11px}.booking label{display:grid;gap:5px;color:#33495f;font-size:10px;font-weight:800}.booking input:not(.cg-phone-number),.booking select:not(.cg-phone-code),.booking textarea{width:100%;min-width:0;min-height:44px;padding:10px 12px;border:1px solid #cbd8e5;border-radius:13px;background:#fff;color:#12314f;font:500 12px/1.3 'Plus Jakarta Sans',Arial,sans-serif;outline:none}.booking textarea{min-height:88px;resize:vertical}.booking input:focus,.booking select:focus,.booking textarea:focus{border-color:#0b6eb8;box-shadow:0 0 0 3px rgba(11,110,184,.10)}
.cg-phone-field{display:flex!important;align-items:stretch!important;width:100%!important;min-width:0!important;height:46px!important;border:1px solid #cbd8e5!important;border-radius:13px!important;background:#fff!important;overflow:hidden!important;direction:ltr!important}.cg-phone-field:focus-within{border-color:#0b6eb8!important;box-shadow:0 0 0 3px rgba(11,110,184,.10)!important}.cg-phone-field .cg-phone-code{display:block!important;flex:0 0 104px!important;width:104px!important;min-width:104px!important;max-width:104px!important;height:44px!important;margin:0!important;padding:0 9px!important;border:0!important;border-right:1px solid #dbe4ec!important;border-radius:0!important;background:#f7fbfe!important;color:#12314f!important;-webkit-text-fill-color:#12314f!important;font:800 11px/44px 'Plus Jakarta Sans',Arial,sans-serif!important;text-align:left!important;direction:ltr!important;outline:none!important;box-shadow:none!important}.cg-phone-field .cg-phone-number{display:block!important;flex:1 1 auto!important;width:auto!important;min-width:0!important;max-width:none!important;height:44px!important;min-height:44px!important;margin:0!important;padding:0 12px!important;border:0!important;border-radius:0!important;background:#fff!important;color:#12314f!important;-webkit-text-fill-color:#12314f!important;caret-color:#12314f!important;font:600 13px/44px 'Plus Jakarta Sans',Arial,sans-serif!important;text-align:left!important;direction:ltr!important;unicode-bidi:plaintext!important;letter-spacing:0!important;text-indent:0!important;transform:none!important;outline:none!important;box-shadow:none!important}.cg-phone-field .cg-phone-number::placeholder{color:#94a6b7!important;-webkit-text-fill-color:#94a6b7!important}.cg-phone-field .cg-phone-code:focus,.cg-phone-field .cg-phone-number:focus{outline:none!important;box-shadow:none!important}
.date-wrap{position:relative}.date-wrap>input{padding-right:48px!important}.date-wrap>button{position:absolute;right:6px;top:5px;width:34px;height:34px;border:0;border-radius:10px;background:#fff7df;cursor:pointer}.calendar{display:none;position:absolute;right:0;top:52px;z-index:9999;width:360px;max-width:calc(100vw - 28px);padding:14px;border:1px solid #cbdce8;border-top:4px solid var(--cg-gold);border-radius:18px;background:#fff;box-shadow:0 20px 48px rgba(8,44,80,.20)}.calendar.open{display:block}.cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}.cal-head button{width:34px;height:34px;border:0;border-radius:10px;background:#eef7fd;color:#075aa6;font-size:19px}.cal-head b{color:#0b3158;font-size:13px}.week,.days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}.week span{text-align:center;color:#71859a;font-size:8px;font-weight:800}.day{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;min-height:55px;padding:4px 1px;border:1px solid #e0e9f0;border-radius:9px;background:#f8fbfd;color:#0b3158;overflow:hidden}.day b{font-size:11px}.day span{margin-top:2px;color:#c48f08;font-size:8px;font-weight:800;white-space:nowrap}.day small{margin-top:2px;color:#198d50;font-size:6.5px;font-weight:700;white-space:nowrap}.day.disabled{opacity:.38}.day.selected{border-color:#0b6eb8;background:#0b6eb8;color:#fff}.day.selected span,.day.selected small{color:#fff}.day.empty{visibility:hidden}.children{color:#73869a;font-size:9px;font-weight:500}.price-box{display:none;padding:11px;border:1px solid #d4e2eb;border-radius:12px;background:#f6fbff}.price-box.show{display:grid;gap:6px}.price-box>div{display:flex;justify-content:space-between;gap:8px;font-size:10px;color:#52677b}.price-box b,.price-box strong{color:#0b3158}.submit{min-height:45px;border:0;border-radius:999px;background:linear-gradient(135deg,#0b6eb8,#1488cf);color:#fff;font-size:12px;font-weight:900;cursor:pointer}
.gallery-modal{display:none;position:fixed;inset:0;z-index:10000;background:rgba(3,15,28,.92);align-items:center;justify-content:center}.gallery-modal.open{display:flex}.gallery-modal img{max-width:min(1100px,88vw);max-height:82vh;object-fit:contain}.gallery-close,.gallery-prev,.gallery-next{position:absolute;border:0;border-radius:50%;background:#fff;color:#0b3158;cursor:pointer}.gallery-close{right:24px;top:24px;width:42px;height:42px;font-size:26px}.gallery-prev,.gallery-next{top:50%;width:44px;height:44px;font-size:28px}.gallery-prev{left:24px}.gallery-next{right:24px}.gallery-count{position:absolute;bottom:24px;color:#fff;font-size:12px}
