@media(max-width:640px){.page{padding:14px 10px 44px}.hero{padding:23px 18px 21px;border-radius:18px}.hero h1{font-size:29px;line-height:1.06}.hero>p{font-size:12px;line-height:1.65}.hero-badges{gap:6px}.hero-badges>span,.hero-badges>a{min-height:30px;padding:6px 9px;font-size:8.5px}.gallery{padding:6px;border-radius:17px}.main-photo{height:245px}.side-photos{grid-template-columns:1fr 1fr}.side-photos button{height:105px}.content>section{padding:19px 17px}.content h2{font-size:19px}.content p{font-size:11.5px}.price-card,.booking{padding:18px}.cg-phone-field .cg-phone-code{flex-basis:100px!important;width:100px!important;min-width:100px!important;max-width:100px!important}.cg-phone-field .cg-phone-number{padding:0 11px!important;font-size:12.5px!important}.calendar.open{position:fixed;left:50%;right:auto;top:50%;transform:translate(-50%,-50%);width:min(360px,calc(100vw - 20px));max-height:calc(100vh - 24px);overflow:auto}}

/* Standard balloon only: lock country-code + number into a true two-column field. */
.cg-phone-field.cg-phone-standard-fix{display:grid!important;grid-template-columns:104px minmax(0,1fr)!important;align-items:stretch!important;width:100%!important;height:46px!important;min-width:0!important;overflow:hidden!important;direction:ltr!important}
.cg-phone-field.cg-phone-standard-fix .cg-phone-code{grid-column:1!important;width:104px!important;min-width:104px!important;max-width:104px!important;height:44px!important;box-sizing:border-box!important;margin:0!important;padding:0 8px!important;position:relative!important;inset:auto!important;transform:none!important;text-align:left!important;direction:ltr!important}
.cg-phone-field.cg-phone-standard-fix .cg-phone-number{grid-column:2!important;width:100%!important;min-width:0!important;max-width:100%!important;height:44px!important;box-sizing:border-box!important;margin:0!important;padding:0 12px!important;position:relative!important;inset:auto!important;left:auto!important;right:auto!important;transform:none!important;text-align:left!important;direction:ltr!important;unicode-bidi:normal!important;writing-mode:horizontal-tb!important;overflow:hidden!important}
@media(max-width:640px){.cg-phone-field.cg-phone-standard-fix{grid-template-columns:100px minmax(0,1fr)!important}.cg-phone-field.cg-phone-standard-fix .cg-phone-code{width:100px!important;min-width:100px!important;max-width:100px!important}.cg-phone-field.cg-phone-standard-fix .cg-phone-number{width:100%!important;padding:0 11px!important}}
</style>
