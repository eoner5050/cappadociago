     25 REVIEW SLIDER — OLD CARD STYLE / 4 CARDS PER VIEW
  ========================================================= */
  .tbc-combined-review-section {
    background: linear-gradient(180deg, #f5fbf8 0%, #f4f7fb 100%);
    border-top: 1px solid #e1ebe7;
    border-bottom: 1px solid #e1e8ef;
