    letter-spacing: 1px;
  }

  .tbc-google-stars {
    color: #e8ad00 !important;
    letter-spacing: 1px;
  }

  .tbc-25-track .rev-comment {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    overflow: hidden;
    margin-bottom: 0;
  }

  .tbc-review-counter {
    margin-top: 10px;
    text-align: center;
    color: #7c8a9c;
    font-size: 11px;
  }

  .tbc-review-counter > span:first-child {
