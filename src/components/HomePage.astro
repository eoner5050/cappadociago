const socialImage = `${siteOrigin}/images/tours/tbc-goreme-standart-hot-air-balloon-tour.webp`;

function resolveTourCardImage(tour) {
  const href = String(tour?.href || "");
  const slug = href.split("/").filter(Boolean).pop() || String(tour?.title || "");
  return getTourGallery({
    slug,
    title: String(tour?.title || ""),
    preferred: [tour?.image].filter(Boolean),
    max: 1
  })[0] || tour?.image || getSiteGallery(1)[0] || "/images/tours/tbc-goreme-standart-hot-air-balloon-tour.webp";
}

function resolveProductSlug(tour) {
  const href = String(tour?.href || "");
  const title = String(tour?.title || "");
  const titleMap: Record<string, string> = {
    "ATV Tour With Göreme Valleys": "atv-tour-with-goreme-valleys",
    "Göreme Vadileri ATV Turu": "atv-tour-with-goreme-valleys",
    "Tour ATV por los Valles de Göreme": "atv-tour-with-goreme-valleys",
    "Private VIP Airport Transfer Cappadocia": "private-airport-transfer",
    "Kapadokya Özel VIP Havalimanı Transferi": "private-airport-transfer",
    "Traslado VIP Privado al Aeropuerto de Capadocia": "private-airport-transfer",
    "Göreme Standard Hot Air Balloon Tour": "goreme-standart-hot-air-balloon-tour",
    "Göreme Standart Hot Air Balloon Tour": "goreme-standart-hot-air-balloon-tour",
    "Göreme Comfort Hot Air Balloon Tour": "goreme-comfort-hot-air-balloon-tour",
    "Blue Tour Cappadocia": "blue-tour-cappadocia"
  };
  if (titleMap[title]) return titleMap[title];
  return href.split("/").filter(Boolean).pop() || "";
}



const faqContent = {
  en: {
    title: "Frequently Asked Questions About Cappadocia Tours",
    items: [
      ["When do hot air balloons fly in Cappadocia?", "Hot air balloons in Cappadocia typically operate in two morning sessions around sunrise. Hotel pickup is generally arranged about one hour before the assigned flight, and the exact pickup time is shared one day before according to weather, wind direction and hotel location."],
      ["How high do hot air balloons fly in Cappadocia?", "Hot air balloons can rise up to approximately 8,000 ft (2,400 m), depending on wind and weather conditions."],
      ["How safe is hot air ballooning with CappadociaGo?", "Hot air ballooning is strictly regulated in Turkey by the Civil Aviation Authority (SHGM). Flights operate only when weather and wind conditions are suitable, and certified operators follow required safety procedures."],
      ["Are hot air balloons insured?", "Yes. Balloon operators in Turkey are required to carry comprehensive insurance, and passenger insurance is included in the flight ticket."],
      ["What if my flight gets cancelled due to bad weather?", "If civil aviation authorities cancel a flight because of unsafe weather, you can receive a full refund or, subject to availability, move your reservation to another suitable date."],
      ["Can I change my flight date?", "Yes. Date changes can be requested subject to seat availability. Seasonal price differences or a reissue fee may apply for the new date."],
      ["Where exactly do we fly from and through?", "The take-off point is selected according to the morning wind. Typical routes may pass over Göreme, Paşabağ, Çavuşin, Rose Valley, Love Valley, Swords Valley and Kızılçukur Valley."],
      ["Do I need to pay a cancellation fee for voluntary cancellations?", "Voluntary cancellation conditions depend on how long before the activity you cancel. The applicable timelines and deductions are explained in the Distance Sales Agreement."],
      ["Can I update my hotel pick-up location later?", "Yes. Contact our support team before the flight to update your pickup location, provided the new address is within our standard Cappadocia service area."],
      ["What other daily tours and activities do you offer?", "Our portfolio includes Red, Green and Blue Tours, ATV and Jeep Safaris, horse riding, Turkish Night experiences, cultural activities and airport or private transfer services."],
      ["What are the important safety rules before the flight?", "Listen carefully to the pilot's safety briefing and follow all instructions. In particular, use the correct landing position exactly as explained before touchdown."]
    ]
  },
  tr: {
    title: "Kapadokya Turları Hakkında Sıkça Sorulan Sorular",
    items: [
      ["Kapadokya'da sıcak hava balonları ne zaman uçar?", "Balon uçuşları genellikle gün doğumu çevresindeki iki sabah seansında yapılır. Otel alımı çoğunlukla uçuş saatinden yaklaşık bir saat önce planlanır; kesin saat hava, rüzgâr ve otel konumuna göre bir gün önce bildirilir."],
      ["Sıcak hava balonları ne kadar yükselir?", "Rüzgâr ve hava koşullarına bağlı olarak balonlar yaklaşık 8.000 ft (2.400 m) seviyesine kadar yükselebilir."],
      ["CappadociaGo ile balon uçuşu güvenli mi?", "Türkiye'deki balon uçuşları Sivil Havacılık Genel Müdürlüğü (SHGM) tarafından sıkı şekilde düzenlenir. Uçuşlar yalnızca uygun hava ve rüzgâr koşullarında, yetkili operatörlerle gerçekleştirilir."],
      ["Balon uçuşlarında sigorta var mı?", "Evet. Türkiye'deki balon işletmelerinin kapsamlı sigorta bulundurması zorunludur ve yolcu sigortası uçuş biletine dahildir."],
      ["Kötü hava nedeniyle uçuş iptal edilirse ne olur?", "Sivil havacılık otoriteleri uçuşu güvenli olmayan hava nedeniyle iptal ederse tam iade alabilir veya müsaitliğe bağlı olarak rezervasyonunuzu başka bir tarihe taşıyabilirsiniz."],
      ["Uçuş tarihimi değiştirebilir miyim?", "Evet. Koltuk müsaitliğine bağlı olarak tarih değişikliği talep edebilirsiniz. Yeni tarihte sezon fiyat farkı veya yeniden düzenleme ücreti uygulanabilir."],
      ["Tam olarak nereden kalkıyor ve nerelerin üzerinden uçuyoruz?", "Kalkış noktası sabah rüzgârına göre belirlenir. Rota Göreme, Paşabağ, Çavuşin, Gül Vadisi, Aşk Vadisi, Kılıçlar Vadisi ve Kızılçukur gibi bölgelerin üzerinden geçebilir."],
      ["Kendi isteğimle iptal edersem ücret öder miyim?", "Gönüllü iptal koşulları, aktiviteye ne kadar süre kala iptal ettiğinize göre değişir. Süreler ve olası kesintiler Mesafeli Satış Sözleşmesi'nde açıklanmıştır."],
      ["Otel alma konumumu daha sonra değiştirebilir miyim?", "Evet. Yeni adres standart Kapadokya servis bölgemiz içindeyse uçuş öncesinde destek ekibimizle iletişime geçerek güncelleyebilirsiniz."],
      ["Başka hangi günlük turlar ve aktiviteler var?", "Red, Green ve Blue Tour; ATV ve Jeep Safari; at turu; Türk Gecesi; kültürel aktiviteler ve havaalanı/özel transfer hizmetleri sunuyoruz."],
      ["Uçuş öncesinde dikkat edilmesi gereken güvenlik kuralları nelerdir?", "Pilotun güvenlik brifingini dikkatle dinleyin ve tüm talimatlara uyun. Özellikle iniş öncesinde anlatılan doğru iniş pozisyonunu uygulayın."]
    ]
  },
  es: {
    title: "Preguntas Frecuentes Sobre Tours en Capadocia",
    items: [
      ["¿Cuándo vuelan los globos aerostáticos en Capadocia?", "Los vuelos suelen operar en dos sesiones por la mañana alrededor del amanecer. La recogida en el hotel normalmente se organiza aproximadamente una hora antes y la hora exacta se confirma el día anterior según el clima, el viento y la ubicación del hotel."],
      ["¿A qué altura vuelan los globos aerostáticos?", "Dependiendo del viento y del clima, los globos pueden alcanzar aproximadamente 8.000 pies (2.400 m)."],
      ["¿Es seguro volar en globo con CappadociaGo?", "Los vuelos en globo en Turquía están estrictamente regulados por la Autoridad de Aviación Civil (SHGM). Solo se opera con condiciones meteorológicas adecuadas y operadores autorizados."],
      ["¿Los vuelos en globo están asegurados?", "Sí. Los operadores de globos en Turquía deben contar con un seguro completo y el seguro de pasajeros está incluido en el billete."],
      ["¿Qué ocurre si mi vuelo se cancela por mal tiempo?", "Si las autoridades cancelan el vuelo por condiciones inseguras, puedes recibir un reembolso completo o cambiar la reserva a otra fecha, sujeto a disponibilidad."],
      ["¿Puedo cambiar la fecha de mi vuelo?", "Sí. Puedes solicitar un cambio de fecha sujeto a disponibilidad. Puede aplicarse una diferencia de tarifa estacional o una tasa de reemisión."],
      ["¿Desde dónde despegamos y por dónde volamos?", "El punto de despegue se elige según el viento de la mañana. Las rutas habituales pueden pasar por Göreme, Paşabağ, Çavuşin, Rose Valley, Love Valley, Swords Valley y Kızılçukur."],
      ["¿Hay una tasa si cancelo voluntariamente?", "Las condiciones dependen de cuánto tiempo antes de la actividad canceles. Los plazos y posibles deducciones se detallan en el Contrato de Venta a Distancia."],
      ["¿Puedo cambiar después el lugar de recogida del hotel?", "Sí. Contacta con nuestro equipo antes del vuelo para actualizarlo, siempre que la nueva dirección esté dentro de nuestra zona estándar de servicio en Capadocia."],
      ["¿Qué otros tours y actividades ofrecen?", "Ofrecemos Red, Green y Blue Tour, safaris en ATV y Jeep, paseos a caballo, Noche Turca, experiencias culturales y traslados privados o de aeropuerto."],
      ["¿Cuáles son las reglas de seguridad más importantes?", "Escucha atentamente la charla de seguridad del piloto y sigue todas las instrucciones, especialmente la posición de aterrizaje indicada antes de tocar tierra."]
    ]
  }
};
const faq = faqContent[lang] || faqContent.en;

const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "TravelAgency"],
      "@id": `${siteOrigin}/#organization`,
      "name": "CappadociaGo",
      "url": siteOrigin,
      "logo": `${siteOrigin}/images/logo.png`,
      "image": socialImage,
      "telephone": "+90 540 101 50 50",
      "email": "info@kapheratravel.com",
      "sameAs": [
        "https://www.instagram.com/cappadociago/"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      "url": siteOrigin,
      "name": "CappadociaGo",
      "publisher": { "@id": `${siteOrigin}/#organization` },
      "inLanguage": ["en", "tr", "es"]
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": seo.title,
      "description": seo.description,
      "isPartOf": { "@id": `${siteOrigin}/#website` },
      "about": { "@id": `${siteOrigin}/#organization` },
      "primaryImageOfPage": { "@type": "ImageObject", "url": socialImage },
      "inLanguage": lang
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqContent[lang]?.items?.map(([question, answer]) => ({
        "@type": "Question",
        "name": question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": answer
        }
      })) || faqContent.en.items.map(([question, answer]) => ({
        "@type": "Question",
        "name": question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": answer
        }
      }))
    }
  ]
};


