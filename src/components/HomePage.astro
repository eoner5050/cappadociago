  .icon-circle { width: 30px; height: 30px; border-radius: 0; display: flex; align-items: center; justify-content: center; font-size: 15px; flex: 0 0 30px; }
  .icon-clean { background: transparent !important; box-shadow: none !important; }
  .contact-icon-img, .contact-whatsapp-icon { width: 22px; height: 22px; display: block; object-fit: contain; flex: 0 0 22px; }
  .orange-bg { background-color: var(--accent-orange); color: var(--primary-navy); }
  .green-bg { background-color: var(--accent-green); color: #fff; }

  .card-info { display: flex; flex-direction: column; }
  .card-label { font-size: 10px; color: #64748b; font-weight: 600; }
  .card-value { font-size: 13px; font-weight: 800; color: #0a1526; text-decoration: none; }

  .mini-gallery { display: flex; gap: 10px; }
  .mini-gallery img { width: 95px; height: 72px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 5px 14px rgba(15,23,42,.06); }

  .footer-middle-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px; padding: 30px 0; }
  .footer-col h4 { color: #0a1526; font-size: 15px; font-weight: 800; margin-bottom: 14px; }
  .footer-col ul { list-style: none; }
  .footer-col ul li { margin-bottom: 6px; }
  .footer-col a { color: #64748b; text-decoration: none; font-size: 12px; }

  .tursab-text { color: var(--accent-gold); font-weight: 700; margin-top: 8px; font-size: 13px; }

  .newsletter-form { display: flex; background: #ffffff; border-radius: 8px; overflow: hidden; margin-bottom: 16px; }
  .newsletter-form input { border: none; padding: 8px 12px; width: 100%; font-size: 12px; outline: none; }
  .newsletter-form button { background: var(--accent-orange); border: none; color: var(--primary-navy); padding: 0 14px; cursor: pointer; font-weight: 800; }

  .social-links { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .social-links > span { font-size: 12px; font-weight: 700; color: #0a1526; }
  .social-icons { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .social-link {
    min-height: 30px;
    background: transparent;
    border: 0;
    border-radius: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 2px 0;
    text-decoration: none;
    color: #334155;
    transition: opacity .2s ease, transform .2s ease;
  }
  .social-link:hover { opacity: .8; transform: translateY(-1px); }
  .social-link span { color: #334155; font-size: 11.5px; font-weight: 700; white-space: nowrap; }
  .social-link-facebook { width: 30px; }
  .social-icon-img { width: 24px; height: 24px; display: block; object-fit: contain; flex: 0 0 24px; }

  .footer-bottom { border-top: 1px solid #e5e7eb; text-align: center; padding: 16px 0; font-size: 12px; color: #64748b; }


  .site-footer .footer-col p,
  .site-footer .footer-info-item {
    color: #64748b;
  }

  .site-footer .footer-col a:hover,
