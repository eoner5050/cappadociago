  <!-- İNTERAKTİF JS KODLARI -->
  <script is:inline>
  (function () {

    // Dil menüsü: masaüstü + mobil güvenli geçiş
    const langSwitcher = document.getElementById('langSwitcher');
    const langButton = document.getElementById('langButton');
    const langDropdown = document.getElementById('langDropdown');

    if (langSwitcher && langButton && langDropdown) {
      const closeLanguageMenu = () => {
        langSwitcher.classList.remove('is-open');
        langButton.setAttribute('aria-expanded', 'false');
      };

      const toggleLanguageMenu = (event) => {
        event.preventDefault();
        event.stopPropagation();

        const willOpen = !langSwitcher.classList.contains('is-open');
        closeLanguageMenu();

        if (willOpen) {
          langSwitcher.classList.add('is-open');
          langButton.setAttribute('aria-expanded', 'true');
        }
      };

      langButton.addEventListener('click', toggleLanguageMenu);

      // Dil bağlantıları normal <a href> davranışını kullanır; JS sadece menüyü kapatır.
      langDropdown.querySelectorAll('.lang-item').forEach((item) => {
        item.addEventListener('click', function () {
          closeLanguageMenu();
        });
      });

      document.addEventListener('click', function (event) {
        if (!langSwitcher.contains(event.target)) {
          closeLanguageMenu();
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
          closeLanguageMenu();
        }
      });
    }

    // Kategori Slider Ok Butonları
    const sliderContainer = document.getElementById('sliderTrackContainer');
    const sliderPrev = document.getElementById('sliderPrevBtn');
    const sliderNext = document.getElementById('sliderNextBtn');

    if (sliderContainer && sliderPrev && sliderNext) {
      sliderNext.addEventListener('click', () => {
        sliderContainer.scrollBy({ left: 240, behavior: 'smooth' });
      });
      sliderPrev.addEventListener('click', () => {
        sliderContainer.scrollBy({ left: -240, behavior: 'smooth' });
      });
    }

    // Mobil Menü Aç/Kapat — erişilebilir ve kararlı
    const mobileToggle = document.querySelector('.mobile-menu-toggle');
    const mainNav = document.querySelector('.main-nav');
    if (mobileToggle && mainNav) {
      mobileToggle.setAttribute('aria-expanded', 'false');
      mobileToggle.addEventListener('click', (event) => {
        event.stopPropagation();
        const willOpen = !mainNav.classList.contains('is-open');
        mainNav.classList.toggle('is-open', willOpen);
        mobileToggle.classList.toggle('is-active', willOpen);
        mobileToggle.setAttribute('aria-expanded', String(willOpen));
      });

      mainNav.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          mainNav.classList.remove('is-open');
          mobileToggle.classList.remove('is-active');
          mobileToggle.setAttribute('aria-expanded', 'false');
        });
      });

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (!mainNav.contains(target) && !mobileToggle.contains(target)) {
          mainNav.classList.remove('is-open');
          mobileToggle.classList.remove('is-active');
          mobileToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    const root = document.querySelector('.tbc-hero-form');
    if (root) {
      const selects = root.querySelectorAll('.tbc-custom-select');
      const form = root.querySelector('#tbcBookingForm');
      const submitBtn = root.querySelector('#tbcSubmitBtn');
      const successBox = root.querySelector('#tbcSuccessBox');
      const errorBox = root.querySelector('#tbcErrorBox');

      function closeAllSelects() {
        root.querySelectorAll('.tbc-custom-select').forEach(select => select.classList.remove('active'));
        root.querySelectorAll('.tbc-field-wrap').forEach(wrap => wrap.classList.remove('is-open'));
      }

      selects.forEach(select => {
        const button = select.querySelector('.tbc-select-btn');
        const placeholder = select.querySelector('.tbc-placeholder');
        const options = select.querySelectorAll('.tbc-option');
        const targetId = select.getAttribute('data-target');
        const hiddenInput = root.querySelector('#' + targetId);
        const wrap = select.closest('.tbc-field-wrap');

        if (!button || !placeholder || !hiddenInput) return;

        button.addEventListener('click', function (event) {
          event.stopPropagation();
          const isActive = select.classList.contains('active');
          closeAllSelects();

          if (!isActive) {
            select.classList.add('active');
            if (wrap) wrap.classList.add('is-open');
          }
        });

        options.forEach(option => {
          option.addEventListener('click', function () {
            const value = this.getAttribute('data-value');
            placeholder.textContent = value;
            hiddenInput.value = value;
            closeAllSelects();
          });
        });
      });

      // LOGO RENKLERİNE UYUMLU ÇİFT AY TAKVİMİ
      const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      const fullMonthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
      const weekdayNames = ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"];
      const startInput = document.getElementById('startDateInput');
      const endInput = document.getElementById('endDateInput');
      const startMonth = document.getElementById('startMonth');
      const startDay = document.getElementById('startDay');
      const endMonth = document.getElementById('endMonth');
      const endDay = document.getElementById('endDay');
      const datePopover = document.getElementById('tbcDatePopover');
      const dateMonths = document.getElementById('tbcDateMonths');
      const dateTitle = document.getElementById('tbcDateTitle');
      const datePrev = document.getElementById('tbcDatePrev');
      const dateNext = document.getElementById('tbcDateNext');

      // Takvimi hero/booking container'larının overflow ve transform etkisinden çıkar.
      // Böylece masaüstü ve mobilde her zaman gerçek viewport üzerinde açılır.
      if (datePopover && datePopover.parentElement !== document.body) {
        document.body.appendChild(datePopover);
      }

      const pad2 = (value) => String(value).padStart(2, '0');
      const dateKey = (date) => `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())}`;
      const fromKey = (key) => {
        const [y, m, d] = key.split('-').map(Number);
        return new Date(y, m - 1, d);
      };
      const dayOnly = (date) => new Date(date.getFullYear(), date.getMonth(), date.getDate());

      let activeDateTarget = 'start';
      let calendarCursor = new Date();
      calendarCursor.setDate(1);

      const today = dayOnly(new Date());
      const tomorrow = new Date(today);
      tomorrow.setDate(tomorrow.getDate() + 1);

      if (startInput && !startInput.value) startInput.value = dateKey(today);
      if (endInput && !endInput.value) endInput.value = dateKey(tomorrow);

      const paintDateLabels = () => {
        if (startInput?.value) {
          const d = fromKey(startInput.value);
          startMonth.textContent = monthNames[d.getMonth()];
          startDay.textContent = d.getDate();
        }
        if (endInput?.value) {
          const d = fromKey(endInput.value);
          endMonth.textContent = monthNames[d.getMonth()];
          endDay.textContent = d.getDate();
        }
      };

      const isBetween = (date, start, end) => date > start && date < end;

      const renderMonth = (year, month) => {
        const monthWrap = document.createElement('div');
        monthWrap.className = 'tbc-date-month';
        monthWrap.innerHTML = `
          <div class="tbc-date-month-title">${fullMonthNames[month]} ${year}</div>
          <div class="tbc-date-weekdays">${weekdayNames.map((w) => `<span>${w}</span>`).join('')}</div>
          <div class="tbc-date-grid"></div>
        `;
        const grid = monthWrap.querySelector('.tbc-date-grid');
        const first = new Date(year, month, 1);
        const last = new Date(year, month + 1, 0);
        const offset = (first.getDay() + 6) % 7;

        for (let i = 0; i < offset; i++) {
          const blank = document.createElement('span');
          blank.className = 'tbc-date-blank';
          grid.appendChild(blank);
        }

        const selectedStart = startInput?.value ? fromKey(startInput.value) : null;
        const selectedEnd = endInput?.value ? fromKey(endInput.value) : null;

        for (let day = 1; day <= last.getDate(); day++) {
          const current = new Date(year, month, day);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'tbc-date-day';
          btn.textContent = String(day);
          btn.dataset.date = dateKey(current);

          if (current < today) btn.disabled = true;
          if (dateKey(current) === dateKey(today)) btn.classList.add('is-today');
          if (selectedStart && dateKey(current) === dateKey(selectedStart)) btn.classList.add('is-selected');
          if (selectedEnd && dateKey(current) === dateKey(selectedEnd)) btn.classList.add('is-selected');
          if (selectedStart && selectedEnd && isBetween(current, selectedStart, selectedEnd)) btn.classList.add('is-range');

          btn.addEventListener('click', () => {
            if (!startInput || !endInput) return;
            const selected = fromKey(btn.dataset.date);
            if (activeDateTarget === 'start') {
              startInput.value = btn.dataset.date;
              const currentEnd = endInput.value ? fromKey(endInput.value) : null;
              if (!currentEnd || currentEnd <= selected) {
                const nextDay = new Date(selected);
                nextDay.setDate(nextDay.getDate() + 1);
                endInput.value = dateKey(nextDay);
              }
              activeDateTarget = 'end';
            } else {
              const start = startInput.value ? fromKey(startInput.value) : today;
              if (selected <= start) {
                startInput.value = btn.dataset.date;
                const nextDay = new Date(selected);
                nextDay.setDate(nextDay.getDate() + 1);
                endInput.value = dateKey(nextDay);
              } else {
                endInput.value = btn.dataset.date;
              }
              activeDateTarget = 'start';
              closeDatePopover();
            }
            paintDateLabels();
            renderCalendar();
          });

          grid.appendChild(btn);
        }
        return monthWrap;
      };

      const renderCalendar = () => {
        if (!dateMonths || !dateTitle) return;
        const firstYear = calendarCursor.getFullYear();
        const firstMonth = calendarCursor.getMonth();
        const second = new Date(firstYear, firstMonth + 1, 1);
        const singleMonth = window.matchMedia('(max-width: 720px)').matches;
        dateTitle.textContent = singleMonth
          ? `${fullMonthNames[firstMonth]} ${firstYear}`
          : `${fullMonthNames[firstMonth]} ${firstYear} · ${fullMonthNames[second.getMonth()]} ${second.getFullYear()}`;
        dateMonths.innerHTML = '';
        dateMonths.appendChild(renderMonth(firstYear, firstMonth));
        if (!singleMonth) dateMonths.appendChild(renderMonth(second.getFullYear(), second.getMonth()));
      };

      const openDatePopover = (target = 'start') => {
        if (!datePopover) return;
        activeDateTarget = target;
        const sourceValue = target === 'end' ? endInput?.value : startInput?.value;
        if (sourceValue) {
          const d = fromKey(sourceValue);
          calendarCursor = new Date(d.getFullYear(), d.getMonth(), 1);
        }
        renderCalendar();
        datePopover.classList.add('is-open');
        datePopover.setAttribute('aria-hidden', 'false');
      };

      const closeDatePopover = () => {
        if (!datePopover) return;
        datePopover.classList.remove('is-open');
        datePopover.setAttribute('aria-hidden', 'true');
      };

      document.querySelectorAll('[data-date-target]').forEach((slot) => {
        slot.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          closeAllSelects();
          openDatePopover(slot.getAttribute('data-date-target') || 'start');
        });
      });

      datePrev?.addEventListener('click', (event) => {
        event.stopPropagation();
        calendarCursor = new Date(calendarCursor.getFullYear(), calendarCursor.getMonth() - 1, 1);
        renderCalendar();
      });

      dateNext?.addEventListener('click', (event) => {
        event.stopPropagation();
        calendarCursor = new Date(calendarCursor.getFullYear(), calendarCursor.getMonth() + 1, 1);
        renderCalendar();
      });

      datePopover?.addEventListener('click', (event) => event.stopPropagation());
      paintDateLabels();
      renderCalendar();

      document.addEventListener('click', () => {
        closeAllSelects();
        closeDatePopover();
      });

      if (form) {
        form.addEventListener('submit', function (event) {
          event.preventDefault();
          const tourType = root.querySelector('#tourType').value;
          const startDate = root.querySelector('#startDateInput').value;
          const guestCount = root.querySelector('#guestCount').value;

          successBox.style.display = 'none';
          errorBox.style.display = 'none';

          if (!tourType || !startDate || !guestCount) {
            errorBox.style.display = 'block';
            return;
          }
          const currentLang = document.documentElement.lang || 'en';
          const routes = {
            'Göreme Comfort Hot Air Balloon Tour':'goreme-comfort-hot-air-balloon-tour',
            'Göreme Standart Hot Air Balloon Tour':'goreme-standart-hot-air-balloon-tour',
            'Ihlara Valley Balloons Tour':'ihlara-valley-balloons-tour',
            'Pamukkale Balloons Tour':'pamukkale-balloons-tour',
            'Soğanlı Valley Balloon Tour':'soganli-valley-balloon-tour',
            'Cappadocia Custom Package Tour':'cappadocia-custom-package-tour',
            'Blue Tour Cappadocia':'blue-tour-cappadocia',
            'Red Tour Cappadocia':'red-tour-cappadocia',
            'Green Tour Cappadocia':'green-tour-cappadocia',
            'Private Red Tour Cappadocia':'private-red-tour-cappadocia',
            'Private Green Tour Cappadocia':'private-green-tour-cappadocia',
            'Cappadocia Mix Tour':'cappadocia-mix-tour',
            'ATV Tour With Göreme Valleys':'atv-tour-with-goreme-valleys',
            'Jeep Safari Cappadocia':'jeep-safari-cappadocia',
            'Sunrise or Sunset Horse Riding Cappadocia':'sunrise-sunset-horse-riding-cappadocia',
            'Cappadocia Sunset Camel Riding Tour':'cappadocia-sunset-camel-riding-tour',
            'Cappadocia Classic Car Tour':'cappadocia-classic-car-tour',
            'Photo Shoot & Flying Dress Experience':'photo-shoot-flying-dress-experience',
            'Cappadocia Pottery Making Experience':'cappadocia-pottery-making-experience',
            'Turkish Night With Cave Dinner Cappadocia':'turkish-night-with-cave-dinner-cappadocia',
            'Balloons Watching Tour Cappadocia':'balloons-watching-tour-cappadocia'
          };
          const transferRoutes = {
            'Kayseri Airport (ASR) Shuttle Transfer':'kayseri-airport-shuttle-transfer',
            'Nevşehir Airport (NAV) Shuttle Transfer':'nevsehir-airport-shuttle-transfer',
            'Private VIP Airport Transfer Cappadocia':'private-airport-transfer'
          };
          const rawPeople = parseInt(guestCount, 10) || 1;
          const params = new URLSearchParams({ date: startDate, people: String(rawPeople) });
          if (routes[tourType]) { window.location.href = `/${currentLang}/tours/${routes[tourType]}?${params.toString()}`; return; }
          if (transferRoutes[tourType]) { window.location.href = `/${currentLang}/transfers/${transferRoutes[tourType]}?${params.toString()}`; return; }
          errorBox.style.display = 'block';
        });
      }
    }

// Tur Filtreleme Fonksiyonu
    const tabButtons = document.querySelectorAll('#tourCategoryTabs .tab-item');
    const tourCards = document.querySelectorAll('#toursGrid .home-tour-card');

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        tabButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        tourCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = '';
            const wrapper = card.closest('.tour-card-link-wrapper');
            if (wrapper) wrapper.style.display = '';
          } else {
            card.style.display = 'none';
            const wrapper = card.closest('.tour-card-link-wrapper');
            if (wrapper) wrapper.style.display = 'none';
          }
        });
      });
    });

    if (tabButtons.length) tabButtons[0].click();

    // 1. TRIPADVISOR SLIDER OKLARI
    const taContainer = document.getElementById('taReviewsContainer');
    const taPrevBtn = document.getElementById('taPrevBtn');
    const taNextBtn = document.getElementById('taNextBtn');

    if (taNextBtn && taPrevBtn && taContainer) {
      taNextBtn.addEventListener('click', () => {
        taContainer.scrollBy({ left: 350, behavior: 'smooth' });
      });
      taPrevBtn.addEventListener('click', () => {
        taContainer.scrollBy({ left: -350, behavior: 'smooth' });
      });
    }

    // 2. GOOGLE SLIDER OKLARI
    const googleContainer = document.getElementById('googleReviewsContainer');
    const googlePrevBtn = document.getElementById('googlePrevBtn');
    const googleNextBtn = document.getElementById('googleNextBtn');

    if (googleNextBtn && googlePrevBtn && googleContainer) {
      googleNextBtn.addEventListener('click', () => {
        googleContainer.scrollBy({ left: 350, behavior: 'smooth' });
      });
      googlePrevBtn.addEventListener('click', () => {
        googleContainer.scrollBy({ left: -350, behavior: 'smooth' });
      });
    }

    // Homepage live pricing is handled by the independent script below.
  })();
  </script>

<script is:inline>
(() => {
  const runHomepagePrices = async () => {
    const grid = document.getElementById('toursGrid');
    if (!grid) return;

    const base = grid.dataset.supabaseUrl || '';
    const key = grid.dataset.supabaseKey || '';
    if (!base || !key) return;

    const cards = [...grid.querySelectorAll('.home-tour-card[data-product-slug]')];
    if (!cards.length) return;

    const headers = {
      apikey: key,
      Authorization: `Bearer ${key}`
    };

    const today = new Date();
    const todayKey =
      `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;

    const lang = document.documentElement.lang || 'en';
    const askText =
      lang === 'tr' ? 'Fiyat Sorunuz' :
      lang === 'es' ? 'Consultar Precio' :
      'Ask For Price';

    const money = (n) => `${Math.round(Number(n))} €`;

    for (const card of cards) {
      const slug = String(card.dataset.productSlug || '').trim();
      if (!slug) continue;

      const currentEl = card.querySelector('[data-current-price]');
      const oldEl = card.querySelector('[data-old-price]');
      if (!currentEl || !oldEl) continue;

      try {
        // Fetch ALL active rows for this slug.
        // This intentionally handles legacy/duplicate product rows safely.
        const productRes = await fetch(
          `${base}/rest/v1/products?slug=eq.${encodeURIComponent(slug)}&active=eq.true&select=id,default_price,ask_for_price`,
          { headers, cache: 'no-store' }
        );

        if (!productRes.ok) continue;
        const products = await productRes.json();
        if (!Array.isArray(products) || !products.length) continue;

        // Ask-for-price only wins when every active row for this slug is ask-for-price.
        const allAsk = products.every(p => p.ask_for_price === true);
        if (allAsk) {
          currentEl.textContent = askText;
          currentEl.classList.add('is-ask-price');
          oldEl.textContent = '';
          oldEl.style.display = 'none';
          continue;
        }

        const ids = products.map(p => String(p.id || '')).filter(Boolean);
        let validPrices = [];

        // Query each matched product's future availability.
        // We deliberately aggregate across duplicate/legacy product rows.
        for (const id of ids) {
          const avRes = await fetch(
            `${base}/rest/v1/availability?product_id=eq.${encodeURIComponent(id)}&date=gte.${todayKey}&status=eq.available&select=price,capacity,booked&limit=1000`,
            { headers, cache: 'no-store' }
          );
          if (!avRes.ok) continue;

          const rows = await avRes.json();
          for (const row of rows || []) {
            const price = Number(row.price || 0);
            const capacity = Number(row.capacity || 0);
            const booked = Number(row.booked || 0);
            if (price > 0 && capacity - booked > 0) validPrices.push(price);
          }
        }

        // Future availability is the primary source.
        // Only if there is no valid future price do we fall back to the lowest
        // positive default_price among active rows for that slug.
        let livePrice = validPrices.length ? Math.min(...validPrices) : 0;

        if (!(livePrice > 0)) {
          const defaults = products
            .map(p => Number(p.default_price || 0))
            .filter(v => v > 0);
          if (defaults.length) livePrice = Math.min(...defaults);
        }

        if (!(livePrice > 0)) continue;

        currentEl.classList.remove('is-ask-price');
        currentEl.textContent = money(livePrice);
        oldEl.textContent = money(livePrice * 1.20);
        oldEl.style.display = '';
        oldEl.style.textDecoration = 'line-through';
        card.dataset.livePriceMode = 'price';
      } catch (err) {
        console.error('Homepage price error:', slug, err);
      }
    }
  };

  const start = () => {
    runHomepagePrices();
    window.setTimeout(runHomepagePrices, 2000);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }

  window.addEventListener('pageshow', () => {
    window.setTimeout(runHomepagePrices, 150);
  });
})();
</script>




<script>
  (() => {
    const viewport = document.getElementById("tbc25Viewport");
    const track = document.getElementById("tbc25Track");
    const prev = document.getElementById("tbc25PrevBtn");
    const next = document.getElementById("tbc25NextBtn");
    if (!viewport || !track || !prev || !next) return;

    let page = 0;
    let timer;

    const cardsPerView = () => {
      if (window.innerWidth <= 520) return 1;
      if (window.innerWidth <= 800) return 2;
      if (window.innerWidth <= 1050) return 3;
      return 4;
    };

    const totalPages = () => {
      const total = track.querySelectorAll(".review-card").length;
      return Math.max(1, Math.ceil(total / cardsPerView()));
    };

    const render = () => {
      const card = track.querySelector(".review-card");
      if (!card) return;
      const perView = cardsPerView();
      const pages = totalPages();
      if (page >= pages) page = 0;
      if (page < 0) page = pages - 1;

      const gap = 16;
      const cardWidth = card.getBoundingClientRect().width;
      const offsetCards = page * perView;
      track.style.transform = `translateX(-${offsetCards * (cardWidth + gap)}px)`;
    };

    const move = (dir) => {
      page += dir;
      render();
    };

    const restart = () => {
      clearInterval(timer);
      timer = setInterval(() => move(1), 6000);
    };

    prev.addEventListener("click", () => { move(-1); restart(); });
    next.addEventListener("click", () => { move(1); restart(); });

    window.addEventListener("resize", () => {
      page = 0;
      render();
    });

    let startX = 0;
    viewport.addEventListener("touchstart", (e) => {
      startX = e.touches[0].clientX;
    }, { passive: true });

    viewport.addEventListener("touchend", (e) => {
      const delta = e.changedTouches[0].clientX - startX;
      if (Math.abs(delta) > 45) {
        move(delta < 0 ? 1 : -1);
        restart();
      }
    }, { passive: true });

    render();
    restart();
  })();
</script>


