  .tbc-submit { min-height: 50px; border: 0; border-radius: 999px; padding: 0 30px; background: var(--primary-navy); color: #fff; font-family: var(--font-heading); font-size: 13.5px; font-weight: 900; letter-spacing: 0.5px; cursor: pointer; text-align: center; display: flex; align-items: center; justify-content: center; width: 100%; }
  
  .tbc-mobile-hero {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .tbc-mobile-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.075);
    animation: tbcHeroImageIntro 8s cubic-bezier(.2,.7,.2,1) forwards;
    will-change: transform;
  }

  .tbc-video-overlay {
    animation: tbcHeroOverlayIntro .9s ease-out both;
  }

  .tbc-video-content {
    animation: tbcHeroContentIntro .85s .12s cubic-bezier(.2,.75,.25,1) both;
  }

  .tbc-booking-wrap {
    animation: tbcHeroBookingIntro .85s .28s cubic-bezier(.2,.75,.25,1) both;
  }

  @keyframes tbcHeroImageIntro {
    from { transform: scale(1.075); }
    to { transform: scale(1); }
  }

  @keyframes tbcHeroOverlayIntro {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes tbcHeroContentIntro {
    from { opacity: 0; transform: translate3d(0, 18px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  @keyframes tbcHeroBookingIntro {
    from { opacity: 0; transform: translate3d(0, 14px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tbc-mobile-hero img,
    .tbc-video-overlay,
