<!DOCTYPE html>
<html lang={lang}>
<head>
    <!-- CappadociaGo favicon -->
    <link rel="icon" type="image/webp" href="/favicon.webp?v=10" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <meta name="keywords" content={seo.keywords} />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <meta name="author" content="CappadociaGo" />
  <meta name="theme-color" content="#071f4e" />



<link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={`${siteOrigin}/en/`} />
  <link rel="alternate" hreflang="tr" href={`${siteOrigin}/tr/`} />
  <link rel="alternate" hreflang="es" href={`${siteOrigin}/es/`} />
  <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/en/`} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="CappadociaGo" />
  <meta property="og:title" content={seo.title} />
  <meta property="og:description" content={seo.description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:alt" content={seo.heroAlt} />
  <meta property="og:locale" content={seo.ogLocale} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={seo.title} />
  <meta name="twitter:description" content={seo.description} />
  <meta name="twitter:image" content={socialImage} />

  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>

  <!-- Google Fonts: render-blocking olmadan yükle; ilk boyamada sistem fontu kullanılır. -->
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600;1,9..144,700&family=Dancing+Script:wght@600;700&family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600;1,9..144,700&family=Dancing+Script:wght@600;700&family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </noscript>

</head>
<body>
  <!-- SHARED HEADER -->
  <SiteHeader lang={lang} />

  <!-- HERO VİDEO BÖLÜMÜ -->
  <section class="tbc-hero-form">
    <section class="tbc-video-hero" id="cgo-ref-hero-v4">

      <!-- Hero Görseli: Vercel üzerinden yerel olarak servis edilir -->
      <picture class="tbc-mobile-hero">
        <img
          src="/images/hero-reference-cappadociago.jpg"
          alt={seo.heroAlt}
          width="800"
          height="520"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      </picture>

      <div class="tbc-video-overlay"></div>

      <div class="tbc-video-content" id="cgo-ref-content-v4">
        <span class="tbc-video-kicker">
          CappadociaGo
        </span>

        <h1 class="tbc-video-title">
          {lang === "tr" ? "Gün Doğumu Balon Turları ve Unutulmaz Kapadokya Maceraları" : lang === "es" ? "Globos al Amanecer y Aventuras Inolvidables en Capadocia" : "Sunrise Hot Air Balloon Tours & Unforgettable Cappadocia Adventures"}
        </h1>

        <span class="tbc-hero-divider" aria-hidden="true"></span>

        <p class="tbc-video-text">
          {lang === "tr" ? "Kapadokya’nın büyüsünü CappadociaGo ile yaşayın. Göreme’de günlük sıcak hava balonu uçuşları, Red & Green turlar, ATV ve Jeep safarileri, at turları ve sorunsuz havalimanı transferleri sunuyoruz. Kapadokya deneyiminizi güvenle planlayın." : lang === "es" ? "Vive la magia de Capadocia con CappadociaGo. Ofrecemos vuelos diarios en globo en Göreme, tours Red & Green, ATV y Jeep Safari, paseos a caballo y traslados al aeropuerto con asistencia local." : "Experience the magic of Cappadocia with CappadociaGo. We offer daily hot air balloon flights in Göreme, guided Red & Green Tours, ATV and Jeep safaris, horse riding and hassle-free airport transfers. Plan your Cappadocia adventure with trusted local support."}
        </p>

        <div class="tbc-video-actions">
          <a href="#tours" class="tbc-video-btn tbc-video-btn-primary">
            {t.hero.exploreTours}
          </a>
          <a href="tel:+905401015050" class="tbc-video-btn tbc-video-btn-secondary">
            {t.hero.contactUs}
          </a>
        </div>

        <div class="tbc-hero-trust-points cgo-reference-trust" id="cgo-ref-trust-v4" aria-label="Why choose CappadociaGo">
          <div class="tbc-trust-point"><span class="tbc-trust-icon" aria-hidden="true">✹</span><span>Premium Experiences</span></div>
          <div class="tbc-trust-point"><span class="tbc-trust-icon" aria-hidden="true">●</span><span>24/7 Customer Care</span></div>
          <div class="tbc-trust-point"><span class="tbc-trust-icon" aria-hidden="true">★</span><span>Top Rated</span></div>
          <div class="tbc-trust-point"><span class="tbc-trust-icon" aria-hidden="true">✦</span><span>Best-in-Class Tours</span></div>
        </div>

      <div class="booking-review-row" aria-label="Guest ratings">
        <div class="booking-review-pill booking-review-tripadvisor">
          <span class="booking-review-logo"><img src="/images/icons/tripadvisor-logo.webp" alt="TripAdvisor" loading="lazy" decoding="async" /></span>
          <span class="booking-review-copy"><strong>4.9/5</strong><span>TripAdvisor</span></span>
          <span class="booking-review-stars" aria-hidden="true">★★★★★</span>
        </div>
        <div class="booking-review-pill booking-review-google">
          <span class="booking-review-logo"><img src="/images/icons/google-logo.webp" alt="Google" loading="lazy" decoding="async" /></span>
          <span class="booking-review-copy"><strong>4.8/5</strong><span>Google Reviews</span></span>
          <span class="booking-review-stars" aria-hidden="true">★★★★★</span>
        </div>
      </div>
      </div>

    <!-- BOOKING CALLOUT — hero içinde referans kompozisyon -->
    <div class="booking-callout">
      <div class="booking-section-heading booking-ready-heading" aria-label="Ready to float over the fairy chimneys">
        {lang === "tr" ? (
          <>
            <strong class="booking-word-yellow">Peri bacalarının üzerinde</strong><span class="booking-word-white"> süzülmeye </span><strong class="booking-word-blue">hazır mısınız?</strong>
          </>
        ) : lang === "es" ? (
          <>
            <strong class="booking-word-yellow">¿Listo</strong><span class="booking-word-white"> para flotar sobre </span><strong class="booking-word-blue">las chimeneas de hadas?</strong>
          </>
        ) : (
          <>
            <strong class="booking-word-yellow" style="color:#FFD400 !important;-webkit-text-fill-color:#FFD400 !important;">Ready</strong><span class="booking-word-white" style="color:#FFFFFF !important;-webkit-text-fill-color:#FFFFFF !important;">to float over</span><strong class="booking-word-blue" style="color:#006DB8 !important;-webkit-text-fill-color:#006DB8 !important;">the fairy chimneys?</strong>
          </>
        )}
      </div>
      <div class="tbc-booking-wrap">
        <div class="tbc-booking-box">
          <form id="tbcBookingForm">
            <input type="hidden" id="tourType" name="Tour Name" required>
            <input type="hidden" id="guestCount" name="Number of Guests" required>

            <div class="tbc-booking-grid">
              
              <!-- 1. Select Tour -->
              <div class="tbc-field-wrap">
                <div class="tbc-custom-select" data-target="tourType">
                  <button type="button" class="tbc-select-btn">
                    <span class="tbc-placeholder">{t.booking.selectTour}</span>
                    <span class="tbc-arrow">▼</span>
                  </button>
                  <div class="tbc-options">
                    
                    <!-- Balloons Tours -->
                    <div class="tbc-opt-group-title">{t.categories.balloonTours}</div>
                    <div class="tbc-option" data-value="Göreme Comfort Hot Air Balloon Tour">Göreme Comfort Hot Air Balloon Tour</div>
                    <div class="tbc-option" data-value="Göreme Standart Hot Air Balloon Tour">Göreme Standart Hot Air Balloon Tour</div>
                    <div class="tbc-option" data-value="Ihlara Valley Balloons Tour">Ihlara Valley Balloons Tour</div>
                    <div class="tbc-option" data-value="Pamukkale Balloons Tour">Pamukkale Balloons Tour</div>
                    <div class="tbc-option" data-value="Soğanlı Valley Balloon Tour">Soğanlı Valley Balloon Tour</div>

                    <!-- Daily Tours -->
                    <div class="tbc-opt-group-title">{t.categories.dailyTours}</div>
                    <div class="tbc-option" data-value="Cappadocia Custom Package Tour">Cappadocia Custom Package Tour</div>
                    <div class="tbc-option" data-value="Blue Tour Cappadocia">Blue Tour Cappadocia</div>
                    <div class="tbc-option" data-value="Red Tour Cappadocia">Red Tour Cappadocia</div>
                    <div class="tbc-option" data-value="Green Tour Cappadocia">Green Tour Cappadocia</div>

                    <!-- Private Tours -->
                    <div class="tbc-opt-group-title">{t.categories.privateTours}</div>
                    <div class="tbc-option" data-value="Private Red Tour Cappadocia">Private Red Tour Cappadocia</div>
                    <div class="tbc-option" data-value="Private Green Tour Cappadocia">Private Green Tour Cappadocia</div>
                    <div class="tbc-option" data-value="Cappadocia Mix Tour">Cappadocia Mix Tour</div>

                    <!-- Transfers -->
                    <div class="tbc-opt-group-title">{t.categories.transfers}</div>
                    <div class="tbc-option" data-value="Kayseri Airport (ASR) Shuttle Transfer">Kayseri Airport (ASR) Shuttle Transfer</div>
                    <div class="tbc-option" data-value="Nevşehir Airport (NAV) Shuttle Transfer">Nevşehir Airport (NAV) Shuttle Transfer</div>
                    <div class="tbc-option" data-value="Private VIP Airport Transfer Cappadocia">Private VIP Airport Transfer Cappadocia</div>

                    <!-- Activites -->
                    <div class="tbc-opt-group-title">{t.categories.activities}</div>
                    <div class="tbc-option" data-value="ATV Tour With Göreme Valleys">ATV Tour With Göreme Valleys</div>
                    <div class="tbc-option" data-value="Jeep Safari Cappadocia">Jeep Safari Cappadocia</div>
                    <div class="tbc-option" data-value="Sunrise or Sunset Horse Riding Cappadocia">Sunrise or Sunset Horse Riding Cappadocia</div>
                    <div class="tbc-option" data-value="Cappadocia Sunset Camel Riding Tour">Cappadocia Sunset Camel Riding Tour</div>
                    <div class="tbc-option" data-value="Cappadocia Classic Car Tour">Cappadocia Classic Car Tour</div>
                    <div class="tbc-option" data-value="Photo Shoot & Flying Dress Experience">Photo Shoot & Flying Dress Experience</div>
                    <div class="tbc-option" data-value="Cappadocia Pottery Making Experience">Cappadocia Pottery Making Experience</div>
                    <div class="tbc-option" data-value="Turkish Night With Cave Dinner Cappadocia">Turkish Night With Cave Dinner Cappadocia</div>
                    <div class="tbc-option" data-value="Balloons Watching Tour Cappadocia">Balloons Watching Tour Cappadocia</div>

                  </div>
                </div>
              </div>

              <!-- 2. TARİH SEKMESİ -->
              <div class="tbc-field-wrap dates-custom-box" id="tbcDateField">
                <span class="dates-top-label">{t.booking.accommodationDates}</span>
                <div class="dates-inputs-row">
                  <button class="date-slot" type="button" data-date-target="start" aria-label="Select start date">
                    <span class="d-m" id="startMonth">Aug</span>
                    <span class="d-d" id="startDay">15</span>
                    <span class="d-a" aria-hidden="true">⌄</span>
                  </button>
                  <span class="date-divider" aria-hidden="true">→</span>
                  <button class="date-slot" type="button" data-date-target="end" aria-label="Select end date">
                    <span class="d-m" id="endMonth">Aug</span>
                    <span class="d-d" id="endDay">16</span>
                    <span class="d-a" aria-hidden="true">⌄</span>
                  </button>
                </div>
                <input type="hidden" id="startDateInput" name="Start Date" required />
                <input type="hidden" id="endDateInput" name="End Date" />
                <div class="tbc-date-popover" id="tbcDatePopover" aria-hidden="true">
                  <div class="tbc-date-head">
                    <button type="button" class="tbc-date-nav" id="tbcDatePrev" aria-label="Previous month">‹</button>
                    <div class="tbc-date-title" id="tbcDateTitle"></div>
                    <button type="button" class="tbc-date-nav" id="tbcDateNext" aria-label="Next month">›</button>
                  </div>
                  <div class="tbc-date-months" id="tbcDateMonths"></div>
                  <div class="tbc-date-help">
                    {lang === "tr" ? "Başlangıç ve bitiş tarihini seçin" : lang === "es" ? "Seleccione la fecha de inicio y fin" : "Select start and end dates"}
                  </div>
                </div>
              </div>

              <!-- 3. Select Person (Guests) -->
              <div class="tbc-field-wrap">
                <div class="tbc-custom-select" data-target="guestCount">
                  <button type="button" class="tbc-select-btn">
                    <span class="tbc-placeholder">{t.booking.selectPerson}</span>
                    <span class="tbc-arrow">▼</span>
                  </button>
                  <div class="tbc-options">
                    <div class="tbc-option" data-value="1 Person">1 Person</div>
                    <div class="tbc-option" data-value="2 Persons">2 Persons</div>
                    <div class="tbc-option" data-value="3 Persons">3 Persons</div>
                    <div class="tbc-option" data-value="4 Persons">4 Persons</div>
                    <div class="tbc-option" data-value="5+ Persons">5+ Persons</div>
                  </div>
                </div>
              </div>

              <!-- 4. Search Button -->
              <div class="tbc-field-wrap">
                <button class="tbc-submit" id="tbcSubmitBtn" type="submit">
                  {t.booking.search}
                </button>
              </div>

            </div>
          </form>

          <div class="tbc-success-box" id="tbcSuccessBox">
            {t.booking.success}
          </div>

          <div class="tbc-error-box" id="tbcErrorBox">
            {t.booking.error}
          </div>
        </div><!-- /.tbc-booking-box -->
      </div><!-- /.tbc-booking-wrap -->
