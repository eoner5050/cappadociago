  /* OUR PARTNERS - PREMIUM TWO ROW SLIDER */
  .tbc-premium-partners {
    --partner-navy: #071f4e;
    --partner-navy-soft: #0b356e;
    --partner-gold: #f5b700;
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: clamp(58px, 6vw, 84px) 0 clamp(58px, 6vw, 82px);
    overflow: hidden;
    background:
      radial-gradient(circle at 50% -10%, rgba(245,183,0,.11), transparent 30rem),
      linear-gradient(180deg, #ffffff 0%, #f4f8fd 100%);
    border-top: 1px solid #edf1f6;
    border-bottom: 1px solid #e5ebf3;
  }

  .tbc-premium-partners-glow {
    position: absolute;
    z-index: -1;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    filter: blur(82px);
    pointer-events: none;
    opacity: .16;
  }

  .tbc-premium-partners-glow-left {
    left: -120px;
    top: 22%;
    background: var(--partner-gold);
  }

  .tbc-premium-partners-glow-right {
    right: -130px;
    bottom: 4%;
    background: #4e91dc;
  }

  .tbc-premium-partners-head {
    width: min(1100px, calc(100% - 34px));
    margin: 0 auto clamp(30px, 4vw, 44px);
    text-align: center;
  }

  .tbc-premium-partners-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 7px 13px;
    margin-bottom: 14px;
    border: 1px solid rgba(7,31,78,.09);
    border-radius: 999px;
    background: rgba(255,255,255,.88);
    box-shadow: 0 8px 26px rgba(7,31,78,.07);
    color: var(--partner-navy);
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .tbc-premium-partners-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--partner-gold);
    box-shadow: 0 0 0 4px rgba(245,183,0,.14);
  }

  .tbc-premium-partners-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .18em;
    margin: 0;
    color: var(--partner-navy);
    font-family: var(--font-heading);
    font-size: clamp(29px, 3.2vw, 48px);
    font-weight: 900;
    letter-spacing: -.035em;
    line-height: 1.08;
  }

  .tbc-premium-partners-title strong {
    color: var(--partner-gold);
    font-weight: 900;
    text-shadow: 0 7px 22px rgba(245,183,0,.16);
  }

  .tbc-premium-partners-text {
    max-width: 820px;
    margin: 14px auto 0;
    color: #61748c;
    font-size: clamp(13px, 1.1vw, 16px);
    line-height: 1.7;
  }

  .tbc-premium-partners-rows {
    display: grid;
    gap: 18px;
  }

  .tbc-premium-marquee {
    width: 100%;
    overflow: hidden;
    padding: 5px 0 8px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
  }

  .tbc-premium-track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 18px;
    padding-inline: 9px;
    will-change: transform;
    backface-visibility: hidden;
  }

  .tbc-premium-card {
    width: clamp(210px, 18vw, 280px);
    height: clamp(112px, 10vw, 132px);
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    padding: 16px 20px;
    overflow: hidden;
    border: 1px solid rgba(7,31,78,.09);
    border-radius: 22px;
    background: rgba(255,255,255,.96);
    box-shadow:
      0 14px 36px rgba(7,31,78,.07),
      inset 0 1px 0 rgba(255,255,255,.92);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }

  .tbc-premium-card:hover {
    transform: translateY(-3px);
    border-color: rgba(245,183,0,.35);
    box-shadow: 0 20px 46px rgba(7,31,78,.11);
  }

  .tbc-premium-card img {
    display: block;
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: contain !important;
    object-position: center center !important;
    margin: 0;
  }

  .tbc-premium-track-left {
    animation: tbc-premium-slide-left 34s linear infinite;
  }

  .tbc-premium-track-right {
    animation: tbc-premium-slide-right 38s linear infinite;
  }

  .tbc-premium-marquee:hover .tbc-premium-track {
    animation-play-state: paused;
  }

  @keyframes tbc-premium-slide-left {
    from { transform: translate3d(0,0,0); }
    to { transform: translate3d(calc(-50% - 9px),0,0); }
  }

  @keyframes tbc-premium-slide-right {
    from { transform: translate3d(calc(-50% - 9px),0,0); }
    to { transform: translate3d(0,0,0); }
  }

  @media (max-width: 767px) {
    .tbc-premium-partners {
      padding: 52px 0 58px;
    }

    .tbc-premium-partners-head {
      margin-bottom: 26px;
    }

    .tbc-premium-partners-title {
      font-size: 27px;
    }

    .tbc-premium-partners-rows {
      gap: 13px;
    }

    .tbc-premium-track {
      gap: 14px;
      padding-inline: 7px;
    }

    .tbc-premium-card {
      width: 185px;
      height: 100px;
      padding: 12px 14px;
      border-radius: 17px;
    }

    .tbc-premium-track-left { animation-duration: 29s; }
    .tbc-premium-track-right { animation-duration: 32s; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tbc-premium-track {
      animation: none !important;
    }

    .tbc-premium-marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
      scrollbar-width: thin;
    }
  }

  /* SEO INTRODUCTION */
  .tbc-seo-intro {
    padding: 58px 0 18px;
    background: linear-gradient(180deg, #f4f8fd 0%, #fffdf7 100%);
  }

  .tbc-seo-intro-card {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 4vw, 46px);
    border: 1px solid #e7e2d5;
    border-radius: 26px;
    background:
      radial-gradient(circle at 92% 0%, rgba(245,183,0,.10), transparent 20rem),
      #ffffff;
    box-shadow: 0 18px 48px rgba(7,31,78,.07);
  }

  .tbc-seo-intro-kicker {
    display: inline-flex;
    align-items: center;
    padding: 7px 12px;
    margin-bottom: 13px;
    border-radius: 999px;
    background: #fff6d6;
    color: #8a6200;
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .08em;
  }

  .tbc-seo-intro-card h2 {
    max-width: 900px;
    margin: 0 0 16px;
    color: #071f4e;
    font-family: var(--font-heading);
    font-size: clamp(27px, 3vw, 40px);
    line-height: 1.15;
    letter-spacing: -.025em;
  }

  .tbc-seo-intro-card p {
    max-width: 980px;
    margin: 0 0 13px;
    color: #53667f;
    font-size: 15px;
    line-height: 1.85;
  }

  .tbc-seo-intro-card .tbc-seo-intro-lead {
    color: #243b5a;
    font-size: 16px;
    font-weight: 600;
  }

  .tbc-seo-intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .tbc-seo-intro-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 15px;
    border: 1px solid #d8e2ef;
    border-radius: 999px;
    background: #f8fbff;
    color: #071f4e;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition: transform .2s ease, border-color .2s ease, background .2s ease;
  }

  .tbc-seo-intro-links a:hover {
    transform: translateY(-2px);
    border-color: #f5b700;
    background: #fff9e7;
  }

  /* FAQ */
  .tbc-faq-section { background: linear-gradient(180deg,#fffdf7 0%,#f6f8fc 100%); padding: 58px 0 64px; border-top: 1px solid #ece6d7; border-bottom: 1px solid #e5eaf2; }
  .tbc-faq-container { max-width: 1040px; }
  .tbc-faq-head { margin-bottom: 24px; text-align: center; }
  .tbc-faq-kicker { display: inline-flex; align-items: center; border-radius: 999px; padding: 7px 13px; margin-bottom: 10px; background: #f5b700; color: #071f4e; font-family: var(--font-heading); font-size: 10px; font-weight: 900; letter-spacing: .8px; box-shadow: 0 6px 18px rgba(245,183,0,.22); }
  .tbc-faq-head h2 { margin: 0; font-family: var(--font-heading); font-size: clamp(25px,3vw,36px); line-height: 1.15; font-weight: 900; color: #071f4e; }
  .tbc-faq-list { display: grid; gap: 10px; }
  .tbc-faq-item { background:#fff; border:1px solid #dfe6f0; border-radius:16px; overflow:hidden; box-shadow:0 8px 24px rgba(7,31,78,.055); transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease; }
  .tbc-faq-item:hover { border-color:#f5c21a; transform:translateY(-1px); box-shadow:0 10px 28px rgba(7,31,78,.08); }
  .tbc-faq-item summary { list-style:none; display:flex; align-items:center; gap:12px; padding:16px 18px; cursor:pointer; color:#071f4e; font-family:var(--font-heading); font-size:14px; font-weight:850; }
  .tbc-faq-item summary::-webkit-details-marker { display:none; }
  .tbc-faq-chevron { flex:0 0 28px; width:28px; height:28px; border-radius:50%; display:grid; place-items:center; background:#fff4c7; color:#a87600; font-size:22px; line-height:1; font-weight:800; transition:transform .2s ease,background .2s ease,color .2s ease; transform-origin:center; }
  .tbc-faq-item[open] { border-color:#f5b700; }
  .tbc-faq-item[open] .tbc-faq-chevron { transform:rotate(90deg); background:#071f4e; color:#f5b700; }
  .tbc-faq-answer { padding:0 20px 18px 58px; max-width:920px; color:#52647c; font-size:13px; line-height:1.75; }

  .footer-social-stack { display: grid; gap: 9px; margin-top: 14px; }
  .footer-social-card { display: flex; align-items: center; gap: 10px; padding: 9px 11px; border: 1px solid #dce5ef; border-radius: 12px; background: #fff; text-decoration: none; color: #0a2b5a; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .footer-social-card:hover { transform: translateY(-2px); border-color: #ffd000; box-shadow: 0 8px 20px rgba(8,34,72,.08); }
  .footer-social-card img { flex: 0 0 22px; object-fit: contain; }
  .footer-social-card span { display: flex; min-width: 0; flex-direction: column; }
  .footer-social-card strong { font-size: 11.5px; line-height: 1.2; color: #0a2b5a; }
  .footer-social-card small { font-size: 10px; color: #64748b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .footer-social-whatsapp { background: #f0fff5; }

  /* WHATSAPP CTA BANNER */
  .footer-cta-banner { background: linear-gradient(135deg, #0a1526 0%, #112240 100%); padding: 30px 0; border-top: 1px solid rgba(255, 208, 0, 0.2); color: #ffffff; }
  .cta-flex { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .cta-text h2 { font-size: 18px; font-weight: 800; color: var(--accent-gold); margin-bottom: 4px; }
  .cta-text p { font-size: 13px; color: #cbd5e1; }
  .cta-btn { background: transparent; color: #ffffff; padding: 8px 4px; border-radius: 0; border: 0; text-decoration: none; font-weight: 800; font-size: 13px; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: opacity .2s ease, transform .2s ease; }
  .cta-btn:hover { opacity: .82; transform: translateY(-1px); }
  .cta-whatsapp-icon { width: 20px; height: 20px; display: block; object-fit: contain; flex: 0 0 20px; }
  .contact-whatsapp-icon { width: 22px; height: 22px; display: block; object-fit: contain; flex: 0 0 22px; }

  /* FOOTER */
  .site-footer { background-color: #ffffff; color: #475569; padding-top: 40px; border-top: 1px solid #e5e7eb; }
  .footer-top-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; padding-bottom: 30px; border-bottom: 1px solid #e5e7eb; }
  .footer-brand-box { display: flex; flex-direction: column; gap: 16px; }

  .transparent-logo { 
    max-height: 90px; 
    width: auto; 
    display: block; 
    object-fit: contain; 
    background: transparent !important;
  }

  .contact-cards { display: flex; flex-wrap: wrap; gap: 12px; }
