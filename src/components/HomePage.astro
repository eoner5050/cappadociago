  .tbc-date-day { aspect-ratio:1/1; min-width:0; min-height:34px; border:1px solid #e2e8f0; border-radius:10px; background:#fffaf0; color:#243b5a; font-family:var(--font-heading); font-size:11px; font-weight:900; cursor:pointer; transition:.15s ease; }
