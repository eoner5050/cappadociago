  }

  .site-footer .footer-info-item a {
    color: #64748b;
    text-decoration: none;
  }

  .site-footer .footer-info-item a:hover {
    color: #b58d00;
  }

  .site-footer .newsletter-form {
    border: 1px solid #e2e8f0;
    box-shadow: 0 5px 14px rgba(15,23,42,.04);
  }

