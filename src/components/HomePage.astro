  {"source": "tripadvisor", "name": "879maritaz", "date": "30 May 2026", "rating": 5, "title": "Great value for money", "text": "Highlighted responsive communication, friendly staff and a reliable shuttle service that made the experience easy."}
];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <!-- CappadociaGo favicon -->
    <link rel="icon" type="image/webp" href="/favicon.webp?v=10" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <meta name="keywords" content={seo.keywords} />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <meta name="author" content="CappadociaGo" />
  <meta name="theme-color" content="#071f4e" />



<link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={`${siteOrigin}/en/`} />
  <link rel="alternate" hreflang="tr" href={`${siteOrigin}/tr/`} />
  <link rel="alternate" hreflang="es" href={`${siteOrigin}/es/`} />
  <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/en/`} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="CappadociaGo" />
  <meta property="og:title" content={seo.title} />
  <meta property="og:description" content={seo.description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:alt" content={seo.heroAlt} />
  <meta property="og:locale" content={seo.ogLocale} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={seo.title} />
  <meta name="twitter:description" content={seo.description} />
  <meta name="twitter:image" content={socialImage} />

  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>

  <!-- Google Fonts: render-blocking olmadan yükle; ilk boyamada sistem fontu kullanılır. -->
  <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </noscript>

</head>
<body>

  <!-- HEADER / NAVBAR -->
  <header class="site-header">
    <div class="header-container">
      <div class="logo">
        <a href={homeUrl} class="logo-home" aria-label="CappadociaGo Home" title="CappadociaGo - Home">
          <img src="/images/logo.png" alt="CappadociaGo" width="400" height="600" loading="lazy" decoding="async"/>
        </a>

        <a
          href="https://www.instagram.com/cappadociago/"
          class="header-instagram"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="CappadociaGo on Instagram"
        >
          <img
            src="/images/icons/instagram-logo.webp"
            alt=""
            class="header-instagram-icon"
            width="23"
            height="23"
            aria-hidden="true" loading="lazy"
          />
          <span>@cappadociago</span>
        </a>
      </div>
      <nav class="main-nav">
        <ul>
          <li><a href={`/${lang}/balloon-tours/`}>{t.nav.balloonTours}</a></li>
          <li><a href={`/${lang}/cappadocia-tours/`}>{t.nav.cappadociaTours}</a></li>
          <li><a href={`/${lang}/activities/`}>{t.nav.activities}</a></li>
          <li><a href={`/${lang}/private-tours/`}>{t.nav.privateTours}</a></li>
          <li><a href={`/${lang}/transfers/`}>{t.nav.transfers}</a></li>
          <li></li>
        </ul>
      </nav>

      <!-- DİL SEÇENEKLERİ MENÜSÜ -->
      <div class="header-right">
        <div class="lang-switcher" id="langSwitcher">
          <button
            class="lang-btn"
            id="langButton"
            type="button"
            aria-label="Select language"
            aria-expanded="false"
          >
            <span class="lang-flag">{currentFlag}</span>
            <span class="lang-code">{currentCode}</span>
            <span class="arrow">▾</span>
          </button>

          <div class="lang-dropdown" id="langDropdown">
            <a href="/en/" data-lang-url="/en/" class:list={["lang-item", { active: lang === "en" }]}>
              <span class="flag">🇬🇧</span>
              <span>English</span>
            </a>

            <a href="/tr/" data-lang-url="/tr/" class:list={["lang-item", { active: lang === "tr" }]}>
              <span class="flag">🇹🇷</span>
              <span>Türkçe</span>
            </a>

            <a href="/es/" data-lang-url="/es/" class:list={["lang-item", { active: lang === "es" }]}>
              <span class="flag">🇪🇸</span>
              <span>Español</span>
            </a>
          </div>
        </div>

        <a href="https://wa.me/905401015050" class="whatsapp-btn" target="_blank" rel="noopener noreferrer">
          <img
            src="/images/icons/whatsapp-logo.webp"
            alt=""
            class="whatsapp-btn-icon"
            width="18"
            height="18"
            aria-hidden="true" loading="lazy"
          />
          <span>{t.contact.whatsapp}</span>
        </a>

        <!-- MOBİL MENÜ BUTONU (HAMBURGER) -->
        <button class="mobile-menu-toggle" type="button" aria-label="Toggle Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </header>

  <!-- HERO VİDEO BÖLÜMÜ -->
  <section class="tbc-hero-form">
    <section class="tbc-video-hero">

      <!-- Hero Görseli: Vercel üzerinden yerel olarak servis edilir -->
      <picture class="tbc-mobile-hero">
        <img
          src="/images/hot-air-balloons-at-sunrise-in-cappadocia-turkey-2021-08-26-19-00-17-utc-min-1-scaled.webp"
          alt={seo.heroAlt}
          width="799"
          height="600"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      </picture>

      <div class="tbc-video-overlay"></div>

      <div class="tbc-video-content">
        <span class="tbc-video-kicker">
          {lang === "tr" ? "KAPADOKYA’YI KEŞFEDİN" : lang === "es" ? "DESCUBRE CAPADOCIA" : "DISCOVER CAPPADOCIA"}
        </span>

        <h1 class="tbc-video-title">
          {lang === "tr" ? "Kapadokya’yı Keşfet" : lang === "es" ? "Descubre Capadocia" : "Discover Cappadocia"}
        </h1>

        <p class="tbc-video-text">
          {lang === "tr" ? "CappadociaGo ile Kapadokya’yı keşfedin. Gün doğumu balon uçuşlarını, Red & Green turları, ATV ve Jeep safarilerini, at turlarını ve havalimanı transferlerini yerel destekle tek yerde karşılaştırın." : lang === "es" ? "Descubre Capadocia con CappadociaGo. Compara vuelos en globo al amanecer, Red & Green Tours, safaris en ATV y Jeep, paseos a caballo y traslados al aeropuerto con asistencia local." : "Discover Cappadocia with CappadociaGo. Compare sunrise hot air balloon flights, Red & Green Tours, ATV and Jeep safaris, horse riding and airport transfers — all with local support in one place."}
        </p>

        <div class="tbc-video-actions">
          <a href="#tours" class="tbc-video-btn tbc-video-btn-primary">
            {t.hero.exploreTours}
          </a>
          <a href="tel:+905401015050" class="tbc-video-btn tbc-video-btn-secondary">
            {t.hero.contactUs}
          </a>
        </div>

        <div class="tbc-partner-reviews">
          <div class="tbc-review-badge" aria-label="TripAdvisor rating">
            <img src="/images/icons/tripadvisor-logo.webp" alt="TripAdvisor" class="tbc-badge-logo" width="22" height="22" loading="lazy" />
            <div class="tbc-badge-info">
              <div class="tbc-stars">★★★★★</div>
              <span class="tbc-badge-text">{t.trust.tripadvisor}</span>
            </div>
          </div>

          <div class="tbc-review-badge" aria-label="Google rating">
            <img src="/images/icons/google-logo.webp" alt="Google" class="tbc-badge-logo" width="22" height="22" loading="lazy" />
            <div class="tbc-badge-info">
              <div class="tbc-stars">★★★★★</div>
              <span class="tbc-badge-text">{t.trust.google}</span>
            </div>
          </div>
        </div>

        <div class="tbc-hero-trust-points" aria-label="Why choose CappadociaGo">
          <div class="tbc-trust-point"><span class="tbc-trust-icon" aria-hidden="true">✹</span><span>{heroTrust.prime}</span></div>
          <div class="tbc-trust-point"><span class="tbc-trust-icon" aria-hidden="true">◉</span><span>{heroTrust.support}</span></div>
          <div class="tbc-trust-point"><span class="tbc-trust-icon" aria-hidden="true">★</span><span>{heroTrust.loved}</span></div>
          <div class="tbc-trust-point"><span class="tbc-trust-icon" aria-hidden="true">✦</span><span>{heroTrust.best}</span></div>
        </div>
      </div>

      <!-- REZERVASYON FORMU VE ÜZERİNDEKİ ORTALANMIŞ BAŞLIK -->
      <div class="tbc-booking-wrap">
        <div class="external-form-title">
          {lang === "tr" ? (
            <>Hayalinizdeki <span class="accent-ready">uçuşa</span> <span class="accent-dreamy">hazır</span> mısınız?</>
          ) : (
            <><span class="accent-ready">Ready</span> to float over <span class="accent-cappadocia">Cappadocia</span> at sunrise?</>
          )}
        </div>
        <div class="cg-experience-dock" aria-label="Cappadocia experience categories">
          <a class="cg-dock-item active" href={`/${lang}/balloon-tours/`}><span class="cg-dock-icon">◉</span><b>{lang === "tr" ? "Balon" : lang === "es" ? "Globos" : "Balloons"}</b></a>
          <a class="cg-dock-item" href={`/${lang}/cappadocia-tours/`}><span class="cg-dock-icon">◇</span><b>{lang === "tr" ? "Turlar" : lang === "es" ? "Tours" : "Tours"}</b></a>
          <a class="cg-dock-item" href={`/${lang}/activities/`}><span class="cg-dock-icon">✦</span><b>{lang === "tr" ? "Aktiviteler" : lang === "es" ? "Actividades" : "Activities"}</b></a>
          <a class="cg-dock-item" href={`/${lang}/private-tours/`}><span class="cg-dock-icon">★</span><b>{lang === "tr" ? "Özel Turlar" : lang === "es" ? "Privados" : "Private"}</b></a>
          <a class="cg-dock-item" href={`/${lang}/transfers/`}><span class="cg-dock-icon">↗</span><b>{lang === "tr" ? "Transfer" : lang === "es" ? "Traslados" : "Transfers"}</b></a>
          <a class="cg-dock-item" href="#tours"><span class="cg-dock-icon">⌁</span><b>{lang === "tr" ? "Tümü" : lang === "es" ? "Todos" : "All Tours"}</b></a>
        </div>
        <div class="tbc-booking-box">
          <form id="tbcBookingForm">
            <input type="hidden" id="tourType" name="Tour Name" required>
            <input type="hidden" id="guestCount" name="Number of Guests" required>

            <div class="tbc-booking-grid">
              
              <!-- 1. Select Tour -->
              <div class="tbc-field-wrap">
                <div class="tbc-custom-select" data-target="tourType">
                  <button type="button" class="tbc-select-btn">
                    <span class="tbc-placeholder">{t.booking.selectTour}</span>
                    <span class="tbc-arrow">▼</span>
                  </button>
                  <div class="tbc-options">
                    
                    <!-- Balloons Tours -->
                    <div class="tbc-opt-group-title">{t.categories.balloonTours}</div>
                    <div class="tbc-option" data-value="Göreme Comfort Hot Air Balloon Tour">Göreme Comfort Hot Air Balloon Tour</div>
                    <div class="tbc-option" data-value="Göreme Standart Hot Air Balloon Tour">Göreme Standart Hot Air Balloon Tour</div>
                    <div class="tbc-option" data-value="Ihlara Valley Balloons Tour">Ihlara Valley Balloons Tour</div>
                    <div class="tbc-option" data-value="Pamukkale Balloons Tour">Pamukkale Balloons Tour</div>
                    <div class="tbc-option" data-value="Soğanlı Valley Balloon Tour">Soğanlı Valley Balloon Tour</div>

                    <!-- Daily Tours -->
                    <div class="tbc-opt-group-title">{t.categories.dailyTours}</div>
                    <div class="tbc-option" data-value="Cappadocia Custom Package Tour">Cappadocia Custom Package Tour</div>
                    <div class="tbc-option" data-value="Blue Tour Cappadocia">Blue Tour Cappadocia</div>
                    <div class="tbc-option" data-value="Red Tour Cappadocia">Red Tour Cappadocia</div>
                    <div class="tbc-option" data-value="Green Tour Cappadocia">Green Tour Cappadocia</div>

                    <!-- Private Tours -->
                    <div class="tbc-opt-group-title">{t.categories.privateTours}</div>
                    <div class="tbc-option" data-value="Private Red Tour Cappadocia">Private Red Tour Cappadocia</div>
                    <div class="tbc-option" data-value="Private Green Tour Cappadocia">Private Green Tour Cappadocia</div>
                    <div class="tbc-option" data-value="Cappadocia Mix Tour">Cappadocia Mix Tour</div>

                    <!-- Transfers -->
                    <div class="tbc-opt-group-title">{t.categories.transfers}</div>
                    <div class="tbc-option" data-value="Kayseri Airport (ASR) Shuttle Transfer">Kayseri Airport (ASR) Shuttle Transfer</div>
                    <div class="tbc-option" data-value="Nevşehir Airport (NAV) Shuttle Transfer">Nevşehir Airport (NAV) Shuttle Transfer</div>
                    <div class="tbc-option" data-value="Private VIP Airport Transfer Cappadocia">Private VIP Airport Transfer Cappadocia</div>

                    <!-- Activites -->
                    <div class="tbc-opt-group-title">{t.categories.activities}</div>
                    <div class="tbc-option" data-value="ATV Tour With Göreme Valleys">ATV Tour With Göreme Valleys</div>
                    <div class="tbc-option" data-value="Jeep Safari Cappadocia">Jeep Safari Cappadocia</div>
                    <div class="tbc-option" data-value="Sunrise or Sunset Horse Riding Cappadocia">Sunrise or Sunset Horse Riding Cappadocia</div>
                    <div class="tbc-option" data-value="Cappadocia Sunset Camel Riding Tour">Cappadocia Sunset Camel Riding Tour</div>
                    <div class="tbc-option" data-value="Cappadocia Classic Car Tour">Cappadocia Classic Car Tour</div>
                    <div class="tbc-option" data-value="Photo Shoot & Flying Dress Experience">Photo Shoot & Flying Dress Experience</div>
                    <div class="tbc-option" data-value="Cappadocia Pottery Making Experience">Cappadocia Pottery Making Experience</div>
                    <div class="tbc-option" data-value="Turkish Night With Cave Dinner Cappadocia">Turkish Night With Cave Dinner Cappadocia</div>
                    <div class="tbc-option" data-value="Balloons Watching Tour Cappadocia">Balloons Watching Tour Cappadocia</div>

                  </div>
                </div>
              </div>

              <!-- 2. TARİH SEKMESİ -->
              <div class="tbc-field-wrap dates-custom-box" id="tbcDateField">
                <span class="dates-top-label">{t.booking.accommodationDates}</span>
                <div class="dates-inputs-row">
                  <button class="date-slot" type="button" data-date-target="start" aria-label="Select start date">
                    <span class="d-m" id="startMonth">Aug</span>
                    <span class="d-d" id="startDay">15</span>
                    <span class="d-a" aria-hidden="true">⌄</span>
                  </button>
                  <span class="date-divider" aria-hidden="true">—</span>
                  <button class="date-slot" type="button" data-date-target="end" aria-label="Select end date">
                    <span class="d-m" id="endMonth">Aug</span>
                    <span class="d-d" id="endDay">16</span>
                    <span class="d-a" aria-hidden="true">⌄</span>
                  </button>
                </div>
                <input type="hidden" id="startDateInput" name="Start Date" required />
                <input type="hidden" id="endDateInput" name="End Date" />
                <div class="tbc-date-popover" id="tbcDatePopover" aria-hidden="true">
                  <div class="tbc-date-head">
                    <button type="button" class="tbc-date-nav" id="tbcDatePrev" aria-label="Previous month">‹</button>
                    <div class="tbc-date-title" id="tbcDateTitle"></div>
                    <button type="button" class="tbc-date-nav" id="tbcDateNext" aria-label="Next month">›</button>
                  </div>
                  <div class="tbc-date-months" id="tbcDateMonths"></div>
                  <div class="tbc-date-help">
                    {lang === "tr" ? "Başlangıç ve bitiş tarihini seçin" : lang === "es" ? "Seleccione la fecha de inicio y fin" : "Select start and end dates"}
                  </div>
                </div>
              </div>

              <!-- 3. Select Person (Guests) -->
              <div class="tbc-field-wrap">
                <div class="tbc-custom-select" data-target="guestCount">
                  <button type="button" class="tbc-select-btn">
                    <span class="tbc-placeholder">{t.booking.selectPerson}</span>
                    <span class="tbc-arrow">▼</span>
                  </button>
                  <div class="tbc-options">
                    <div class="tbc-option" data-value="1 Person">1 Person</div>
                    <div class="tbc-option" data-value="2 Persons">2 Persons</div>
                    <div class="tbc-option" data-value="3 Persons">3 Persons</div>
                    <div class="tbc-option" data-value="4 Persons">4 Persons</div>
                    <div class="tbc-option" data-value="5+ Persons">5+ Persons</div>
                  </div>
                </div>
              </div>

              <!-- 4. Search Button -->
              <div class="tbc-field-wrap">
                <button class="tbc-submit" id="tbcSubmitBtn" type="submit">
                  {t.booking.search}
                </button>
              </div>

            </div>
          </form>

          <div class="tbc-success-box" id="tbcSuccessBox">
            {t.booking.success}
          </div>

          <div class="tbc-error-box" id="tbcErrorBox">
            {t.booking.error}
          </div>
        </div>
      </div>
    </section>
  </section>

  <!-- KAYAN KATEGORİ SLIDER'I -->
  <section class="infinite-slider-section">
    <div class="container">
      <div class="slider-wrapper">
        <button class="slider-arrow prev-btn" id="sliderPrevBtn" type="button">‹</button>
        <div class="infinite-track-container" id="sliderTrackContainer">
          <div class="infinite-track">
            <a class="cat-card" href={`/${lang}/tours/goreme-standart-hot-air-balloon-tour`}><Image src={sliderTourImages.standard} alt="Göreme Standart Hot Air Balloon Tour" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>Göreme Standart Balloon</h3></div></a>
            <a class="cat-card" href={`/${lang}/tours/goreme-comfort-hot-air-balloon-tour`}><Image src={sliderTourImages.comfort} alt="Göreme Comfort Hot Air Balloon Tour" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>Göreme Comfort Balloon</h3></div></a>
            <a class="cat-card" href={`/${lang}/tours/red-tour-cappadocia`}><Image src={sliderTourImages.red} alt="Red Tour Cappadocia" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>Red Tour Cappadocia</h3></div></a>
            <a class="cat-card" href={`/${lang}/tours/green-tour-cappadocia`}><Image src={sliderTourImages.green} alt="Green Tour Cappadocia" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>Green Tour Cappadocia</h3></div></a>
            <a class="cat-card" href={`/${lang}/tours/jeep-safari-cappadocia`}><Image src={sliderTourImages.jeep} alt="Jeep Safari Cappadocia" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>Jeep Safari Cappadocia</h3></div></a>
            <a class="cat-card" href={`/${lang}/tours/atv-tour-with-goreme-valleys`}><Image src={sliderTourImages.atv} alt="ATV Tour With Göreme Valleys" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>ATV Tour</h3></div></a>
            <a class="cat-card" href={`/${lang}/tours/sunrise-sunset-horse-riding-cappadocia`}><Image src={sliderTourImages.horse} alt="Horse Riding Cappadocia" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>Horse Riding Tour</h3></div></a>
            <a class="cat-card" href={`/${lang}/tours/cappadocia-mix-tour`}><Image src={sliderTourImages.mix} alt="Cappadocia Mix Tour" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>Cappadocia Mix Tour</h3></div></a>
            <a class="cat-card" href={`/${lang}/tours/private-red-tour-cappadocia`}><Image src={sliderTourImages.privateRed} alt="Private Red Tour Cappadocia" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>Private Red Tour</h3></div></a>
            <a class="cat-card" href={`/${lang}/tours/private-green-tour-cappadocia`}><Image src={sliderTourImages.privateGreen} alt="Private Green Tour Cappadocia" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>Private Green Tour</h3></div></a>
            <!-- loop duplicates -->
            <a class="cat-card" href={`/${lang}/tours/goreme-standart-hot-air-balloon-tour`}><Image src={sliderTourImages.standard} alt="Göreme Standart Hot Air Balloon Tour" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>Göreme Standart Balloon</h3></div></a>
            <a class="cat-card" href={`/${lang}/tours/goreme-comfort-hot-air-balloon-tour`}><Image src={sliderTourImages.comfort} alt="Göreme Comfort Hot Air Balloon Tour" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>Göreme Comfort Balloon</h3></div></a>
            <a class="cat-card" href={`/${lang}/tours/red-tour-cappadocia`}><Image src={sliderTourImages.red} alt="Red Tour Cappadocia" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>Red Tour Cappadocia</h3></div></a>
            <a class="cat-card" href={`/${lang}/tours/green-tour-cappadocia`}><Image src={sliderTourImages.green} alt="Green Tour Cappadocia" width={440} height={293} loading="lazy" decoding="async" /><div class="cat-overlay"><h3>Green Tour Cappadocia</h3></div></a>
          </div>
        </div>
        <button class="slider-arrow next-btn" id="sliderNextBtn" type="button">›</button>
      </div>
    </div>
  </section>

  <!-- CATEGORY TABS -->
  <section class="category-tabs-section">
    <div class="container">
      <div class="category-tabs" id="tourCategoryTabs">
        <button type="button" class="tab-item active" data-filter="all">{t.categories.allTours}</button>
        <button type="button" class="tab-item" data-filter="balloon">{t.categories.balloonTours}</button>
