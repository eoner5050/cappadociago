function resolveTourCardImage(tour) {
  const href = String(tour?.href || "");
  const slug = href.split("/").filter(Boolean).pop() || String(tour?.title || "");
  return getTourGallery({
    slug,
    title: String(tour?.title || ""),
    preferred: [tour?.image].filter(Boolean),
    max: 1
  })[0] || tour?.image || getSiteGallery(1)[0] || "/images/tours/goreme-standart-hot-air-balloon-tour (2).webp";
}

function resolveProductSlug(tour) {
  const href = String(tour?.href || "");
  const title = String(tour?.title || "");
  const titleMap: Record<string, string> = {
    "ATV Tour With Göreme Valleys": "atv-tour-with-goreme-valleys",
    "Göreme Vadileri ATV Turu": "atv-tour-with-goreme-valleys",
    "Tour ATV por los Valles de Göreme": "atv-tour-with-goreme-valleys",
    "Private VIP Airport Transfer Cappadocia": "private-airport-transfer",
    "Kapadokya Özel VIP Havalimanı Transferi": "private-airport-transfer",
    "Traslado VIP Privado al Aeropuerto de Capadocia": "private-airport-transfer",
    "Göreme Standard Hot Air Balloon Tour": "goreme-standart-hot-air-balloon-tour",
    "Göreme Standart Hot Air Balloon Tour": "goreme-standart-hot-air-balloon-tour",
    "Göreme Comfort Hot Air Balloon Tour": "goreme-comfort-hot-air-balloon-tour",
    "Blue Tour Cappadocia": "blue-tour-cappadocia"
  };
  if (titleMap[title]) return titleMap[title];
  return href.split("/").filter(Boolean).pop() || "";
}



