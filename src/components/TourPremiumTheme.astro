<style is:global>
  :root{
    --tour-bg:#eaf1f7;
    --tour-bg-2:#dde8f2;
    --tour-card:#ffffff;
    --tour-navy:#062d63;
    --tour-blue:#075aa6;
    --tour-blue-bright:#1286d5;
    --tour-gold:#d19a18;
    --tour-gold-soft:#f6e8ba;
    --tour-text:#2a415c;
    --tour-muted:#6d7f93;
    --tour-line:#cad9e7;
  }
  body{background:linear-gradient(145deg,var(--tour-bg) 0%,#f1f6fa 45%,var(--tour-bg-2) 100%)!important;color:var(--tour-text)!important;font-family:'Plus Jakarta Sans',Arial,sans-serif!important}
  .page,.tbc-tour-page{background:
    radial-gradient(circle at 8% 7%,rgba(209,154,24,.12),transparent 26%),
    radial-gradient(circle at 92% 18%,rgba(7,90,166,.11),transparent 28%),
    linear-gradient(145deg,#e8f0f7 0%,#f4f7fa 47%,#dfeaf3 100%)!important;
    min-height:100vh!important;
  }
  .container,.tbc-tour-container{max-width:1200px!important}
  .hero,.tbc-tour-hero{background:linear-gradient(135deg,#062d63 0%,#075aa6 72%,#0b75bd 100%)!important;border:1px solid rgba(255,255,255,.14)!important;border-radius:26px!important;box-shadow:0 22px 55px rgba(6,45,99,.18)!important;padding:28px 30px!important;color:#fff!important;overflow:hidden!important;position:relative!important}
  .hero:after,.tbc-tour-hero:after{content:'';position:absolute;right:-70px;top:-90px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(240,212,138,.28),rgba(240,212,138,0) 70%);pointer-events:none}
  .hero h1,.tbc-tour-title{font-family:'Fraunces',serif!important;color:#fff!important;font-weight:650!important;letter-spacing:-.035em!important;text-shadow:none!important}
  .hero>p,.tbc-tour-desc{color:#eaf4ff!important;line-height:1.72!important}
  .kicker,.tbc-tour-kicker{background:rgba(240,212,138,.14)!important;border:1px solid rgba(240,212,138,.6)!important;color:#f7d770!important;border-radius:999px!important;font-weight:900!important;letter-spacing:.12em!important}
  .hero-badges,.tbc-hero-badges-bar{border-top:1px solid rgba(255,255,255,.17)!important}
  .hero-badges>span,.hero-badges>a,.tbc-badge-item{background:rgba(255,255,255,.10)!important;border:1px solid rgba(255,255,255,.20)!important;color:#fff!important;backdrop-filter:blur(8px)}
  .hero-stars,.tbc-stars{color:#f4c64c!important}
  .gallery,.tbc-photo-grid-wrapper{background:#f9fcff!important;border:1px solid var(--tour-line)!important;border-radius:24px!important;padding:9px!important;box-shadow:0 18px 44px rgba(6,45,99,.10)!important}
  .gallery button,.tbc-main-photo,.tbc-side-photo-item{border-radius:16px!important;overflow:hidden!important}
  .gallery img,.tbc-photo-grid-wrapper img{transition:transform .45s ease!important}.gallery button:hover img,.tbc-photo-grid-wrapper button:hover img{transform:scale(1.025)!important}
  .card,.tbc-tour-card{background:rgba(255,255,255,.96)!important;border:1px solid var(--tour-line)!important;border-radius:24px!important;box-shadow:0 18px 42px rgba(6,45,99,.085)!important}
  .content>section,.tbc-tour-section{border-color:#e1eaf2!important}
  .content h2,.tbc-tour-section h2{font-family:'Fraunces',serif!important;color:var(--tour-navy)!important;font-weight:650!important;letter-spacing:-.02em!important}
  .content p,.tbc-tour-section p{color:#4e647a!important;line-height:1.78!important}
  .checks i,.tbc-tour-check{background:#e7f3fc!important;color:var(--tour-blue)!important}
  .price-card,.tbc-price-card{background:linear-gradient(160deg,#061f49 0%,#073d79 76%,#075aa6 100%)!important;color:#fff!important;border:1px solid rgba(240,212,138,.35)!important;box-shadow:0 22px 50px rgba(6,45,99,.22)!important}
  .price-card h3,.price-card p,.price-card .side-list>div,.tbc-price-card h3,.tbc-price-card p{color:#fff!important}
  .price,.tbc-price{color:#f3c64e!important;text-shadow:none!important}
  .price-card .badges span,.tbc-price-card .badges span{background:rgba(255,255,255,.10)!important;border-color:rgba(240,212,138,.35)!important;color:#f7db8f!important}
  .price-card .phone,.price-card .wa,.tbc-price-card .phone,.tbc-price-card .wa{background:#fff!important;color:var(--tour-navy)!important;border-color:rgba(255,255,255,.7)!important}
  .booking,.tbc-booking-card{background:#fff!important;border:1px solid var(--tour-line)!important;border-top:4px solid var(--tour-gold)!important;border-radius:24px!important;box-shadow:0 18px 42px rgba(6,45,99,.10)!important}
  .booking h3,.tbc-booking-card h3{font-family:'Fraunces',serif!important;color:var(--tour-navy)!important}
  .booking input,.booking select,.booking textarea,.tbc-booking-card input,.tbc-booking-card select,.tbc-booking-card textarea{background:#f7fbff!important;border:1px solid #c9dbe9!important;color:var(--tour-navy)!important;border-radius:13px!important}
  .submit,.tbc-submit-btn{background:linear-gradient(135deg,var(--tour-gold),#edbc3b)!important;color:#08294f!important;border:0!important;font-weight:900!important;box-shadow:0 10px 24px rgba(209,154,24,.24)!important}
  .calendar,.tbc-calendar{border:1px solid #cbdce9!important;border-top:4px solid var(--tour-blue)!important;background:#fff!important;box-shadow:0 24px 55px rgba(6,45,99,.18)!important}
  .day.selected,.tbc-day.selected{background:var(--tour-blue)!important;color:#fff!important;border-color:var(--tour-blue)!important}
  .breadcrumb,.tbc-breadcrumb{color:#5d7389!important}.breadcrumb a,.tbc-breadcrumb a{color:var(--tour-blue)!important;font-weight:800!important}
  .unified-footer,.tbc-footer{border-top:4px solid var(--tour-gold)!important}
  @media(max-width:900px){.hero,.tbc-tour-hero{padding:22px 20px!important;border-radius:20px!important}.gallery,.tbc-photo-grid-wrapper,.card,.tbc-tour-card,.booking,.tbc-booking-card{border-radius:18px!important}}
</style>

<style is:global>
html{background:#eaf1f6!important}body{background:radial-gradient(circle at 12% 3%,rgba(217,165,31,.10),transparent 24%),radial-gradient(circle at 88% 18%,rgba(7,90,166,.10),transparent 28%),linear-gradient(180deg,#eef5fa 0%,#e8f0f6 52%,#f3eee5 100%)!important;background-attachment:fixed!important}.page,.tbc-page,.tour-page,.tour-detail-page{background:transparent!important}.card,.tbc-tour-card,.booking,.tbc-booking-card,.gallery,.tbc-photo-grid-wrapper{background:rgba(255,255,255,.94)!important;backdrop-filter:blur(8px)}
</style>


<style is:global>
/* 2026-08-30 FINAL TOUR SYSTEM — all tour pages visually follow Standard Balloon */
:root{
  --cg-final-navy:#062d63; --cg-final-blue:#075aa6; --cg-final-gold:#d9a51f;
  --cg-final-ink:#263f59; --cg-final-muted:#64778b; --cg-final-line:#d5e0e9;
  --cg-final-bg1:#e9e2d7; --cg-final-bg2:#eef3f6; --cg-final-bg3:#dfe9f1;
}
html,body{background:#e9e2d7!important;}
body{
  background:
    radial-gradient(circle at 9% 4%,rgba(217,165,31,.16),transparent 24%),
    radial-gradient(circle at 92% 16%,rgba(7,90,166,.13),transparent 28%),
    linear-gradient(135deg,var(--cg-final-bg1) 0%,var(--cg-final-bg2) 46%,var(--cg-final-bg3) 100%)!important;
  background-attachment:fixed!important;
}
.page,.tbc-tour-page,.tour-page,.tour-detail-page,main{background:transparent!important;}
.page,.tbc-tour-page{padding-top:22px!important;padding-bottom:64px!important;}
.container,.tbc-tour-container{max-width:1180px!important;margin-inline:auto!important;}
.hero,.tbc-tour-hero{
  background:linear-gradient(120deg,#123b63 0%,#0d3158 58%,#092648 100%)!important;
  border:1px solid rgba(255,255,255,.10)!important;border-radius:24px!important;
  box-shadow:0 16px 38px rgba(8,44,80,.16)!important;color:#fff!important;
}
.hero h1,.tbc-tour-title{font-family:'Fraunces',Georgia,serif!important;color:#fff!important;text-shadow:none!important;}
.hero>p,.tbc-tour-desc{color:rgba(255,255,255,.82)!important;}
.gallery,.tbc-photo-grid-wrapper,.card,.tbc-tour-card,.booking,.tbc-booking-card{
  background:#fff!important;border:1px solid var(--cg-final-line)!important;
  box-shadow:0 12px 30px rgba(9,47,86,.07)!important;
}
.content h2,.tbc-tour-section h2{font-family:'Fraunces',Georgia,serif!important;color:var(--cg-final-navy)!important;}
.content p,.tbc-tour-section p{color:#50647a!important;}
/* Keep every tour description visible on mobile and desktop. */
.content,.tbc-tour-main-card,.tbc-tour-main,.tbc-tour-section{visibility:visible!important;opacity:1!important;}
.content p,.tbc-tour-section p,.checks,.tbc-tour-checks{display:revert!important;max-height:none!important;overflow:visible!important;}
/* Make both reservation systems visually consistent. */
.booking,.tbc-booking-card{border-top:4px solid var(--cg-final-blue)!important;overflow:visible!important;}
.booking input,.booking select,.booking textarea,.tbc-booking-group input,.tbc-booking-group select,.tbc-booking-group textarea{
  background:#f8fbfd!important;border:1px solid #cbdbe8!important;color:var(--cg-final-navy)!important;
}
.submit,.tbc-booking-submit{background:linear-gradient(135deg,var(--cg-final-blue),#0b76c7)!important;color:#fff!important;}
/* Calendar: desktop dropdown, mobile modal so it can never disappear behind content. */
.calendar,.tbc-custom-calendar{z-index:2147481000!important;}
@media(max-width:900px){
  .grid,.tbc-tour-grid{grid-template-columns:1fr!important;}
  .side,.tbc-tour-side{position:static!important;}
  .content,.tbc-tour-main-card{display:block!important;width:100%!important;}
  .content>section,.tbc-tour-section{display:block!important;}
}
@media(max-width:640px){
  .page,.tbc-tour-page{padding:14px 10px 42px!important;}
  .hero,.tbc-tour-hero{padding:22px 17px!important;border-radius:18px!important;}
  .hero h1,.tbc-tour-title{font-size:29px!important;line-height:1.06!important;}
  .hero>p,.tbc-tour-desc{font-size:12px!important;line-height:1.68!important;}
  .content>section,.tbc-tour-section{padding:19px 17px!important;}
  .content h2,.tbc-tour-section h2{font-size:20px!important;}
  .content p,.tbc-tour-section p{font-size:12px!important;line-height:1.78!important;}
  .calendar.open,.tbc-custom-calendar.is-open{
    position:fixed!important;left:50%!important;right:auto!important;top:50%!important;
    transform:translate(-50%,-50%)!important;width:min(360px,calc(100vw - 20px))!important;
    max-width:calc(100vw - 20px)!important;max-height:calc(100vh - 24px)!important;
    overflow:auto!important;margin:0!important;padding:14px!important;border-radius:18px!important;
    background:#fff!important;border:1px solid #bfd1df!important;border-top:4px solid var(--cg-final-gold)!important;
    box-shadow:0 28px 80px rgba(3,22,42,.38)!important;color:var(--cg-final-navy)!important;
  }
  .tbc-custom-calendar.is-open .tbc-cal-title{color:var(--cg-final-navy)!important;}
  .tbc-custom-calendar.is-open .tbc-cal-nav{background:#eaf4fb!important;color:var(--cg-final-blue)!important;}
  .tbc-custom-calendar.is-open .tbc-calendar-weekdays span{color:#60758a!important;}
  .tbc-custom-calendar.is-open .tbc-cal-day{background:#f6fafc!important;color:var(--cg-final-navy)!important;border:1px solid #dce8f0!important;}
  .tbc-custom-calendar.is-open .tbc-cal-day.is-selected{background:var(--cg-final-blue)!important;color:#fff!important;}
  .tbc-custom-calendar.is-open .tbc-calendar-note{color:#60758a!important;border-color:#dde7ef!important;}
  .calendar.open .day{min-height:50px!important;}
}
</style>

