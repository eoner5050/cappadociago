---
import SeoHead from './SeoHead.astro';
const {lang="en", slug, title, hero, rating, reviewCount, price, priceSuffix, badges=[], paragraphs=[], areas=[], benefits=[]} = Astro.props;
const C = {
 en:{weekdays:["Mon","Tue","Wed","Thu","Fri","Sat","Sun"],selectDate:"Select Date",selectPeople:"Select People",children:"Children are included in this number of people.",unit:"Price per person",total:"Total price",home:"Home",transfers:"Transfers",service:"Transfer Service",areas:"Service Areas",why:"Why Choose This Service?",price:"Transfer Price",contact:"Contact via WhatsApp",form:"Quick Reservation Form",formText:"Leave your details and our team will contact you as soon as possible.",name:"Full Name",phone:"Phone",date:"Date",people:"Number of People",message:"Your Message",send:"Send Reservation Request",reviews:"Reviews"},
 tr:{weekdays:["Pzt","Sal","Çar","Per","Cum","Cmt","Paz"],selectDate:"Tarih Seçin",selectPeople:"Kişi Seçin",children:"Çocuklar da bu kişi sayısına dahildir.",unit:"Kişi başı fiyat",total:"Toplam fiyat",home:"Ana Sayfa",transfers:"Transferler",service:"Transfer Hizmeti",areas:"Hizmet Bölgeleri",why:"Neden Bu Hizmeti Seçmelisiniz?",price:"Transfer Fiyatı",contact:"WhatsApp ile İletişim",form:"Hızlı Rezervasyon Formu",formText:"Bilgilerinizi bırakın, ekibimiz en kısa sürede sizinle iletişime geçsin.",name:"Ad Soyad",phone:"Telefon",date:"Tarih",people:"Kişi Sayısı",message:"Mesajınız",send:"Rezervasyon Talebi Gönder",reviews:"Yorum"},
 es:{weekdays:["Lun","Mar","Mié","Jue","Vie","Sáb","Dom"],selectDate:"Seleccionar fecha",selectPeople:"Seleccionar personas",children:"Los niños también están incluidos en este número de personas.",unit:"Precio por persona",total:"Precio total",home:"Inicio",transfers:"Traslados",service:"Servicio de Traslado",areas:"Zonas de Servicio",why:"¿Por Qué Elegir Este Servicio?",price:"Precio del Traslado",contact:"Contactar por WhatsApp",form:"Formulario de Reserva Rápida",formText:"Déjanos tus datos y nuestro equipo se pondrá en contacto contigo lo antes posible.",name:"Nombre Completo",phone:"Teléfono",date:"Fecha",people:"Número de Personas",message:"Tu Mensaje",send:"Enviar Solicitud de Reserva",reviews:"Reseñas"}
}[lang];
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || "";
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "";
const links={en:`/en/transfers/${slug}`,tr:`/tr/transfers/${slug}`,es:`/es/transfers/${slug}`};
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<SeoHead title={`${title} | CappadociaGo`} description={hero} lang={lang} />
<style>
:root{--blue:#0e4594;--blue2:#294f84;--ink:#092d67;--bg:#f6f8fb;--line:#dce5f0;--green:#10aa50}
*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:#10294d}a{text-decoration:none;color:inherit}
.top{background:white;border-bottom:1px solid #e7edf5}.topin{max-width:1180px;margin:auto;padding:15px 22px;display:flex;align-items:center;gap:18px}.brand{font-weight:900;color:var(--ink)}.langs{margin-left:auto;display:flex;gap:7px}.langs a{border:1px solid #d6e0ed;border-radius:20px;padding:7px 10px;font-size:12px;font-weight:800;background:#fff}.langs a.active{background:#eef5ff;color:var(--blue)}
.wrap{max-width:1180px;margin:24px auto;padding:0 18px}.hero{background:linear-gradient(110deg,#0d4799,#34557e);border-radius:0 0 26px 26px;padding:28px 34px 34px;color:white;box-shadow:0 14px 32px rgba(19,55,105,.12)}.kicker{display:inline-block;border:1px solid rgba(255,255,255,.25);border-radius:20px;padding:6px 12px;font-size:11px;font-weight:900;letter-spacing:.5px}.hero h1{font-size:38px;line-height:1.05;margin:16px 0 12px}.hero p{max-width:800px;line-height:1.7;font-weight:600}
.grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:22px;margin-top:24px}.card{background:white;border:1px solid var(--line);border-radius:22px;padding:28px;box-shadow:0 12px 30px rgba(18,49,89,.07)}h2{font-size:25px;color:#062d67;margin:0 0 14px}.copy p{line-height:1.75;margin:0 0 16px}.divider{height:1px;background:var(--line);margin:24px 0}.areas{display:grid;grid-template-columns:1fr 1fr;gap:14px}.check:before{content:"✓";display:inline-grid;place-items:center;width:19px;height:19px;border-radius:50%;background:#eaf9ef;color:#0aa24b;font-weight:900;margin-right:8px}
.priceLabel{font-size:12px;color:#63738b}.price{font-size:38px;color:#0b4498;font-weight:900;margin:8px 0}.suffix{font-size:13px;color:#65758e;font-weight:700}.badges{display:flex;flex-wrap:wrap;gap:8px}.badge{font-size:11px;font-weight:800;background:#f2f7ff;border:1px solid #dce7f7;border-radius:18px;padding:7px 10px}.rating{margin-top:16px;font-weight:900;color:#0a3f8b}.stars{color:#f2b400;letter-spacing:1px}.phone,.wa{display:block;text-align:center;border-radius:24px;padding:13px;font-weight:900;margin-top:15px}.phone{background:#f4f8fd;border:1px solid #d6e2f1}.wa{background:var(--green);color:white}.benefits{margin-top:18px}.benefits div{margin:12px 0;line-height:1.45}.benefits div:before{content:"✓";color:#0a55b2;font-weight:900;margin-right:9px}
.form{margin-top:18px}.form h2{font-size:20px}.form p{font-size:13px;line-height:1.55;color:#66758c}.form label{font-size:12px;font-weight:800;display:block;margin:13px 0 6px}.form input,.form select,.form textarea{width:100%;padding:13px;border:1px solid #cfdaea;border-radius:12px;background:#fff}.form textarea{min-height:90px}.send{width:100%;border:0;background:#0c48a1;color:#fff;font-weight:900;padding:14px;border-radius:22px;margin-top:14px}
.live-date-wrap{position:relative}.live-date-input{cursor:pointer}.live-calendar{position:absolute;top:calc(100% + 8px);right:0;width:350px;max-width:calc(100vw - 32px);background:#fff;border:1px solid #cfdaea;border-radius:16px;padding:14px;box-shadow:0 18px 45px rgba(18,49,89,.18);z-index:999;display:none}.live-calendar.open{display:block}.live-cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}.live-cal-head button{width:34px;margin:0;padding:7px;background:#eef5ff;color:#0e4594}.live-cal-title{font-weight:900;color:#062d67}.live-week,.live-days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}.live-week span{text-align:center;font-size:10px;font-weight:800;color:#64748b}.live-day{min-width:0;min-height:52px;margin:0!important;padding:4px 1px!important;border-radius:10px!important;background:#f7faff!important;border:1px solid #dce5f0!important;color:#092d67!important;display:flex!important;flex-direction:column;align-items:center;justify-content:center;overflow:hidden}.live-day.empty{visibility:hidden}.live-day.disabled{opacity:.42;cursor:not-allowed}.live-day.selected{background:#eaf2ff!important;border-color:#0e4594!important}.live-day-num{font-size:11px;font-weight:900}.live-day-price{font-size:8px;font-weight:900;color:#0e4594;white-space:nowrap}.live-day-stock{font-size:7px;color:#10aa50;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}.live-day.disabled .live-day-stock{color:#94a3b8}.live-note{font-size:11px;color:#64748b;margin-top:6px}.live-total{display:none;margin-top:10px;padding:12px;border-radius:12px;background:#f7faff;border:1px solid #dce5f0}.live-total.show{display:block}.live-total-row{display:flex;justify-content:space-between;gap:10px;font-size:12px}.live-total-row strong{font-size:17px;color:#0e4594}.live-error{grid-column:1/-1;padding:15px;text-align:center;color:#b91c1c;font-size:11px}
@media(max-width:850px){.grid{grid-template-columns:1fr}.hero h1{font-size:30px}.areas{grid-template-columns:1fr}.wrap{margin-top:12px}.hero{padding:24px}.card{padding:22px}}
</style></head><body>
<header class="top"><div class="topin"><a class="brand" href={`/${lang}/`}>CAPPADOCIAGO</a><nav class="langs"><a class={lang==="en"?"active":""} href={links.en}>🇬🇧 EN</a><a class={lang==="tr"?"active":""} href={links.tr}>🇹🇷 TR</a><a class={lang==="es"?"active":""} href={links.es}>🇪🇸 ES</a></nav></div></header>
<main class="wrap"><section class="hero"><span class="kicker">CAPPADOCIAGO</span><h1>{title}</h1><p>{hero}</p></section>
<div class="grid"><section class="card copy"><h2>{C.service}</h2>{paragraphs.map(p=><p>{p}</p>)}<div class="divider"></div><h2>{C.areas}</h2><div class="areas">{areas.map(a=><div class="check">{a}</div>)}</div><div class="divider"></div><h2>{C.why}</h2><p>{benefits.join(" ")}</p></section>
<aside><section class="card"><div class="priceLabel">{C.price}</div><div class="price"><span id="live-starting-price">{price}</span> <span class="suffix">{priceSuffix}</span></div><div class="badges">{badges.map(b=><span class="badge">{b}</span>)}</div><div class="rating"><span class="stars">★★★★★</span> {rating} · {reviewCount} {C.reviews}</div><a class="phone" href="tel:+905401015050">☎ +90 540 101 50 50</a><a class="wa" href="https://wa.me/905401015050">WhatsApp</a><div class="benefits">{benefits.map(b=><div>{b}</div>)}</div></section>
<section class="card form"><h2>{C.form}</h2><p>{C.formText}</p><form id="live-booking-form" data-product-slug={slug} data-lang={lang} data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey}><label>{C.name}</label><input id="live-name" required><label>{C.phone}</label><input id="live-phone" type="tel" required><label>{C.date}</label><div class="live-date-wrap"><input id="live-date" class="live-date-input" type="text" placeholder={C.selectDate} readonly required><div class="live-calendar" id="live-calendar"><div class="live-cal-head"><button type="button" id="live-prev">‹</button><div class="live-cal-title" id="live-title"></div><button type="button" id="live-next">›</button></div><div class="live-week">{C.weekdays.map(d=><span>{d}</span>)}</div><div class="live-days" id="live-days"></div></div></div><label>{C.people}</label><select id="live-guests" required><option value="">{C.selectPeople}</option></select><div class="live-note">{C.children}</div><div class="live-total" id="live-total"><div class="live-total-row"><span>{C.unit}</span><span id="live-unit-price">—</span></div><div class="live-total-row"><span>{C.total}</span><strong id="live-total-price">—</strong></div></div><label>{C.message}</label><textarea id="live-message"></textarea><button class="send" type="submit">{C.send}</button></form></section></aside></div></main><script>
  const liveForm = document.getElementById("live-booking-form");
  if (liveForm) {
    const lang = liveForm.dataset.lang || "en";
    const T = {
      en:{months:["January","February","March","April","May","June","July","August","September","October","November","December"],left:"left",closed:"Closed",sold:"Sold out",unavailable:"Unavailable",loading:"Loading availability...",selectPeople:"Select People",person:"Person",people:"People",request:"Reservation Request",name:"Name",phone:"Phone",date:"Date",guests:"People",unit:"Price per person",total:"Total"},
      tr:{months:["Ocak","Şubat","Mart","Nisan","Mayıs","Haziran","Temmuz","Ağustos","Eylül","Ekim","Kasım","Aralık"],left:"yer kaldı",closed:"Kapalı",sold:"Dolu",unavailable:"Müsait değil",loading:"Müsaitlik yükleniyor...",selectPeople:"Kişi Seçin",person:"Kişi",people:"Kişi",request:"Rezervasyon Talebi",name:"Ad Soyad",phone:"Telefon",date:"Tarih",guests:"Kişi",unit:"Kişi başı",total:"Toplam"},
      es:{months:["Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"],left:"plazas",closed:"Cerrado",sold:"Agotado",unavailable:"No disponible",loading:"Cargando disponibilidad...",selectPeople:"Seleccionar personas",person:"Persona",people:"Personas",request:"Solicitud de Reserva",name:"Nombre",phone:"Teléfono",date:"Fecha",guests:"Personas",unit:"Precio por persona",total:"Total"}
    }[lang];
    const slug=liveForm.dataset.productSlug, base=liveForm.dataset.supabaseUrl, key=liveForm.dataset.supabaseKey;
    const dateEl=document.getElementById("live-date"), cal=document.getElementById("live-calendar"), days=document.getElementById("live-days"), title=document.getElementById("live-title"), guests=document.getElementById("live-guests"), totalBox=document.getElementById("live-total"), unitEl=document.getElementById("live-unit-price"), totalEl=document.getElementById("live-total-price"), starting=document.getElementById("live-starting-price");
    let product=null, availability={}, selected=null, month=new Date().getMonth(), year=new Date().getFullYear();
    const pad=n=>String(n).padStart(2,"0"), keyDate=(y,m,d)=>`${y}-${pad(m+1)}-${pad(d)}`, money=v=>`${Number(v).toLocaleString(lang==="tr"?"tr-TR":lang==="es"?"es-ES":"en-US",{maximumFractionDigits:2})} €`, remain=r=>Math.max(Number(r?.capacity||0)-Number(r?.booked||0),0);
    async function get(path){const r=await fetch(`${base}/rest/v1/${path}`,{headers:{apikey:key,Authorization:`Bearer ${key}`}});if(!r.ok)throw new Error(await r.text());return r.json()}
    function effective(k){return availability[k]|| (product?{date:k,price:Number(product.default_price||0),capacity:Number(product.default_capacity||0),booked:0,status:"available"}:null)}
    function available(r){return !!r&&r.status==="available"&&Number(r.capacity)>0&&remain(r)>0}
    async function loadProduct(){if(!base||!key)return;const rows=await get(`products?slug=eq.${encodeURIComponent(slug)}&active=eq.true&select=id,default_price,default_capacity&limit=1`);product=rows[0]||null;if(!product)return;const today=new Date().toISOString().slice(0,10);const prices=await get(`availability?product_id=eq.${product.id}&date=gte.${today}&status=eq.available&capacity=gt.0&select=price,capacity,booked&order=price.asc&limit=100`);const valid=prices.filter(r=>remain(r)>0&&Number(r.price)>0);const candidates=valid.map(r=>Number(r.price)).filter(v=>v>0);const min=candidates.length?Math.min(...candidates):Number(product.default_price||0);if(min>0&&starting){starting.textContent=money(min);let old=starting.parentElement?.querySelector('[data-live-old-price]');if(!old){old=document.createElement('del');old.setAttribute('data-live-old-price','');old.style.cssText='margin-right:7px;color:#8b95a5;font-size:13px;text-decoration:line-through';starting.parentElement?.insertBefore(old,starting)}old.textContent=money(Math.round(min*1.20))}}
    async function loadMonth(){if(!product)return;days.innerHTML=`<div class="live-error" style="color:#64748b">${T.loading}</div>`;const first=`${year}-${pad(month+1)}-01`, last=`${year}-${pad(month+1)}-${pad(new Date(year,month+1,0).getDate())}`;try{const rows=await get(`availability?product_id=eq.${product.id}&date=gte.${first}&date=lte.${last}&select=date,price,capacity,booked,status&order=date.asc`);availability={};rows.forEach(r=>availability[r.date]=r);render()}catch(e){console.error(e);days.innerHTML=`<div class="live-error">${T.unavailable}</div>`}}
    function render(){days.innerHTML="";title.textContent=`${T.months[month]} ${year}`;let offset=new Date(year,month,1).getDay();offset=offset===0?6:offset-1;for(let i=0;i<offset;i++){const b=document.createElement("button");b.type="button";b.className="live-day empty";days.appendChild(b)}const last=new Date(year,month+1,0).getDate();for(let d=1;d<=last;d++){const kd=keyDate(year,month,d), r=effective(kd), past=new Date(year,month,d)<new Date(new Date().setHours(0,0,0,0)), ok=!past&&available(r), b=document.createElement("button");b.type="button";b.className="live-day"+(ok?"":" disabled")+(selected?.date===kd?" selected":"");b.disabled=!ok;let status=r?(r.status==="closed"?T.closed:remain(r)<=0?T.sold:ok?`${remain(r)} ${T.left}`:T.unavailable):T.unavailable;b.innerHTML=`<span class="live-day-num">${d}</span>${r&&Number(r.price)>0?`<span class="live-day-price">${money(r.price)}</span>`:""}<span class="live-day-stock">${status}</span>`;if(ok)b.onclick=()=>choose(r,d);days.appendChild(b)}}
    function choose(r,d){selected=r;dateEl.value=`${pad(d)}.${pad(month+1)}.${year}`;guests.innerHTML=`<option value="">${T.selectPeople}</option>`;for(let i=1;i<=Math.min(remain(r),20);i++)guests.insertAdjacentHTML("beforeend",`<option value="${i}">${i} ${i===1?T.person:T.people}</option>`);unitEl.textContent=money(r.price);totalBox.classList.add("show");updateTotal();cal.classList.remove("open");render()}
    function updateTotal(){if(!selected)return;const n=Number(guests.value||0);totalEl.textContent=n?money(Number(selected.price)*n):"—"}
    dateEl.addEventListener("click",async()=>{cal.classList.toggle("open");if(cal.classList.contains("open"))await loadMonth()});guests.addEventListener("change",updateTotal);document.getElementById("live-prev").onclick=async()=>{month--;if(month<0){month=11;year--}await loadMonth()};document.getElementById("live-next").onclick=async()=>{month++;if(month>11){month=0;year++}await loadMonth()};document.addEventListener("click",e=>{if(!cal.contains(e.target)&&e.target!==dateEl)cal.classList.remove("open")});
    liveForm.addEventListener("submit",e=>{e.preventDefault();if(!selected||!guests.value)return;const n=Number(guests.value), msg=[T.request,`${T.name}: ${document.getElementById("live-name").value}`,`${T.phone}: ${document.getElementById("live-phone").value}`,`${T.date}: ${dateEl.value}`,`${T.guests}: ${n}`,`${T.unit}: ${money(selected.price)}`,`${T.total}: ${money(Number(selected.price)*n)}`,document.getElementById("live-message").value].filter(Boolean).join("\n");window.open(`https://wa.me/905401015050?text=${encodeURIComponent(msg)}`,"_blank")});
    async function applyHomePrefill(){const q=new URLSearchParams(location.search),qd=q.get("date"),qp=Math.max(1,Math.min(20,Number(q.get("people")||0)));if(!qd||!/^\d{4}-\d{2}-\d{2}$/.test(qd)||!product)return;const [yy,mm,dd]=qd.split("-").map(Number);year=yy;month=mm-1;await loadMonth();const r=effective(qd);if(available(r)){choose(r,dd);if(qp){guests.value=String(qp);updateTotal()}}}
    loadProduct().then(async()=>{await loadMonth();await applyHomePrefill()}).catch(console.error);
  }
</script></body></html>
<!-- CG_FINAL_MOBILE_TOUR_CONTENT_PHONE -->
<link rel="stylesheet" href="/tour-mobile-critical-v3.css" />
