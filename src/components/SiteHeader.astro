---
const { lang = 'en', active = '', detailSlug = '', section = '' } = Astro.props;
const copy = {
  en: { balloon:'Balloon Tours', cappadocia:'Cappadocia Tours', activities:'Activities', private:'Private Tours', transfers:'Transfers', menu:'Menu' },
  tr: { balloon:'Balon Turları', cappadocia:'Kapadokya Turları', activities:'Aktiviteler', private:'Özel Turlar', transfers:'Transferler', menu:'Menü' },
  es: { balloon:'Tours en Globo', cappadocia:'Tours por Capadocia', activities:'Actividades', private:'Tours Privados', transfers:'Traslados', menu:'Menú' },
};
const c = copy[lang] || copy.en;
const code = lang.toUpperCase();
const resolvedSection = section || (/transfer/i.test(detailSlug) ? 'transfers' : 'tours');
const routeFor = (targetLang) => detailSlug
  ? `/${targetLang}/${resolvedSection}/${detailSlug}/`
  : active === 'balloon' ? `/${targetLang}/balloon-tours/`
  : active === 'cappadocia' ? `/${targetLang}/cappadocia-tours/`
  : active === 'private' ? `/${targetLang}/private-tours/`
  : active === 'transfers' ? `/${targetLang}/transfers/`
  : active === 'activities' ? `/${targetLang}/activities/`
  : `/${targetLang}/`;
---
<header class="cg-tour-header" data-cg-tour-header>
  <div class="cg-tour-header__inner">
    <div class="cg-tour-header__brand">
      <a href={`/${lang}/`} class="cg-tour-header__logo" aria-label="CappadociaGo home">
        <img src="/images/logo.png" alt="CappadociaGo" width="600" height="200" />
      </a>
      <a class="cg-tour-header__phone" href="https://wa.me/905401015050" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp +90 540 101 50 50">
        <img src="/images/icons/whatsapp-logo.webp" alt="" width="20" height="20" />
        <span>+90 540 101 50 50</span>
      </a>
    </div>

    <nav class="cg-tour-header__nav" aria-label="Main navigation">
      <a class={active==='balloon'?'active':''} href={`/${lang}/balloon-tours/`}>{c.balloon}</a>
      <a class={active==='cappadocia'?'active':''} href={`/${lang}/cappadocia-tours/`}>{c.cappadocia}</a>
      <a class={active==='activities'?'active':''} href={`/${lang}/activities/`}>{c.activities}</a>
      <a class={active==='private'?'active':''} href={`/${lang}/private-tours/`}>{c.private}</a>
      <a class={active==='transfers'?'active':''} href={`/${lang}/transfers/`}>{c.transfers}</a>
    </nav>

    <div class="cg-tour-header__actions">
      <div class="cg-tour-header__language">
        <button type="button" class="cg-tour-header__language-btn" aria-haspopup="true" aria-expanded="false">
          <span>{code}</span><i>⌄</i>
        </button>
        <div class="cg-tour-header__language-menu" role="menu">
          <a href={routeFor('en')}>EN · English</a>
          <a href={routeFor('tr')}>TR · Türkçe</a>
          <a href={routeFor('es')}>ES · Español</a>
        </div>
      </div>
      <button class="cg-tour-header__burger" type="button" aria-label={c.menu} aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="cg-tour-header__mobile" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <a href={`/${lang}/balloon-tours/`}>{c.balloon}</a>
      <a href={`/${lang}/cappadocia-tours/`}>{c.cappadocia}</a>
      <a href={`/${lang}/activities/`}>{c.activities}</a>
      <a href={`/${lang}/private-tours/`}>{c.private}</a>
      <a href={`/${lang}/transfers/`}>{c.transfers}</a>
    </nav>
    <a class="cg-tour-header__mobile-phone" href="https://wa.me/905401015050" target="_blank" rel="noopener noreferrer">
      <img src="/images/icons/whatsapp-logo.webp" alt="" width="20" height="20" />
      +90 540 101 50 50
    </a>
  </div>
</header>
<script is:inline>
  document.querySelectorAll('[data-cg-tour-header]').forEach((header) => {
    const burger = header.querySelector('.cg-tour-header__burger');
    const mobile = header.querySelector('.cg-tour-header__mobile');
    const langWrap = header.querySelector('.cg-tour-header__language');
    const langBtn = header.querySelector('.cg-tour-header__language-btn');
    const langMenu = header.querySelector('.cg-tour-header__language-menu');
    const setMenu = (open) => {
      header.classList.toggle('menu-open', open);
      burger?.setAttribute('aria-expanded', String(open));
      mobile?.setAttribute('aria-hidden', String(!open));
    };
    burger?.addEventListener('click', (event) => {
      event.stopPropagation();
      setMenu(!header.classList.contains('menu-open'));
      langWrap?.classList.remove('open');
      langBtn?.setAttribute('aria-expanded','false');
    });
    langBtn?.addEventListener('click', (event) => {
      event.stopPropagation();
      const open = !langWrap?.classList.contains('open');
      langWrap?.classList.toggle('open', open);
      langBtn.setAttribute('aria-expanded', String(open));
      setMenu(false);
    });
    mobile?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target)) {
        setMenu(false);
        langWrap?.classList.remove('open');
        langBtn?.setAttribute('aria-expanded','false');
      }
    });
  });
</script>
<style is:global>
  :root{--cg-head-blue:#075aa6;--cg-head-navy:#062d63;--cg-head-gold:#d19a18;--cg-head-line:#dce5ee}
  .cg-tour-header{position:sticky;top:0;z-index:1400;width:100%;background:#fff;border-top:1px solid rgba(209,154,24,.26);border-bottom:1px solid #edf1f5;box-shadow:0 5px 18px rgba(6,45,99,.045);font-family:'Plus Jakarta Sans',Arial,sans-serif}
  .cg-tour-header__inner{width:min(1380px,calc(100% - 46px));height:82px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:24px}
  .cg-tour-header__brand,.cg-tour-header__actions{display:flex;align-items:center;min-width:0}.cg-tour-header__brand{gap:16px}
  .cg-tour-header__logo{display:flex;align-items:center;flex:0 0 auto}.cg-tour-header__logo img{display:block;width:auto;height:62px;max-width:170px;object-fit:contain}
  .cg-tour-header__phone{height:42px;padding:0 16px;display:inline-flex;align-items:center;gap:9px;border:1px solid #d5e1eb;border-radius:999px;background:#fff;color:var(--cg-head-navy);font-size:12px;font-weight:800;text-decoration:none;white-space:nowrap;box-shadow:0 6px 16px rgba(6,45,99,.05)}
  .cg-tour-header__phone img{width:18px;height:18px;object-fit:contain}
  .cg-tour-header__nav{display:flex;align-items:center;justify-content:center;gap:26px;min-width:0;flex:1}.cg-tour-header__nav a{position:relative;padding:31px 0 29px;color:#0b2341;font-size:12.5px;font-weight:800;text-decoration:none;white-space:nowrap}.cg-tour-header__nav a:hover,.cg-tour-header__nav a.active{color:var(--cg-head-blue)}.cg-tour-header__nav a.active:after{content:'';position:absolute;left:0;right:0;bottom:20px;height:2px;border-radius:9px;background:var(--cg-head-gold)}
  .cg-tour-header__actions{gap:10px;flex:0 0 auto}.cg-tour-header__language{position:relative}.cg-tour-header__language-btn{height:42px;min-width:78px;padding:0 15px;border:1px solid #8e959d;border-radius:999px;background:#9ca0a4;color:#fff;font:800 11px/1 'Plus Jakarta Sans',Arial,sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 8px 20px rgba(10,31,54,.14)}.cg-tour-header__language-btn i{font-style:normal;color:#f5c44e;font-size:13px}.cg-tour-header__language-menu{display:none;position:absolute;right:0;top:49px;min-width:178px;padding:7px;background:#071a2f;border:1px solid rgba(209,154,24,.35);border-radius:14px;box-shadow:0 18px 40px rgba(4,23,43,.2)}.cg-tour-header__language.open .cg-tour-header__language-menu{display:grid}.cg-tour-header__language-menu a{padding:10px 11px;border-radius:9px;color:#fff;font-size:11px;font-weight:700;text-decoration:none}.cg-tour-header__language-menu a:hover{background:rgba(255,255,255,.09);color:#ffd46d}
  .cg-tour-header__burger{display:none;width:42px;height:42px;padding:0;border:0;border-radius:50%;background:var(--cg-head-blue);align-items:center;justify-content:center;flex-direction:column;gap:4px;box-shadow:0 6px 16px rgba(7,90,166,.18);cursor:pointer}.cg-tour-header__burger span{display:block;width:18px;height:2px;border-radius:4px;background:#fff;transition:transform .2s,opacity .2s}.cg-tour-header.menu-open .cg-tour-header__burger span:nth-child(1){transform:translateY(6px) rotate(45deg)}.cg-tour-header.menu-open .cg-tour-header__burger span:nth-child(2){opacity:0}.cg-tour-header.menu-open .cg-tour-header__burger span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
  .cg-tour-header__mobile{display:none}
  @media(max-width:1120px){.cg-tour-header__nav{display:none}.cg-tour-header__burger{display:flex}.cg-tour-header__mobile{display:none;position:absolute;left:14px;right:14px;top:calc(100% + 8px);padding:12px;background:#fff;border:1px solid #d9e4ed;border-radius:18px;box-shadow:0 20px 50px rgba(6,45,99,.18)}.cg-tour-header.menu-open .cg-tour-header__mobile{display:block}.cg-tour-header__mobile nav{display:grid}.cg-tour-header__mobile nav a{padding:13px 14px;border-bottom:1px solid #edf2f6;color:var(--cg-head-navy);font-size:13px;font-weight:800;text-decoration:none}.cg-tour-header__mobile nav a:last-child{border-bottom:0}.cg-tour-header__mobile-phone{margin-top:10px;min-height:44px;display:flex;align-items:center;justify-content:center;gap:9px;border-radius:12px;background:#f0fbf5;color:#146b40;font-size:12px;font-weight:800;text-decoration:none}.cg-tour-header__mobile-phone img{width:18px;height:18px}}
  @media(max-width:680px){.cg-tour-header__inner{width:calc(100% - 20px);height:72px;gap:8px}.cg-tour-header__brand{gap:8px}.cg-tour-header__logo img{height:53px;max-width:142px}.cg-tour-header__phone{width:38px;height:38px;padding:0;justify-content:center}.cg-tour-header__phone span{display:none}.cg-tour-header__phone img{width:18px;height:18px}.cg-tour-header__language-btn{min-width:62px;height:38px;padding:0 11px;font-size:10px}.cg-tour-header__burger{width:38px;height:38px}.cg-tour-header__mobile{left:10px;right:10px;top:calc(100% + 6px)}}
  @media(max-width:360px){.cg-tour-header__logo img{height:48px;max-width:128px}.cg-tour-header__inner{width:calc(100% - 14px)}.cg-tour-header__actions{gap:6px}.cg-tour-header__language-btn{min-width:56px;padding:0 8px}.cg-tour-header__phone{width:36px;height:36px}.cg-tour-header__burger{width:36px;height:36px}}
</style>
