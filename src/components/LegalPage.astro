---
import SeoHead from './SeoHead.astro';
const { lang='en', title, paragraphs=[] } = Astro.props;
const copy = {
  en:{home:'Home',balloon:'Balloon Tours',tours:'Cappadocia Tours',activities:'Activities',private:'Private Tours',transfers:'Transfers',official:'Official English text supplied by CappadociaGo.'},
  tr:{home:'Ana Sayfa',balloon:'Balon Turları',tours:'Kapadokya Turları',activities:'Aktiviteler',private:'Özel Turlar',transfers:'Transferler',official:'CappadociaGo tarafından sağlanan resmi İngilizce metindir.'},
  es:{home:'Inicio',balloon:'Tours en Globo',tours:'Tours por Capadocia',activities:'Actividades',private:'Tours Privados',transfers:'Traslados',official:'Texto oficial en inglés facilitado por CappadociaGo.'}
}[lang] || null;
const flag = lang==='tr'?'🇹🇷':lang==='es'?'🇪🇸':'🇬🇧';
const code = lang.toUpperCase();
function typeOf(text='') {
  if (/^\d+\.?\s+[A-ZÇĞİÖŞÜÑÁÉÍÓÚ]/.test(text) || /^[A-ZÇĞİÖŞÜÑÁÉÍÓÚ][A-Z0-9ÇĞİÖŞÜÑÁÉÍÓÚ &()\-–—:'’]+$/.test(text)) return 'heading';
  if (/^(•|·|o\s|\d+\.\d+\.)/.test(text)) return 'bullet';
  return 'p';
}
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><SeoHead title={`${title} | CappadociaGo`} description={paragraphs[0] || title} lang={lang} /><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"></head>
<body>
<header class="site-header"><div class="header-container"><a class="logo" href={`/${lang}/`}><img src="/images/logo.png" alt="CappadociaGo" loading="lazy" width="600" height="200"/></a><nav><a href={`/${lang}/balloon-tours/`}>{copy.balloon}</a><a href={`/${lang}/cappadocia-tours/`}>{copy.tours}</a><a href={`/${lang}/activities/`}>{copy.activities}</a><a href={`/${lang}/private-tours/`}>{copy.private}</a><a href={`/${lang}/transfers/`}>{copy.transfers}</a></nav><div class="right"><span>{flag} {code}</span><a href="https://wa.me/905401015050">WhatsApp</a></div></div></header>
<main><div class="wrap"><div class="crumb"><a href={`/${lang}/`}>{copy.home}</a><span>›</span><span>{title}</span></div><section class="hero"><span>CAPPADOCIAGO</span><h1>{title}</h1>{paragraphs[0] && <p>{paragraphs[0]}</p>}{lang!=='en' && <p class="note">{copy.official}</p>}</section><article class="card">{paragraphs.slice(1).map((text)=> typeOf(text)==='heading' ? <h2>{text}</h2> : typeOf(text)==='bullet' ? <div class="bullet"><i>✓</i><p>{text.replace(/^(•|·)\s*/, '')}</p></div> : <p>{text}</p>)}</article></div></main>
<footer><div><strong>CappadociaGo</strong><span>Cappadocia, Nevşehir, Türkiye</span></div><div><a href="tel:+905401015050">+90 540 101 50 50</a><a href="mailto:info@kapheratravel.com">info@kapheratravel.com</a></div></footer>

<style>
:root{
  --navy:#071f4e;--navy2:#0b2f68;--gold:#f5b700;--cream:#f7f3e9;
  --ink:#112744;--muted:#65758a;--line:#e4ded2;--white:#fff
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:'Plus Jakarta Sans',Arial,sans-serif;background:
  radial-gradient(circle at 6% 4%,rgba(245,183,0,.08),transparent 26%),
  linear-gradient(180deg,#f8f5ed 0,#f5f1e7 100%);color:var(--ink)}
.site-header{background:#fff;border-bottom:1px solid #e5e9ef;position:sticky;top:0;z-index:50}
.header-container{max-width:1200px;height:86px;margin:auto;padding:0 18px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo img{height:62px;width:auto;display:block}
.header-container nav{display:flex;align-items:center;gap:20px}
.header-container nav a,.right a{color:var(--navy);text-decoration:none;font-size:12px;font-weight:800}
.right{display:flex;align-items:center;gap:12px;font-size:11px;color:#718096}
.right a{border:1px solid #dbe3ec;border-radius:999px;padding:9px 13px;background:#fff}
.wrap{max-width:1080px;margin:auto;padding:22px 18px 68px}
.crumb{display:flex;gap:7px;align-items:center;font-size:11px;color:#718096;margin-bottom:13px}
.crumb a{color:var(--navy);text-decoration:none;font-weight:700}
.hero{
  background:rgba(255,255,255,.96);color:var(--navy);padding:32px 30px 28px;border-radius:23px;
  border:1px solid var(--line);box-shadow:0 14px 34px rgba(7,31,78,.055);position:relative;overflow:hidden
}
.hero:after{content:"";position:absolute;left:30px;right:30px;bottom:0;height:1px;background:linear-gradient(90deg,var(--gold),#e8e0d2)}
.hero>span{display:inline-flex;background:var(--gold);color:#171f2d;border-radius:999px;padding:7px 12px;font-size:9px;font-weight:900;letter-spacing:.55px}
.hero h1{font-size:clamp(28px,3.7vw,40px);line-height:1.12;margin:13px 0 0;letter-spacing:-.025em}
.note{margin:12px 0 0;color:var(--muted);font-size:12px;line-height:1.7}
.card{
  margin-top:18px;background:#fff;border:1px solid var(--line);border-radius:23px;padding:34px 36px;
  box-shadow:0 14px 34px rgba(7,31,78,.05)
}
.card h2{font-size:21px;line-height:1.25;margin:28px 0 11px;padding-top:23px;border-top:1px solid #e8e1d6;color:var(--navy);letter-spacing:-.018em}
.card h2:first-child{margin-top:0;padding-top:0;border:0}
.card>p,.bullet p{font-size:13.5px;line-height:1.88;color:#53667d;margin:0 0 13px}
.bullet{display:flex;gap:10px;align-items:flex-start;margin:0 0 8px}
.bullet i{font-style:normal;flex:0 0 20px;width:20px;height:20px;border-radius:50%;display:grid;place-items:center;background:#fff5cf;color:#996d00;font-weight:900;font-size:10px;margin-top:3px}
footer{background:#fff;border-top:1px solid #e6eaf0;padding:28px max(18px,calc((100vw - 1080px)/2));display:flex;justify-content:space-between;gap:20px;color:#607086;font-size:11px}
footer div{display:grid;gap:5px}footer a{color:var(--navy);text-decoration:none;font-weight:700}
@media(max-width:850px){
  .header-container nav{display:none}.header-container{height:76px}.logo img{height:53px}
  .wrap{padding:16px 12px 50px}.hero{padding:25px 20px}.hero:after{left:20px;right:20px}
  .hero h1{font-size:28px}.card{padding:24px 20px;border-radius:19px}footer{flex-direction:column}
}

/* TOUR DETAIL VISUAL SYSTEM — information pages (no price/calendar/booking UI) */
:root{--tbc-navy:#0b1f3a;--tbc-navy2:#17345d;--tbc-gold:#e3a800;--tbc-bg:#f7f4ec;--tbc-surface:#fff;--tbc-border:#e7dfcf;--tbc-text:#10213a;--tbc-muted:#64748b}
body{background:radial-gradient(circle at 10% 0%,rgba(227,168,0,.08),transparent 28%),radial-gradient(circle at 90% 8%,rgba(23,52,93,.05),transparent 26%),var(--tbc-bg)!important;color:var(--tbc-text)!important}
.wrap,.shell{max-width:1240px!important;width:min(1240px,calc(100% - 32px))!important;margin-left:auto!important;margin-right:auto!important}
main .wrap{padding-top:20px!important}
.crumb{font-size:14px!important;margin-bottom:20px!important;color:#64748b!important;font-weight:600!important}.crumb a{color:var(--tbc-navy)!important}.crumb span{color:var(--tbc-gold)!important}
.hero,.heroCard{border-radius:24px!important;padding:40px 36px!important;background:linear-gradient(135deg,rgba(255,255,255,.98),rgba(255,250,240,.96))!important;border:1px solid var(--tbc-border)!important;box-shadow:0 14px 34px rgba(11,31,58,.08)!important;color:var(--tbc-text)!important;overflow:hidden!important}
.hero:after,.heroCard:after{content:none!important}
.hero>span,.hero .eyebrow,.heroCard .eyebrow{display:inline-flex!important;align-items:center!important;min-height:30px!important;padding:0 14px!important;border-radius:999px!important;background:var(--tbc-gold)!important;color:var(--tbc-navy)!important;font-size:11px!important;font-weight:800!important;letter-spacing:.08em!important;text-transform:uppercase!important;box-shadow:0 5px 14px rgba(227,168,0,.18)!important}
.hero h1,.heroCard h1{margin:14px 0 12px!important;font-size:38px!important;line-height:1.15!important;font-weight:800!important;letter-spacing:-.02em!important;color:var(--tbc-navy)!important}
.hero p,.heroCard .lead{max-width:960px!important;font-size:15px!important;line-height:1.8!important;color:#475569!important;margin:0!important}
.card,.contact-card,.info-main,.social-card,.faq{background:#fff!important;border:1px solid var(--tbc-border)!important;box-shadow:0 14px 34px rgba(11,31,58,.07)!important}
.card{border-radius:28px!important;padding:32px!important;margin-top:24px!important}.card h2,.info-main h2,.social-card h3{color:var(--tbc-navy)!important;font-size:26px!important}.card>p,.bullet p,.info-row p,.answer p{font-size:15px!important;line-height:1.95!important;color:var(--tbc-muted)!important}
.contact-grid{gap:18px!important;margin-top:24px!important}.contact-card{border-radius:24px!important;padding:22px!important}.info-panel{gap:24px!important;margin-top:24px!important}.info-main,.social-card{border-radius:28px!important;padding:32px!important}
.faq-list{gap:14px!important;margin-top:24px!important}.faq{border-radius:22px!important}.faq[open]{border-color:#d9b74d!important;box-shadow:0 14px 34px rgba(11,31,58,.09)!important}summary{padding:20px 22px!important;font-size:15px!important}summary i{background:var(--tbc-navy)!important;color:var(--tbc-gold)!important}
@media(max-width:850px){.wrap,.shell{width:min(100% - 24px,1240px)!important}.hero,.heroCard{padding:28px 22px!important}.hero h1,.heroCard h1{font-size:30px!important}.card,.info-main,.social-card{padding:24px!important}}

</style></body></html>
