---
interface Props {
  lang?: 'en' | 'tr' | 'es' | string;
}

const { lang = 'en' } = Astro.props;

const copy = {
  en: {
    eyebrow: 'OUR PARTNERS',
    titleStart: 'Trusted',
    titleAccent: 'Global & Local',
    titleEnd: 'Partners',
    subtitle: 'We cooperate with licensed local balloon operators and trusted aviation partners across Cappadocia.'
  },
  tr: {
    eyebrow: 'İŞ ORTAKLARIMIZ',
    titleStart: 'Güvenilir',
    titleAccent: 'Global & Yerel',
    titleEnd: 'Partnerler',
    subtitle: 'Kapadokya genelinde lisanslı yerel balon işletmeleri ve güvenilir havacılık partnerleriyle çalışıyoruz.'
  },
  es: {
    eyebrow: 'NUESTROS SOCIOS',
    titleStart: 'Socios',
    titleAccent: 'Globales y Locales',
    titleEnd: 'de Confianza',
    subtitle: 'Trabajamos con operadores locales de globos con licencia y socios de aviación de confianza en Capadocia.'
  }
};

const t = copy[lang as keyof typeof copy] ?? copy.en;

const rowOne = [
  ['air-kapadokya.webp', 'Air Kapadokya'],
  ['anatolian-balloons.webp', 'Anatolian Balloons'],
  ['flower-balloons.webp', 'Flower Balloons'],
  ['urgup-balloons.webp', 'Ürgüp Balloons'],
  ['atmosfer-balloons.webp', 'Atmosfer Balloons'],
  ['guvercin-balloons.webp', 'Güvercin Balloons']
];

const rowTwo = [
  ['istanbul-balloons.webp', 'Istanbul Balloons'],
  ['kapadokya-balloons.webp', 'Kapadokya Balloons'],
  ['sultan-balloons.webp', 'Sultan Balloons'],
  ['turkiye-balloons.webp', 'Türkiye Balloons'],
  ['universal-balloon.webp', 'Universal Balloon'],
  ['thk.webp', 'THK'],
  ['assiana.webp', 'Assiana']
];

const logoBase = '/images/partners-premium/';
---

<section class="partnerShowcase" aria-labelledby="partner-title">
  <div class="partnerGlow partnerGlowOne" aria-hidden="true"></div>
  <div class="partnerGlow partnerGlowTwo" aria-hidden="true"></div>

  <div class="partnerIntro">
    <div class="partnerEyebrow">
      <span class="partnerEyebrowDot"></span>
      {t.eyebrow}
    </div>

    <h2 id="partner-title" class="partnerTitle">
      <span>{t.titleStart}</span>
      <span class="partnerTitleAccent">{t.titleAccent}</span>
      <span>{t.titleEnd}</span>
    </h2>

    <p class="partnerSubtitle">{t.subtitle}</p>
  </div>

  <div class="partnerRows">
    <div class="partnerViewport partnerViewportTop">
      <div class="partnerTrack partnerTrackLeft">
        {[...rowOne, ...rowOne].map(([file, name], index) => (
          <div class="partnerCard" aria-hidden={index >= rowOne.length ? 'true' : undefined}>
            <img src={`${logoBase}${file}`} alt={index  width="260" height="120" loading="lazy" decoding="async" >= rowOne.length ? '' : name}
              width="260"
              height="120"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>

    <div class="partnerViewport partnerViewportBottom">
      <div class="partnerTrack partnerTrackRight">
        {[...rowTwo, ...rowTwo].map(([file, name], index) => (
          <div class="partnerCard" aria-hidden={index >= rowTwo.length ? 'true' : undefined}>
            <img src={`${logoBase}${file}`} alt={index  width="260" height="120" loading="lazy" decoding="async" >= rowTwo.length ? '' : name}
              width="260"
              height="120"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .partnerShowcase {
    --brand-navy: #082a4f;
    --brand-navy-2: #123e70;
    --brand-gold: #f2b300;
    --brand-gold-2: #ffd34f;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(64px, 7vw, 96px) 0 clamp(58px, 6vw, 86px);
    background:
      radial-gradient(circle at 50% 0%, rgba(242,179,0,.09), transparent 28rem),
      linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
  }

  .partnerGlow {
    position: absolute;
    border-radius: 999px;
    filter: blur(70px);
    opacity: .2;
    pointer-events: none;
    z-index: -1;
  }

  .partnerGlowOne {
    width: 240px;
    height: 240px;
    background: var(--brand-gold);
    left: -90px;
    top: 28%;
  }

  .partnerGlowTwo {
    width: 280px;
    height: 280px;
    background: #60a5fa;
    right: -120px;
    bottom: 10%;
  }

  .partnerIntro {
    width: min(1120px, calc(100% - 36px));
    margin: 0 auto clamp(34px, 4vw, 48px);
    text-align: center;
  }

  .partnerEyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px;
    border-radius: 999px;
    border: 1px solid rgba(8,42,79,.10);
    background: rgba(255,255,255,.88);
    box-shadow: 0 8px 26px rgba(8,42,79,.07);
    color: var(--brand-navy);
    font-size: 11px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: .11em;
  }

  .partnerEyebrowDot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-gold);
    box-shadow: 0 0 0 4px rgba(242,179,0,.14);
  }

  .partnerTitle {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: .18em;
    margin: 16px 0 0;
    color: var(--brand-navy);
    font-size: clamp(30px, 3.25vw, 52px);
    line-height: 1.05;
    letter-spacing: -.035em;
    font-weight: 900;
  }

  .partnerTitleAccent {
    color: var(--brand-gold);
    text-shadow: 0 8px 24px rgba(242,179,0,.16);
  }

  .partnerSubtitle {
    max-width: 830px;
    margin: 16px auto 0;
    color: #63748a;
    font-size: clamp(14px, 1.15vw, 17px);
    line-height: 1.7;
  }

  .partnerRows {
    display: grid;
    gap: 18px;
  }

  .partnerViewport {
    position: relative;
    overflow: hidden;
    padding: 4px 0 8px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
  }

  .partnerTrack {
    display: flex;
    width: max-content;
    gap: 18px;
    padding-inline: 9px;
    will-change: transform;
  }

  .partnerCard {
    width: clamp(180px, 17vw, 260px);
    height: clamp(98px, 9vw, 126px);
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    padding: 16px 20px;
    border: 1px solid rgba(8,42,79,.09);
    border-radius: 22px;
    background: rgba(255,255,255,.96);
    box-shadow:
      0 14px 38px rgba(8,42,79,.07),
      inset 0 1px 0 rgba(255,255,255,.9);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }

  .partnerCard:hover {
    transform: translateY(-3px);
    border-color: rgba(242,179,0,.28);
    box-shadow: 0 20px 48px rgba(8,42,79,.11);
  }

  .partnerCard img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .partnerTrackLeft {
    animation: partner-left 34s linear infinite;
  }

  .partnerTrackRight {
    animation: partner-right 38s linear infinite;
  }

  .partnerViewport:hover .partnerTrack {
    animation-play-state: paused;
  }

  @keyframes partner-left {
    from { transform: translate3d(0,0,0); }
    to { transform: translate3d(calc(-50% - 9px),0,0); }
  }

  @keyframes partner-right {
    from { transform: translate3d(calc(-50% - 9px),0,0); }
    to { transform: translate3d(0,0,0); }
  }

  @media (max-width: 720px) {
    .partnerShowcase {
      padding-block: 54px 58px;
    }

    .partnerRows {
      gap: 14px;
    }

    .partnerTrack {
      gap: 14px;
    }

    .partnerCard {
      width: 168px;
      height: 92px;
      border-radius: 18px;
      padding: 12px 15px;
    }

    .partnerTrackLeft {
      animation-duration: 29s;
    }

    .partnerTrackRight {
      animation-duration: 32s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .partnerTrack {
      animation: none !important;
    }

    .partnerViewport {
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
      scrollbar-width: thin;
    }
  }
</style>
