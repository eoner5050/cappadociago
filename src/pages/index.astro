---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Cappadocia Balloon Tours & Hot Air Balloon Rides | CappadociaGo">

<nav>
  <div class="wrap">
    <div class="brand-cluster"><a href="/" class="logo-mark"><img src="/images/logo.png" alt="CappadociaGo" /></a><a class="ig-pill" href="https://www.instagram.com/cappadociago/" target="_blank" rel="noopener noreferrer">◎ @cappadociago</a></div>
    <ul class="nav-menu">
      <li><a href="#tours">Balloon Tours</a></li>
      <li><a href="#tours">Daily Tours</a></li>
      <li><a href="#tours">Activities</a></li>
      <li><a href="#tours">Private Tours</a></li>
      <li><a href="#tours">Transfers</a></li>
    </ul>
    <div class="nav-right">
      <div class="lang-sel">
        <span class="flag-icon">🇬🇧</span>
        <span class="lang-text">English</span>
        <svg class="chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
      <a class="wa-btn" href="#">💬 WhatsApp</a>
    </div>
  </div>
</nav>

<header class="hero">
  <div class="hero-top">
    <div class="wrap">
      <span class="eyebrow-pill">DISCOVER CAPPADOCIA</span>
      <h1 class="hero-title">Sunrise Balloon Flights &amp; <em class="hero-accent">Unforgettable Cappadocia Experiences</em></h1>
      <p class="hero-sub">Discover Cappadocia with CappadociaGo. Compare sunrise hot air balloon flights, Red &amp; Green Tours, ATV and Jeep safaris, horse riding and airport transfers — all with local support in one place.</p>
      <div class="hero-actions">
        <a class="btn-primary" href="#tours">Explore Tours</a>
        <a class="btn-ghost" href="#">Contact Us</a>
      </div>
      <div class="trust-row">
        <span class="rate"><span class="stars">★★★★★</span> 4.9/5 on TripAdvisor</span>
        <span class="rate"><span class="stars">★★★★★</span> 4.8/5 Google Reviews</span>
      </div>
      <div class="trust-badge-row">
        <span>✹ Prime Experiences</span>
        <span>◉ 24/7 Live Support</span>
        <span>★ Highly Loved</span>
        <span>✦ Best-in-Class Tours</span>
      </div>
    </div>
  </div>

  <div class="hero-mid wrap">
    <h2><span class="accent">Ready</span> to soar above <span class="accent">fairy chimneys</span>?</h2>
    <div class="booking">
      <div class="booking-inner">
        <div class="field"><label>Select Tour</label><select><option>All Tours</option><option>Balloon Tours</option><option>Daily Tours</option><option>Package Tours</option><option>Transfers</option><option>Activities</option></select></div>
        <div class="field date-field" id="dateField">
          <label>Accommodation Dates in Cappadocia</label>
          <div class="date-range" id="dateRangeDisplay">
            <span class="date-part">Aug <strong>23</strong> <svg class="date-chev" viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg></span>
            <span class="date-dash">—</span>
            <span class="date-part">Aug <strong>24</strong> <svg class="date-chev" viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg></span>
          </div>

          <div class="cal-popup" id="calPopup">
            <div class="cal-header">
              <button type="button" class="cal-nav" id="calPrev" aria-label="Previous month">‹</button>
              <div class="cal-title" id="calTitle">August 2026 · September 2026</div>
              <button type="button" class="cal-nav" id="calNext" aria-label="Next month">›</button>
            </div>
            <div class="cal-months" id="calMonths"></div>
            <div class="cal-footer" id="calFooter">Select start and end dates</div>
          </div>
        </div>
        <div class="field"><label>Select Person</label><select><option>1 Person</option><option>2 Persons</option><option>3 Persons</option><option>4+ Persons</option></select></div>
        <button class="btn-search">SEARCH</button>
      </div>
    </div>
  </div>
</header>

