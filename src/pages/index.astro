<script>
  const catSlider = document.getElementById('catSlider');
  const leftBtn = document.getElementById('catArrowLeft');
  const rightBtn = document.getElementById('catArrowRight');
  if (catSlider && leftBtn && rightBtn) {
    leftBtn.addEventListener('click', () => catSlider.scrollBy({ left: -300, behavior: 'smooth' }));
    rightBtn.addEventListener('click', () => catSlider.scrollBy({ left: 300, behavior: 'smooth' }));
  }

  /* ---------- CALENDAR ---------- */
  const dateField = document.getElementById('dateField');
  const calPopup = document.getElementById('calPopup');
  const calMonths = document.getElementById('calMonths');
  const calTitle = document.getElementById('calTitle');
  const calPrev = document.getElementById('calPrev');
  const calNext = document.getElementById('calNext');
  const calFooter = document.getElementById('calFooter');
  const dateRangeDisplay = document.getElementById('dateRangeDisplay');

  if (dateField && calPopup) {
    const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const monthShort = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const weekdays = ['MO','TU','WE','TH','FR','SA','SU'];

    const today = new Date();
    today.setHours(0,0,0,0);

    let viewYear = today.getFullYear();
    let viewMonth = today.getMonth();
    let rangeStart = null;
    let rangeEnd = null;

    function fmt(d) {
      return `${monthShort[d.getMonth()]} ${d.getDate()}`;
    }

    function updateDisplay() {
      if (rangeStart && rangeEnd) {
        dateRangeDisplay.innerHTML = `
          <span class="date-part">${monthShort[rangeStart.getMonth()]} <strong>${rangeStart.getDate()}</strong></span>
          <span class="date-dash">—</span>
          <span class="date-part">${monthShort[rangeEnd.getMonth()]} <strong>${rangeEnd.getDate()}</strong></span>
        `;
      }
    }

    function buildMonth(year, month) {
      const firstDay = new Date(year, month, 1);
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      let startOffset = firstDay.getDay() - 1;
      if (startOffset < 0) startOffset = 6;

      let daysHtml = '';
      for (let i = 0; i < startOffset; i++) {
        daysHtml += `<div class="cal-day empty"></div>`;
      }
      for (let d = 1; d <= daysInMonth; d++) {
        const thisDate = new Date(year, month, d);
        thisDate.setHours(0,0,0,0);
        const isPast = thisDate < today;
        let cls = 'cal-day';
        if (isPast) cls += ' past';
        if (rangeStart && thisDate.getTime() === rangeStart.getTime()) cls += ' range-start';
        if (rangeEnd && thisDate.getTime() === rangeEnd.getTime()) cls += ' range-end';
        if (rangeStart && rangeEnd && thisDate > rangeStart && thisDate < rangeEnd) cls += ' in-range';
        daysHtml += `<div class="${cls}" data-date="${year}-${month}-${d}">${d}</div>`;
      }

      return `
        <div class="cal-month">
          <div class="cal-month-name">${monthNames[month]} ${year}</div>
          <div class="cal-weekdays">${weekdays.map(w => `<span>${w}</span>`).join('')}</div>
          <div class="cal-days">${daysHtml}</div>
        </div>
      `;
    }

    function render() {
      let m2 = viewMonth + 1, y2 = viewYear;
      if (m2 > 11) { m2 = 0; y2++; }
      calTitle.textContent = `${monthNames[viewMonth]} ${viewYear} · ${monthNames[m2]} ${y2}`;
      calMonths.innerHTML = buildMonth(viewYear, viewMonth) + buildMonth(y2, m2);

      calMonths.querySelectorAll('.cal-day:not(.empty):not(.past)').forEach(el => {
        el.addEventListener('click', () => {
          const [y, m, d] = el.getAttribute('data-date').split('-').map(Number);
          const clicked = new Date(y, m, d);
          clicked.setHours(0,0,0,0);

          if (!rangeStart || (rangeStart && rangeEnd)) {
            rangeStart = clicked;
            rangeEnd = null;
            calFooter.textContent = 'Select end date';
          } else if (clicked < rangeStart) {
            rangeStart = clicked;
            rangeEnd = null;
            calFooter.textContent = 'Select end date';
          } else if (clicked.getTime() === rangeStart.getTime()) {
            rangeEnd = null;
          } else {
            rangeEnd = clicked;
            calFooter.textContent = 'Select start and end dates';
            updateDisplay();
            setTimeout(() => calPopup.classList.remove('open'), 350);
          }
          render();
        });
      });
    }

    render();

    dateField.addEventListener('click', (e) => {
      calPopup.classList.toggle('open');
    });

    calPrev.addEventListener('click', (e) => {
      e.stopPropagation();
      viewMonth--;
      if (viewMonth < 0) { viewMonth = 11; viewYear--; }
      render();
    });
    calNext.addEventListener('click', (e) => {
      e.stopPropagation();
      viewMonth++;
      if (viewMonth > 11) { viewMonth = 0; viewYear++; }
      render();
    });

    calPopup.addEventListener('click', (e) => e.stopPropagation());
    document.addEventListener('click', () => calPopup.classList.remove('open'));
  }
</script>

