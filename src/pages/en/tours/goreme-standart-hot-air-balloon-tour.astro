---
import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const tour = {
  title: 'Göreme Balloon Tour (Standard Flight)',
  kicker: 'CAPPADOCIAGO',
  heroDesc: 'Experience the magic of a Cappadocia Balloon Tour (Standard Flight) and witness the breathtaking sunrise over Göreme. Fly above the region\'s iconic fairy chimneys and spectacular valleys while enjoying one of the most unforgettable hot air balloon experiences in Cappadocia.',
  overviewTitle: 'Göreme Balloon Tour (Standard Flight) Overview',
  overviewParagraphs: [
    'Cappadocia Balloon Tour (Standard Flight) is designed for travelers who want to discover Cappadocia\'s breathtaking landscapes from the sky at the best value. As the sun rises, you\'ll float above Göreme\'s iconic fairy chimneys, spectacular valleys, and unique volcanic rock formations, enjoying one of the most unforgettable hot air balloon experiences in Cappadocia.',
    'This Cappadocia Balloon Tour (Standard Flight) lasts approximately one hour, giving you plenty of time to admire the breathtaking views of Göreme, fairy chimneys, scenic valleys, and unique volcanic rock formations. Combining safety, professional service, and spectacular sunrise views, it is one of the most unforgettable hot air balloon experiences in Cappadocia.'
  ],
  priceTitle: 'Göreme Balloon Tour (Standard Flight) Price',
  priceText: 'Göreme Balloon Tour (Standard Flight) is planned at 80 Euro per person. For current availability, seasonal demand, and confirmed reservations for the Cappadocia Balloon Tour (Standard Flight), please contact us directly. Our team will provide the latest availability and help you secure your booking.',
  whatsIncluded: [
    'Hotel pickup and drop-off',
    'Light breakfast before the flight',
    'Transfer to the launch area',
    'Safety briefing by an experienced pilot',
    'Approximately 1-hour hot air balloon flight',
    'Flight certificate',
    'Full insurance coverage',
    'Free Wi-Fi in the basket',
    'Professional operation support',
    'Clear service with no hidden fees'
  ],
  importantInfo: [
    'Flights operate early in the morning throughout the year.',
    'Flight duration and route may vary depending on weather conditions.',
    'All passengers are insured with maximum coverage.',
    'Comfortable clothing and suitable shoes are recommended.',
    'Children under 16 may join only with an accompanying adult.',
    'Children under 5 years old are not accepted.',
    'Not suitable for pregnant guests or guests who have recently had major surgery.',
    'The remaining payment is collected one day before or on the tour day; card payments may include a 15 € commission per person.'
  ],
  flightDetailsTitle: 'Flight Details',
  flightDetailsParagraphs: [
    'The Cappadocia Balloon Tour (Standard Flight) is operated with baskets accommodating 28 passengers. Enjoy breathtaking sunrise views over Göreme\'s iconic fairy chimneys, spectacular valleys, and unique volcanic landscapes while experiencing one of the most popular hot air balloon tours in Cappadocia.',
    'Your Cappadocia Balloon Tour (Standard Flight) begins with an early morning hotel pickup and a comfortable transfer to the launch site. While the balloons are being prepared for takeoff, your experienced pilot provides a short safety briefing and explains the flight process, ensuring you are ready for an unforgettable sunrise adventure over Göreme.',
    'As the sun rises, your Cappadocia Balloon Tour (Standard Flight) takes you high above Göreme\'s breathtaking landscapes. Admire the golden light illuminating the region\'s iconic fairy chimneys, spectacular valleys, vineyards, and unique volcanic rock formations. Throughout the flight, you\'ll have plenty of opportunities to capture stunning photos and enjoy the peaceful beauty of Cappadocia from the sky, creating memories that will last a lifetime.'
  ],
  afterFlightTitle: 'After the Flight',
  afterFlightText: 'After landing, our ground crew welcomes you and provides the necessary support during the landing process. Your flight certificate, a souvenir of this special experience, is presented to you. Afterwards, you are comfortably transferred back to your hotel.',
  refundTitle: 'Refund Guarantee',
  refundText: 'If flights are cancelled due to weather conditions, they may be rescheduled for the next available day. If rescheduling is not possible, a full refund is provided. Free cancellation may be available up to 24 hours before the flight. All reservations are subject to availability.',
  advanceTitle: 'Why Should You Book in Advance?',
  advanceText: 'Hot air balloon flights in Cappadocia operate under a regulated and supervised structure by the Turkish Civil Aviation Authority. Since daily seat capacity is limited, early booking is especially important during busy periods. Booking in advance increases the chance of securing a place and allows better planning.',
  safetyTitle: 'Safety and Experience',
  safetyText: 'Our Cappadocia Balloon Tour (Standard Flight) is operated by certified and highly experienced pilots holding PPL and SPL licenses. Every flight is conducted with the highest standards of safety and professionalism to ensure a smooth and enjoyable balloon experience. From hotel pickup to landing, our dedicated team is committed to providing excellent service, with 24/7 customer support available throughout your journey.'
};
const pageLang = 'en';
const slug = 'goreme-standart-hot-air-balloon-tour';
const mainImage = '/images/tours/goreme-standart-hot-air-balloon-tour (2).webp';
export const prerender = false;
const extraSections = [
  { title: tour.afterFlightTitle || 'After the Tour', paragraphs: tour.afterFlightText ? [tour.afterFlightText] : [] },
  { title: tour.refundTitle || 'Cancellation & Refund', paragraphs: tour.refundText ? [tour.refundText] : [] },
  { title: tour.advanceTitle || 'Why Book in Advance?', paragraphs: tour.advanceText ? [tour.advanceText] : [] },
  { title: tour.safetyTitle || 'Safety and Experience', paragraphs: tour.safetyText ? [tour.safetyText] : [] }
].filter(s => s.paragraphs.length);
---
<StandardizedPrivateTourPage
  lang={pageLang}
  slug={slug}
  title={tour.title}
  heroDesc={tour.heroDesc}
  overviewTitle={tour.overviewTitle}
  overviewParagraphs={tour.overviewParagraphs || []}
  priceTitle={tour.priceTitle}
  priceText={tour.priceText}
  included={tour.whatsIncluded || []}
  importantTitle='Important Information'
  important={tour.importantInfo || []}
  detailsTitle={tour.flightDetailsTitle}
  details={tour.flightDetailsParagraphs || []}
  extraSections={extraSections}
  duration='60 Minutes'
  rating='4.95'
  reviewCount=94
  mainImage={mainImage}
  priceMode={/request|fiyat sor|consultar/i.test(String(tour.priceText || '')) ? 'ask' : 'perPerson'}
  sidebarBadges={(tour.whatsIncluded || []).slice(0,3)}
  sideHighlights={(tour.importantInfo || []).slice(0,5)}
  standardPhoneFix={true}
/>
