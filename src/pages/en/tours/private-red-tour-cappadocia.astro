---
import FloatingAssistant from "../../../components/FloatingAssistant.astro";
import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const props = {
  "title": "Private Red Tour Cappadocia",
  "heroDesc": "Explore the best of northern Cappadocia with a private vehicle, a professional English-speaking guide and a flexible full-day itinerary designed around your group.",
  "overviewTitle": "Cappadocia Private Red Tour Overview",
  "overviewParagraphs": [
    "The Cappadocia Private Red Tour is a full-day sightseeing experience for travelers who prefer privacy, flexibility and expert guidance. Unlike a standard group tour, your group travels with a licensed local guide and private vehicle at a comfortable pace.",
    "The route combines northern Cappadocia’s famous fairy chimneys, cave settlements, cultural workshops and panoramic viewpoints, making it suitable for couples, families, photographers and small private groups."
  ],
  "priceTitle": "Private Red Tour Price",
  "priceText": "The displayed starting price is the total group price for participation by up to 18 people. It is not a per-person price and includes a private vehicle and professional tour guide.",
  "included": [
    "Private tour with a professional guide",
    "Comfortable, air-conditioned private vehicle",
    "All entrance fees to listed attractions",
    "Traditional Turkish lunch",
    "Pottery workshop visit and demonstration",
    "Visit to a local leather shop",
    "Hotel pickup and drop-off"
  ],
  "importantTitle": "What’s Not Included",
  "important": [
    "Personal expenses such as drinks and souvenirs",
    "Tips for the guide and driver",
    "Optional activities such as hot air balloon rides",
    "Items not mentioned under inclusions"
  ],
  "detailsTitle": "Private Red Tour Itinerary",
  "details": [
    "Paşabağ (Monks Valley): Walk among Cappadocia’s world-famous fairy chimneys and learn how these formations developed over centuries.",
    "Zelve Open-Air Museum: Explore a former cave settlement carved into volcanic rock and discover the region’s historic cave life.",
    "Devrent Valley (Imagination Valley): See unusual rock shapes resembling animals and mythical figures.",
    "Avanos Pottery Workshop: Discover the traditional pottery culture of Avanos and watch local artisans at work.",
    "Traditional Turkish Lunch: Enjoy regional Cappadocian dishes at a local restaurant; vegetarian and gluten-free options can be requested.",
    "Love Valley: Take in the panoramic scenery and distinctive rock towers of one of Cappadocia’s best-known valleys.",
    "Uçhisar Castle: Visit the region’s highest viewpoint for broad views over Göreme National Park and surrounding valleys.",
    "Local Leather Shop: See locally produced leather bags, jackets and accessories before returning to your hotel."
  ],
  "extraSections": [
    {
      "title": "Why Choose a Private Red Tour?",
      "items": [
        "Personalized itinerary tailored to your interests",
        "Exclusive comfort away from large tour groups",
        "English-speaking licensed tour guide",
        "Ideal for couples, families, photographers and VIP travelers",
        "Hotel pickup and drop-off included"
      ]
    },
    {
      "title": "Book Your Private Red Tour",
      "paragraphs": [
        "Availability for private vehicles and guides is limited on busy dates. Select your date and group size to request your reservation."
      ]
    }
  ],
  "duration": "Full Day",
  "rating": "4.80",
  "mainImage": "/images/tours/Private-Red-Tour-Cappadocia.webp",
  "galleryImages": [
    "/images/tours/Red-Tour-Cappadocia.webp",
    "/images/tours/Private-Tour-and-Mix-Tour.webp",
    "/images/tours/tbc-cappadocia-pottery-making-experience.webp",
    "/images/tours/tbc-green-tour-cappadocia.webp"
  ],
  "priceMode": "group",
  "sidebarBadges": [
    "Private Vehicle",
    "Professional Guide",
    "Up to 18 People"
  ],
  "sideHighlights": [
    "Flexible private itinerary",
    "Entrance fees and lunch included",
    "Hotel pickup and drop-off",
    "Private guide and vehicle"
  ]
};
