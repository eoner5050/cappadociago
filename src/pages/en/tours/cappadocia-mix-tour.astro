---
import FloatingAssistant from "../../../components/FloatingAssistant.astro";
import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const props = {
  "title": "Cappadocia Mix Tour",
  "heroDesc": "Explore Cappadocia’s iconic valleys, cave settlements, panoramic viewpoints and local heritage on a carefully planned private or small-group route.",
  "overviewTitle": "Cappadocia Mix Tour Overview",
  "overviewParagraphs": [
    "Explore the breathtaking landscapes and rich history of Cappadocia with a curated itinerary combining some of the region’s most iconic destinations.",
    "From ancient rock formations to enchanting valleys, the route is designed to give you a balanced mix of nature, history and local culture."
  ],
  "priceTitle": "Cappadocia Mix Tour Price",
  "priceText": "The live calendar shows the starting group price for available dates. The final program can be adjusted according to your group and requested route.",
  "included": [
    "Hotel pick-up and drop-off",
    "Private Mercedes-Benz Vito transportation",
    "Professional private tour guide",
    "Lunch",
    "Entrance tickets"
  ],
  "importantTitle": "Tour Highlights",
  "important": [
    "Zelve Open Air Museum and its historic cave dwellings",
    "Paşabağ (Monks Valley) and mushroom-shaped fairy chimneys",
    "Pigeon Valley views toward Uçhisar Castle",
    "Love Valley and its distinctive rock formations",
    "Avanos pottery heritage",
    "Özkonak Underground City"
  ],
