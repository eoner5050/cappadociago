    "Zelve Open Air Museum (1 Hour): Explore the atmosphere of cave dwellings inhabited until the 1950s.",
    "Pigeon Valley (30 Minutes): Enjoy a peaceful nature stop with views of Uçhisar Castle and rock formations.",
    "Uçhisar Castle (30 Minutes): Take in panoramic views from Cappadocia’s highest point.",
    "Love Valley (30 Minutes): Walk among towering fairy chimneys and enjoy memorable photo opportunities.",
    "Paşabağ (Monks Valley) (1 Hour): Explore ancient dwellings and chapels carved into the rocks.",
    "Avanos (1 Hour): Visit traditional pottery workshops; optional workshop experiences may carry an extra charge.",
    "Özkonak Underground City (1 Hour): Discover a multi-level ancient shelter; an extra charge may apply according to the selected program."
  ],
  "extraSections": [
    {
      "title": "Tour Details",
      "items": [
        "Duration: 7 Hours",
        "Language: English live tour guide",
        "Group Type: Private or Small Groups",
        "Transportation: Private Mercedes-Benz Vito"
      ]
    },
    {
      "title": "Pick-up & Drop-off Locations",
      "paragraphs": [
        "Available in Ürgüp, Göreme, Çavuşin, Avanos, Uçhisar, Ortahisar and Mustafapaşa."
      ]
    }
  ],
  "duration": "7 Hours",
  "rating": "4.95",
  "mainImage": "/images/tours/Private-Tour-and-Mix-Tour.webp",
  "galleryImages": [
    "/images/tours/Private-Mix-Cappadocia-Tour.webp",
    "/images/tours/Red-Tour-Cappadocia.webp",
    "/images/tours/tbc-green-tour-cappadocia.webp",
    "/images/tours/tbc-cappadocia-pottery-making-experience.webp"
  ],
  "priceMode": "group",
