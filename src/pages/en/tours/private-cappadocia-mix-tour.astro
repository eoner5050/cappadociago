---
import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const tour = {
  title: 'Private Cappadocia Mix Tour',
  kicker: 'CAPPADOCIAGO',
  heroDesc: 'Discover Cappadocia at your own pace with a private itinerary designed around your interests. Combine highlights from Red and Green Tour routes with private transportation, a professional guide and flexible timing.',
  overviewTitle: 'Private Cappadocia Tour Overview',
  overviewParagraphs: ['The Private Cappadocia Mix Tour is designed for guests who want to explore the region with a route planned especially for them. Instead of joining a standard group tour, you travel privately with your own vehicle and professional guide.'],
  priceTitle: 'Private Cappadocia Tour Price',
  priceText: 'Price on Request',
  whatsIncluded: ['VIP private transfer service', 'Professional private tour guide', 'Lunch', 'Flexible route planning', 'Private vehicle for your group', '24/7 reservation support'],
  importantInfo: ['Flexible route planned for your group', 'Option to combine Red and Green Tour stops', 'Suitable for families, couples and small groups', 'Pickup and drop-off from your hotel', 'Final route depends on your interests and available time', 'Price depends on group size and selected program'],
  flightDetailsTitle: 'Private Cappadocia Tour Route',
  flightDetailsParagraphs: ['Personalized Route Planning: A special travel plan can be prepared according to the places you want to see in Cappadocia, giving you full control over your program.', 'Combined Red and Green Tour Highlights: Depending on your request, popular stops from the Red Tour and Green Tour can be brought together in one private route.', 'Comfort for Families and Groups: The program is planned flexibly according to the number of participants, expectations, walking preferences and available time.', 'More Control, More Comfort: You can spend more time at the places you enjoy and move more quickly through other stops, making the tour more comfortable and personal.'],
  afterFlightTitle: 'End of the Tour',
  afterFlightText: 'After the program, you will be transferred comfortably back to your hotel.',
  refundTitle: 'Cancellation & Reservation',
  refundText: 'Reservation and cancellation conditions depend on availability and the selected program. Contact us for confirmed details.',
  advanceTitle: 'Why Book in Advance?',
  advanceText: 'Advance booking helps secure your preferred date, guide and vehicle.',
  safetyTitle: 'Professional Service',
  safetyText: 'The tour is organized with experienced drivers, professional guides and our local operations team.'
};
const pageLang = 'en';
const slug = 'private-cappadocia-mix-tour';
const mainImage = '/images/tours/Private-Mix-Cappadocia-Tour.webp';
export const prerender = false;
const extraSections = [
  { title: tour.afterFlightTitle || 'After the Tour', paragraphs: tour.afterFlightText ? [tour.afterFlightText] : [] },
  { title: tour.refundTitle || 'Cancellation & Refund', paragraphs: tour.refundText ? [tour.refundText] : [] },
  { title: tour.advanceTitle || 'Why Book in Advance?', paragraphs: tour.advanceText ? [tour.advanceText] : [] },
  { title: tour.safetyTitle || 'Safety and Experience', paragraphs: tour.safetyText ? [tour.safetyText] : [] }
].filter(s => s.paragraphs.length);
---
<StandardizedPrivateTourPage
  lang={pageLang}
  slug={slug}
  title={tour.title}
  heroDesc={tour.heroDesc}
  overviewTitle={tour.overviewTitle}
  overviewParagraphs={tour.overviewParagraphs || []}
  priceTitle={tour.priceTitle}
  priceText={tour.priceText}
  included={tour.whatsIncluded || []}
  importantTitle='Important Information'
  important={tour.importantInfo || []}
  detailsTitle={tour.flightDetailsTitle}
  details={tour.flightDetailsParagraphs || []}
  extraSections={extraSections}
  duration='60 Minutes'
  rating='4.97'
  reviewCount=9
  mainImage={mainImage}
  priceMode={/request|fiyat sor|consultar/i.test(String(tour.priceText || '')) ? 'ask' : 'perPerson'}
  sidebarBadges={(tour.whatsIncluded || []).slice(0,3)}
  sideHighlights={(tour.importantInfo || []).slice(0,5)}
/>
