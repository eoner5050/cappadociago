---
import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const tour = {
  title: 'Red Tour Cappadocia',
  kicker: 'CAPPADOCIAGO',
  heroDesc: 'Discover the most iconic highlights of northern Cappadocia on a professionally guided full-day Red Tour. Visit panoramic viewpoints, Zelve Open Air Museum, Pasabag fairy chimneys, Avanos, Devrent Valley and traditional local workshops.',
  overviewTitle: 'Red Tour Cappadocia Overview',
  overviewParagraphs: ["Red Tour Cappadocia is one of the most popular full-day sightseeing tours in the region. It is ideal for guests who want to explore northern Cappadocia's famous landscapes, historical sites and cultural heritage in one well-organized day.", 'The tour usually starts with hotel pickup in the morning and continues with a professional licensed guide and comfortable transportation. The exact order of stops may change depending on traffic and operational conditions.'],
  priceTitle: 'Red Tour Cappadocia Price',
  priceText: 'Red Tour Cappadocia is available from 40 Euro per person. Final prices may vary depending on the season, group size and availability. Contact us for the current confirmed price.',
  whatsIncluded: ['Hotel pickup and drop-off', 'Professional licensed tour guide', 'Transportation with air-conditioned vehicle', 'Lunch at a local restaurant', 'Parking and local service fees', 'Professional operation support', '24/7 customer assistance', 'Transparent service with no hidden fees'],
  importantInfo: ['Full-day tour with morning hotel pickup', 'Comfortable walking shoes are recommended', 'Tour order may change according to traffic and operational conditions', 'Museum entrance fees may be included or charged separately depending on the selected package', 'Please inform us in advance about dietary requirements', 'Children must be accompanied by an adult', 'Weather conditions may affect some outdoor stops', 'All reservations are subject to availability'],
  flightDetailsTitle: 'Red Tour Cappadocia Itinerary',
  flightDetailsParagraphs: ['Uçhisar Panorama: Begin with a panoramic view of Cappadocia and its unique rock formations.', "Zelve Open Air Museum: Explore one of Cappadocia's most fascinating historical settlements with cave houses, churches and rock-cut structures.", "Pasabag (Monks Valley): See some of the region's most famous fairy chimneys and unusual geological formations.", 'Avanos: Visit the town known for pottery making, enjoy lunch at a local restaurant and experience a traditional pottery workshop.', 'Devrent Valley: Discover the imagination valley, famous for naturally shaped rock formations resembling animals and different figures.', 'Local Workshop Stop: Depending on the day, the program may include a traditional handicraft, jewelry or local product workshop before returning to the hotel.'],
  afterFlightTitle: 'End of the Tour',
  afterFlightText: 'After the final visit, you will be transferred comfortably back to your hotel. Our team can also assist with balloon flights, airport transfers, private tours and other Cappadocia activities.',
  refundTitle: 'Cancellation & Refund',
  refundText: 'Free cancellation may be available up to 24 hours before the tour depending on reservation conditions. Late cancellations and no-shows may be subject to charges. If the operator cancels the tour, an alternative date or refund will be offered.',
  advanceTitle: 'Why Book in Advance?',
  advanceText: "Red Tour is one of Cappadocia's most popular daily tours, especially during spring, summer and holiday periods. Booking in advance helps secure your preferred date and hotel pickup.",
  safetyTitle: 'Professional Guide & Comfortable Transportation',
  safetyText: 'The tour is organized with professional licensed guides, experienced drivers and comfortable vehicles. Our operations team follows the service throughout the day.'
};
const pageLang = 'en';
const slug = 'red-tour-cappadocia';
const mainImage = '/images/tours/red-tour-cappadocia (2).webp';
export const prerender = false;
const extraSections = [
  { title: tour.afterFlightTitle || 'After the Tour', paragraphs: tour.afterFlightText ? [tour.afterFlightText] : [] },
  { title: tour.refundTitle || 'Cancellation & Refund', paragraphs: tour.refundText ? [tour.refundText] : [] },
  { title: tour.advanceTitle || 'Why Book in Advance?', paragraphs: tour.advanceText ? [tour.advanceText] : [] },
  { title: tour.safetyTitle || 'Safety and Experience', paragraphs: tour.safetyText ? [tour.safetyText] : [] }
].filter(s => s.paragraphs.length);
---
<StandardizedPrivateTourPage
  lang={pageLang}
  slug={slug}
  title={tour.title}
  heroDesc={tour.heroDesc}
  overviewTitle={tour.overviewTitle}
  overviewParagraphs={tour.overviewParagraphs || []}
  priceTitle={tour.priceTitle}
  priceText={tour.priceText}
  included={tour.whatsIncluded || []}
  importantTitle='Important Information'
  important={tour.importantInfo || []}
  detailsTitle={tour.flightDetailsTitle}
  details={tour.flightDetailsParagraphs || []}
  extraSections={extraSections}
  duration='60 Minutes'
  rating='4.97'
  reviewCount=28
  mainImage={mainImage}
  priceMode={/request|fiyat sor|consultar/i.test(String(tour.priceText || '')) ? 'ask' : 'perPerson'}
  sidebarBadges={(tour.whatsIncluded || []).slice(0,3)}
  sideHighlights={(tour.importantInfo || []).slice(0,5)}
/>
