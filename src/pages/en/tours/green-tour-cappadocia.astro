---
import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const tour = {
  title: 'Green Tour Cappadocia',
  kicker: 'CAPPADOCIAGO',
  heroDesc: "Explore Cappadocia's natural and historical beauty on a wider full-day route. Green Tour Cappadocia brings together panoramic viewpoints, Ihlara Valley, underground history and some of the region's most memorable landscapes.",
  overviewTitle: 'Green Tour Cappadocia Overview',
  overviewParagraphs: ['Green Tour Cappadocia is a full-day program designed for guests who want to discover both the historical and natural sides of Cappadocia in greater depth. Starting with hotel pickup in the morning, the experience continues with a professional guide and comfortable transportation.'],
  priceTitle: 'Green Tour Cappadocia Price',
  priceText: 'Green Tour Cappadocia is available from 50 Euro per person. Current prices can vary according to season and availability.',
  whatsIncluded: ['Hotel pickup and drop-off', 'Professional tour guide', 'Lunch', 'Comfortable transportation', 'Local operation support', '24/7 customer assistance'],
  importantInfo: ['Full-day guided tour', 'Comfortable walking shoes are recommended', 'The route may change according to operational conditions', 'Please inform us about dietary requirements', 'Reservations are subject to availability', 'Weather can affect outdoor stops'],
  flightDetailsTitle: 'Green Tour Program',
  flightDetailsParagraphs: ['Göreme Panorama: Enjoy a wide panoramic viewpoint over Cappadocia and its fairy chimneys.', "Ihlara Valley: Discover one of the region's most special natural areas with its valley scenery and walking experience.", 'Panoramic Glass Terrace: Enjoy a panoramic viewpoint and the distinctive landscape around Ihlara.', 'Lunch in Belisırma: Take a pleasant lunch break during the route.', 'Narlıgöl: Visit the peaceful volcanic crater lake and its distinctive natural surroundings.', 'Kaymaklı Underground City: Discover underground rooms, tunnels and the fascinating atmosphere of ancient Cappadocian life.', "Pigeon Valley: See one of Cappadocia's famous valleys with pigeon houses and panoramic scenery.", 'Onyx Demonstration: Learn about natural stones and local craftsmanship.', 'Return to Hotel: At the end of the tour, you are comfortably transferred back to your hotel.'],
  afterFlightTitle: 'End of the Tour',
  afterFlightText: 'After the program, you will be transferred comfortably back to your hotel.',
  refundTitle: 'Cancellation & Reservation',
  refundText: 'Reservation and cancellation conditions depend on availability and the selected program. Contact us for confirmed details.',
  advanceTitle: 'Why Book in Advance?',
  advanceText: 'Advance booking helps secure your preferred date, guide and vehicle.',
  safetyTitle: 'Professional Service',
  safetyText: 'The tour is organized with experienced drivers, professional guides and our local operations team.'
};
const pageLang = 'en';
const slug = 'green-tour-cappadocia';
const mainImage = '/images/tours/green-tour-cappadocia (2).webp';
export const prerender = false;
const extraSections = [
  { title: tour.afterFlightTitle || 'After the Tour', paragraphs: tour.afterFlightText ? [tour.afterFlightText] : [] },
  { title: tour.refundTitle || 'Cancellation & Refund', paragraphs: tour.refundText ? [tour.refundText] : [] },
  { title: tour.advanceTitle || 'Why Book in Advance?', paragraphs: tour.advanceText ? [tour.advanceText] : [] },
  { title: tour.safetyTitle || 'Safety and Experience', paragraphs: tour.safetyText ? [tour.safetyText] : [] }
].filter(s => s.paragraphs.length);
---
<StandardizedPrivateTourPage
  lang={pageLang}
  slug={slug}
  title={tour.title}
  heroDesc={tour.heroDesc}
  overviewTitle={tour.overviewTitle}
  overviewParagraphs={tour.overviewParagraphs || []}
  priceTitle={tour.priceTitle}
  priceText={tour.priceText}
  included={tour.whatsIncluded || []}
  importantTitle='Important Information'
  important={tour.importantInfo || []}
  detailsTitle={tour.flightDetailsTitle}
  details={tour.flightDetailsParagraphs || []}
  extraSections={extraSections}
  duration='60 Minutes'
  rating='4.97'
  reviewCount=32
  mainImage={mainImage}
  priceMode={/request|fiyat sor|consultar/i.test(String(tour.priceText || '')) ? 'ask' : 'perPerson'}
  sidebarBadges={(tour.whatsIncluded || []).slice(0,3)}
  sideHighlights={(tour.importantInfo || []).slice(0,5)}
/>
