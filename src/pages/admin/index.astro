---
const title = "CappadociaGo — Admin";
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="robots" content="noindex,nofollow" />
  <style is:global>
    :root{
      --ink:#18324a;--ink-2:#28495f;--brand:#55c7c1;--brand-dark:#2faaa5;--accent:#f3b23c;
      --bg:#f7fafb;--panel:#ffffff;--line:#e4ecef;--muted:#7b8e99;--soft:#eef8f7;
      --ok:#2f9d6a;--warn:#b67b12;--danger:#c94b4b;--shadow:0 10px 30px rgba(31,72,90,.07);
    }
    *{box-sizing:border-box}
    html{font-size:14px}
    body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;background:var(--bg);color:var(--ink);font-weight:400}
    button,input,select,textarea{font:inherit;color:inherit} button{cursor:pointer}
    .shell{min-height:100vh;display:grid;grid-template-columns:210px minmax(0,1fr)}
    aside{background:#fff;border-right:1px solid var(--line);padding:24px 15px;position:sticky;top:0;height:100vh}
    .brand{font-size:14px;font-weight:800;letter-spacing:.04em;color:var(--ink);line-height:1.25;margin:2px 8px 28px}.brand small{display:block;color:var(--brand-dark);font-size:9px;letter-spacing:.13em;margin-top:5px;font-weight:800}
    .nav{display:grid;gap:5px}.nav button,.nav a{width:100%;text-align:left;border:0;background:transparent;color:#59707d;padding:10px 11px;border-radius:10px;font-size:12px;font-weight:650;transition:.15s ease}.nav button:hover,.nav a:hover{background:#f3f8f8;color:var(--ink)}.nav button.active,.nav a.active{background:var(--soft);color:#248c88;box-shadow:inset 3px 0 var(--brand)}
    main{padding:24px 26px 36px;min-width:0}.topbar{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:18px}.topbar h1{margin:0;font-size:21px;line-height:1.2;font-weight:700;letter-spacing:-.015em}.userbar{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:11px}
    .btn{border:1px solid transparent;border-radius:9px;padding:9px 12px;font-size:11px;font-weight:650;line-height:1;min-height:34px}.btn.primary{background:var(--brand);color:#103b3a}.btn.primary:hover{background:#49bbb5}.btn.dark{background:var(--ink);color:#fff}.btn.ghost{background:#fff;border-color:var(--line);color:var(--ink)}.btn.ghost:hover{background:#f8fbfc}.btn.danger{background:#fff5f5;color:#a63b3b;border-color:#f0d3d3}
    .panel,.reservation-card{background:var(--panel);border:1px solid var(--line);border-radius:15px;box-shadow:var(--shadow);padding:15px;margin-bottom:14px}
    .toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.toolbar select,.toolbar input{border:1px solid var(--line);border-radius:9px;padding:8px 10px;background:#fff;font-size:11px;min-height:34px}.toolbar #productSelect{min-width:280px;max-width:420px}
    .month-nav{display:flex;gap:7px;align-items:center;margin-left:auto}.month-title{min-width:132px;text-align:center;font-size:12px;font-weight:700;text-transform:capitalize}
    #askPriceBtn{border-color:#f2d69a;background:#fffaf0;color:#9a6811}#askPriceBtn.on{background:var(--ink);border-color:var(--ink);color:#fff}
    .calendar{display:grid;grid-template-columns:repeat(7,minmax(118px,1fr));gap:7px;overflow-x:auto;padding:0 0 5px}.dow{font-size:9px;font-weight:700;color:#728692;text-align:center;padding:4px 2px 7px;text-transform:uppercase;letter-spacing:.06em}
    .day{min-height:139px;background:#fff;border:1px solid var(--line);border-radius:11px;padding:8px;cursor:pointer;position:relative;color:var(--ink);transition:.16s ease}.day:hover{transform:translateY(-1px);border-color:#9bd9d5;box-shadow:0 8px 20px rgba(42,117,114,.09)}.day.out{opacity:.38;background:#f8fafb}
    .day-head{display:flex;align-items:center;justify-content:space-between;gap:6px;padding-bottom:6px;margin-bottom:5px;border-bottom:1px solid #edf2f4}.day-number{display:grid;place-items:center;width:27px;height:27px;border-radius:8px;background:var(--soft);color:#267f7b;font-weight:750;font-size:12px}.day-full-date{font-size:8px;color:#94a3ab;font-weight:600;text-align:right}
    .day-row{display:grid;grid-template-columns:46px 1fr;align-items:center;gap:5px;min-height:22px;padding:3px 5px;margin-top:3px;border-radius:6px;background:#f8fafb;border:1px solid #edf2f4}.day-row.gold{background:#fff9ec;border-color:#f6e7c6}.day-label{font-size:7px;text-transform:uppercase;letter-spacing:.07em;font-weight:700;color:#8b9aa2}.day-value{font-size:9px;font-weight:700;text-align:right;white-space:nowrap}.day-price .day-value{font-size:10px}.status{display:inline-flex;justify-content:center;align-items:center;font-size:7px;font-weight:750;padding:3px 6px;border-radius:999px;justify-self:end}.available{background:#eaf8f1;color:#23794f}.low{background:#fff4d9;color:#8d671c}.sold_out{background:#fff0f0;color:#ac4040}.closed{background:#eef2f4;color:#697c86}.ask-chip{display:block;margin-top:4px;padding:4px 5px;border-radius:6px;background:#fff5db;color:#8f6616;font-size:7px;font-weight:700;text-align:center}
    .products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.product-card{border:1px solid var(--line);border-radius:11px;padding:12px;background:#fff}.product-card h3{font-size:11px;margin:0 0 6px;font-weight:700}.product-card p{font-size:9px;color:var(--muted);margin:3px 0;line-height:1.45}
    .reservation-layout{display:grid;grid-template-columns:minmax(300px,360px) minmax(0,1fr);gap:14px;align-items:start}.reservation-card h2{margin:0 0 4px;font-size:15px;font-weight:700}.reservation-card>p{margin:0 0 13px;color:var(--muted);font-size:10px;line-height:1.5}.reservation-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.reservation-form-grid .full{grid-column:1/-1}.reservation-form-grid label,.form-grid label{display:block;font-size:9px;font-weight:700;margin-bottom:5px;color:#5b707c}.reservation-form-grid input,.reservation-form-grid select,.reservation-form-grid textarea,.form-grid input,.form-grid select{width:100%;border:1px solid var(--line);border-radius:8px;padding:8px 9px;background:#fff;font-size:10px;outline:none}.reservation-form-grid input:focus,.reservation-form-grid select:focus,.reservation-form-grid textarea:focus,.form-grid input:focus,.form-grid select:focus{border-color:#89d4cf;box-shadow:0 0 0 3px rgba(85,199,193,.1)}.reservation-form-grid textarea{min-height:75px;resize:vertical}.reservation-actions{display:flex;gap:7px;margin-top:11px}.reservation-actions .btn{flex:1}
    .reservation-filterbar{display:grid;grid-template-columns:minmax(180px,1.4fr) repeat(2,minmax(130px,.8fr)) auto;gap:7px;margin:0 0 12px;padding:10px;background:#f8fbfb;border:1px solid var(--line);border-radius:11px;align-items:end}.filter-field label{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.06em;color:#8a9aa3;font-weight:700;margin-bottom:4px}.filter-field select,.filter-field input{width:100%;border:1px solid var(--line);background:#fff;border-radius:8px;padding:7px 8px;font-size:10px;min-height:32px}.filter-actions{display:flex;gap:5px}.filter-summary{font-size:9px;color:var(--muted);margin:-5px 0 10px}
    .reservation-list{display:grid;gap:7px;max-height:690px;overflow:auto;padding-right:2px}.reservation-item{border:1px solid var(--line);border-radius:10px;padding:10px;background:#fff}.reservation-item-head{display:flex;justify-content:space-between;gap:10px;align-items:start;border-bottom:1px solid #edf2f4;padding-bottom:7px;margin-bottom:7px}.reservation-item h3{margin:0;font-size:11px;font-weight:700}.reservation-item small{font-size:9px;color:#6f838e}.reservation-date{font-size:8px;font-weight:700;color:#267f7b;background:var(--soft);padding:4px 6px;border-radius:999px;white-space:nowrap}.reservation-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 10px;font-size:9px;color:#5a6e79}.reservation-note{margin-top:6px;padding:7px;background:#f6fafb;border-radius:7px;font-size:9px;line-height:1.4}.reservation-item-actions{display:flex;justify-content:flex-end;margin-top:7px}.empty-state{padding:24px 12px;text-align:center;border:1px dashed #d6e3e7;border-radius:10px;color:var(--muted);font-size:10px;background:#fbfdfd}
    .login-wrap{min-height:100vh;display:grid;place-items:center;padding:24px;background:linear-gradient(135deg,#f7fafb,#eef8f7)}.login-card{width:min(380px,100%);background:#fff;border:1px solid var(--line);border-radius:18px;padding:25px;box-shadow:0 18px 50px rgba(31,72,90,.09)}.login-card h1{margin:0 0 5px;font-size:19px}.login-card p{color:var(--muted);font-size:10px}.field{margin:12px 0}.field label{display:block;font-size:9px;font-weight:700;margin-bottom:5px}.field input,.field select{width:100%;padding:9px;border:1px solid var(--line);border-radius:9px;font-size:11px}.notice{padding:9px 10px;border-radius:8px;background:#fff8e8;color:#896317;font-size:10px;margin-bottom:11px}.hidden{display:none!important}
    dialog{width:min(500px,calc(100% - 30px));border:0;border-radius:15px;padding:0;box-shadow:0 25px 70px rgba(0,0,0,.18)}dialog::backdrop{background:rgba(19,42,55,.32)}.dialog-body{padding:19px}.dialog-body h3{margin:0 0 14px;font-size:15px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.form-grid .full{grid-column:1/-1}.actions{display:flex;justify-content:flex-end;gap:7px;margin-top:14px}
    .nav a{text-decoration:none}
    @media(max-width:1180px){.products{grid-template-columns:repeat(2,1fr)}.calendar{grid-template-columns:repeat(7,minmax(110px,1fr))}.reservation-filterbar{grid-template-columns:1fr 1fr}.filter-actions{align-self:end}}
    @media(max-width:900px){.shell{grid-template-columns:1fr}aside{height:auto;position:static;border-right:0;border-bottom:1px solid var(--line);padding:11px 14px}.brand{margin:0 0 10px}.nav{display:flex;overflow:auto}.nav button,.nav a{white-space:nowrap;width:auto}.reservation-layout{grid-template-columns:1fr}main{padding:16px}.toolbar #productSelect{min-width:210px}.month-nav{margin-left:0}.calendar{grid-template-columns:repeat(7,minmax(105px,1fr))}}
    @media(max-width:600px){html{font-size:13px}.topbar{align-items:flex-start}.userbar{flex-direction:column;align-items:flex-end}.reservation-form-grid,.reservation-filterbar{grid-template-columns:1fr}.products{grid-template-columns:1fr}.panel{padding:10px}.calendar{grid-template-columns:repeat(7,minmax(98px,1fr))}}
  </style>
</head>
<body>
  <section id="loginView" class="login-wrap">
    <div class="login-card">
      <h1>Yönetim Paneli</h1>
      <p>Fiyat, kontenjan ve satış durumlarını yönetin.</p>
      <div id="loginError" class="notice hidden"></div>
      <form id="loginForm">
        <div class="field"><label>E-posta</label><input id="email" type="email" required /></div>
        <div class="field"><label>Şifre</label><input id="password" type="password" required /></div>
        <button class="btn primary" style="width:100%" type="submit">Giriş Yap</button>
      </form>
    </div>
  </section>

  <section id="appView" class="shell hidden">
    <aside>
      <div class="brand">CAPPADOCIAGO<small>CAPPADOCIA ADMIN</small></div>
      <div class="nav">
        <button class="active" data-tab="calendar">📅 Takvim</button>
        <button data-tab="products">🎈 Ürünler</button>
        <button data-tab="reservations">🧾 Rezervasyon Detayları</button>
        <a class="tour-manager-link" href="/admin/tours">🗺️ Tur İçerik Paneli</a>
</div>
    </aside>
    <main>
      <div class="topbar">
        <div><h1 id="pageTitle">Fiyat & Kontenjan Takvimi</h1></div>
        <div class="userbar"><span id="adminEmail"></span><button id="logoutBtn" class="btn ghost">Çıkış</button></div>
      </div>

      <section id="calendarTab">
        <div class="panel">
          <div class="toolbar">
            <select id="productSelect"></select>
            <button id="bulkBtn" class="btn primary">Tarih Aralığı Güncelle</button>
            <button id="askPriceBtn" class="btn" type="button">💬 Ask For Price: Kapalı</button>
            <div class="month-nav">
              <button id="prevMonth" class="btn ghost">‹</button>
              <div id="monthTitle" class="month-title"></div>
              <button id="nextMonth" class="btn ghost">›</button>
            </div>
          </div>
        </div>
        <div class="panel">
          <div id="calendar" class="calendar"></div>
        </div>
      </section>

      <section id="productsTab" class="hidden">
        <div class="panel"><div id="productsGrid" class="products"></div></div>
      </section>

      <section id="reservationsTab" class="hidden">
        <div class="reservation-layout">
          <div class="reservation-card">
            <h2>Manuel Rezervasyon Ekle</h2>
            <p>Misafirin rezervasyon detaylarını tarih ve tur bazında kaydedin.</p>
            <form id="reservationForm">
              <input id="reservationId" type="hidden" />
              <div class="reservation-form-grid">
                <div><label>Rezervasyon Tarihi</label><input id="reservationDate" type="date" required /></div>
                <div><label>Tur Adı</label><select id="reservationProduct" required></select></div>
                <div><label>Müşteri Adı</label><input id="reservationName" type="text" required placeholder="Ad Soyad" /></div>
                <div><label>Müşteri Sayısı</label><input id="reservationCount" type="number" min="1" value="1" required /></div>
                <div><label>Otel</label><input id="reservationHotel" type="text" placeholder="Otel / Konaklama" /></div>
                <div><label>Telefon</label><input id="reservationPhone" type="tel" placeholder="+90 ..." /></div>
                <div class="full"><label>E-posta</label><input id="reservationEmail" type="email" placeholder="guest@example.com" /></div>
                <div class="full"><label>Not</label><textarea id="reservationNote" placeholder="Pickup saati, özel istek, ödeme notu vb."></textarea></div>
              </div>
              <div class="reservation-actions"><button id="reservationReset" type="button" class="btn ghost">Temizle</button><button class="btn primary" type="submit">Rezervasyonu Kaydet</button></div>
            </form>
          </div>
          <div class="reservation-card">
            <h2>Gelen Rezervasyonlar</h2>
            <p>Tur ve tarih aralığına göre rezervasyonları hızlıca filtreleyin.</p>
            <div class="reservation-filterbar">
              <div class="filter-field"><label>Tur</label><select id="reservationFilterProduct"><option value="">Tüm turlar</option></select></div>
              <div class="filter-field"><label>Başlangıç</label><input id="reservationFilterStart" type="date" /></div>
              <div class="filter-field"><label>Bitiş</label><input id="reservationFilterEnd" type="date" /></div>
              <div class="filter-actions"><button id="reservationFilterClear" type="button" class="btn ghost">Temizle</button></div>
            </div>
            <div id="reservationFilterSummary" class="filter-summary"></div>
            <div id="reservationsList" class="reservation-list"></div>
          </div>
        </div>
      </section>

    </main>
  </section>

  <dialog id="dayDialog">
    <div class="dialog-body">
      <h3 id="dayDialogTitle">Günü Güncelle</h3>
      <form id="dayForm">
        <input type="hidden" id="editDate" />
        <div class="form-grid">
          <div><label>Fiyat (€)</label><input id="editPrice" type="number" step="0.01" min="0" required /></div>
          <div><label>Toplam Kontenjan</label><input id="editCapacity" type="number" min="0" required /></div>
          <div><label>Satılan</label><input id="editBooked" type="number" min="0" required /></div>
          <div><label>Durum</label><select id="editStatus"><option value="available">Müsait</option><option value="sold_out">Dolu</option><option value="closed">Satış Kapalı</option></select></div>
        </div>
        <div class="actions"><button type="button" class="btn ghost" id="dayCancel">Vazgeç</button><button class="btn primary">Kaydet</button></div>
      </form>
    </div>
  </dialog>

  <dialog id="bulkDialog">
    <div class="dialog-body">
      <h3>Tarih Aralığı Güncelle</h3>
      <form id="bulkForm">
        <div class="form-grid">
          <div><label>Başlangıç</label><input id="bulkStart" type="date" required /></div>
          <div><label>Bitiş</label><input id="bulkEnd" type="date" required /></div>
          <div><label>Fiyat (€)</label><input id="bulkPrice" type="number" step="0.01" min="0" required /></div>
          <div><label>Kontenjan</label><input id="bulkCapacity" type="number" min="0" required /></div>
          <div class="full"><label>Durum</label><select id="bulkStatus"><option value="available">Müsait</option><option value="closed">Satış Kapalı</option></select></div>
        </div>
        <div class="actions"><button type="button" class="btn ghost" id="bulkCancel">Vazgeç</button><button class="btn primary">Aralığı Kaydet</button></div>
      </form>
    </div>
  </dialog>

  <script src="../../scripts/admin.ts"></script>
</body>
</html>