---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Add Tour | CappadociaGo Admin">

<div class="admin-page">
  <div class="wrap">

    <div class="admin-header">
      <a href="/" class="back-link">← Back to site</a>
      <h1>Add a New Tour</h1>
      <p class="admin-sub">Fill in the shared details once, then fill each language tab. All three languages are required before saving.</p>
    </div>

    <form id="tourForm">

      <section class="admin-block">
        <h2>Shared Details <span class="tag-note">(same for all languages)</span></h2>
        <div class="grid-2">
          <label>Slug (URL) <span class="req">*</span>
            <input type="text" name="slug" placeholder="e.g. cappadocia-hot-air-balloon-tour" required />
          </label>
          <label>Category <span class="req">*</span>
            <select name="category" required>
              <option value="">Select category</option>
              <option value="balloon">Balloon Tours</option>
              <option value="daily">Daily Tours</option>
              <option value="package">Package Tours</option>
              <option value="activity">Activities</option>
              <option value="transfer">Transfers</option>
              <option value="private">Private Tours</option>
              <option value="safari">Safari Tours</option>
              <option value="sunset">Sunset Tours</option>
            </select>
          </label>
          <label>Price (€) <span class="req">*</span>
            <input type="number" name="price" step="0.01" min="0" required />
          </label>
          <label>Old / Crossed-out Price (€)
            <input type="number" name="old_price" step="0.01" min="0" />
          </label>
          <label>Duration (minutes)
            <input type="number" name="duration_minutes" min="0" placeholder="e.g. 60" />
          </label>
          <label>Hero Image Path
            <input type="text" name="hero_image" placeholder="/images/tour-balloon-1.jpg" />
          </label>
        </div>
        <label class="full">Gallery Image Paths <span class="hint">(one per line)</span>
          <textarea name="gallery_images" rows="3" placeholder="/images/tour-balloon-2.jpg&#10;/images/tour-balloon-3.jpg"></textarea>
        </label>
      </section>

      <section class="admin-block">
        <h2>Content <span class="tag-note">(fill in all 3 tabs)</span></h2>

        <div class="lang-tabs">
          <button type="button" class="lang-tab active" data-lang="tr">🇹🇷 Türkçe</button>
          <button type="button" class="lang-tab" data-lang="en">🇬🇧 English</button>
          <button type="button" class="lang-tab" data-lang="es">🇪🇸 Español</button>
        </div>

        {['tr', 'en', 'es'].map((lang) => (
          <div class="lang-panel" data-lang-panel={lang} style={lang === 'tr' ? '' : 'display:none;'}>
            <div class="grid-2">
              <label>Title <span class="req">*</span>
                <input type="text" name={`${lang}_title`} required />
              </label>
              <label>Badge / Kicker text
                <input type="text" name={`${lang}_kicker`} placeholder="CAPPADOCIAGO" />
              </label>
              <label>Duration label
                <input type="text" name={`${lang}_duration_label`} placeholder="60 Minutes / 60 Dakika / 60 Minutos" />
              </label>
            </div>

            <label class="full">Hero Description
              <textarea name={`${lang}_hero_desc`} rows="2"></textarea>
            </label>

            <label class="full">Overview Title
              <input type="text" name={`${lang}_overview_title`} />
            </label>
            <label class="full">Overview Paragraphs <span class="hint">(one paragraph per line)</span>
              <textarea name={`${lang}_overview_paragraphs`} rows="3"></textarea>
            </label>

            <div class="grid-2">
              <label>Price Section Title
                <input type="text" name={`${lang}_price_title`} />
              </label>
            </div>
            <label class="full">Price Text
              <textarea name={`${lang}_price_text`} rows="2"></textarea>
            </label>

            <label class="full">What's Included <span class="hint">(one item per line)</span>
              <textarea name={`${lang}_whats_included`} rows="4"></textarea>
            </label>

            <label class="full">Important Information <span class="hint">(one item per line)</span>
              <textarea name={`${lang}_important_info`} rows="4"></textarea>
            </label>

            <label class="full">Flight Details Title
              <input type="text" name={`${lang}_flight_details_title`} />
            </label>
            <label class="full">Flight Details Paragraphs <span class="hint">(one paragraph per line)</span>
              <textarea name={`${lang}_flight_details_paragraphs`} rows="3"></textarea>
            </label>

            <div class="grid-2">
              <label>After Flight Title
                <input type="text" name={`${lang}_after_flight_title`} />
              </label>
              <label>Refund Guarantee Title
                <input type="text" name={`${lang}_refund_title`} />
              </label>
            </div>
            <label class="full">After Flight Text
              <textarea name={`${lang}_after_flight_text`} rows="2"></textarea>
            </label>
            <label class="full">Refund Guarantee Text
              <textarea name={`${lang}_refund_text`} rows="2"></textarea>
            </label>

            <div class="grid-2">
              <label>Advance Booking Title
                <input type="text" name={`${lang}_advance_title`} />
              </label>
              <label>Safety Title
                <input type="text" name={`${lang}_safety_title`} />
              </label>
            </div>
            <label class="full">Advance Booking Text
              <textarea name={`${lang}_advance_text`} rows="2"></textarea>
            </label>
            <label class="full">Safety Text
              <textarea name={`${lang}_safety_text`} rows="2"></textarea>
            </label>
          </div>
        ))}
      </section>

      <div class="admin-actions">
        <div id="formMsg" class="form-msg"></div>
        <button type="submit" class="btn-save" id="saveBtn">Save Tour to All 3 Languages</button>
      </div>

    </form>
  </div>
</div>

</Layout>

<style>
  .admin-page{background:var(--cream);padding:50px 0 100px;min-height:100vh;}
  .admin-header{margin-bottom:36px;}
  .back-link{font-size:13.5px;font-weight:600;color:var(--blue-deep);margin-bottom:16px;display:inline-block;}
  .admin-header h1{font-family:'Fraunces',serif;font-weight:600;font-size:clamp(26px,3.4vw,36px);color:var(--blue-deeper);margin-top:10px;}
  .admin-sub{font-size:14.5px;color:var(--stone);margin-top:8px;max-width:600px;line-height:1.6;}

  .admin-block{background:#fff;border:1px solid var(--line);border-radius:16px;padding:28px 30px;margin-bottom:24px;}
  .admin-block h2{font-family:'Fraunces',serif;font-weight:600;font-size:19px;color:var(--blue-deeper);margin-bottom:20px;}
  .tag-note{font-size:12px;font-weight:400;color:var(--stone);font-family:'Plus Jakarta Sans',sans-serif;}

  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}
  @media(max-width:700px){.grid-2{grid-template-columns:1fr;}}

  label{display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:700;color:var(--stone);text-transform:uppercase;letter-spacing:.04em;}
  label.full{margin-bottom:16px;}
  .req{color:#C13B3B;}
  .hint{font-size:11px;font-weight:500;color:var(--stone);text-transform:none;letter-spacing:0;}

  input, select, textarea{
    border:1px solid var(--line);border-radius:10px;padding:11px 13px;font-size:14px;
    font-family:'Plus Jakarta Sans',sans-serif;color:var(--ink);background:var(--cream);
    text-transform:none;font-weight:400;letter-spacing:normal;
  }
  textarea{resize:vertical;}

  .lang-tabs{display:flex;gap:10px;margin-bottom:24px;border-bottom:1px solid var(--line);padding-bottom:0;}
  .lang-tab{
    border:none;background:none;padding:10px 18px;font-size:14px;font-weight:700;color:var(--stone);
    cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-1px;transition:color .2s,border-color .2s;
  }
  .lang-tab.active{color:var(--blue-deep);border-bottom-color:var(--gold-bright);}
  .lang-tab:hover{color:var(--blue-deep);}

  .admin-actions{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;}
  .btn-save{
    background:var(--blue-deep);color:#fff;border:none;padding:15px 32px;border-radius:100px;
    font-weight:700;font-size:14.5px;cursor:pointer;transition:background .2s;
  }
  .btn-save:hover{background:var(--blue-bright);}
  .btn-save:disabled{opacity:.6;cursor:not-allowed;}
  .form-msg{font-size:14px;font-weight:600;}
  .form-msg.success{color:#1E8A5F;}
  .form-msg.error{color:#C13B3B;}
</style>

<script>
  // Tab switching
  document.querySelectorAll('.lang-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang');
      document.querySelectorAll('.lang-tab').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.lang-panel').forEach((panel) => {
        const el = panel as HTMLElement;
        el.style.display = el.getAttribute('data-lang-panel') === lang ? '' : 'none';
      });
    });
  });

  // Helper: split a textarea's value into a clean array of non-empty lines
  function linesToArray(value: string): string[] {
    return value
      .split('\n')
      .map((line) => line.trim())
      .filter((line) => line.length > 0);
  }

  const form = document.getElementById('tourForm') as HTMLFormElement;
  const saveBtn = document.getElementById('saveBtn') as HTMLButtonElement;
  const formMsg = document.getElementById('formMsg') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    formMsg.textContent = 'Saving...';
    formMsg.className = 'form-msg';

    const fd = new FormData(form);
    const get = (name: string) => (fd.get(name) as string) || '';

    const langs = ['tr', 'en', 'es'];
    const translations: Record<string, any> = {};

    for (const lang of langs) {
      translations[lang] = {
        title: get(`${lang}_title`),
        kicker: get(`${lang}_kicker`),
        duration_label: get(`${lang}_duration_label`),
        hero_desc: get(`${lang}_hero_desc`),
        overview_title: get(`${lang}_overview_title`),
        overview_paragraphs: linesToArray(get(`${lang}_overview_paragraphs`)),
        price_title: get(`${lang}_price_title`),
        price_text: get(`${lang}_price_text`),
        whats_included: linesToArray(get(`${lang}_whats_included`)),
        important_info: linesToArray(get(`${lang}_important_info`)),
        flight_details_title: get(`${lang}_flight_details_title`),
        flight_details_paragraphs: linesToArray(get(`${lang}_flight_details_paragraphs`)),
        after_flight_title: get(`${lang}_after_flight_title`),
        after_flight_text: get(`${lang}_after_flight_text`),
        refund_title: get(`${lang}_refund_title`),
        refund_text: get(`${lang}_refund_text`),
        advance_title: get(`${lang}_advance_title`),
        advance_text: get(`${lang}_advance_text`),
        safety_title: get(`${lang}_safety_title`),
        safety_text: get(`${lang}_safety_text`),
      };
    }

    const payload = {
      slug: get('slug'),
      category: get('category'),
      price: parseFloat(get('price')),
      old_price: get('old_price') ? parseFloat(get('old_price')) : null,
      duration_minutes: get('duration_minutes') ? parseInt(get('duration_minutes')) : null,
      hero_image: get('hero_image'),
      gallery_images: linesToArray(get('gallery_images')),
      translations,
    };

    try {
      const res = await fetch('/api/add-tour', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || 'Something went wrong.');
      }

      formMsg.textContent = `✓ Tour saved successfully! (slug: ${data.slug})`;
      formMsg.className = 'form-msg success';
      form.reset();
    } catch (err) {
      formMsg.textContent = `✗ ${err instanceof Error ? err.message : 'Failed to save tour.'}`;
      formMsg.className = 'form-msg error';
    } finally {
      saveBtn.disabled = false;
    }
  });
</script>
