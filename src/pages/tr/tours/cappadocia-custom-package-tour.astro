    {
      "title": "Neden Bizimle Planlamalısınız?",
      "items": [
        "Tam esneklik: yalnızca istediğiniz turları seçin",
        "Havalimanı transferleri, özel araçlar ve profesyonel rehberlerle uçtan uca konfor",
        "Grup büyüklüğü ve aktivitelere göre özel fiyatlandırma"
      ]
    }
  ],
  "duration": "Esnek",
  "rating": "",
  "mainImage": "/images/tours/Cappadocia-Package-Tour.webp",
  "galleryImages": [
    "/images/tours/tbc-goreme-standart-hot-air-balloon-tour.webp",
    "/images/tours/Private-Red-Tour-Cappadocia.webp",
    "/images/tours/Private-Green-Tour-Cappadocia.webp",
    "/images/tours/ATV-Tour-With-Goreme-Valleys.webp"
