  "included": [
    "Size özel program planlama",
    "Özel Kırmızı veya Yeşil Tur seçeneği",
    "Gün doğumu sıcak hava balonu ekleme seçeneği",
    "ATV safari, at turu veya Jeep safari seçenekleri",
    "Havalimanı transferi ve özel araç seçenekleri",
    "Seyahat danışmanı desteği"
  ],
  "importantTitle": "Aktivite Menüsü",
  "important": [
    "Kültürel Keşif: Özel Kırmızı Tur veya Özel Yeşil Tur",
    "Gökyüzü Deneyimi: Gün doğumu sıcak hava balonu uçuşu",
    "ATV Safari: Vadilerde eğlenceli sürüş",
    "At Turu: Güzel Atlar Diyarı’nda sakin yolculuk",
    "Jeep Safari: Ulaşılması zor tepeler ve vadiler"
  ],
  "detailsTitle": "Örnek 3 Günlük Paket",
