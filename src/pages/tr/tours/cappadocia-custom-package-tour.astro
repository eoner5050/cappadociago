import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const props = {
  "title": "Kapadokya Özel Paket Tur",
  "heroDesc": "Hayaliniz, bizim Kapadokya deneyimimiz: kalış gününüze ve yapmak istediğiniz aktivitelere göre tamamen size özel tatil paketi oluşturun.",
