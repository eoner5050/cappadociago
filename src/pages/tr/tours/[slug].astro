---
import DatabaseTourPage from '../../../components/DatabaseTourPage.astro';
import { getPublishedTour } from '../../../lib/databaseTours';
export const prerender = false;
const { slug = '' } = Astro.params;
const result = await getPublishedTour(slug, 'tr');
if (!result) return Astro.redirect('/tr/cappadocia-tours/');
---
<DatabaseTourPage lang="tr" tour={result.tour} translation={result.translation} />

<!-- CG_FINAL_MOBILE_TOUR_CONTENT_PHONE -->
<link rel="stylesheet" href="/tour-mobile-critical-v3.css" />
