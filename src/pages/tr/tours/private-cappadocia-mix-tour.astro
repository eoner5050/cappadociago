---
import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const tour = {
  title: 'Özel Kapadokya Mix Tur',
  kicker: 'CAPPADOCIAGO',
  heroDesc: "İlgi alanlarınıza göre hazırlanan özel rota ile Kapadokya'yı kendi temponuzda keşfedin. Kırmızı ve Yeşil Tur'un öne çıkan noktalarını özel araç, profesyonel rehber ve esnek zamanlama ile birleştirin.",
  overviewTitle: 'Özel Kapadokya Tur Genel Bakış',
  overviewParagraphs: ['Özel Kapadokya Mix Tur, bölgeyi tamamen kendilerine göre hazırlanmış bir programla gezmek isteyen misafirler için tasarlanmıştır. Standart grup turuna katılmak yerine kendi özel aracınız ve profesyonel rehberinizle seyahat edersiniz.'],
  priceTitle: 'Özel Kapadokya Tur Fiyatı',
  priceText: 'Fiyat İçin İletişime Geçin',
  whatsIncluded: ['VIP özel transfer hizmeti', 'Profesyonel özel tur rehberi', 'Öğle yemeği', 'Esnek rota planlaması', 'Grubunuza özel araç', '7/24 rezervasyon desteği'],
  importantInfo: ['Grubunuza özel esnek rota', 'Kırmızı ve Yeşil Tur noktalarını birleştirme seçeneği', 'Aileler, çiftler ve küçük gruplar için uygun', 'Otelden alma ve otele bırakma', 'Kesin rota ilgi alanlarınıza ve zamana göre belirlenir', 'Fiyat grup büyüklüğü ve seçilen programa göre değişir'],
  flightDetailsTitle: 'Özel Kapadokya Tur Rotası',
  flightDetailsParagraphs: ["Kişiye Özel Rota Planlama: Kapadokya'da görmek istediğiniz yerlere göre size özel bir gezi planı hazırlanabilir ve program üzerinde daha fazla kontrol sahibi olabilirsiniz.", "Kırmızı ve Yeşil Tur Noktalarını Birleştirme: Talebinize göre Kırmızı Tur ve Yeşil Tur'un popüler durakları tek bir özel rotada bir araya getirilebilir.", 'Aileler ve Gruplar İçin Konfor: Program katılımcı sayısı, beklentiler, yürüyüş tercihleri ve zamanınıza göre esnek şekilde planlanır.', 'Daha Fazla Kontrol, Daha Fazla Konfor: Beğendiğiniz noktalarda daha uzun kalabilir, diğer duraklarda daha hızlı ilerleyerek turu daha kişisel hale getirebilirsiniz.'],
  afterFlightTitle: 'Tur Sonu',
  afterFlightText: 'Programın ardından konforlu şekilde otelinize geri transfer edilirsiniz.',
  refundTitle: 'İptal ve Rezervasyon',
  refundText: 'Rezervasyon ve iptal koşulları müsaitlik ve seçilen programa göre değişir. Kesin detaylar için bizimle iletişime geçebilirsiniz.',
  advanceTitle: 'Neden Erken Rezervasyon?',
  advanceText: 'Erken rezervasyon tercih ettiğiniz tarih, rehber ve araç müsaitliğini güvence altına almaya yardımcı olur.',
  safetyTitle: 'Profesyonel Hizmet',
  safetyText: 'Tur deneyimli sürücüler, profesyonel rehberler ve yerel operasyon ekibimiz tarafından organize edilir.'
};
const pageLang = 'tr';
const slug = 'private-cappadocia-mix-tour';
const mainImage = '/images/tours/Private-Mix-Cappadocia-Tour.webp';
export const prerender = false;
const extraSections = [
  { title: tour.afterFlightTitle || 'Tur Sonrası', paragraphs: tour.afterFlightText ? [tour.afterFlightText] : [] },
  { title: tour.refundTitle || 'İptal & İade', paragraphs: tour.refundText ? [tour.refundText] : [] },
  { title: tour.advanceTitle || 'Neden Önceden Rezervasyon?', paragraphs: tour.advanceText ? [tour.advanceText] : [] },
  { title: tour.safetyTitle || 'Güvenlik ve Deneyim', paragraphs: tour.safetyText ? [tour.safetyText] : [] }
].filter(s => s.paragraphs.length);
---
<StandardizedPrivateTourPage
  lang={pageLang}
  slug={slug}
  title={tour.title}
  heroDesc={tour.heroDesc}
  overviewTitle={tour.overviewTitle}
  overviewParagraphs={tour.overviewParagraphs || []}
  priceTitle={tour.priceTitle}
  priceText={tour.priceText}
  included={tour.whatsIncluded || []}
  importantTitle='Önemli Bilgiler'
  important={tour.importantInfo || []}
  detailsTitle={tour.flightDetailsTitle}
  details={tour.flightDetailsParagraphs || []}
  extraSections={extraSections}
  duration='Full Day'
  rating='4.97'
  reviewCount=0
  mainImage={mainImage}
  priceMode={/request|fiyat sor|consultar/i.test(String(tour.priceText || '')) ? 'ask' : 'perPerson'}
  sidebarBadges={(tour.whatsIncluded || []).slice(0,3)}
  sideHighlights={(tour.importantInfo || []).slice(0,5)}
/>
