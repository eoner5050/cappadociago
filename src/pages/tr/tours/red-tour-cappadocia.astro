  .tbc-review-item { padding: 20px 0; border-bottom: 1px solid #334155; }
  .tbc-review-item:last-child { border-bottom: none; }
  .tbc-review-top { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 12px; position: relative; }
  .tbc-review-user-avatar { width: 44px; height: 44px; border-radius: 50%; background: #3b82f6; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px; flex-shrink: 0; }
  .tbc-review-stars { color: #eab308; font-size: 13px; letter-spacing: 1px; margin-bottom: 3px; }
  .tbc-review-name { margin: 0; font-size: 16px; font-weight: 800; color: #f8fafc; }
  .tbc-review-tour-type { font-size: 12px; color: #94a3b8; font-weight: 600; }
  .tbc-review-date { position: absolute; right: 0; top: 0; font-size: 12px; color: #94a3b8; font-weight: 600; }
  .tbc-review-text { margin: 0; font-size: 14px; line-height: 1.8; color: #cbd5e1; }
  .tbc-load-more-wrap { margin-top: 24px; text-align: center; padding-top: 16px; border-top: 1px solid #334155; }
  .tbc-load-more-btn { background: #0f172a; border: 1px solid #eab308; color: #eab308; padding: 12px 28px; border-radius: 999px; font-weight: 800; font-size: 14px; cursor: pointer; transition: all 0.2s ease; }
  .tbc-load-more-btn:hover { background: #eab308; color: #0f172a; }
  .tbc-tour-side-card { padding: 22px; }
  .tbc-tour-price-top { padding-bottom: 18px; margin-bottom: 18px; border-bottom: 1px solid #334155; }
  .tbc-tour-price-label { display: block; margin-bottom: 6px; font-size: 13px; color: #94a3b8; font-weight: 700; }
  .tbc-tour-price-value { display: flex; align-items: flex-end; gap: 8px; color: #eab308; }
  .tbc-tour-price-value strong { font-size: 40px; line-height: 1; font-weight: 900; }
  .tbc-tour-price-value span { font-size: 15px; font-weight: 700; color: #94a3b8; padding-bottom: 4px; }
  .tbc-tour-badge-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .tbc-tour-badge { display: inline-flex; align-items: center; min-height: 30px; padding: 0 12px; border-radius: 999px; background: #0f172a; border: 1px solid #334155; color: #eab308; font-size: 12px; font-weight: 800; }
  .tbc-tour-contact-box { margin-top: 0; padding-top: 0; border-top: 0; display: grid; gap: 10px; }
  .tbc-tour-contact-link, .tbc-tour-whatsapp { display: inline-flex; align-items: center; justify-content: center; width: 100%; min-height: 48px; border-radius: 999px; text-decoration: none; font-size: 14px; font-weight: 800; }
  .tbc-tour-contact-link { background: #0f172a; border: 1px solid #334155; color: #f8fafc; }
  .tbc-tour-whatsapp { background: #22c55e; color: #fff; }
  .tbc-tour-side-list { margin-top: 18px; display: grid; gap: 10px; }
