<style is:global>
.tbc-main-photo,.tbc-side-photo-item{border:0;padding:0;cursor:zoom-in}.tbc-gallery-modal{position:fixed;inset:0;background:rgba(3,12,25,.92);z-index:99999;display:none;align-items:center;justify-content:center;padding:70px 80px}.tbc-gallery-modal.is-open{display:flex}.tbc-gallery-modal>img{max-width:min(1180px,88vw);max-height:82vh;object-fit:contain;border-radius:16px;box-shadow:0 20px 70px #0008}.tbc-gallery-close,.tbc-gallery-prev,.tbc-gallery-next{position:absolute;border:0;background:#fff;color:#071d3b;display:grid;place-items:center;cursor:pointer;box-shadow:0 8px 24px #0004}.tbc-gallery-close{right:26px;top:22px;width:44px;height:44px;border-radius:50%;font-size:28px}.tbc-gallery-prev,.tbc-gallery-next{top:50%;transform:translateY(-50%);width:48px;height:48px;border-radius:50%;font-size:30px}.tbc-gallery-prev{left:24px}.tbc-gallery-next{right:24px}.tbc-gallery-count{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);color:#fff;font-weight:800;font-size:13px;background:#0008;padding:7px 12px;border-radius:99px}@media(max-width:600px){.tbc-gallery-modal{padding:65px 14px}.tbc-gallery-prev{left:8px}.tbc-gallery-next{right:8px}}

