  .tbc-tour-check { width: 20px; height: 20px; min-width: 20px; border-radius: 50%; margin-top: 3px; background: rgba(34, 197, 94, 0.15); color: #22c55e; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; }
  .tbc-reviews-card { padding: 32px; }
