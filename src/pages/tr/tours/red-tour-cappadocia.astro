  .tbc-calendar-note { margin-top: 12px; padding-top: 12px; border-top: 1px solid #334155; font-size: 11px; line-height: 1.5; color: #94a3b8; }
  .tbc-selected-price-box { grid-column: 1 / -1; display: none; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 15px; border-radius: 16px; background: #0f172a; border: 1px solid #334155; }
  .tbc-selected-price-box.is-visible { display: flex; }
  .tbc-selected-price-box span { font-size: 13px; font-weight: 700; color: #94a3b8; }
  .tbc-selected-price-box strong { font-size: 18px; font-weight: 900; color: #eab308; }
  .tbc-site-footer { width: 100%; background: #0b1120; border-top: 1px solid #1e293b; padding: 50px 20px; color: #f8fafc; }
  .tbc-footer-container { max-width: 1240px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; gap: 40px; flex-wrap: wrap; }
  .tbc-footer-col-left .tbc-footer-logo-big { max-height: 180px; width: auto; display: block; }
  .tbc-footer-col-right { display: flex; flex-direction: column; gap: 24px; max-width: 700px; }
  .tbc-footer-contacts { display: flex; flex-wrap: wrap; gap: 30px; }
  .tbc-f-contact-item { display: flex; align-items: center; gap: 14px; }
  .tbc-f-icon { width: 44px; height: 44px; border-radius: 50%; background: #ff5722; display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff; flex-shrink: 0; }
  .whatsapp-icon { background: #22c55e; }
  .email-icon { background: #ff5722; }
  .phone-icon { background: #ff5722; }
  .tbc-f-label { display: block; font-size: 12px; color: #94a3b8; font-weight: 600; }
  .tbc-footer-contacts a { color: #f8fafc; text-decoration: none; font-size: 15px; font-weight: 700; transition: color 0.2s; }
