    border: 1px solid #e4eaf1;
    border-radius: 999px;
    background: #fff;
    color: #30445d;
    text-decoration: none;
    font-size: 10.5px;
    font-weight: 700;
    white-space: nowrap;
    line-height: 1;
    box-shadow: 0 3px 10px rgba(10,21,38,.035);
  }

  .header-instagram::before {
    content: '';
    width: 1px;
    height: 26px;
    position: absolute;
    left: -7px;
    top: 50%;
    transform: translateY(-50%);
    background: #e7edf4;
  }

  .header-instagram-icon {
    width: 19px;
    height: 19px;
    display: block;
    object-fit: contain;
    flex: 0 0 19px;
  }

  .main-nav ul {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 18px;
    margin: 0;
    padding: 0;
  }

  .main-nav a {
    position: relative;
    text-decoration: none;
    color: #0a1526;
    font-weight: 700;
    font-size: 13px;
    white-space: nowrap;
    padding: 34px 0;
  }

  .main-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 25px;
    height: 2px;
    border-radius: 99px;
    background: #ffd000;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform .2s ease;
  }

  .main-nav a:hover::after { transform: scaleX(1); }

  .header-right {
    position: relative;
    z-index: 1200;
    display: flex;
    align-items: center;
    gap: 9px;
    flex: 0 0 auto;
  }

  .lang-switcher { position: relative; display: inline-block; z-index: 1205; }
  .lang-btn {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    padding: 6px 12px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 12px;
    cursor: pointer;
    color: #0a1526;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .lang-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 10px 25px rgba(0,0,0,.15);
    min-width: 170px;
    z-index: 99999;
    padding: 6px;
  }
  .lang-switcher.is-open .lang-dropdown { display: block; }
  .lang-btn .arrow { transition: transform .2s ease; }
  .lang-switcher.is-open .arrow { transform: rotate(180deg); }
  .lang-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    color: #0a1526;
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 600;
    border-radius: 8px;
  }
  .lang-item:hover, .lang-item.active { background: #f1f5f9; color: #d4a900; }

  .whatsapp-btn {
    background: transparent;
    color: #0a1526;
    padding: 7px 4px;
    text-decoration: none;
    font-weight: 800;
    font-size: 12.5px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    line-height: 1;
  }
  .whatsapp-btn-icon { width: 21px; height: 21px; object-fit: contain; }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 21px;
    padding: 0;
  }
  .mobile-menu-toggle span {
    display: block;
    width: 100%;
    height: 3px;
    background: #0a1526;
    border-radius: 3px;
  }

  @media (max-width: 1024px) {
    .header-container { height: 80px; gap: 8px; }
    .logo-home img { height: 68px; max-width: 145px; }
    .header-instagram { max-width: 150px; }
    .main-nav {
      display: none;
      position: absolute;
      top: 80px;
      left: 0;
      width: 100%;
      background: #fff;
      padding: 20px;
      border-bottom: 1px solid #e2e8f0;
      box-shadow: 0 10px 25px rgba(0,0,0,.1);
    }
    .main-nav.is-open { display: block; }
    .main-nav ul { flex-direction: column; gap: 14px; align-items: flex-start; }
    .main-nav a { padding: 4px 0; }
    .mobile-menu-toggle { display: flex; }
  }

  @media (max-width: 600px) {
    .header-container { width: calc(100% - 20px); height: 80px; gap: 5px; }
    .logo-home img { height: 64px; max-width: 130px; }
    .header-instagram {
      max-width: 112px;
      padding: 4px 6px 4px 5px;
      font-size: 8px;
      gap: 4px;
    }
    .header-instagram-icon { width: 16px; height: 16px; flex-basis: 16px; }
    .whatsapp-btn span { display: none; }
    .whatsapp-btn { width: 28px; justify-content: center; padding: 0; }
    .whatsapp-btn-icon { width: 18px; height: 18px; }
    .lang-btn .lang-flag { display: none; }
    .lang-btn { padding: 6px 7px; }
  }

  /* FOOTER GERÇEK İKONLAR */
  .tbc-f-icon-clean {
    background: transparent !important;
    border-radius: 0 !important;
  }
  .tbc-footer-contact-icon {
    display: block;
    width: 26px;
    height: 26px;
    object-fit: contain;
  }
  .tbc-footer-social-inline {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
