  }

  .tbc-tour-page * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Plus Jakarta Sans', Arial, sans-serif; background: #0f172a; color: #f8fafc; }
  .tbc-site-header { width: 100%; background: #ffffff; border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; z-index: 1000; box-shadow: 0 4px 20px rgba(0,0,0,0.03); }
  .tbc-header-container { max-width: 1320px; margin: 0 auto; padding: 0 20px; height: 95px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .tbc-logo-big { height: 75px; width: auto; display: block; transition: transform 0.3s; }
  .tbc-main-nav ul { display: flex; list-style: none; gap: 24px; margin: 0; padding: 0; }
  .tbc-main-nav a { text-decoration: none; color: #0f172a; font-weight: 700; font-size: 14px; transition: color 0.2s; }
  .tbc-main-nav a:hover { color: #eab308; }
  .tbc-header-right { display: flex; align-items: center; gap: 12px; }
  .tbc-top-lang { background: #f1f5f9; border: 1px solid #cbd5e1; padding: 8px 16px; border-radius: 30px; font-weight: 700; font-size: 13px; cursor: pointer; color: #0f172a; display: flex; align-items: center; gap: 6px; }
  .tbc-top-whatsapp { background: #22c55e; color: #fff; padding: 9px 18px; border-radius: 30px; font-weight: 700; font-size: 13px; text-decoration: none; display: flex; align-items: center; gap: 6px; transition: background 0.2s; }
  .tbc-top-whatsapp:hover { background: #16a34a; }
  .tbc-tour-page { width: 100%; background: #0f172a; padding: 20px 16px 70px; }
  .tbc-tour-container { max-width: 1240px; margin: 0 auto; }
  .tbc-breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 14px; color: #94a3b8; margin-bottom: 20px; font-weight: 600; }
  .tbc-breadcrumb a { color: #f8fafc; text-decoration: none; transition: color 0.2s; }
  .tbc-breadcrumb a:hover { color: #eab308; }
  .tbc-breadcrumb span { color: #eab308; }
  .tbc-tour-hero { position: relative; overflow: hidden; border-radius: 24px; padding: 40px 36px; margin-bottom: 24px; background: linear-gradient(135deg, rgba(15,23,42,.95), rgba(30,41,59,.9)); box-shadow: 0 20px 48px rgba(0, 0, 0, 0.4); color: #fff; border: 1px solid #334155; }
  .tbc-tour-kicker { display: inline-flex; align-items: center; min-height: 30px; padding: 0 14px; border-radius: 999px; background: #eab308; color: #0f172a; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 14px; }
  .tbc-tour-title { margin: 0 0 12px; font-size: 38px; line-height: 1.15; font-weight: 800; letter-spacing: -.02em; color: #fff; }
  .tbc-tour-desc { margin: 0 0 24px; max-width: 960px; font-size: 15px; line-height: 1.8; color: #cbd5e1; }
  .tbc-hero-badges-bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; padding-top: 10px; border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .tbc-badge-item { display: inline-flex; align-items: center; gap: 8px; background: #1e293b; border: 1px solid #334155; padding: 8px 16px; border-radius: 999px; font-size: 13px; font-weight: 700; color: #f8fafc; }
  .tbc-stars { color: #eab308; font-size: 14px; letter-spacing: 1px; }
  .tbc-badge-val { color: #f8fafc; font-weight: 800; }
  .tbc-badge-sep { color: #475569; }
  .tbc-badge-link { color: #38bdf8; cursor: pointer; }
  .tbc-badge-icon { font-size: 15px; }
  .tbc-badge-wa { background: #22c55e !important; border-color: #22c55e !important; color: #ffffff !important; text-decoration: none; }
  .tbc-badge-wa strong { font-weight: 800; }
  .tbc-photo-grid-wrapper { display: grid; grid-template-columns: 2fr 1fr; gap: 12px; margin-bottom: 30px; border-radius: 24px; overflow: hidden; background: #1e293b; border: 1px solid #334155; padding: 12px; box-shadow: 0 20px 48px rgba(0, 0, 0, 0.4); }
  .tbc-main-photo { position: relative; border-radius: 16px; overflow: hidden; height: 380px; background: #0f172a; }
  .tbc-main-photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
  .tbc-main-photo:hover img { transform: scale(1.02); }
  .tbc-photo-badge { position: absolute; bottom: 16px; left: 16px; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px); color: #f8fafc; padding: 8px 16px; border-radius: 12px; font-size: 13px; font-weight: 700; border: 1px solid rgba(255, 255, 255, 0.15); }
  .tbc-side-photos { display: grid; grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 1fr); gap: 10px; height: 380px; }
