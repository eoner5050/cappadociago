---
import SeoHead from '../../../components/SeoHead.astro';
import FloatingAssistant from "../../../components/FloatingAssistant.astro";
import { getTourGallery } from '../../../utils/tourGallery';
// src/pages/tours/goreme-comfort-hot-air-balloon-tour.astro
const tour = {
  title: 'Kapadokya Kırmızı Tur',
  kicker: 'CAPPADOCIAGO',
  heroDesc: "Profesyonel rehber eşliğinde tam günlük Kapadokya Kırmızı Tur ile Kuzey Kapadokya'nın en ikonik noktalarını keşfedin. Uçhisar Panorama, Zelve Açık Hava Müzesi, Paşabağları, Avanos, Devrent Vadisi ve geleneksel yerel atölyeleri ziyaret edin.",
  overviewTitle: 'Kapadokya Kırmızı Tur Genel Bakış',
  overviewParagraphs: ["Kapadokya Kırmızı Tur, bölgenin en popüler tam günlük gezi programlarından biridir. Kuzey Kapadokya'nın ünlü manzaralarını, tarihi alanlarını ve kültürel mirasını tek bir düzenli program içinde keşfetmek isteyen misafirler için idealdir.", 'Tur genellikle sabah otelden alınmanızla başlar ve profesyonel lisanslı rehber ile konforlu araç eşliğinde devam eder. Durakların sırası trafik ve operasyon koşullarına göre değişebilir.'],
  priceTitle: 'Kapadokya Kırmızı Tur Fiyatı',
  priceText: "Kapadokya Kırmızı Tur kişi başı 40 Euro'dan başlayan fiyatlarla sunulmaktadır. Kesin fiyatlar sezon, grup büyüklüğü ve müsaitliğe göre değişebilir. Güncel kesin fiyat için bizimle iletişime geçebilirsiniz.",
  whatsIncluded: ['Otelden alma ve otele bırakma', 'Profesyonel lisanslı tur rehberi', 'Klimalı araç ile ulaşım', 'Yerel restoranda öğle yemeği', 'Otopark ve yerel hizmet ücretleri', 'Profesyonel operasyon desteği', '7/24 müşteri desteği', 'Gizli ücret olmadan şeffaf hizmet'],
  importantInfo: ['Sabah otel transferi ile başlayan tam günlük tur', 'Rahat yürüyüş ayakkabısı tavsiye edilir', 'Tur sırası trafik ve operasyon koşullarına göre değişebilir', 'Müze giriş ücretleri seçilen pakete göre dahil olabilir veya ayrıca tahsil edilebilir', 'Özel beslenme taleplerinizi önceden bildiriniz', 'Çocuklar bir yetişkin eşliğinde katılmalıdır', 'Hava koşulları bazı açık hava duraklarını etkileyebilir', 'Tüm rezervasyonlar müsaitliğe bağlıdır'],
  flightDetailsTitle: 'Kapadokya Kırmızı Tur Programı',
  flightDetailsParagraphs: ["Uçhisar Panorama: Kapadokya'nın eşsiz kaya oluşumlarını ve panoramik manzarasını izleyerek güne başlayın.", "Zelve Açık Hava Müzesi: Kaya oyma yaşam alanları, kiliseler ve tarihi yapılarıyla Kapadokya'nın en etkileyici eski yerleşimlerinden birini keşfedin.", 'Paşabağları (Rahipler Vadisi): Bölgenin en ünlü peri bacalarını ve sıra dışı jeolojik oluşumlarını görün.', 'Avanos: Çömlekçiliğiyle ünlü ilçeyi ziyaret edin, yerel restoranda öğle yemeği yiyin ve geleneksel çömlek yapım deneyimini görün.', "Devrent Vadisi: Hayvanlara ve farklı figürlere benzeyen doğal kaya oluşumlarıyla ünlü Hayal Vadisi'ni keşfedin.", 'Yerel Atölye Ziyareti: Günün programına göre geleneksel el sanatları, takı veya yerel ürün atölyesi ziyareti yapılabilir.'],
  afterFlightTitle: 'Tur Sonu',
  afterFlightText: 'Son ziyaretin ardından konforlu şekilde otelinize geri transfer edilirsiniz. Ekibimiz balon uçuşu, havalimanı transferi, özel tur ve diğer Kapadokya aktivitelerinde de yardımcı olabilir.',
  refundTitle: 'İptal ve İade',
  refundText: 'Rezervasyon koşullarına bağlı olarak turdan 24 saat öncesine kadar ücretsiz iptal mümkün olabilir. Geç iptal ve katılmama durumlarında ücret kesintisi uygulanabilir. Tur operatör tarafından iptal edilirse alternatif tarih veya iade sunulur.',
  advanceTitle: 'Neden Erken Rezervasyon?',
  advanceText: "Kırmızı Tur özellikle ilkbahar, yaz ve tatil dönemlerinde Kapadokya'nın en çok talep gören günlük turlarından biridir. Erken rezervasyon istediğiniz tarihi ve otel transferini güvence altına alır.",
  safetyTitle: 'Profesyonel Rehber ve Konforlu Ulaşım',
  safetyText: 'Tur profesyonel lisanslı rehberler, deneyimli sürücüler ve konforlu araçlarla organize edilir. Operasyon ekibimiz gün boyunca hizmeti takip eder.'
};
const pageLang = 'tr';
const galleryImages = getTourGallery({ slug: 'red-tour-cappadocia', title: tour.title, preferred: ['/images/tours/Red-Tour-Cappadocia.webp'], max: 6 });
const galleryPhotoWord = 'fotoğraf';
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SeoHead title={`${tour.title} | CappadociaGo`} description={tour.heroDesc || tour.overviewParagraphs?.[0] || tour.title} lang={pageLang} />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/css/intlTelInput.css">
  <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/js/intlTelInput.min.js"></script>
</head>
<body>

  <!-- HEADER / NAVBAR - ANA SAYFA İLE AYNI TASARIM -->
  <header class="site-header">
    <div class="header-container">
      <div class="logo">
        <a href="/tr/" class="logo-home" aria-label="CappadociaGo Home" title="CappadociaGo - Ana Sayfa">
          <img src="/images/logo.png" alt="CappadociaGo" loading="lazy" width="600" height="200" />
        </a>

        <a
          href="https://www.instagram.com/cappadociago/"
          class="header-instagram"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="CappadociaGo on Instagram"
        >
          <img
            src="/images/icons/instagram-logo.webp"
            alt=""
            class="header-instagram-icon"
            width="23"
            height="23"
            aria-hidden="true" loading="lazy"
          />
          <span>@cappadociago</span>
        </a>
      </div>

      <nav class="main-nav" id="mainNav">
        <ul>
          <li><a href="/tr/">Balon Turları</a></li>
          <li><a href="/tr/">Kapadokya Turları</a></li>
          <li><a href="/tr/">Aktiviteler</a></li>
          <li><a href="/tr/">Özel Turlar</a></li>
          <li><a href="/tr/transfers/">Transferler</a></li>
          <li></li>
        </ul>
      </nav>

      <div class="header-right">
        <div class="lang-switcher" id="langSwitcher">
          <button
            class="lang-btn"
            id="langButton"
            type="button"
            aria-label="Select language"
            aria-expanded="false"
          >
            <span class="lang-flag">🇹🇷</span>
            <span class="lang-code">TR</span>
            <span class="arrow">▾</span>
          </button>

          <div class="lang-dropdown" id="langDropdown">
            <a href="/en/tours/red-tour-cappadocia" class="lang-item"><span class="flag">🇬🇧</span><span>English</span></a>
            <a href="/tr/tours/red-tour-cappadocia" class="lang-item active"><span class="flag">🇹🇷</span><span>Türkçe</span></a>
            <a href="/es/tours/red-tour-cappadocia" class="lang-item"><span class="flag">🇪🇸</span><span>Español</span></a>
          </div>
        </div>

        <a href="https://wa.me/905401015050" class="whatsapp-btn" target="_blank" rel="noopener noreferrer">
          <img
            src="/images/icons/whatsapp-logo.webp"
            alt=""
            class="whatsapp-btn-icon"
            width="18"
            height="18"
            aria-hidden="true" loading="lazy"
          />
          <span>WhatsApp</span>
        </a>

        <button class="mobile-menu-toggle" id="mobileMenuToggle" type="button" aria-label="Toggle Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </header>

  <section class="tbc-tour-page">
    <div class="tbc-tour-container">

      <!-- BREADCRUMB -->
      <div class="tbc-breadcrumb">
        <a href="/tr/">Ana Sayfa</a> <span>›</span> <span>{tour.title}</span>
      </div>

      <!-- HERO ALANI -->
      <div class="tbc-tour-hero">
        <div class="tbc-tour-kicker">{tour.kicker}</div>
        <h1 class="tbc-tour-title">{tour.title}</h1>
        <p class="tbc-tour-desc">{tour.heroDesc}</p>

        <!-- ÖZELLİK ROZETLERİ -->
        <div class="tbc-hero-badges-bar">
          <div class="tbc-badge-item">
            <span class="tbc-stars">★★★★★</span>
            <strong class="tbc-badge-val">4.97</strong>
            <span class="tbc-badge-sep">|</span>
            <span class="tbc-badge-link" id="tbc-scrollToReviews">28 Yorum ❯</span>
          </div>
          <div class="tbc-badge-item">
            <span class="tbc-badge-icon">⏱</span>
            <span>Tur Süresi: 60 Dakika</span>
          </div>
          <div class="tbc-badge-item">
            <span class="tbc-badge-icon">⚡</span>
            <span>Anında Onay!</span>
          </div>
          <a href="https://wa.me/905401015050" class="tbc-badge-item tbc-badge-wa" target="_blank" rel="noopener noreferrer">
            <img src="/images/icons/whatsapp-logo.webp" alt="" class="tbc-badge-wa-icon" width="20" height="20" aria-hidden="true" loading="lazy" />
            <strong>905401015050</strong>
          </a>
        </div>
      </div>

      <!-- PHOTO GALLERY GRID -->
      {galleryImages.length > 0 && (
        <div class="tbc-photo-grid-wrapper" data-gallery-root>
          <button type="button" class="tbc-main-photo tbc-gallery-click" data-gallery-index="0">
            <img src={galleryImages[0]} alt={tour.title} width="1200" height="800" loading="lazy" decoding="async" />
            <div class="tbc-photo-badge">📁 {galleryImages.length} {galleryPhotoWord}</div>
          </button>
          <div class="tbc-side-photos">
            {galleryImages.slice(1,5).map((src, i) => (
              <button type="button" class="tbc-side-photo-item tbc-gallery-click" data-gallery-index={String(i+1)}>
                <img src={src} alt={tour.title} width="1200" height="800" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        </div>
      )}
      <div class="tbc-gallery-modal" id="tbcGalleryModal" aria-hidden="true">
        <button type="button" class="tbc-gallery-close" aria-label="Close">×</button>
        <button type="button" class="tbc-gallery-prev" aria-label="Previous">‹</button>
        <img id="tbcGalleryModalImg" alt={tour.title} width="1200" height="800" loading="lazy" decoding="async" />
        <button type="button" class="tbc-gallery-next" aria-label="Next">›</button>
        <div class="tbc-gallery-count" id="tbcGalleryCount"></div>
      </div>

      <div class="tbc-tour-grid">

        <!-- MAIN CONTENT -->
        <div class="tbc-tour-main">
          <div class="tbc-tour-card tbc-tour-main-card">

            <div class="tbc-tour-section">
              <h2>{tour.overviewTitle}</h2>
              {tour.overviewParagraphs.map(p => (
                <p>{p}</p>
              ))}
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.priceTitle}</h2>
              <p>{tour.priceText}</p>
            </div>

            <div class="tbc-tour-section">
              <h2>Fiyata Dahil Olanlar</h2>
              <div class="tbc-tour-list">
                {tour.whatsIncluded.map(item => (
                  <div class="tbc-tour-list-item"><span class="tbc-tour-check">✓</span><span>{item}</span></div>
                ))}
              </div>
            </div>

            <div class="tbc-tour-section">
              <h2>Önemli Bilgiler</h2>
              <div class="tbc-tour-list">
                {tour.importantInfo.map(info => (
                  <div class="tbc-tour-list-item"><span class="tbc-tour-check">✓</span><span>{info}</span></div>
                ))}
              </div>
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.flightDetailsTitle}</h2>
              {tour.flightDetailsParagraphs.map(fp => (
                <p>{fp}</p>
              ))}
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.afterFlightTitle}</h2>
              <p>{tour.afterFlightText}</p>
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.refundTitle}</h2>
              <p>{tour.refundText}</p>
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.advanceTitle}</h2>
              <p>{tour.advanceText}</p>
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.safetyTitle}</h2>
              <p>{tour.safetyText}</p>
            </div>

          </div>

          <!-- YORUMLAR -->
          <div class="tbc-tour-card tbc-reviews-card" id="reviews-section">
            <h3 class="tbc-reviews-main-title">Yorumlar (28)</h3>
            <div class="tbc-aggregate-rating" style="margin:8px 0 18px;font-weight:800;font-size:18px;"><span style="letter-spacing:2px;">★★★★★</span> <span>4,97 / 5</span></div>

            <div class="tbc-reviews-container" id="tbc-reviews-container">
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">W</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Wang Lei</h4>
                    <span class="tbc-review-tour-type">Kapadokya Kırmızı Tur</span>
                  </div>
                  <div class="tbc-review-date">1 Ocak 2024</div>
                </div>
                <p class="tbc-review-text">İletişim ve otelden alınış çok sorunsuzdu. Kırmızı Tur, aceleye gelmeden tüm önemli noktaları kapsadı.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">P</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Paula Romero</h4>
                    <span class="tbc-review-tour-type">Kapadokya Kırmızı Tur</span>
                  </div>
                  <div class="tbc-review-date">8 Mart 2025</div>
                </div>
                <p class="tbc-review-text">Rehberimiz bölgenin tarihi konusunda son derece bilgiliydi. Öğle yemeği yediğimiz yer de çok güzel ve otantikti.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">C</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Carlos Vega</h4>
                    <span class="tbc-review-tour-type">Kapadokya Kırmızı Tur</span>
                  </div>
                  <div class="tbc-review-date">15 Mayıs 2026</div>
                </div>
                <p class="tbc-review-text">Unutulmaz bir deneyimdi! Sıcak hava balonu uçuşu büyüleyiciydi ve yer ekibi her şeyin çok güvenli hissettirmesini sağladı.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">N</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Nuria Castillo</h4>
                    <span class="tbc-review-tour-type">Kapadokya Kırmızı Tur</span>
                  </div>
                  <div class="tbc-review-date">22 Temmuz 2024</div>
                </div>
                <p class="tbc-review-text">Otelden alınıştan bırakılışa kadar her şey çok iyi organize edilmişti. Kapadokya gezileri için bu acenteyi kesinlikle tavsiye ederim.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">Á</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Álvaro Medina</h4>
                    <span class="tbc-review-tour-type">Kapadokya Kırmızı Tur</span>
                  </div>
                  <div class="tbc-review-date">2 Eylül 2025</div>
                </div>
                <p class="tbc-review-text">Hem Yeşil Tur hem de ATV safari rezervasyonu yaptık. İki aktivite de zamanında, eğlenceli ve son derece iyi yönetildi.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">I</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Irene Torres</h4>
                    <span class="tbc-review-tour-type">Kapadokya Kırmızı Tur</span>
                  </div>
                  <div class="tbc-review-date">9 Kasım 2026</div>
                </div>
                <p class="tbc-review-text">Zelve ve Paşabağ bizim için günün en güçlü bölümleriydi. Rehber tarihi ve jeolojiyi net şekilde anlattı ve acele etmeden gezmek için yeterli zamanımız oldu. Avanos'taki çömlek gösterisi de güzel bir kültürel mola kattı.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">Y</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Yuki Nakamura</h4>
                    <span class="tbc-review-tour-type">Kapadokya Kırmızı Tur</span>
                  </div>
                  <div class="tbc-review-date">16 Ocak 2024</div>
                </div>
                <p class="tbc-review-text">Bu Kapadokya'daki ilk rehberli turumuzdu ve kuzey bölgesi hakkında çok iyi bir genel bakış sundu. Devrent Vadisi eğlenceliydi, Paşabağ görsel olarak etkileyiciydi ve öğle yemeği molası iyi zamanlanmıştı. Otelden alınış ve dönüş de sorunsuzdu.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">F</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Felix Schneider</h4>
                    <span class="tbc-review-tour-type">Kapadokya Kırmızı Tur</span>
                  </div>
                  <div class="tbc-review-date">23 Mart 2025</div>
                </div>
                <p class="tbc-review-text">Her durak farklı olduğu için rota çok iyi yapılandırılmıştı. Zelve tarihi, Paşabağ klasik peri bacalarını, Avanos ise yerel el sanatlarını ve kültürü sundu. Rehber günü bilgilendirici ama rahat tuttu.</p>
              </div>
              <div class="tbc-hidden-reviews" id="tbc-hidden-reviews" style="display:none;">
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">F</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Francesca Conti</h4>
                    <span class="tbc-review-tour-type">Kapadokya Kırmızı Tur</span>
                  </div>
                  <div class="tbc-review-date">3 Mayıs 2026</div>
                </div>
                <p class="tbc-review-text">Zelve'deki açıklamaları özellikle beğendik çünkü ilk bakışta görülenden çok daha fazlası var. Grup büyüklüğü rahattı ve rehberi duymak kolaydı. Günün sonundaki Devrent Vadisi hafif ve keyifli bir duraktı.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">L</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Luca Moretti</h4>
                    <span class="tbc-review-tour-type">Kapadokya Kırmızı Tur</span>
                  </div>
                  <div class="tbc-review-date">10 Temmuz 2024</div>
                </div>
                <p class="tbc-review-text">Kırmızı Tur Kapadokya'daki ilk tam günümüz için çok iyi oldu. Programı aşırı yoğun hissettirmeden birçok ünlü yeri kapsadı. Fotoğraf, soru ve düzgün bir öğle yemeği molası için zamanımız vardı.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">É</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Élodie Martin</h4>
                    <span class="tbc-review-tour-type">Kapadokya Kırmızı Tur</span>
                  </div>
                  <div class="tbc-review-date">17 Eylül 2025</div>
                </div>
                <p class="tbc-review-text">Paşabağ, oluşumlar yakından çok sıra dışı olduğu için favori noktamızdı. Rehber Avanos ve yerel çömlek gelenekleri hakkında da faydalı bilgiler verdi. Gün boyunca ulaşım konforluydu.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">J</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Julien Robert</h4>
                    <span class="tbc-review-tour-type">Kapadokya Kırmızı Tur</span>
                  </div>
                  <div class="tbc-review-date">24 Kasım 2026</div>
                </div>
                <p class="tbc-review-text">Tur, kültürel alanlarla manzara noktaları arasında iyi bir denge kurdu. Rehber her yerde bağlam kattığı için sadece fotoğraf noktasından fotoğraf noktasına gidiyormuşuz gibi hissetmedik. Her şey zamanında ilerledi.</p>
              </div>
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">H</div>
                  <div>
