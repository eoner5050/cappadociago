  .tbc-booking-head p { margin: 0; font-size: 14px; line-height: 1.75; color: #94a3b8; }
  .tbc-booking-form { display: grid; grid-template-columns: 1fr; gap: 14px; }
  .tbc-booking-group { display: flex; flex-direction: column; }
  .tbc-booking-group-full { grid-column: 1 / -1; }
  .tbc-booking-group label { margin-bottom: 7px; font-size: 13px; font-weight: 700; color: #cbd5e1; }
  .tbc-booking-group input, .tbc-booking-group select, .tbc-booking-group textarea { width: 100%; min-height: 48px; padding: 12px 14px; border: 1px solid #334155; border-radius: 16px; background: #0f172a; font-size: 14px; color: #f8fafc; outline: none; transition: .2s ease; }
