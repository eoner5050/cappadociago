  .tbc-side-photo-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
  .tbc-side-photo-item:hover img { transform: scale(1.04); }
  .tbc-tour-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 24px; align-items: start; }
  .tbc-tour-main, .tbc-tour-side { min-width: 0; }
