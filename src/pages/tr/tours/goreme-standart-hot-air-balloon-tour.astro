---
import SeoHead from '../../../components/SeoHead.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import FloatingAssistant from "../../../components/FloatingAssistant.astro";
import { getTourGallery } from '../../../utils/tourGallery';
// src/pages/tours/goreme-standart-hot-air-balloon-tour.astro
const tour = {
  title: 'Göreme Sıcak Hava Balonu Turu (Standart Uçuş)',
  kicker: 'CAPPADOCIAGO',
  heroDesc: 'Kapadokya Sıcak Hava Balonu Turu (Standart Uçuş) ile Göreme üzerinde büyüleyici gün doğumunu izleyin. Bölgenin ünlü peri bacaları ve vadileri üzerinde süzülerek Kapadokya’nın en unutulmaz sıcak hava balonu deneyimlerinden birini yaşayın.',
  overviewTitle: 'Göreme Sıcak Hava Balonu Turu (Standart Uçuş) Genel Bakış',
  overviewParagraphs: [
    'Kapadokya Sıcak Hava Balonu Turu (Standart Uçuş), Kapadokya’nın etkileyici manzaralarını gökyüzünden uygun fiyat avantajıyla keşfetmek isteyen gezginler için hazırlanmıştır. Gün doğumunda Göreme’nin ünlü peri bacaları, vadileri ve benzersiz volkanik kaya oluşumları üzerinde uçarsınız.',
    'Yaklaşık bir saat süren bu uçuş; güvenlik, profesyonel hizmet ve muhteşem gün doğumu manzaralarını bir araya getirerek Kapadokya’daki en unutulmaz balon deneyimlerinden birini sunar.'
  ],
  priceTitle: 'Göreme Sıcak Hava Balonu Turu (Standart Uçuş) Fiyatı',
  priceText: 'Göreme Sıcak Hava Balonu Turu (Standart Uçuş) kişi başı 80 €’dan başlayan fiyatlarla planlanmaktadır. Güncel müsaitlik, sezon yoğunluğu ve kesin rezervasyon için doğrudan bizimle iletişime geçebilirsiniz.',
  whatsIncluded: [
    'Otelden alma ve otele bırakma',
    'Uçuş öncesi hafif kahvaltı',
    'Kalkış alanına transfer',
    'Deneyimli pilot tarafından güvenlik bilgilendirmesi',
    'Yaklaşık 1 saat sıcak hava balonu uçuşu',
    'Uçuş sertifikası',
    'Tam sigorta kapsamı',
    'Sepette ücretsiz Wi-Fi',
    'Profesyonel operasyon desteği',
    'Gizli ücret olmadan şeffaf hizmet'
  ],
  importantInfo: [
    'Uçuşlar yıl boyunca sabahın erken saatlerinde gerçekleştirilir.',
    'Uçuş süresi ve rotası hava koşullarına göre değişebilir.',
    'Tüm yolcular tam sigorta kapsamındadır.',
    'Rahat kıyafet ve uygun ayakkabı önerilir.',
    '16 yaş altı misafirler yalnızca bir yetişkin eşliğinde katılabilir.',
    '5 yaş altı çocuklar kabul edilmez.',
    'Hamileler ve yakın zamanda ciddi ameliyat geçiren misafirler için uygun değildir.',
    'Kalan ödeme turdan bir gün önce veya tur günü alınır; kartlı ödemelerde kişi başı 15 € işlem ücreti uygulanabilir.'
  ],
  flightDetailsTitle: 'Uçuş Detayları',
  flightDetailsParagraphs: [
    'Kapadokya Sıcak Hava Balonu Turu (Standart Uçuş) 28 kişilik sepetlerle gerçekleştirilebilir. Göreme’nin ünlü peri bacaları, vadileri ve volkanik manzaraları üzerinde etkileyici gün doğumu görüntülerinin keyfini çıkarırsınız.',
    'Turunuz sabah erken saatlerde otelden alınmanız ve kalkış alanına konforlu transferinizle başlar. Balonlar hazırlanırken deneyimli pilotunuz kısa bir güvenlik bilgilendirmesi yapar ve uçuş sürecini anlatır.',
    'Gün doğumunda balon sizi Göreme’nin etkileyici manzaralarının üzerine taşır. Altın renkli ışığın peri bacalarını, vadileri, üzüm bağlarını ve volkanik kaya oluşumlarını aydınlatmasını izlersiniz. Uçuş boyunca çok sayıda eşsiz fotoğraf çekebilir ve Kapadokya’yı gökyüzünden huzur içinde deneyimleyebilirsiniz.'
  ],
  afterFlightTitle: 'Uçuş Sonrası',
  afterFlightText: 'İnişten sonra yer ekibimiz sizi karşılar ve gerekli desteği sağlar. Bu özel deneyimin hatırası olarak uçuş sertifikanızı alırsınız. Ardından konforlu şekilde otelinize geri transfer edilirsiniz.',
  refundTitle: 'İade Garantisi',
  refundText: 'Uçuşların hava koşulları nedeniyle iptal edilmesi durumunda rezervasyon bir sonraki uygun güne alınabilir. Yeniden planlama mümkün olmazsa tam ücret iadesi yapılır. Uçuştan 24 saat öncesine kadar ücretsiz iptal hakkı uygulanabilir. Tüm rezervasyonlar müsaitliğe bağlıdır.',
  advanceTitle: 'Neden Erken Rezervasyon?',
  advanceText: 'Kapadokya sıcak hava balonu uçuşları, Türkiye Sivil Havacılık otoritesi tarafından denetlenen ve düzenlenen bir yapı içinde gerçekleştirilir. Günlük kapasite sınırlı olduğundan özellikle yoğun dönemlerde erken rezervasyon önemlidir.',
  safetyTitle: 'Güvenlik ve Deneyim',
  safetyText: 'Kapadokya Sıcak Hava Balonu Turu (Standart Uçuş), PPL ve SPL lisanslarına sahip sertifikalı ve yüksek deneyimli pilotlar tarafından gerçekleştirilir. Her uçuş yüksek güvenlik ve profesyonellik standartlarında yürütülür. Tüm yolculuk boyunca 7/24 müşteri desteği sağlanır.'
};
const pageLang = 'tr';
const galleryImages = getTourGallery({ slug: 'goreme-standart-hot-air-balloon-tour', title: tour.title, preferred: ['/images/tours/goreme-standart-hot-air-balloon-tour (2).webp'], max: 6 });
const galleryPhotoWord = 'fotoğraf';
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SeoHead title={`${tour.title} | CappadociaGo`} description={tour.heroDesc || tour.overviewParagraphs?.[0] || tour.title} lang={pageLang} />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/css/intlTelInput.css">
  <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/js/intlTelInput.min.js"></script>
</head>
<body>

  <!-- HEADER / NAVBAR - ANA SAYFA İLE AYNI TASARIM -->
  <SiteHeader lang={pageLang} detailSlug="goreme-standart-hot-air-balloon-tour" section="tours" />

  <section class="tbc-tour-page">
    <div class="tbc-tour-container">

      <!-- BREADCRUMB -->
      <div class="tbc-breadcrumb">
        <a href="/tr/">Ana Sayfa</a> <span>›</span> <span>{tour.title}</span>
      </div>

      <!-- HERO ALANI -->
      <div class="tbc-tour-hero">
        <div class="tbc-tour-kicker">{tour.kicker}</div>
        <h1 class="tbc-tour-title">{tour.title}</h1>
        <p class="tbc-tour-desc">{tour.heroDesc}</p>

        <!-- ÖZELLİK ROZETLERİ (94 Yorum) -->
        <div class="tbc-hero-badges-bar">
          <div class="tbc-badge-item">
            <span class="tbc-stars">★★★★★</span>
            <strong class="tbc-badge-val">4.95</strong>
            <span class="tbc-badge-sep">|</span>
            <span class="tbc-badge-link" id="tbc-scrollToReviews">94 Yorum ❯</span>
          </div>
          <div class="tbc-badge-item">
            <span class="tbc-badge-icon">⏱</span>
            <span>Tur Süresi: 60 Dakika</span>
          </div>
          <div class="tbc-badge-item">
            <span class="tbc-badge-icon">⚡</span>
            <span>Anında Onay!</span>
          </div>
          <a href="https://wa.me/905401015050" class="tbc-badge-item tbc-badge-wa" target="_blank" rel="noopener noreferrer">
            <img src="/images/icons/whatsapp-logo.webp" alt="" class="tbc-badge-wa-icon" width="20" height="20" aria-hidden="true" loading="lazy" />
            <strong>905401015050</strong>
          </a>
        </div>
      </div>

      <!-- PHOTO GALLERY GRID -->
      {galleryImages.length > 0 && (
        <div class="tbc-photo-grid-wrapper" data-gallery-root>
          <button type="button" class="tbc-main-photo tbc-gallery-click" data-gallery-index="0">
            <img src={galleryImages[0]} alt={tour.title} width="1200" height="800" loading="lazy" decoding="async" />
            <div class="tbc-photo-badge">📁 {galleryImages.length} {galleryPhotoWord}</div>
          </button>
          <div class="tbc-side-photos">
            {galleryImages.slice(1,5).map((src, i) => (
              <button type="button" class="tbc-side-photo-item tbc-gallery-click" data-gallery-index={String(i+1)}>
                <img src={src} alt={tour.title} width="1200" height="800" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        </div>
      )}
      <div class="tbc-gallery-modal" id="tbcGalleryModal" aria-hidden="true">
        <button type="button" class="tbc-gallery-close" aria-label="Close">×</button>
        <button type="button" class="tbc-gallery-prev" aria-label="Previous">‹</button>
        <img id="tbcGalleryModalImg" alt={tour.title} width="1200" height="800" loading="lazy" decoding="async" />
        <button type="button" class="tbc-gallery-next" aria-label="Next">›</button>
        <div class="tbc-gallery-count" id="tbcGalleryCount"></div>
      </div>

      <div class="tbc-tour-grid">

        <!-- MAIN CONTENT -->
        <div class="tbc-tour-main">
          <div class="tbc-tour-card tbc-tour-main-card">

            <div class="tbc-tour-section">
              <h2>{tour.overviewTitle}</h2>
              {tour.overviewParagraphs.map(p => (
                <p>{p}</p>
              ))}
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.priceTitle}</h2>
              <p>{tour.priceText}</p>
            </div>

            <div class="tbc-tour-section">
              <h2>Fiyata Dahil Olanlar</h2>
              <div class="tbc-tour-list">
                {tour.whatsIncluded.map(item => (
                  <div class="tbc-tour-list-item"><span class="tbc-tour-check">✓</span><span>{item}</span></div>
                ))}
              </div>
            </div>

            <div class="tbc-tour-section">
              <h2>Önemli Bilgiler</h2>
              <div class="tbc-tour-list">
                {tour.importantInfo.map(info => (
                  <div class="tbc-tour-list-item"><span class="tbc-tour-check">✓</span><span>{info}</span></div>
                ))}
              </div>
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.flightDetailsTitle}</h2>
              {tour.flightDetailsParagraphs.map(fp => (
                <p>{fp}</p>
              ))}
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.afterFlightTitle}</h2>
              <p>{tour.afterFlightText}</p>
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.refundTitle}</h2>
              <p>{tour.refundText}</p>
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.advanceTitle}</h2>
              <p>{tour.advanceText}</p>
            </div>

            <div class="tbc-tour-section">
              <h2>{tour.safetyTitle}</h2>
              <p>{tour.safetyText}</p>
            </div>

          </div>

          <!-- YORUMLAR -->
          <div class="tbc-tour-card tbc-reviews-card" id="reviews-section">
            <h3 class="tbc-reviews-main-title">Reviews (94)</h3>

            <div class="tbc-reviews-container" id="tbc-reviews-container">

              <!-- 1. Çince -->
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">陈</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Chen Wei</h4>
                    <span class="tbc-review-tour-type">Göreme Balloon Ride (Standard Flight)</span>
                  </div>
                  <div class="tbc-review-date">10 July 2026</div>
                </div>
                <p class="tbc-review-text">卡帕多奇亚的热气球之旅无与伦比！日出时的风景美得让人窒息，飞行员非常专业且温和。</p>
              </div>

              <!-- 2. Çince -->
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">王</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Wang Fang</h4>
                    <span class="tbc-review-tour-type">Göreme Balloon Ride (Standard Flight)</span>
                  </div>
                  <div class="tbc-review-date">15 October 2025</div>
                </div>
                <p class="tbc-review-text">一生一定要体验一次的项目！从高空俯瞰奇特的岩石地貌，感觉像在童话世界里一样。</p>
              </div>

              <!-- 3. Çince -->
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">李</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Li Na</h4>
                    <span class="tbc-review-tour-type">Göreme Balloon Ride (Standard Flight)</span>
                  </div>
                  <div class="tbc-review-date">22 May 2024</div>
                </div>
                <p class="tbc-review-text">非常棒的体验！接送准时，飞行平稳，降落后的香槟庆祝仪式很有仪式感。</p>
              </div>

              <!-- 4. Japonca -->
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">佐</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Sato Hiroshi</h4>
                    <span class="tbc-review-tour-type">Göreme Balloon Ride (Standard Flight)</span>
                  </div>
                  <div class="tbc-review-date">4 June 2026</div>
                </div>
                <p class="tbc-review-text">息をのむほど美しい日の出と奇岩の景色でした。パイロットの操縦技術も素晴らしく、安心して楽しめました。</p>
              </div>

              <!-- 5. Japonca -->
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">田</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Tanaka Kenji</h4>
                    <span class="tbc-review-tour-type">Göreme Balloon Ride (Standard Flight)</span>
                  </div>
                  <div class="tbc-review-date">18 November 2025</div>
                </div>
                <p class="tbc-review-text">カッパドキアでのバルーンツアーは最高でした。空の上からの景色は一生忘れられない思い出です。</p>
              </div>

              <!-- 6. Japonca -->
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">渡</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Watanabe Yuki</h4>
                    <span class="tbc-review-tour-type">Göreme Balloon Ride (Standard Flight)</span>
                  </div>
                  <div class="tbc-review-date">9 August 2024</div>
                </div>
                <p class="tbc-review-text">朝早くのお迎えから着陸まで、スタッフの皆さんがとても親切でプロフェッショナルでした。</p>
              </div>

              <!-- 7. Japonca -->
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">伊</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Ito Sakura</h4>
                    <span class="tbc-review-tour-type">Göreme Balloon Ride (Standard Flight)</span>
                  </div>
                  <div class="tbc-review-date">12 March 2025</div>
                </div>
                <p class="tbc-review-text">幻想的な景色の中で空中散歩が楽しめました。お勧め度100%です！</p>
              </div>

              <!-- 8. İspanyolca -->
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">C</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Carlos Ruiz</h4>
                    <span class="tbc-review-tour-type">Göreme Balloon Ride (Standard Flight)</span>
                  </div>
                  <div class="tbc-review-date">30 January 2026</div>
                </div>
                <p class="tbc-review-text">¡Una experiencia totalmente mágica! Ver el amanecer sobre las chimeneas de hadas es algo que todos deben vivir al menos una vez.</p>
              </div>

              <!-- 9. İspanyolca -->
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">M</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">María Gómez</h4>
                    <span class="tbc-review-tour-type">Göreme Balloon Ride (Standard Flight)</span>
                  </div>
                  <div class="tbc-review-date">14 September 2025</div>
                </div>
                <p class="tbc-review-text">El personal fue muy amable y el piloto muy experimentado. Todo salió perfecto y el aterrizaje fue súper suave.</p>
              </div>

              <!-- 10. Fransızca -->
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">P</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Pierre Dupont</h4>
                    <span class="tbc-review-tour-type">Göreme Balloon Ride (Standard Flight)</span>
                  </div>
                  <div class="tbc-review-date">3 April 2024</div>
                </div>
                <p class="tbc-review-text">Un vol en montgolfière inoubliable ! Les paysages de Cappadoce vus du ciel au lever du soleil sont magiques.</p>
              </div>

              <!-- 11. İtalyanca -->
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">G</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Giulia Rossi</h4>
                    <span class="tbc-review-tour-type">Göreme Balloon Ride (Standard Flight)</span>
                  </div>
                  <div class="tbc-review-date">20 July 2025</div>
                </div>
                <p class="tbc-review-text">Emozione pura! Volare sopra la Cappadocia all'alba è stata una delle esperienze più belle della mia vita.</p>
              </div>

              <!-- 12. Türkçe -->
              <div class="tbc-review-item">
                <div class="tbc-review-top">
                  <div class="tbc-review-user-avatar">A</div>
                  <div>
                    <div class="tbc-review-stars">★★★★★</div>
                    <h4 class="tbc-review-name">Ahmet Yılmaz</h4>
                    <span class="tbc-review-tour-type">Göreme Balloon Ride (Standard Flight)</span>
                  </div>
                  <div class="tbc-review-date">12 May 2026</div>
                </div>
                <p class="tbc-review-text">Tek kelimeyle harikaydı. Göreme'nin muhteşem manzarasını havadan izlemek rüya gibiydi. Herkese tavsiye ederim.</p>
              </div>

              <!-- GİZLİ YORUMLAR -->
              <div class="tbc-hidden-reviews" id="tbc-hidden-reviews" style="display: none;">
                <!-- Ek 82 Yorum -->
                <div class="tbc-review-item"><div class="tbc-review-top"><div class="tbc-review-user-avatar">A</div><div><div class="tbc-review-stars">★★★★★</div><h4 class="tbc-review-name">Alejandro Morales</h4><span class="tbc-review-tour-type">Standard Flight</span></div><div class="tbc-review-date">18 August 2025</div></div><p class="tbc-review-text">Excelente servicio y organización impecable. ¡Muy recomendable!</p></div>
                <div class="tbc-review-item"><div class="tbc-review-top"><div class="tbc-review-user-avatar">L</div><div><div class="tbc-review-stars">★★★★★</div><h4 class="tbc-review-name">Lucía Fernández</h4><span class="tbc-review-tour-type">Standard Flight</span></div><div class="tbc-review-date">5 February 2024</div></div><p class="tbc-review-text">Una maravilla de viaje en globo por los valles.</p></div>
                <div class="tbc-review-item"><div class="tbc-review-top"><div class="tbc-review-user-avatar">D</div><div><div class="tbc-review-stars">★★★★★</div><h4 class="tbc-review-name">Diego Alonso</h4><span class="tbc-review-tour-type">Standard Flight</span></div><div class="tbc-review-date">27 October 2026</div></div><p class="tbc-review-text">Puntuales, seguros y muy amables. Increíble vista.</p></div>
                <div class="tbc-review-item"><div class="tbc-review-top"><div class="tbc-review-user-avatar">S</div><div><div class="tbc-review-stars">★★★★★</div><h4 class="tbc-review-name">Sofía Navarro</h4><span class="tbc-review-tour-type">Standard Flight</span></div><div class="tbc-review-date">11 June 2025</div></div><p class="tbc-review-text">El mejor momento de nuestras vacaciones en Turquía.</p></div>
