---
import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const tour = {
  title: 'Göreme Sıcak Hava Balonu Turu (Comfort Sınıf)',
  kicker: 'CAPPADOCIAGO',
  heroDesc: 'Göreme üzerinde gün doğumunu gökyüzünden izlemek ve peri bacaları ile vadilerin üzerinde daha konforlu bir balon deneyimi yaşamak istiyorsanız, Göreme Sıcak Hava Balonu Turu (Comfort Sınıf) Kapadokya’da unutulmaz bir deneyim sunar.',
  overviewTitle: 'Göreme Sıcak Hava Balonu Turu (Comfort Sınıf) Genel Bakış',
  overviewParagraphs: [
    'Göreme Sıcak Hava Balonu Turu (Comfort Sınıf), Kapadokya’nın büyüleyici manzaralarını daha geniş ve rahat sepet düzeninde gökyüzünden keşfetmek isteyen misafirler için hazırlanmıştır. Gün doğumunda yükselirken peri bacaları, vadiler ve volkanik kaya oluşumlarının benzersiz görüntülerini izlersiniz.',
    'Yaklaşık bir saat süren bu özel deneyim; konfor, güvenlik ve eşsiz manzaraları bir araya getirerek Kapadokya’da yaşayabileceğiniz en unutulmaz aktivitelerden birine dönüşür.'
  ],
  priceTitle: 'Göreme Sıcak Hava Balonu Turu (Comfort Sınıf) Fiyatı',
  priceText: 'Göreme Sıcak Hava Balonu Turu (Comfort Sınıf) kişi başı 110 €’dan başlayan fiyatlarla sunulmaktadır. Güncel müsaitlik, sezon yoğunluğu ve kesin rezervasyon bilgileri için bizimle doğrudan iletişime geçebilirsiniz.',
  whatsIncluded: [
    'Otelden alma ve otele bırakma',
    'Uçuş öncesi hafif kahvaltı',
    'Kalkış alanına transfer',
    'Deneyimli pilot tarafından güvenlik bilgilendirmesi',
    'Yaklaşık 1 saat sıcak hava balonu uçuşu',
    'Uçuş sertifikası',
    'Tam sigorta kapsamı',
    'Sepette ücretsiz Wi-Fi',
    'Profesyonel operasyon desteği',
    'Gizli ücret olmadan şeffaf hizmet'
  ],
  importantInfo: [
    'Uçuşlar yıl boyunca sabahın erken saatlerinde gerçekleştirilir.',
    'Uçuş süresi ve rotası hava koşullarına göre değişebilir.',
    'Tüm yolcular tam sigorta kapsamındadır.',
    'Rahat kıyafet ve uygun ayakkabı önerilir.',
    '16 yaş altı misafirler yalnızca bir yetişkin eşliğinde katılabilir.',
    '5 yaş altı çocuklar kabul edilmez.',
    'Hamileler ve yakın zamanda ciddi ameliyat geçiren misafirler için uygun değildir.',
    'Kalan ödeme turdan bir gün önce veya tur günü alınır; kartlı ödemelerde kişi başı 15 € işlem ücreti uygulanabilir.'
  ],
  flightDetailsTitle: 'Uçuş Detayları',
  flightDetailsParagraphs: [
    'Comfort Sınıf uçuşlarda sepet kapasitesi genellikle 16–20 kişi arasındadır. Bu düzen, standart uçuşlara göre daha ferah ve konforlu bir deneyim sağlar.',
    'Yolculuğunuz sabah erken saatte otelden alınmanızla başlar. Ardından kalkış alanına transfer edilirsiniz. Balonlar hazırlanırken profesyonel pilotunuz kısa bir güvenlik bilgilendirmesi yapar ve uçuş sürecini anlatır.',
    'Balon gün doğumuyla birlikte yavaşça yükselirken Göreme’nin eşsiz manzarası ayaklarınızın altına serilir. Peri bacaları, vadiler, üzüm bağları ve volkanik oluşumlar üzerinde oluşan altın renkli ışık büyüleyici bir atmosfer yaratır. Uçuş boyunca eşsiz fotoğraflar çekebilir ve Kapadokya’nın sessizliğini gökyüzünden yaşayabilirsiniz.'
  ],
  afterFlightTitle: 'Uçuş Sonrası',
  afterFlightText: 'İnişten sonra yer ekibimiz sizi karşılar ve gerekli desteği sağlar. Bu özel deneyimin hatırası olarak uçuş sertifikanızı alırsınız. Ardından konforlu şekilde otelinize geri transfer edilirsiniz.',
  refundTitle: 'İade Garantisi',
  refundText: 'Uçuşların hava koşulları nedeniyle iptal edilmesi durumunda rezervasyon bir sonraki uygun güne alınabilir. Yeniden planlama mümkün olmazsa tam ücret iadesi yapılır. Uçuştan 24 saat öncesine kadar ücretsiz iptal hakkı uygulanabilir. Tüm rezervasyonlar müsaitliğe bağlıdır.',
  advanceTitle: 'Neden Erken Rezervasyon?',
  advanceText: 'Kapadokya sıcak hava balonu uçuşları, Türkiye Sivil Havacılık otoritesi tarafından denetlenen ve düzenlenen bir yapı içinde gerçekleştirilir. Günlük kapasite sınırlı olduğundan özellikle yoğun dönemlerde erken rezervasyon önemlidir. Erken rezervasyon yer bulma ihtimalinizi artırır ve seyahat planınızı daha rahat yapmanızı sağlar.',
  safetyTitle: 'Güvenlik ve Deneyim',
  safetyText: '2010 yılından bu yana devam eden operasyonlarımızda yalnızca sertifikalı ve deneyimli pilotlarla çalışıyoruz. PPL ve SPL lisanslarına sahip, yüksek uçuş saatli profesyonellerle güvenlik, konfor ve misafir memnuniyeti her zaman önceliğimizdir. Tüm süreç boyunca 7/24 müşteri desteği sunuyoruz.'
};
const pageLang = 'tr';
const slug = 'goreme-comfort-hot-air-balloon-tour';
const mainImage = '/images/tours/goreme-comfort-hot-air-balloon-tour (2).webp';
export const prerender = false;
const extraSections = [
  { title: tour.afterFlightTitle || 'Tur Sonrası', paragraphs: tour.afterFlightText ? [tour.afterFlightText] : [] },
  { title: tour.refundTitle || 'İptal & İade', paragraphs: tour.refundText ? [tour.refundText] : [] },
  { title: tour.advanceTitle || 'Neden Önceden Rezervasyon?', paragraphs: tour.advanceText ? [tour.advanceText] : [] },
  { title: tour.safetyTitle || 'Güvenlik ve Deneyim', paragraphs: tour.safetyText ? [tour.safetyText] : [] }
].filter(s => s.paragraphs.length);
---
<StandardizedPrivateTourPage
  lang={pageLang}
  slug={slug}
  title={tour.title}
  heroDesc={tour.heroDesc}
  overviewTitle={tour.overviewTitle}
  overviewParagraphs={tour.overviewParagraphs || []}
  priceTitle={tour.priceTitle}
  priceText={tour.priceText}
  included={tour.whatsIncluded || []}
  importantTitle='Önemli Bilgiler'
  important={tour.importantInfo || []}
  detailsTitle={tour.flightDetailsTitle}
  details={tour.flightDetailsParagraphs || []}
  extraSections={extraSections}
  duration='60 Minutes'
  rating='4.97'
  reviewCount=0
  mainImage={mainImage}
  priceMode={/request|fiyat sor|consultar/i.test(String(tour.priceText || '')) ? 'ask' : 'perPerson'}
  sidebarBadges={(tour.whatsIncluded || []).slice(0,3)}
  sideHighlights={(tour.importantInfo || []).slice(0,5)}
/>
