---
import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const tour = {
  title: 'Kapadokya Yeşil Tur',
  kicker: 'CAPPADOCIAGO',
  heroDesc: "Kapadokya'nın doğal ve tarihi güzelliklerini daha geniş bir tam günlük rotada keşfedin. Yeşil Tur; panoramik manzaraları, Ihlara Vadisi'ni, yeraltı tarihini ve bölgenin unutulmaz doğal noktalarını bir araya getirir.",
  overviewTitle: 'Kapadokya Yeşil Tur Genel Bakış',
  overviewParagraphs: ['Kapadokya Yeşil Tur, bölgenin hem tarihi hem de doğal yönlerini daha detaylı keşfetmek isteyen misafirler için hazırlanmış tam günlük bir programdır. Sabah otelden alınmanızla başlayan tur profesyonel rehber ve konforlu ulaşım ile devam eder.'],
  priceTitle: 'Kapadokya Yeşil Tur Fiyatı',
  priceText: "Kapadokya Yeşil Tur kişi başı 50 Euro'dan başlayan fiyatlarla sunulmaktadır. Güncel fiyatlar sezona ve müsaitliğe göre değişebilir.",
  whatsIncluded: ['Otelden alma ve otele bırakma', 'Profesyonel tur rehberi', 'Öğle yemeği', 'Konforlu ulaşım', 'Yerel operasyon desteği', '7/24 müşteri desteği'],
  importantInfo: ['Tam günlük rehberli tur', 'Rahat yürüyüş ayakkabısı tavsiye edilir', 'Rota operasyon koşullarına göre değişebilir', 'Beslenme taleplerinizi önceden bildiriniz', 'Rezervasyonlar müsaitliğe bağlıdır', 'Hava koşulları açık hava duraklarını etkileyebilir'],
  flightDetailsTitle: 'Kapadokya Yeşil Tur Programı',
  flightDetailsParagraphs: ['Göreme Panorama: Kapadokya ve peri bacalarının geniş panoramik manzarasını izleyin.', 'Ihlara Vadisi: Vadi manzarası ve yürüyüş deneyimiyle bölgenin en özel doğal alanlarından birini keşfedin.', 'Panoramik Cam Teras: Ihlara çevresindeki eşsiz manzarayı panoramik noktadan izleyin.', "Belisırma'da Öğle Yemeği: Tur sırasında keyifli bir öğle yemeği molası verin.", 'Narlıgöl: Volkanik krater gölünü ve sakin doğal çevresini ziyaret edin.', 'Kaymaklı Yeraltı Şehri: Yeraltı odalarını, tünelleri ve eski Kapadokya yaşamının etkileyici atmosferini keşfedin.', 'Güvercinlik Vadisi: Güvercin evleri ve panoramik manzarasıyla ünlü vadiyi görün.', 'Oniks Atölyesi: Doğal taşların işlenmesi ve yerel el sanatları hakkında bilgi alın.', 'Otele Dönüş: Tur sonunda konforlu şekilde otelinize geri bırakılırsınız.'],
  afterFlightTitle: 'Tur Sonu',
  afterFlightText: 'Programın ardından konforlu şekilde otelinize geri transfer edilirsiniz.',
  refundTitle: 'İptal ve Rezervasyon',
  refundText: 'Rezervasyon ve iptal koşulları müsaitlik ve seçilen programa göre değişir. Kesin detaylar için bizimle iletişime geçebilirsiniz.',
  advanceTitle: 'Neden Erken Rezervasyon?',
  advanceText: 'Erken rezervasyon tercih ettiğiniz tarih, rehber ve araç müsaitliğini güvence altına almaya yardımcı olur.',
  safetyTitle: 'Profesyonel Hizmet',
  safetyText: 'Tur deneyimli sürücüler, profesyonel rehberler ve yerel operasyon ekibimiz tarafından organize edilir.'
};
const pageLang = 'tr';
const slug = 'green-tour-cappadocia';
const mainImage = '/images/tours/green-tour-cappadocia (2).webp';
export const prerender = false;
const extraSections = [
  { title: tour.afterFlightTitle || 'Tur Sonrası', paragraphs: tour.afterFlightText ? [tour.afterFlightText] : [] },
  { title: tour.refundTitle || 'İptal & İade', paragraphs: tour.refundText ? [tour.refundText] : [] },
  { title: tour.advanceTitle || 'Neden Önceden Rezervasyon?', paragraphs: tour.advanceText ? [tour.advanceText] : [] },
  { title: tour.safetyTitle || 'Güvenlik ve Deneyim', paragraphs: tour.safetyText ? [tour.safetyText] : [] }
].filter(s => s.paragraphs.length);
---
<StandardizedPrivateTourPage
  lang={pageLang}
  slug={slug}
  title={tour.title}
  heroDesc={tour.heroDesc}
  overviewTitle={tour.overviewTitle}
  overviewParagraphs={tour.overviewParagraphs || []}
  priceTitle={tour.priceTitle}
  priceText={tour.priceText}
  included={tour.whatsIncluded || []}
  importantTitle='Önemli Bilgiler'
  important={tour.importantInfo || []}
  detailsTitle={tour.flightDetailsTitle}
  details={tour.flightDetailsParagraphs || []}
  extraSections={extraSections}
  duration='Full Day'
  rating='4.97'
  reviewCount=0
  mainImage={mainImage}
  priceMode={/request|fiyat sor|consultar/i.test(String(tour.priceText || '')) ? 'ask' : 'perPerson'}
  sidebarBadges={(tour.whatsIncluded || []).slice(0,3)}
  sideHighlights={(tour.importantInfo || []).slice(0,5)}
/>
