import FloatingAssistant from "../../components/FloatingAssistant.astro";
import FaqPage from "../../components/FaqPage.astro";
const items=[{q:"Kapadokya’da sıcak hava balonları ne zaman uçar?",a:["Balon uçuşları genellikle gün doğumu çevresindeki iki sabah seansında gerçekleştirilir. Otel alım saati çoğunlukla ilk uçuş saatinden yaklaşık bir saat öncedir ve kesin saat bir gün önce bildirilir."]},{q:"Balonlar ne kadar yükselir?",a:["Rüzgâr ve hava koşullarına bağlı olarak balonlar yaklaşık 8.000 ft (2.400 m) seviyesine kadar yükselebilir."]},{q:"Balon uçuşu güvenli mi?",a:["Türkiye’de balon uçuşları SHGM tarafından sıkı şekilde düzenlenir ve yalnızca uygun hava koşullarında yetkili operatörlerle gerçekleştirilir."]},{q:"Balon uçuşları sigortalı mı?",a:["Evet. Yolcu sigortası bilet fiyatına dahildir."]},{q:"Kötü hava nedeniyle uçuş iptal edilirse ne olur?",a:["Güvenli olmayan hava koşullarında uçuş iptal edilirse tam iade veya müsaitliğe bağlı alternatif tarih seçeneği sunulur."]},{q:"Uçuş tarihimi değiştirebilir miyim?",a:["Evet. Koltuk müsaitliğine bağlı olarak tarih değişikliği talep edilebilir; sezon fiyat farkı veya yeniden düzenleme ücreti uygulanabilir."]},{q:"Nereden kalkıyor ve nerelerin üzerinden uçuyoruz?",a:["Kalkış noktası sabah rüzgârına göre belirlenir. Rota Göreme, Paşabağ, Çavuşin, Gül Vadisi, Aşk Vadisi, Kılıçlar Vadisi ve Kızılçukur üzerinden geçebilir."]},{q:"Gönüllü iptalde ücret var mı?",a:["İptal koşulları bildirimin ne kadar önce yapıldığına göre değişir. Detaylar Mesafeli Satış Sözleşmesi’nde yer alır."]},{q:"Otel alım konumumu değiştirebilir miyim?",a:["Evet. Yeni adres standart servis alanı içindeyse uçuş öncesinde destek ekibimizle iletişime geçebilirsiniz."]},{q:"Başka hangi turlar ve aktiviteler var?",a:["Red, Green ve Blue Tour; ATV ve Jeep Safari; at turu; Türk Gecesi; kültürel aktiviteler ve transfer hizmetleri sunuyoruz."]},{q:"Uçuş öncesi en önemli güvenlik kuralı nedir?",a:["Pilotun güvenlik brifingini dikkatle dinleyin ve özellikle iniş pozisyonu dahil tüm talimatlara uyun."]}];
---
