---
import FloatingAssistant from "../../../components/FloatingAssistant.astro";
import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const props = {
  "title": "Paquete Personalizado de Capadocia",
  "heroDesc": "Tu sueño, nuestra experiencia en Capadocia: crea un paquete a medida según los días de estancia y las actividades que quieres vivir.",
  "overviewTitle": "Resumen del Paquete Personalizado",
  "overviewParagraphs": [
    "Personaliza tus vacaciones en Capadocia según tus preferencias. Diseñamos un paquete a medida que combina tours emblemáticos, actividades de aventura y experiencias culturales según los días de estancia.",
    "Indícanos cuánto tiempo estarás en Capadocia y qué experiencias te interesan; nuestro equipo preparará un itinerario práctico."
  ],
  "priceTitle": "Precio del Paquete Personalizado",
  "priceText": "Consultar Precio. La cotización se prepara según el tamaño del grupo, número de días, tours, actividades, traslados y otros servicios solicitados.",
  "included": [
    "Planificación de itinerario a medida",
    "Tour Rojo o Verde Privado",
    "Opción de añadir vuelo en globo al amanecer",
    "Opciones de ATV, paseo a caballo o Jeep Safari",
    "Traslados al aeropuerto y vehículo privado",
    "Asistencia de consultor de viaje"
  ],
  "importantTitle": "Menú de Actividades",
  "important": [
    "Exploración Cultural: Tour Rojo Privado o Tour Verde Privado",
    "Experiencia en el Cielo: Vuelo en Globo al Amanecer",
    "ATV Safari por los valles",
    "Paseo a Caballo por la Tierra de los Bellos Caballos",
    "Jeep Safari por picos y valles de difícil acceso"
  ],
  "detailsTitle": "Ejemplo de Paquete de 3 Días",
  "details": [
    "Día 1: Llegada, check-in y Tour Rojo Privado.",
    "Día 2: Globo al amanecer y Tour Verde Privado.",
    "Día 3: ATV al amanecer o paseo a caballo, city tour y salida."
  ],
  "extraSections": [
    {
      "title": "¿Cómo Funciona?",
      "paragraphs": [
        "Planificamos el programa según la duración de tu estancia y tus preferencias. El ejemplo es solo un borrador y puede modificarse."
      ]
    },
    {
      "title": "¿Por Qué Planificar con Nosotros?",
      "items": [
        "Total flexibilidad: elige solo los tours que deseas",
        "Comodidad integral con traslados, vehículos privados y guías profesionales",
        "Precio personalizado según grupo y actividades"
      ]
    }
  ],
  "duration": "Flexible",
  "rating": "",
  "mainImage": "/images/tours/cappadocia-package-tours.webp",
  "galleryImages": [
    "/images/tours/goreme-standart-hot-air-balloon-tour (2).webp",
    "/images/tours/red-tour-cappadocia (4).webp",
    "/images/tours/green-tour-cappadocia (4).webp",
    "/images/tours/ATV-Tour-With-Goreme-Valleys (2).webp"
  ],
  "priceMode": "ask",
  "sidebarBadges": [
    "A Medida",
    "Días Flexibles",
    "Consultar Precio"
  ],
  "sideHighlights": [
    "Elige solo las experiencias que quieras",
    "Combina globo, tours y actividades",
    "Opciones de traslado privado",
    "Consultor personal de viaje"
  ]
};
---
<StandardizedPrivateTourPage lang="es" slug="cappadocia-custom-package-tour" {...props} />
<FloatingAssistant lang="es" />
<link rel="stylesheet" href="/cappadociago-brand-v2.css" />

<link rel="stylesheet" href="/tour-unified-final.css" />

<!-- CG_FINAL_TOUR_MOBILE_COMFORT -->
<link rel="stylesheet" href="/tour-mobile-comfort-final.css" />

<!-- CG_FINAL_MOBILE_TOUR_CONTENT_PHONE -->
<link rel="stylesheet" href="/tour-mobile-critical-v3.css" />

<style is:global>
/* FINAL INLINE MOBILE TOUR FLOW FIX — keeps Comfort design, fixes 1-letter vertical text */
@media (max-width: 900px){
  body .tbc-tour-container, body .container{width:100%!important;max-width:100%!important;min-width:0!important;padding-inline:0!important;}
  body .tbc-tour-grid, body .grid{display:flex!important;flex-direction:column!important;grid-template-columns:none!important;width:100%!important;max-width:100%!important;min-width:0!important;gap:14px!important;align-items:stretch!important;}
  body .tbc-tour-main, body .main-col{order:1!important;display:block!important;position:static!important;float:none!important;width:100%!important;max-width:100%!important;min-width:0!important;flex:0 0 auto!important;margin:0!important;padding:0!important;overflow:visible!important;}
  body .tbc-tour-side, body .side{order:2!important;display:flex!important;flex-direction:column!important;position:static!important;float:none!important;width:100%!important;max-width:100%!important;min-width:0!important;flex:0 0 auto!important;margin:0!important;overflow:visible!important;}
  body .tbc-tour-main-card, body .card.content, body .content{display:block!important;width:100%!important;max-width:100%!important;min-width:0!important;overflow:visible!important;}
  body .tbc-tour-section, body .content>section, body .content section{display:block!important;width:100%!important;max-width:100%!important;min-width:0!important;height:auto!important;max-height:none!important;overflow:visible!important;visibility:visible!important;opacity:1!important;clear:both!important;float:none!important;position:relative!important;}
  body .tbc-tour-section *, body .content>section *, body .content section *{max-width:100%!important;min-width:0!important;writing-mode:horizontal-tb!important;text-orientation:mixed!important;}
  body .tbc-tour-section h1, body .tbc-tour-section h2, body .tbc-tour-section h3,
  body .content h1, body .content h2, body .content h3,
  body .tbc-tour-section p, body .content p,
  body .tbc-tour-section li, body .content li,
  body .tbc-tour-list-item, body .tbc-tour-list-item span{
    width:auto!important;max-width:100%!important;min-width:0!important;
    white-space:normal!important;word-break:normal!important;overflow-wrap:break-word!important;
    writing-mode:horizontal-tb!important;text-orientation:mixed!important;
  }
  body .tbc-tour-section h2, body .content h2{font-size:18px!important;line-height:1.3!important;margin:0 0 10px!important;}
  body .tbc-tour-section p, body .content p, body .tbc-tour-section li, body .content li, body .tbc-tour-list-item{font-size:12.5px!important;line-height:1.72!important;}
  body .tbc-tour-list{display:grid!important;grid-template-columns:1fr!important;width:100%!important;gap:8px!important;}
  body .tbc-tour-list-item{display:flex!important;align-items:flex-start!important;gap:8px!important;}
  body .tbc-tour-check{flex:0 0 18px!important;}
  body .tbc-tour-side .tbc-tour-card, body .booking, body .tbc-booking-card, body .price-card, body .tbc-price-card{width:100%!important;max-width:100%!important;min-width:0!important;}
  body .booking .iti, body .tbc-booking-card .iti, body .iti{width:100%!important;max-width:100%!important;min-width:0!important;}
  body .iti__country-container{width:94px!important;min-width:94px!important;max-width:94px!important;}
  body .iti__selected-country{width:94px!important;min-width:94px!important;max-width:94px!important;padding:0 9px!important;}
  body .iti__tel-input{width:100%!important;max-width:100%!important;min-width:0!important;padding-left:106px!important;padding-right:12px!important;box-sizing:border-box!important;}
}
@media (max-width: 390px){
  body .tbc-tour-section h2, body .content h2{font-size:17px!important;}
  body .tbc-tour-section p, body .content p, body .tbc-tour-section li, body .content li, body .tbc-tour-list-item{font-size:12px!important;}
  body .iti__country-container, body .iti__selected-country{width:88px!important;min-width:88px!important;max-width:88px!important;}
  body .iti__tel-input{padding-left:100px!important;}
}
</style>

