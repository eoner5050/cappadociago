---
import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const tour = {
  title: 'Tour en Globo por Göreme (Clase Comfort)',
  kicker: 'CAPPADOCIAGO',
  heroDesc: 'Si quieres contemplar el amanecer sobre Göreme desde el cielo y disfrutar de una experiencia en globo más cómoda entre chimeneas de hadas y valles, el Tour en Globo por Göreme (Clase Comfort) te ofrece un recuerdo inolvidable de Capadocia.',
  overviewTitle: 'Resumen del Tour en Globo por Göreme (Clase Comfort)',
  overviewParagraphs: [
    'El Tour en Globo por Göreme (Clase Comfort) está diseñado para quienes desean descubrir los fascinantes paisajes de Capadocia desde el cielo con una distribución de cesta más espaciosa y cómoda. Mientras asciendes al amanecer, disfrutarás de una experiencia visual única sobre chimeneas de hadas, valles y formaciones rocosas volcánicas.',
    'Esta experiencia especial, de aproximadamente una hora de duración, combina comodidad, seguridad y vistas impresionantes, convirtiéndose en una de las actividades más inolvidables que puedes disfrutar en Capadocia.'
  ],
  priceTitle: 'Precio del Tour en Globo por Göreme (Clase Comfort)',
  priceText: 'El Tour en Globo por Göreme (Clase Comfort) está disponible desde 110 € por persona. Para consultar disponibilidad actual, demanda de temporada y detalles de reserva confirmados, contáctanos directamente.',
  whatsIncluded: [
    'Recogida y regreso al hotel',
    'Desayuno ligero antes del vuelo',
    'Traslado a la zona de despegue',
    'Información de seguridad por un piloto experimentado',
    'Vuelo en globo aerostático de aproximadamente 1 hora',
    'Certificado de vuelo',
    'Cobertura de seguro completa',
    'Wi-Fi gratuito en la cesta',
    'Asistencia profesional de operaciones',
    'Servicio transparente sin cargos ocultos'
  ],
  importantInfo: [
    'Los vuelos se realizan a primera hora de la mañana durante todo el año.',
    'La duración y la ruta del vuelo pueden variar según las condiciones meteorológicas.',
    'Todos los pasajeros cuentan con cobertura de seguro completa.',
    'Se recomienda ropa cómoda y calzado adecuado.',
    'Los menores de 16 años solo pueden participar acompañados por un adulto.',
    'No se aceptan niños menores de 5 años.',
    'No es adecuado para embarazadas ni para personas que hayan tenido recientemente una cirugía importante.',
    'El pago restante se cobra un día antes o el día del tour; los pagos con tarjeta pueden incluir una comisión de 15 € por persona.'
  ],
  flightDetailsTitle: 'Detalles del Vuelo',
  flightDetailsParagraphs: [
    'En los vuelos de Clase Comfort, la capacidad de la cesta suele variar entre 16 y 20 pasajeros. Esta distribución ofrece una experiencia más cómoda y espaciosa que los vuelos estándar.',
    'Tu viaje comienza con la recogida en el hotel a primera hora de la mañana. Después serás trasladado a la zona de despegue. Mientras se preparan los globos, el piloto profesional ofrece una breve explicación de seguridad y describe el proceso del vuelo.',
    'Cuando el globo asciende lentamente con el amanecer, el paisaje único de Göreme aparece bajo tus pies. La luz dorada sobre las chimeneas de hadas, los valles, los viñedos y las formaciones volcánicas crea una atmósfera realmente mágica. Durante el vuelo podrás tomar fotografías increíbles y disfrutar del silencio de Capadocia desde el cielo.'
  ],
  afterFlightTitle: 'Después del Vuelo',
  afterFlightText: 'Después del aterrizaje, nuestro equipo de tierra te recibe y presta la asistencia necesaria. Recibirás tu certificado de vuelo como recuerdo de esta experiencia especial. Después serás trasladado cómodamente de regreso a tu hotel.',
  refundTitle: 'Garantía de Reembolso',
  refundText: 'Si los vuelos se cancelan por condiciones meteorológicas, podrán reprogramarse para el siguiente día disponible. Si no es posible reprogramar, se realizará un reembolso completo. Puede haber cancelación gratuita hasta 24 horas antes del vuelo. Todas las reservas están sujetas a disponibilidad.',
  advanceTitle: '¿Por Qué Reservar con Anticipación?',
  advanceText: 'Los vuelos en globo aerostático en Capadocia funcionan bajo una estructura regulada y supervisada por la Autoridad de Aviación Civil de Turquía. Como la capacidad diaria es limitada, reservar con antelación es especialmente importante en periodos de alta demanda. La reserva anticipada aumenta tus posibilidades de conseguir plaza y permite una mejor planificación.',
  safetyTitle: 'Seguridad y Experiencia',
  safetyText: 'En nuestra operación, activa desde 2010, trabajamos únicamente con pilotos certificados y experimentados. Con profesionales que poseen licencias PPL y SPL y muchas horas de vuelo, la seguridad, la comodidad y la satisfacción de nuestros huéspedes son siempre prioritarias. También ofrecemos atención al cliente 24/7 durante todo el proceso.'
};
const pageLang = 'es';
const slug = 'goreme-comfort-hot-air-balloon-tour';
const mainImage = '/images/tours/goreme-comfort-hot-air-balloon-tour (2).webp';
export const prerender = false;
const extraSections = [
  { title: tour.afterFlightTitle || 'Después del Tour', paragraphs: tour.afterFlightText ? [tour.afterFlightText] : [] },
  { title: tour.refundTitle || 'Cancelación y Reembolso', paragraphs: tour.refundText ? [tour.refundText] : [] },
  { title: tour.advanceTitle || '¿Por qué reservar con antelación?', paragraphs: tour.advanceText ? [tour.advanceText] : [] },
  { title: tour.safetyTitle || 'Seguridad y Experiencia', paragraphs: tour.safetyText ? [tour.safetyText] : [] }
].filter(s => s.paragraphs.length);
---
<StandardizedPrivateTourPage
  lang={pageLang}
  slug={slug}
  title={tour.title}
  heroDesc={tour.heroDesc}
  overviewTitle={tour.overviewTitle}
  overviewParagraphs={tour.overviewParagraphs || []}
  priceTitle={tour.priceTitle}
  priceText={tour.priceText}
  included={tour.whatsIncluded || []}
  importantTitle='Información Importante'
  important={tour.importantInfo || []}
  detailsTitle={tour.flightDetailsTitle}
  details={tour.flightDetailsParagraphs || []}
  extraSections={extraSections}
  duration='60 Minutes'
  rating='4.97'
  reviewCount=0
  mainImage={mainImage}
  priceMode={/request|fiyat sor|consultar/i.test(String(tour.priceText || '')) ? 'ask' : 'perPerson'}
  sidebarBadges={(tour.whatsIncluded || []).slice(0,3)}
  sideHighlights={(tour.importantInfo || []).slice(0,5)}
/>
