---
import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const tour = {
  title: 'Tour Verde de Capadocia',
  kicker: 'CAPPADOCIAGO',
  heroDesc: 'Explora la belleza natural e histórica de Capadocia en una ruta más amplia de día completo. El Tour Verde combina miradores panorámicos, el Valle de Ihlara, historia subterránea y algunos de los paisajes más memorables de la región.',
  overviewTitle: 'Resumen del Tour Verde de Capadocia',
  overviewParagraphs: ['El Tour Verde de Capadocia es un programa de día completo para quienes desean descubrir con mayor profundidad los aspectos históricos y naturales de la región. Comienza con la recogida en el hotel y continúa con guía profesional y transporte cómodo.'],
  priceTitle: 'Precio del Tour Verde de Capadocia',
  priceText: 'El Tour Verde de Capadocia está disponible desde 50 Euro por persona. Los precios actuales pueden variar según la temporada y la disponibilidad.',
  whatsIncluded: ['Recogida y regreso al hotel', 'Guía turístico profesional', 'Almuerzo', 'Transporte cómodo', 'Asistencia local de operaciones', 'Atención al cliente 24/7'],
  importantInfo: ['Tour guiado de día completo', 'Se recomienda calzado cómodo', 'La ruta puede cambiar según las condiciones operativas', 'Infórmanos sobre requisitos alimentarios', 'Reservas sujetas a disponibilidad', 'El clima puede afectar las paradas al aire libre'],
  flightDetailsTitle: 'Programa del Tour Verde',
  flightDetailsParagraphs: ['Panorama de Göreme: Disfruta de una amplia vista panorámica de Capadocia y sus chimeneas de hadas.', 'Valle de Ihlara: Descubre una de las zonas naturales más especiales de la región con paisajes y una agradable experiencia de caminata.', 'Terraza Panorámica de Cristal: Contempla el paisaje único de los alrededores de Ihlara.', 'Almuerzo en Belisırma: Disfruta de una agradable pausa para almorzar durante la ruta.', 'Narlıgöl: Visita el tranquilo lago de cráter volcánico y su entorno natural.', 'Ciudad Subterránea de Kaymaklı: Descubre habitaciones, túneles y la fascinante vida subterránea de la antigua Capadocia.', 'Valle de las Palomas: Visita uno de los valles más famosos de Capadocia, con palomares y vistas panorámicas.', 'Demostración de Ónix: Conoce el trabajo de piedras naturales y la artesanía local.', 'Regreso al Hotel: Al finalizar el tour, regresarás cómodamente a tu hotel.'],
  afterFlightTitle: 'Fin del Tour',
  afterFlightText: 'Después del programa, regresarás cómodamente a tu hotel.',
  refundTitle: 'Cancelación y Reserva',
  refundText: 'Las condiciones de reserva y cancelación dependen de la disponibilidad y del programa elegido. Contáctanos para confirmar los detalles.',
  advanceTitle: '¿Por Qué Reservar con Anticipación?',
  advanceText: 'Reservar con antelación ayuda a asegurar la fecha, el guía y el vehículo deseados.',
  safetyTitle: 'Servicio Profesional',
  safetyText: 'El tour está organizado con conductores experimentados, guías profesionales y nuestro equipo local de operaciones.'
};
const pageLang = 'es';
const slug = 'green-tour-cappadocia';
const mainImage = '/images/tours/green-tour-cappadocia (2).webp';
export const prerender = false;
const extraSections = [
  { title: tour.afterFlightTitle || 'Después del Tour', paragraphs: tour.afterFlightText ? [tour.afterFlightText] : [] },
  { title: tour.refundTitle || 'Cancelación y Reembolso', paragraphs: tour.refundText ? [tour.refundText] : [] },
  { title: tour.advanceTitle || '¿Por qué reservar con antelación?', paragraphs: tour.advanceText ? [tour.advanceText] : [] },
  { title: tour.safetyTitle || 'Seguridad y Experiencia', paragraphs: tour.safetyText ? [tour.safetyText] : [] }
].filter(s => s.paragraphs.length);
---
<StandardizedPrivateTourPage
  lang={pageLang}
  slug={slug}
  title={tour.title}
  heroDesc={tour.heroDesc}
  overviewTitle={tour.overviewTitle}
  overviewParagraphs={tour.overviewParagraphs || []}
  priceTitle={tour.priceTitle}
  priceText={tour.priceText}
  included={tour.whatsIncluded || []}
  importantTitle='Información Importante'
  important={tour.importantInfo || []}
  detailsTitle={tour.flightDetailsTitle}
  details={tour.flightDetailsParagraphs || []}
  extraSections={extraSections}
  duration='Full Day'
  rating='4.97'
  reviewCount=0
  mainImage={mainImage}
  priceMode={/request|fiyat sor|consultar/i.test(String(tour.priceText || '')) ? 'ask' : 'perPerson'}
  sidebarBadges={(tour.whatsIncluded || []).slice(0,3)}
  sideHighlights={(tour.importantInfo || []).slice(0,5)}
/>
