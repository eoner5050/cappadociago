---
import StandardizedPrivateTourPage from '../../../components/StandardizedPrivateTourPage.astro';
const tour = {
  title: 'Tour en Globo por Göreme (Vuelo Estándar)',
  kicker: 'CAPPADOCIAGO',
  heroDesc: 'Vive la magia de un Tour en Globo por Capadocia (Vuelo Estándar) y contempla el impresionante amanecer sobre Göreme. Vuela sobre las famosas chimeneas de hadas y los espectaculares valles de la región mientras disfrutas de una de las experiencias en globo aerostático más inolvidables de Capadocia.',
  overviewTitle: 'Resumen del Tour en Globo por Göreme (Vuelo Estándar)',
  overviewParagraphs: [
    'El Tour en Globo por Capadocia (Vuelo Estándar) está pensado para viajeros que desean descubrir los impresionantes paisajes de Capadocia desde el cielo con una excelente relación calidad-precio. Al amanecer, sobrevolarás las famosas chimeneas de hadas de Göreme, sus espectaculares valles y sus singulares formaciones rocosas volcánicas.',
    'Este Tour en Globo por Capadocia (Vuelo Estándar) dura aproximadamente una hora, ofreciéndote tiempo suficiente para admirar las increíbles vistas de Göreme, las chimeneas de hadas, los valles y las formaciones volcánicas. Combinando seguridad, servicio profesional y espectaculares vistas del amanecer, es una de las experiencias en globo más inolvidables de Capadocia.'
  ],
  priceTitle: 'Precio del Tour en Globo por Göreme (Vuelo Estándar)',
  priceText: 'El Tour en Globo por Göreme (Vuelo Estándar) está previsto desde 80 € por persona. Para consultar disponibilidad actual, demanda de temporada y reservas confirmadas, contáctanos directamente. Nuestro equipo te informará de las últimas plazas disponibles y te ayudará a asegurar tu reserva.',
  whatsIncluded: [
    'Recogida y regreso al hotel',
    'Desayuno ligero antes del vuelo',
    'Traslado a la zona de despegue',
    'Información de seguridad por un piloto experimentado',
    'Vuelo en globo aerostático de aproximadamente 1 hora',
    'Certificado de vuelo',
    'Cobertura de seguro completa',
    'Wi-Fi gratuito en la cesta',
    'Asistencia profesional de operaciones',
    'Servicio transparente sin cargos ocultos'
  ],
  importantInfo: [
    'Los vuelos se realizan a primera hora de la mañana durante todo el año.',
    'La duración y la ruta del vuelo pueden variar según las condiciones meteorológicas.',
    'Todos los pasajeros cuentan con cobertura de seguro completa.',
    'Se recomienda ropa cómoda y calzado adecuado.',
    'Los menores de 16 años solo pueden participar acompañados por un adulto.',
    'No se aceptan niños menores de 5 años.',
    'No es adecuado para embarazadas ni para personas que hayan tenido recientemente una cirugía importante.',
    'El pago restante se cobra un día antes o el día del tour; los pagos con tarjeta pueden incluir una comisión de 15 € por persona.'
  ],
  flightDetailsTitle: 'Detalles del Vuelo',
  flightDetailsParagraphs: [
    'El Tour en Globo por Capadocia (Vuelo Estándar) se realiza con cestas con capacidad para 28 pasajeros. Disfruta de impresionantes vistas del amanecer sobre las famosas chimeneas de hadas de Göreme, sus espectaculares valles y sus paisajes volcánicos.',
    'Tu Tour en Globo por Capadocia (Vuelo Estándar) comienza con la recogida en el hotel a primera hora y un cómodo traslado a la zona de despegue. Mientras los globos se preparan, tu piloto experimentado ofrece una breve explicación de seguridad y describe el proceso del vuelo.',
    'Al amanecer, el globo te eleva sobre los impresionantes paisajes de Göreme. Contempla la luz dorada iluminando las chimeneas de hadas, los valles, los viñedos y las formaciones rocosas volcánicas. Durante el vuelo tendrás muchas oportunidades para tomar fotografías increíbles y disfrutar de la tranquilidad de Capadocia desde el cielo.'
  ],
  afterFlightTitle: 'Después del Vuelo',
  afterFlightText: 'Después del aterrizaje, nuestro equipo de tierra te recibe y presta la asistencia necesaria. Recibirás tu certificado de vuelo como recuerdo de esta experiencia especial. Después serás trasladado cómodamente de regreso a tu hotel.',
  refundTitle: 'Garantía de Reembolso',
  refundText: 'Si los vuelos se cancelan por condiciones meteorológicas, podrán reprogramarse para el siguiente día disponible. Si no es posible reprogramar, se realizará un reembolso completo. Puede haber cancelación gratuita hasta 24 horas antes del vuelo. Todas las reservas están sujetas a disponibilidad.',
  advanceTitle: '¿Por Qué Reservar con Anticipación?',
  advanceText: 'Los vuelos en globo aerostático en Capadocia funcionan bajo una estructura regulada y supervisada por la Autoridad de Aviación Civil de Turquía. Como la capacidad diaria es limitada, reservar con antelación es especialmente importante en periodos de alta demanda.',
  safetyTitle: 'Seguridad y Experiencia',
  safetyText: 'Nuestro Tour en Globo por Capadocia (Vuelo Estándar) está operado por pilotos certificados y altamente experimentados con licencias PPL y SPL. Cada vuelo se realiza con altos estándares de seguridad y profesionalidad para ofrecer una experiencia cómoda y agradable. Nuestro equipo ofrece además atención al cliente 24/7 durante todo el viaje.'
};
const pageLang = 'es';
const slug = 'goreme-standart-hot-air-balloon-tour';
const mainImage = '/images/tours/goreme-standart-hot-air-balloon-tour (2).webp';
export const prerender = false;
const extraSections = [
  { title: tour.afterFlightTitle || 'Después del Tour', paragraphs: tour.afterFlightText ? [tour.afterFlightText] : [] },
  { title: tour.refundTitle || 'Cancelación y Reembolso', paragraphs: tour.refundText ? [tour.refundText] : [] },
  { title: tour.advanceTitle || '¿Por qué reservar con antelación?', paragraphs: tour.advanceText ? [tour.advanceText] : [] },
  { title: tour.safetyTitle || 'Seguridad y Experiencia', paragraphs: tour.safetyText ? [tour.safetyText] : [] }
].filter(s => s.paragraphs.length);
---
<StandardizedPrivateTourPage
  lang={pageLang}
  slug={slug}
  title={tour.title}
  heroDesc={tour.heroDesc}
  overviewTitle={tour.overviewTitle}
  overviewParagraphs={tour.overviewParagraphs || []}
  priceTitle={tour.priceTitle}
  priceText={tour.priceText}
  included={tour.whatsIncluded || []}
  importantTitle='Información Importante'
  important={tour.importantInfo || []}
  detailsTitle={tour.flightDetailsTitle}
  details={tour.flightDetailsParagraphs || []}
  extraSections={extraSections}
  duration='60 Minutes'
  rating='4.95'
  reviewCount=0
  mainImage={mainImage}
  priceMode={/request|fiyat sor|consultar/i.test(String(tour.priceText || '')) ? 'ask' : 'perPerson'}
  sidebarBadges={(tour.whatsIncluded || []).slice(0,3)}
  sideHighlights={(tour.importantInfo || []).slice(0,5)}
/>
