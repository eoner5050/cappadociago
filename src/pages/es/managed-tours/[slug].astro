---
import DatabaseTourPage from '../../../components/DatabaseTourPage.astro';
import FloatingAssistant from '../../../components/FloatingAssistant.astro';
import { getPublishedTour } from '../../../lib/databaseTours';
export const prerender = false;
const { slug = '' } = Astro.params;
const result = await getPublishedTour(slug, 'es');
if (!result) return Astro.redirect('/es/cappadocia-tours/');
---
<DatabaseTourPage lang="es" tour={result.tour} translation={result.translation} />
<FloatingAssistant lang="es" />
