import FloatingAssistant from "../../components/FloatingAssistant.astro";
import FaqPage from "../../components/FaqPage.astro";
const items=[{q:"¿Cuándo vuelan los globos en Capadocia?",a:["Los vuelos suelen operar en dos sesiones por la mañana alrededor del amanecer. La hora exacta de recogida se confirma el día anterior."]},{q:"¿A qué altura vuelan los globos?",a:["Dependiendo del viento y del clima, pueden alcanzar aproximadamente 8.000 pies (2.400 m)."]},{q:"¿Es seguro volar en globo?",a:["Los vuelos están estrictamente regulados por la autoridad de aviación civil de Turquía (SHGM) y solo operan en condiciones adecuadas."]},{q:"¿Los vuelos están asegurados?",a:["Sí. El seguro de pasajeros está incluido en el precio del billete."]},{q:"¿Qué pasa si el vuelo se cancela por mal tiempo?",a:["Se ofrece reembolso completo o una fecha alternativa, sujeta a disponibilidad."]},{q:"¿Puedo cambiar la fecha?",a:["Sí, sujeto a disponibilidad. Puede aplicarse una diferencia estacional o tasa de reemisión."]},{q:"¿Desde dónde despegamos?",a:["El punto de despegue depende del viento. Las rutas pueden pasar por Göreme, Paşabağ, Çavuşin, Rose Valley, Love Valley, Swords Valley y Kızılçukur."]},{q:"¿Hay cargos por cancelación voluntaria?",a:["Dependen del plazo de aviso. Consulta el Contrato de Venta a Distancia."]},{q:"¿Puedo cambiar el lugar de recogida?",a:["Sí, si la nueva dirección está dentro de nuestra zona estándar de servicio."]},{q:"¿Qué otros tours y actividades ofrecen?",a:["Ofrecemos Red, Green y Blue Tour, ATV, Jeep Safari, paseos a caballo, Noche Turca y traslados."]},{q:"¿Cuáles son las reglas de seguridad más importantes?",a:["Escucha atentamente la charla del piloto y sigue todas las instrucciones, especialmente la posición de aterrizaje."]}];
---
<FaqPage lang="es" title="Preguntas Frecuentes" items={items} />
<FloatingAssistant lang="es" />
