# Copy this file to .env and fill in your real values.
# Get these from Supabase Dashboard → Project Settings → API

# Safe to expose to the browser (used for public read-only queries)
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Google Ads measurement. The base tag is already configured for CappadociaGo.
PUBLIC_GOOGLE_ADS_ID=AW-18426176965
# Add the send_to values after creating the two Google Ads conversion actions.
PUBLIC_GOOGLE_ADS_WHATSAPP_SEND_TO=AW-18426176965/8N_-CIT01O0cEMXLpNJE
PUBLIC_GOOGLE_ADS_RESERVATION_SEND_TO=AW-18426176965/vg1fCMqy4O0cEMXLpNJE

# NEVER expose this one to the browser. Server-side only.
# Used by src/pages/api/add-tour.ts to insert new tours.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
